# Install as /etc/paradox-verify-systemd.conf, owned by root and mode 0644.
# Values are parsed as data; this file is never sourced by a shell.
repository=/home/mewse/paradox_neo
uid=1002
gid=1002
user=mewse
group=mewse
home=/home/mewse
memory_max_mib=32768
memory_reserve_mib=12288
cpu_reserve=2
tasks_max=8192
runtime_max_sec=604800
engine=podman
worker_image=localhost/paradox-verification-worker@sha256:9af0174219c3b0467cec8a4f0db8b3b664077ff797c88fd38ad03402e94bab4c
