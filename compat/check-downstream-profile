cp "$EVIDENCE_VERIFIER" "$EVIDENCE/inputs/verify-repository-evidence.R"
cp "$BRIDGE_EVIDENCE/metadata/completion.tsv" \
  "$EVIDENCE/inputs/downstream-bridges-completion.tsv"
cp "$BRIDGE_EVIDENCE/metadata/packages.tsv" \
  "$EVIDENCE/inputs/downstream-bridges-packages.tsv"
cp "$BRIDGE_EVIDENCE/metadata/completion.seal" \
  "$EVIDENCE/inputs/downstream-bridges-completion.seal"
cp "$BRIDGE_EVIDENCE/metadata/evidence-manifest.tsv" \
  "$EVIDENCE/inputs/downstream-bridges-evidence-manifest.tsv"
cp "$PROVENANCE" "$EVIDENCE/inputs/candidate-provenance.tsv"
cp "$PROVENANCE_SEAL" "$EVIDENCE/inputs/candidate-provenance.sha256"
cp "$SENTINEL" "$EVIDENCE/inputs/candidate-content-sha256"

ALL_LIBRARIES=("$CANDIDATE_LIBRARY" "${EXTRA_LIBRARIES[@]}" "$DEPENDENCY_LIBRARY")
LIBRARIES=$(IFS=:; printf '%s' "${ALL_LIBRARIES[*]}")

TOOLING_COMMIT=$(git_value "$ROOT" rev-parse --verify 'HEAD^{commit}')
TOOLING_TREE=$(git_value "$ROOT" rev-parse --verify "$TOOLING_COMMIT^{tree}")
[[ -z $(git_value "$ROOT" status --porcelain=v1 --untracked-files=all) ]] ||
  fail "check tooling worktree is dirty"
PROTECTED_BEFORE=$(library_inputs)
printf '%s\n' "$PROTECTED_BEFORE" >"$EVIDENCE/metadata/library-inputs.tsv"

printf 'repository\tcommit\ttree\tstatus\tbuild_exit_status\tcheck_exit_status\telapsed_seconds\tbuild_log_sha256\tcheck_log_sha256\tpackage_path\tpackage_sha256\n' \
  >"$EVIDENCE/results.tsv"
printf 'repository\tcommit\ttree\tcommit_date\tbranch\tarchive_sha256\n' \
  >"$EVIDENCE/metadata/selection.tsv"
failed=0
for repository in "${SELECTED[@]}"; do
  identity=$(authenticate_checkout "$repository")
  IFS=$'\t' read -r _ commit tree _ _ <<<"$identity"
  row=$BUILD/$repository
  mkdir "$row" "$row/source" "$row/home" "$row/tmp" "$row/cache" \
    "$row/package-output" "$row/check"
  git_value "$CONSUMER_ROOT/$repository" archive --format=tar \
    -o "$row/source.tar" "$commit"
  archive_sha256=$(sha256sum "$row/source.tar" | awk '{print $1}')
  printf '%s\t%s\n' "$identity" "$archive_sha256" \
    >>"$EVIDENCE/metadata/selection.tsv"
  tar -xf "$row/source.tar" -C "$row/source"
  started=$(date +%s)
  build_log=$EVIDENCE/logs/$repository.build.log
  check_log=$EVIDENCE/logs/$repository.check.log
  row_environment=(
    HOME="$row/home" USER="${USER:-paradox}" LOGNAME="${LOGNAME:-paradox}"
    PATH="$PATH" LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
    R_LIBS="$LIBRARIES" R_LIBS_USER="$LIBRARIES" R_LIBS_SITE=
    R_ENVIRON=/dev/null R_ENVIRON_USER=/dev/null R_PROFILE=/dev/null
    R_PROFILE_USER=/dev/null R_TESTS= NOT_CRAN=true
    _R_CHECK_FORCE_SUGGESTS_=false _R_CHECK_CRAN_INCOMING_=false
    R_MAKEVARS_USER="$ROOT/environment/Makevars" TMPDIR="$row/tmp"
    LC_ALL=C.UTF-8 LANG=C.UTF-8 LANGUAGE=C TZ=UTC
    XDG_CACHE_HOME="$row/cache" MAKEFLAGS=-j1 OMP_NUM_THREADS=1
    OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
    BLIS_NUM_THREADS=1
  )
  set +e
  (
    cd "$row/package-output"
    env -i "${row_environment[@]}" \
      "$R" CMD build --no-manual "$row/source"
  ) >"$build_log" 2>&1
  build_status=$?
  set -e
  package_relative=-
  package_sha256=-
  package_tarball=
  built_packages=()
  if [[ $build_status -eq 0 ]]; then
    shopt -s nullglob
    built_packages=("$row/package-output"/*.tar.gz)
    shopt -u nullglob
    if [[ ${#built_packages[@]} -eq 1 && -f ${built_packages[0]} &&
       ! -L ${built_packages[0]} ]]; then
      package_name=${built_packages[0]##*/}
      if [[ $package_name =~ ^[A-Za-z][A-Za-z0-9.]*_[A-Za-z0-9.+~-]+\.tar\.gz$ ]]; then
        mkdir "$EVIDENCE/packages/$repository"
        package_relative=packages/$repository/$package_name
        package_tarball=$EVIDENCE/$package_relative
        mv -- "${built_packages[0]}" "$package_tarball"
        package_sha256=$(sha256sum "$package_tarball" | awk '{print $1}')
      fi
    fi
  fi
  if [[ $package_relative == - ]]; then
    printf '%s\n' \
      "check-downstream-profile: R CMD build did not produce exactly one safe package tarball" \
      >>"$build_log"
  fi
  check_status=-
  check_log_sha256=-
  check_directory=
  if [[ $package_relative != - ]]; then
    set +e
    (
      cd "$row/check"
      env -i "${row_environment[@]}" \
        "$R" CMD check --no-manual --no-build-vignettes "$package_tarball"
    ) >"$check_log" 2>&1
    check_status=$?
    set -e
    [[ $(sha256sum "$package_tarball" | awk '{print $1}') == \
       "$package_sha256" ]] ||
      fail "built package changed while it was checked: $repository"
    check_log_sha256=$(sha256sum "$check_log" | awk '{print $1}')
    shopt -s nullglob
    check_directories=("$row/check"/*.Rcheck)
    shopt -u nullglob
    if [[ ${#check_directories[@]} -eq 1 &&
       -d ${check_directories[0]} && ! -L ${check_directories[0]} ]]; then
      check_directory=${check_directories[0]}
    else
      printf '%s\n' \
        "check-downstream-profile: R CMD check did not produce exactly one check directory" \
        >>"$check_log"
      check_log_sha256=$(sha256sum "$check_log" | awk '{print $1}')
    fi
  fi
  elapsed=$(($(date +%s) - started))
  result=failed
  if [[ $build_status -eq 0 && $check_status == 0 &&
      $package_relative != - && -n $check_directory ]] &&
      check_status_is_release_clean "$check_directory/00check.log"; then
    result=passed
  else
    failed=$((failed + 1))
  fi
  if [[ -n $check_directory ]]; then
    mv "$check_directory" "$EVIDENCE/checks/$repository.Rcheck"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$repository" "$commit" "$tree" "$result" "$build_status" \
    "$check_status" "$elapsed" \
    "$(sha256sum "$build_log" | awk '{print $1}')" "$check_log_sha256" \
    "$package_relative" "$package_sha256" \
    >>"$EVIDENCE/results.tsv"
done

PROTECTED_AFTER=$(library_inputs)
[[ $PROTECTED_BEFORE == "$PROTECTED_AFTER" ]] ||
  fail "protected libraries changed during downstream checks"

{
  printf 'field\tvalue\n'
  printf 'schema\t3\n'
  printf 'stage_kind\tdownstream_profile_checks\n'
  printf 'status\t%s\n' "$([[ $failed -eq 0 ]] && printf passed || printf completed_with_failures)"
  printf 'candidate_run_id\t%s\n' "$RUN_ID"
  printf 'evidence_profile\t%s\n' "$PROFILE"
  printf 'paradox_axis\t%s\n' "$AXIS"
  printf 'repositories\t%s\n' "$REPOSITORIES"
  printf 'candidate_ref\t%s\n' "$(receipt_value candidate_ref)"
  printf 'candidate_commit\t%s\n' "$(receipt_value candidate_commit)"
  printf 'candidate_tree\t%s\n' "$(receipt_value candidate_tree)"
  printf 'candidate_version\t%s\n' "$(receipt_value candidate_version)"
  printf 'candidate_content_sha256\t%s\n' "$CANDIDATE_CONTENT"
  printf 'tooling_commit\t%s\n' "$TOOLING_COMMIT"
  printf 'tooling_tree\t%s\n' "$TOOLING_TREE"
  printf 'profile_registry_sha256\t%s\n' "$(profile_value profile_registry_sha256)"
  printf 'axis_registry_sha256\t%s\n' "$(profile_value axis_registry_sha256)"
  printf 'repository_manifest_sha256\t%s\n' "$(profile_value repository_manifest_sha256)"
  printf 'snapshot_sha256\t%s\n' "$(profile_value snapshot_sha256)"
  printf 'bridge_provenance_sha256\t%s\n' "$(profile_value bridge_provenance_sha256)"
  printf 'candidate_provenance_sha256\t%s\n' "$(sha256sum "$PROVENANCE" | awk '{print $1}')"
  printf 'bridge_completion_sha256\t%s\n' \
    "$(sha256sum "$BRIDGE_EVIDENCE/metadata/completion.tsv" | awk '{print $1}')"
  printf 'library_inputs_sha256\t%s\n' \
    "$(sha256sum "$EVIDENCE/metadata/library-inputs.tsv" | awk '{print $1}')"
  printf 'protected_content_sha256\t%s\n' "$(printf '%s' "$PROTECTED_AFTER" | sha256sum | awk '{print $1}')"
  printf 'result_sha256\t%s\n' "$(sha256sum "$EVIDENCE/results.tsv" | awk '{print $1}')"
  printf 'rows\t%s\n' "${#SELECTED[@]}"
  printf 'failed_rows\t%s\n' "$failed"
  printf 'harness_sha256\t%s\n' "$(sha256sum "$SELF" | awk '{print $1}')"
  printf 'completed_utc\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} >"$EVIDENCE/metadata/completion.tsv"

"$RSCRIPT" --vanilla - "$EVIDENCE_HELPER" "$EVIDENCE" <<'RSCRIPT'
args <- commandArgs(TRUE)
sys.source(args[[1L]], envir = environment())
repository_seal_evidence(args[[2L]])
RSCRIPT
chmod -R a-w "$EVIDENCE"
PUBLISHED_EVIDENCE_ID=$(directory_identity "$EVIDENCE")
publish_directory_no_clobber "$EVIDENCE" "$STAGE" ||
  fail "check evidence publication raced"
[[ $(directory_identity "$STAGE") == "$PUBLISHED_EVIDENCE_ID" ]] ||
  fail "published check evidence identity changed"
release_ownership || fail "could not release downstream check ownership"
COMPLETE=true
remove_private_directory "$BUILD" "$BUILD_ID" ||
  fail "could not remove the private downstream check build"
BUILD=
BUILD_ID=
trap - EXIT
verify_stage
