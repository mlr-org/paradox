#!/usr/bin/env bash
set -euo pipefail

SELF_DIRECTORY=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
SELF=$SELF_DIRECTORY/$(basename "${BASH_SOURCE[0]}")
[[ -f $SELF && ! -L $SELF ]] || {
  printf '%s\n' "install-downstream-bridges: installer is absent or symbolic" >&2
  exit 2
}
ROOT=$(cd "$SELF_DIRECTORY/.." && pwd -P)
VERIFY=false
PROTECTED_CONTENT_PREVERIFIED=false
CANDIDATE_SOURCE=$ROOT
EVIDENCE_PROFILE=default
PROFILE_SEEN=false
PARADOX_AXIS=paradox2
AXIS_SEEN=false
INSTALL_ORDER=()

usage() {
  cat <<'EOF'
Usage: compat/install-downstream-bridges [--candidate-source PATH] [--verify]
       [--protected-content-preverified] [--evidence-profile NAME]
       [--paradox-axis paradox2|paradox1]

Install one named exact reviewed downstream bridge set into its immutable
candidate-specific overlay, or verify an existing overlay without loading it.
Candidate identity is supplied by the five PARADOX_CANDIDATE_* variables.
The protected-content option is verify-only and avoids rehashing candidate/
dependency trees when an entrypoint already authenticated those exact contents.
EOF
}

fail() {
  printf '%s\n' "install-downstream-bridges: $*" >&2
  exit 2
}

# GNU mv reports success when --no-clobber skips an existing destination.  The
# source-side postcondition is therefore part of the operation: a successful
# publication must consume exactly the private source directory, and -T must
# keep a raced destination from turning the source into a nested child.
publish_directory_no_clobber() {
  local source=$1 destination=$2 source_mode
  [[ -d $source && ! -L $source &&
     ! -e $destination && ! -L $destination ]] || return 1
  source_mode=$(stat -c '%a' "$source") || return 1
  [[ $source_mode =~ ^[0-7]{3,4}$ ]] || return 1
  chmod u+w "$source" || return 1
  if ! mv -T --no-clobber -- "$source" "$destination"; then
    chmod "$source_mode" "$source" 2>/dev/null || true
    return 1
  fi
  if [[ -e $source || -L $source || ! -d $destination || -L $destination ]]; then
    chmod "$source_mode" "$source" 2>/dev/null || true
    return 1
  fi
  chmod "$source_mode" "$destination" || return 1
}

directory_identity() {
  [[ -d $1 && ! -L $1 ]] || return 1
  stat -c '%d:%i' "$1"
}

validate_package_evidence_shape() {
  local table=$1 order
  order=$(IFS=,; printf '%s' "${INSTALL_ORDER[*]}")
  awk -F '\t' -v order="$order" '
    BEGIN {
      count = split(order, expected, ",")
      header = "position\trepository\tcommit\ttree\tarchive_sha256\tversion\tcontent_sha256"
    }
    NR == 1 {
      if ($0 != header) bad = 1
      next
    }
    {
      position = NR - 1
      if (NF != 7 || $1 != position || $2 != expected[position] ||
          seen_position[$1]++ || seen_repository[$2]++) bad = 1
    }
    END {
      if (NR != count + 1 || bad) exit 1
      for (position = 1; position <= count; ++position) {
        if (seen_position[position] != 1 ||
            seen_repository[expected[position]] != 1) exit 1
      }
    }
  ' "$table"
}

while (($#)); do
  case "$1" in
    --candidate-source)
      [[ $# -ge 2 ]] || fail "--candidate-source requires a path"
      CANDIDATE_SOURCE=$2
      shift 2
      ;;
    --verify)
      VERIFY=true
      shift
      ;;
    --protected-content-preverified)
      PROTECTED_CONTENT_PREVERIFIED=true
      shift
      ;;
    --evidence-profile)
      [[ $# -ge 2 && $PROFILE_SEEN == false ]] ||
        fail "--evidence-profile requires one value and may occur once"
      EVIDENCE_PROFILE=$2
      PROFILE_SEEN=true
      shift 2
      ;;
    --evidence-profile=*)
      [[ $PROFILE_SEEN == false ]] || fail "--evidence-profile may occur once"
      EVIDENCE_PROFILE=${1#*=}
      PROFILE_SEEN=true
      shift
      ;;
    --paradox-axis)
      [[ $# -ge 2 && $AXIS_SEEN == false ]] ||
        fail "--paradox-axis requires one value and may occur once"
      PARADOX_AXIS=$2
      AXIS_SEEN=true
      shift 2
      ;;
    --paradox-axis=*)
      [[ $AXIS_SEEN == false ]] || fail "--paradox-axis may occur once"
      PARADOX_AXIS=${1#*=}
      AXIS_SEEN=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *) fail "unknown argument: $1" ;;
  esac
done
[[ $PROTECTED_CONTENT_PREVERIFIED == false || $VERIFY == true ]] ||
  fail "--protected-content-preverified is valid only with --verify"
[[ $EVIDENCE_PROFILE =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ &&
   $EVIDENCE_PROFILE != . && $EVIDENCE_PROFILE != .. ]] ||
  fail "invalid downstream evidence profile"
[[ $PARADOX_AXIS == paradox2 || $PARADOX_AXIS == paradox1 ]] ||
  fail "--paradox-axis must be paradox2 or paradox1"

[[ ${PARADOX_ACTIVE_ROOT:-} == "$ROOT" ]] ||
  fail "activate the repository-local environment first: . scripts/activate"
R=$ROOT/.local/toolchain/bin/R
RSCRIPT=$ROOT/.local/toolchain/bin/Rscript
GIT=$ROOT/.local/toolchain/bin/git
[[ $(command -v R) == "$R" && $(command -v Rscript) == "$RSCRIPT" &&
   $(command -v git) == "$GIT" ]] || fail "the exact local R and Git must be active"

profile_git() {
  local checkout=$1
  shift
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR \
    -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
    -u GIT_NAMESPACE -u GIT_REPLACE_REF_BASE -u GIT_QUARANTINE_PATH \
    -u GIT_SHALLOW_FILE -u GIT_EXEC_PATH -u GIT_TEMPLATE_DIR \
    -u GIT_CONFIG -u GIT_CONFIG_GLOBAL -u GIT_CONFIG_SYSTEM \
    -u GIT_CONFIG_NOSYSTEM -u GIT_CONFIG_COUNT -u GIT_CONFIG_PARAMETERS \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
    GIT_CONFIG_NOSYSTEM=1 GIT_ATTR_NOSYSTEM=1 GIT_NO_REPLACE_OBJECTS=1 \
    GIT_NO_LAZY_FETCH=1 GIT_OPTIONAL_LOCKS=0 LC_ALL=C TZ=UTC \
    "$GIT" --no-replace-objects -c core.attributesFile=/dev/null \
      -c core.hooksPath=/dev/null -c core.fsmonitor=false \
      -c core.untrackedCache=false -c tar.umask=0022 -C "$checkout" "$@"
}

# Git 2.55 spells the UTC offset in strict ISO dates as Z, while older Git
# emitted the equivalent +00:00 retained in the reviewed ledger.
canonical_git_date() {
  local value=$1
  case "$value" in
    *Z) printf '%s+00:00\n' "${value%Z}" ;;
    *) printf '%s\n' "$value" ;;
  esac
}

PROFILE_HELPER=$ROOT/compat/downstream-evidence-profile.R
PROFILE_RESOLVER=$ROOT/compat/resolve-downstream-evidence-profile.R
PROFILE_REGISTRY=$ROOT/compat/downstream-evidence-profiles.tsv
AXIS_REGISTRY=$ROOT/compat/paradox-evidence-axes.tsv
for file in "$PROFILE_HELPER" "$PROFILE_RESOLVER" "$PROFILE_REGISTRY" \
    "$AXIS_REGISTRY"; do
  [[ -f $file && ! -L $file ]] || fail "profile input is absent or symbolic: $file"
done
PROFILE_OUTPUT=$("$RSCRIPT" --vanilla "$PROFILE_RESOLVER" "$ROOT" \
  "$EVIDENCE_PROFILE" "$PARADOX_AXIS") ||
  fail "could not resolve downstream evidence profile"
profile_value() {
  local key=$1
  awk -F '\t' -v key="$key" 'NR > 1 && $1 == key { if (seen++) exit 2; print $2 }' \
    <<<"$PROFILE_OUTPUT"
}
[[ $(head -n 1 <<<"$PROFILE_OUTPUT") == $'field\tvalue' ]] ||
  fail "profile resolver returned an unexpected schema"
PROFILE_SUFFIX=$(profile_value suffix)
[[ $PROFILE_SUFFIX == - ]] && PROFILE_SUFFIX=
PROFILE_PROFILE_SUFFIX=$(profile_value profile_suffix)
[[ $PROFILE_PROFILE_SUFFIX == - ]] && PROFILE_PROFILE_SUFFIX=
PROFILE_VERSION_MAJOR=$(profile_value version_major)
PROFILE_CANDIDATE_REF=$(profile_value candidate_ref)
PROFILE_CANDIDATE_COMMIT=$(profile_value candidate_commit)
PROFILE_CANDIDATE_TREE=$(profile_value candidate_tree)
PROFILE_CANDIDATE_VERSION=$(profile_value candidate_version)
BRIDGE_PROVENANCE=$(profile_value bridge_provenance)
SNAPSHOT=$(profile_value snapshot)
REPOSITORY_MANIFEST=$(profile_value repository_manifest)
DEPENDENCY_REPOSITORY_MANIFEST=$(profile_value dependency_repository_manifest)
DEPENDENCY_SNAPSHOT=$(profile_value dependency_snapshot)
CONSUMER_ROOT=$(profile_value consumer_root)
IFS=, read -r -a INSTALL_ORDER <<<"$(profile_value install_order)"
[[ ${#INSTALL_ORDER[@]} -gt 0 ]] || fail "profile install order is empty"

RUN_ID=${PARADOX_CANDIDATE_RUN_ID:-}
CANDIDATE_REF=${PARADOX_CANDIDATE_REF:-}
CANDIDATE_COMMIT=${PARADOX_CANDIDATE_COMMIT:-}
CANDIDATE_TREE=${PARADOX_CANDIDATE_TREE:-}
CANDIDATE_CONTENT=${PARADOX_CANDIDATE_CONTENT_SHA256:-}
[[ $RUN_ID =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ &&
   $RUN_ID != . && $RUN_ID != .. ]] || fail "invalid candidate run ID"
[[ $CANDIDATE_REF == refs/* ]] || fail "invalid candidate ref"
[[ $CANDIDATE_COMMIT =~ ^[0-9a-f]{40}$ && $CANDIDATE_TREE =~ ^[0-9a-f]{40}$ &&
   $CANDIDATE_CONTENT =~ ^[0-9a-f]{64}$ ]] || fail "invalid candidate identity"
[[ $CANDIDATE_REF == "$PROFILE_CANDIDATE_REF" &&
   $CANDIDATE_COMMIT == "$PROFILE_CANDIDATE_COMMIT" &&
   $CANDIDATE_TREE == "$PROFILE_CANDIDATE_TREE" ]] ||
  fail "candidate identity differs from the exact selected evidence axis"

RUN=$ROOT/.local/compat/runs/$RUN_ID
CANDIDATE_LIBRARY=$RUN/library-candidate
DEPENDENCY_LIBRARY=$ROOT/.local/compat/R/library-dependencies
BRIDGE_LIBRARY=$RUN/library-downstream-bridges$PROFILE_SUFFIX
EVIDENCE=$RUN/downstream-bridges$PROFILE_SUFFIX
DEPENDENCY_EVIDENCE=$RUN/repository-dependencies-priority-1$PROFILE_PROFILE_SUFFIX
PROVENANCE=$CANDIDATE_LIBRARY/.paradox-candidate-provenance.tsv
PROVENANCE_SEAL=$CANDIDATE_LIBRARY/.paradox-candidate-provenance.sha256
SENTINEL=$CANDIDATE_LIBRARY/.paradox-candidate-content-sha256
AUTHENTICATOR=$ROOT/compat/authenticate-candidate-git
REVIEW_VERIFIER=$ROOT/compat/verify-mlr-org-review
FINGERPRINT=$ROOT/compat/fingerprint.R
EVIDENCE_HELPER=$ROOT/compat/repository-evidence.R
EVIDENCE_VERIFIER=$ROOT/compat/verify-repository-evidence.R
RESOURCE_JOBS=$ROOT/scripts/environment/resource-jobs
REVIEW=$ROOT/compat/mlr-org-review.tsv

for directory in "$RUN" "$CANDIDATE_LIBRARY" "$DEPENDENCY_LIBRARY" \
    "$CONSUMER_ROOT"; do
  [[ -d $directory && ! -L $directory ]] || fail "required directory is absent or symbolic: $directory"
done
for file in "$PROVENANCE" "$PROVENANCE_SEAL" "$SENTINEL" "$AUTHENTICATOR" \
    "$REVIEW_VERIFIER" "$FINGERPRINT" "$EVIDENCE_HELPER" "$EVIDENCE_VERIFIER" \
    "$RESOURCE_JOBS" "$PROFILE_HELPER" "$PROFILE_RESOLVER" "$PROFILE_REGISTRY" \
    "$AXIS_REGISTRY" \
    "$REPOSITORY_MANIFEST" "$DEPENDENCY_REPOSITORY_MANIFEST" \
    "$DEPENDENCY_SNAPSHOT" "$BRIDGE_PROVENANCE" "$SNAPSHOT" "$REVIEW"; do
  [[ -f $file && ! -L $file ]] || fail "required input is absent or symbolic: $file"
done

CANDIDATE_SOURCE=$(cd "$CANDIDATE_SOURCE" && pwd -P)
if [[ $CANDIDATE_SOURCE == "$ROOT" ]]; then
  "$AUTHENTICATOR" "$ROOT" "$CANDIDATE_REF" "$CANDIDATE_COMMIT" \
    "$CANDIDATE_TREE" >/dev/null
else
  "$AUTHENTICATOR" "$ROOT" "$CANDIDATE_REF" "$CANDIDATE_COMMIT" \
    "$CANDIDATE_TREE" "$CANDIDATE_SOURCE" >/dev/null
fi
TOOLING_COMMIT=$(profile_git "$ROOT" rev-parse --verify 'HEAD^{commit}')
TOOLING_TREE=$(profile_git "$ROOT" rev-parse --verify "$TOOLING_COMMIT^{tree}")
[[ $TOOLING_COMMIT =~ ^[0-9a-f]{40}$ && $TOOLING_TREE =~ ^[0-9a-f]{40}$ &&
   -d $ROOT/.git && ! -L $ROOT/.git &&
   $(profile_git "$ROOT" rev-parse --absolute-git-dir) == "$ROOT/.git" &&
   -z $(profile_git "$ROOT" for-each-ref --format='%(refname)' refs/replace) &&
   -z $(profile_git "$ROOT" status --porcelain=v1 --untracked-files=all) ]] ||
  fail "active evidence tooling is not one clean commit"
for forbidden in "$ROOT/.git/info/grafts" "$ROOT/.git/info/attributes" \
    "$ROOT/.git/objects/info/alternates" \
    "$ROOT/.git/objects/info/http-alternates"; do
  [[ ! -e $forbidden && ! -L $forbidden ]] ||
    fail "evidence tooling has a graft, attribute, or alternate input"
done
dangerous=
if dangerous=$(profile_git "$ROOT" config --local --get-regexp \
    '^(include[.]|includeif[.]|core[.]attributesfile$|core[.]hookspath$|core[.]worktree$|extensions[.]worktreeconfig$|extensions[.]partialclone$|remote[.].*[.]promisor$)'); then
  [[ -z $dangerous ]] || fail "evidence tooling redirects authenticated Git inputs"
else
  [[ $? -eq 1 ]] || fail "could not audit evidence tooling Git configuration"
fi
flags=$(profile_git "$ROOT" ls-files -v | cut -c1 | LC_ALL=C sort -u)
[[ -z $(grep -E '^[a-zS]$' <<<"$flags") ]] ||
  fail "evidence tooling hides index state"
if [[ $EVIDENCE_PROFILE == default ]]; then
  for relative in compat/install-downstream-bridges \
      compat/github-bridge-provenance.tsv compat/github-snapshot.tsv \
      compat/mlr-org-review.tsv compat/verify-mlr-org-review \
      compat/fingerprint.R compat/repository-evidence.R \
      compat/verify-repository-evidence.R \
      scripts/environment/resource-jobs; do
    cmp -s "$ROOT/$relative" "$CANDIDATE_SOURCE/$relative" ||
      fail "active default release input differs from the candidate: $relative"
  done
else
  for file in "$SELF" "$PROFILE_HELPER" "$PROFILE_RESOLVER" \
      "$PROFILE_REGISTRY" "$AXIS_REGISTRY" "$REPOSITORY_MANIFEST" \
      "$DEPENDENCY_REPOSITORY_MANIFEST" "$DEPENDENCY_SNAPSHOT" \
      "$BRIDGE_PROVENANCE" \
      "$SNAPSHOT" "$REVIEW" "$REVIEW_VERIFIER" "$FINGERPRINT" \
      "$EVIDENCE_HELPER" "$EVIDENCE_VERIFIER" "$RESOURCE_JOBS"; do
    relative=${file#"$ROOT"/}
    [[ $relative != "$file" ]] || fail "profile input escaped the tooling root"
    profile_git "$ROOT" ls-files --error-unmatch -- \
      "$relative" >/dev/null 2>&1 || fail "profile input is not tracked: $relative"
  done
  if [[ $PARADOX_AXIS == paradox2 ]]; then
    changed_paths=$(profile_git "$ROOT" diff --no-renames --name-only \
      "$CANDIDATE_COMMIT" "$TOOLING_COMMIT") ||
      fail "could not compare post-freeze tooling with the candidate"
    while IFS= read -r changed_path; do
      [[ -n $changed_path ]] || continue
      case "$changed_path" in
        AGENTS.md|benchmarks/*|compat/*|design/*|environment/*|scripts/*) ;;
        *) fail "post-freeze tooling changes a package-facing path: $changed_path" ;;
      esac
    done <<<"$changed_paths"
  fi
fi

receipt_value() {
  local key=$1
  awk -F '\t' -v key="$key" 'NR > 1 && $1 == key { if (seen++) exit 2; print $2 }' "$PROVENANCE"
}

EXPECTED_KEYS=$'schema\ncandidate_run_id\ncandidate_ref\ncandidate_commit\ncandidate_tree\ncandidate_version\ncandidate_library\ndependency_library\ndependency_library_content_sha256\nsource_archive_sha256\ncandidate_content_sha256\ninstaller_sha256\ngit_authenticator_sha256'
[[ $(tail -n +2 "$PROVENANCE" | cut -f1) == "$EXPECTED_KEYS" ]] ||
  fail "candidate provenance has an unexpected schema"
[[ $(cat "$PROVENANCE_SEAL") == "$(sha256sum "$PROVENANCE" | cut -d ' ' -f 1)  .paradox-candidate-provenance.tsv" ]] ||
  fail "candidate provenance seal is invalid"
CANDIDATE_VERSION=$(receipt_value candidate_version)
[[ $(tr -d '\r\n' <"$SENTINEL") == "$CANDIDATE_CONTENT" &&
   $(receipt_value schema) == 2 && $(receipt_value candidate_run_id) == "$RUN_ID" &&
   $(receipt_value candidate_ref) == "$CANDIDATE_REF" &&
   $(receipt_value candidate_commit) == "$CANDIDATE_COMMIT" &&
   $(receipt_value candidate_tree) == "$CANDIDATE_TREE" &&
   $CANDIDATE_VERSION == "$PROFILE_CANDIDATE_VERSION" &&
   ${CANDIDATE_VERSION%%.*} == "$PROFILE_VERSION_MAJOR" &&
   $(receipt_value candidate_library) == "$CANDIDATE_LIBRARY" &&
   $(receipt_value dependency_library) == "$DEPENDENCY_LIBRARY" &&
   $(receipt_value candidate_content_sha256) == "$CANDIDATE_CONTENT" &&
   $(receipt_value installer_sha256) == "$(sha256sum "$ROOT/compat/install-candidate" | cut -d ' ' -f 1)" &&
   $(receipt_value git_authenticator_sha256) == "$(sha256sum "$AUTHENTICATOR" | cut -d ' ' -f 1)" ]] ||
  fail "candidate provenance differs from the declared candidate"

tree_fingerprint() {
  R_LIBS="$ROOT/.local/R/library" R_LIBS_USER="$ROOT/.local/R/library" \
    "$RSCRIPT" --vanilla -e \
    'a=commandArgs(TRUE); sys.source(a[[2L]], envir=environment()); cat(compat_tree_content_sha256(a[[1L]]))' \
    "$1" "$FINGERPRINT"
}

trusted_input_path() {
  case "$1" in
    install-downstream-bridges) printf '%s\n' "$SELF" ;;
    downstream-evidence-profile.R) printf '%s\n' "$PROFILE_HELPER" ;;
    resolve-downstream-evidence-profile.R) printf '%s\n' "$PROFILE_RESOLVER" ;;
    downstream-evidence-profiles.tsv) printf '%s\n' "$PROFILE_REGISTRY" ;;
    paradox-evidence-axes.tsv) printf '%s\n' "$AXIS_REGISTRY" ;;
    github-repositories.tsv) printf '%s\n' "$REPOSITORY_MANIFEST" ;;
    dependency-github-repositories.tsv) printf '%s\n' "$DEPENDENCY_REPOSITORY_MANIFEST" ;;
    dependency-github-snapshot.tsv) printf '%s\n' "$DEPENDENCY_SNAPSHOT" ;;
    github-bridge-provenance.tsv) printf '%s\n' "$BRIDGE_PROVENANCE" ;;
    github-snapshot.tsv) printf '%s\n' "$SNAPSHOT" ;;
    mlr-org-review.tsv) printf '%s\n' "$REVIEW" ;;
    verify-mlr-org-review) printf '%s\n' "$REVIEW_VERIFIER" ;;
    fingerprint.R) printf '%s\n' "$FINGERPRINT" ;;
    repository-evidence.R) printf '%s\n' "$EVIDENCE_HELPER" ;;
    verify-repository-evidence.R) printf '%s\n' "$EVIDENCE_VERIFIER" ;;
    resource-jobs) printf '%s\n' "$RESOURCE_JOBS" ;;
    *) fail "unknown retained bridge input: $1" ;;
  esac
}

CANDIDATE_PACKAGE_CONTENT=$CANDIDATE_CONTENT
DEPENDENCY_CONTENT=$(receipt_value dependency_library_content_sha256)
if [[ $PROTECTED_CONTENT_PREVERIFIED == false ]]; then
  CANDIDATE_PACKAGE_CONTENT=$(tree_fingerprint "$CANDIDATE_LIBRARY/paradox")
  DEPENDENCY_CONTENT=$(tree_fingerprint "$DEPENDENCY_LIBRARY")
fi
[[ $CANDIDATE_PACKAGE_CONTENT == "$CANDIDATE_CONTENT" &&
   $DEPENDENCY_CONTENT == "$(receipt_value dependency_library_content_sha256)" ]] ||
  fail "candidate or dependency library differs from its receipt"

[[ -d $DEPENDENCY_EVIDENCE && ! -L $DEPENDENCY_EVIDENCE ]] ||
  fail "the run has no priority-one dependency preparation evidence"
"$RSCRIPT" --vanilla "$EVIDENCE_VERIFIER" "$DEPENDENCY_EVIDENCE" >/dev/null
DEPENDENCY_COMPLETION=$DEPENDENCY_EVIDENCE/metadata/completion.tsv
DEPENDENCY_SCHEMA=$(awk -F '\t' '$1 == "schema" { if (seen++) exit 2; print $2 }' \
  "$DEPENDENCY_COMPLETION")
if [[ $DEPENDENCY_SCHEMA == 3 && $EVIDENCE_PROFILE == default ]]; then
  DEPENDENCY_COMPLETION_KEYS=$'schema\nstage_kind\nrun_id\nmax_priority\nfinished_utc\nstatus\nresult_rows\nfailed_rows\nresult_sha256\ncheckout_postflight_sha256\nfallback_checkout_postflight_sha256\ndependency_library_content_after'
elif [[ $DEPENDENCY_SCHEMA == 4 ]]; then
  DEPENDENCY_COMPLETION_KEYS=$'schema\nstage_kind\nrun_id\nevidence_profile\nmax_priority\nfinished_utc\nstatus\nresult_rows\nfailed_rows\nresult_sha256\ncheckout_postflight_sha256\nfallback_checkout_postflight_sha256\ndependency_library_content_after'
else
  fail "priority-one dependency preparation has an unsupported profile schema"
fi
[[ $(tail -n +2 "$DEPENDENCY_COMPLETION" | cut -f1) == \
   "$DEPENDENCY_COMPLETION_KEYS" ]] ||
  fail "priority-one dependency preparation has an unexpected schema"
dependency_completion_value() {
  local key=$1
  awk -F '\t' -v key="$key" \
    'NR > 1 && $1 == key { if (seen++) exit 2; print $2 }' \
    "$DEPENDENCY_COMPLETION"
}
[[ $(dependency_completion_value schema) == "$DEPENDENCY_SCHEMA" &&
   $(dependency_completion_value stage_kind) == repository_dependencies &&
   $(dependency_completion_value run_id) == "$RUN_ID" &&
   ( $DEPENDENCY_SCHEMA == 3 ||
     $(dependency_completion_value evidence_profile) == "$EVIDENCE_PROFILE" ) &&
   $(dependency_completion_value max_priority) == 1 &&
   $(dependency_completion_value status) == passed &&
   $(dependency_completion_value failed_rows) == 0 &&
   $(dependency_completion_value dependency_library_content_after) == \
     "$DEPENDENCY_CONTENT" ]] ||
  fail "priority-one dependency preparation belongs to a different run, scope, or endpoint"

declare -A BRIDGE_ORIGIN BRIDGE_BASE BRIDGE_BASE_TREE BRIDGE_COMMIT BRIDGE_TREE
declare -A BRIDGE_BASE_DATE BRIDGE_BASE_BRANCH BRIDGE_COMMIT_DATE BRIDGE_BRANCH
while IFS=$'\t' read -r repository origin base base_tree base_date base_branch commit tree \
    commit_date branch _; do
  [[ $repository == repository ]] && continue
  BRIDGE_ORIGIN[$repository]=$origin
  BRIDGE_BASE[$repository]=$base
  BRIDGE_BASE_TREE[$repository]=$base_tree
  BRIDGE_BASE_DATE[$repository]=$base_date
  BRIDGE_BASE_BRANCH[$repository]=$base_branch
  BRIDGE_COMMIT[$repository]=$commit
  BRIDGE_TREE[$repository]=$tree
  BRIDGE_COMMIT_DATE[$repository]=$commit_date
  BRIDGE_BRANCH[$repository]=$branch
done <"$BRIDGE_PROVENANCE"
[[ ${#BRIDGE_COMMIT[@]} -eq ${#INSTALL_ORDER[@]} ]] ||
  fail "bridge provenance row count differs from the profile install order"
for repository in "${INSTALL_ORDER[@]}"; do
  [[ -n ${BRIDGE_COMMIT[$repository]:-} && -n ${BRIDGE_TREE[$repository]:-} ]] ||
    fail "missing bridge provenance for $repository"
  checkout=$CONSUMER_ROOT/$repository
  [[ -d $checkout && ! -L $checkout && -d $checkout/.git && ! -L $checkout/.git &&
     $(profile_git "$checkout" rev-parse --show-toplevel) == "$checkout" &&
     $(profile_git "$checkout" rev-parse --absolute-git-dir) == "$checkout/.git" &&
     $(profile_git "$checkout" rev-parse --path-format=absolute --git-common-dir) == "$checkout/.git" ]] ||
    fail "profile checkout is not one plain primary worktree: $repository"
  [[ -z $(profile_git "$checkout" for-each-ref --format='%(refname)' refs/replace) ]] ||
    fail "profile checkout contains replacement refs: $repository"
  for forbidden in \
      "$checkout/.git/info/grafts" "$checkout/.git/info/attributes" \
      "$checkout/.git/objects/info/alternates" \
      "$checkout/.git/objects/info/http-alternates"; do
    [[ ! -e $forbidden && ! -L $forbidden ]] ||
      fail "profile checkout contains a graft, attribute, or alternate input: $repository"
  done
  dangerous=
  if dangerous=$(profile_git "$checkout" config --local --get-regexp \
      '^(include[.]|includeif[.]|core[.]attributesfile$|core[.]hookspath$|core[.]worktree$|extensions[.]worktreeconfig$|extensions[.]partialclone$|remote[.].*[.]promisor$)'); then
    [[ -z $dangerous ]] ||
      fail "profile checkout redirects authenticated Git inputs: $repository"
  else
    [[ $? -eq 1 ]] || fail "could not audit profile Git configuration: $repository"
  fi
  flags=$(profile_git "$checkout" ls-files -v | cut -c1 | LC_ALL=C sort -u)
  [[ -z $(grep -E '^[a-zS]$' <<<"$flags") ]] ||
    fail "profile checkout hides index state: $repository"
  profile_git "$checkout" check-ref-format --branch \
    "${BRIDGE_BASE_BRANCH[$repository]}" >/dev/null ||
    fail "reviewed base branch name is invalid: $repository"
  profile_git "$checkout" check-ref-format --branch \
    "${BRIDGE_BRANCH[$repository]}" >/dev/null ||
    fail "reviewed bridge branch name is invalid: $repository"
  [[ $(profile_git "$checkout" remote get-url origin) == \
       "${BRIDGE_ORIGIN[$repository]}" &&
     $(profile_git "$checkout" rev-parse --verify 'HEAD^{commit}') == \
       "${BRIDGE_COMMIT[$repository]}" &&
     $(profile_git "$checkout" rev-parse --verify \
       "${BRIDGE_COMMIT[$repository]}^{commit}") == "${BRIDGE_COMMIT[$repository]}" &&
     $(profile_git "$checkout" rev-parse --verify \
       "${BRIDGE_COMMIT[$repository]}^{tree}") == "${BRIDGE_TREE[$repository]}" &&
     $(profile_git "$checkout" rev-parse --verify \
       "${BRIDGE_BASE[$repository]}^{commit}") == "${BRIDGE_BASE[$repository]}" &&
     $(profile_git "$checkout" rev-parse --verify \
       "${BRIDGE_BASE[$repository]}^{tree}") == "${BRIDGE_BASE_TREE[$repository]}" &&
     $(profile_git "$checkout" rev-parse --verify \
       "refs/heads/${BRIDGE_BASE_BRANCH[$repository]}^{commit}") == \
       "${BRIDGE_BASE[$repository]}" &&
     $(canonical_git_date "$(profile_git "$checkout" show -s --format=%cI \
       "${BRIDGE_BASE[$repository]}")") == "${BRIDGE_BASE_DATE[$repository]}" &&
     $(profile_git "$checkout" branch --show-current) == "${BRIDGE_BRANCH[$repository]}" &&
     $(canonical_git_date "$(profile_git "$checkout" show -s --format=%cI \
       "${BRIDGE_COMMIT[$repository]}")") == "${BRIDGE_COMMIT_DATE[$repository]}" &&
     -z $(profile_git "$checkout" status --porcelain=v1 --untracked-files=all) ]] ||
    fail "reviewed Git checkout or object differs for $repository"
  profile_git "$checkout" merge-base --is-ancestor \
    "${BRIDGE_BASE[$repository]}" "${BRIDGE_COMMIT[$repository]}" ||
    fail "reviewed bridge does not descend from its declared base: $repository"
done

verify_overlay() {
  [[ -d $BRIDGE_LIBRARY && ! -L $BRIDGE_LIBRARY &&
     -d $EVIDENCE && ! -L $EVIDENCE ]] || fail "bridge overlay or evidence is absent"
  "$RSCRIPT" --vanilla "$EVIDENCE_VERIFIER" "$EVIDENCE" >/dev/null
  local completion=$EVIDENCE/metadata/completion.tsv
  completion_value() {
    awk -F '\t' -v key="$1" 'NR > 1 && $1 == key { if (seen++) exit 2; print $2 }' "$completion"
  }
  if [[ $EVIDENCE_PROFILE == default ]]; then
    [[ $(tail -n +2 "$completion" | cut -f1) == $'schema\nstatus\ncandidate_run_id\ncandidate_ref\ncandidate_commit\ncandidate_tree\ncandidate_content_sha256\ncandidate_provenance_sha256\ndependency_library_content_sha256\nbridge_library_content_sha256\nbridge_provenance_sha256\ngithub_snapshot_sha256\nreview_verifier_sha256\nevidence_verifier_sha256\nresource_jobs_sha256\ninstaller_sha256' &&
       $(completion_value schema) == 2 ]] ||
      fail "default bridge completion uses an unexpected schema"
  else
    [[ $(tail -n +2 "$completion" | cut -f1) == $'schema\nstatus\nevidence_profile\nparadox_axis\ntooling_commit\ntooling_tree\ncandidate_run_id\ncandidate_ref\ncandidate_commit\ncandidate_tree\ncandidate_content_sha256\ncandidate_provenance_sha256\ndependency_library_content_sha256\nbridge_library_content_sha256\nprofile_registry_sha256\naxis_registry_sha256\nprofile_helper_sha256\nprofile_resolver_sha256\nrepository_manifest_sha256\ndependency_repository_manifest_sha256\ndependency_snapshot_sha256\nbridge_provenance_sha256\ngithub_snapshot_sha256\nreview_verifier_sha256\nevidence_verifier_sha256\nresource_jobs_sha256\ninstaller_sha256' &&
       $(completion_value schema) == 3 &&
       $(completion_value evidence_profile) == "$EVIDENCE_PROFILE" &&
       $(completion_value paradox_axis) == "$PARADOX_AXIS" &&
       $(completion_value tooling_commit) == "$TOOLING_COMMIT" &&
       $(completion_value tooling_tree) == "$TOOLING_TREE" &&
       $(completion_value profile_registry_sha256) == "$(sha256sum "$PROFILE_REGISTRY" | cut -d ' ' -f 1)" &&
       $(completion_value axis_registry_sha256) == "$(sha256sum "$AXIS_REGISTRY" | cut -d ' ' -f 1)" &&
       $(completion_value profile_helper_sha256) == "$(sha256sum "$PROFILE_HELPER" | cut -d ' ' -f 1)" &&
       $(completion_value profile_resolver_sha256) == "$(sha256sum "$PROFILE_RESOLVER" | cut -d ' ' -f 1)" &&
       $(completion_value repository_manifest_sha256) == "$(sha256sum "$REPOSITORY_MANIFEST" | cut -d ' ' -f 1)" &&
       $(completion_value dependency_repository_manifest_sha256) == "$(sha256sum "$DEPENDENCY_REPOSITORY_MANIFEST" | cut -d ' ' -f 1)" &&
       $(completion_value dependency_snapshot_sha256) == "$(sha256sum "$DEPENDENCY_SNAPSHOT" | cut -d ' ' -f 1)" ]] ||
      fail "profile bridge completion uses an unexpected identity"
  fi
  [[ $(completion_value status) == passed &&
     $(completion_value candidate_run_id) == "$RUN_ID" &&
     $(completion_value candidate_ref) == "$CANDIDATE_REF" &&
     $(completion_value candidate_commit) == "$CANDIDATE_COMMIT" &&
     $(completion_value candidate_tree) == "$CANDIDATE_TREE" &&
     $(completion_value candidate_provenance_sha256) == "$(sha256sum "$PROVENANCE" | cut -d ' ' -f 1)" &&
     $(completion_value bridge_provenance_sha256) == "$(sha256sum "$BRIDGE_PROVENANCE" | cut -d ' ' -f 1)" &&
     $(completion_value github_snapshot_sha256) == "$(sha256sum "$SNAPSHOT" | cut -d ' ' -f 1)" &&
     $(completion_value review_verifier_sha256) == "$(sha256sum "$REVIEW_VERIFIER" | cut -d ' ' -f 1)" &&
     $(completion_value evidence_verifier_sha256) == "$(sha256sum "$EVIDENCE_VERIFIER" | cut -d ' ' -f 1)" &&
     $(completion_value resource_jobs_sha256) == "$(sha256sum "$RESOURCE_JOBS" | cut -d ' ' -f 1)" &&
     $(completion_value installer_sha256) == "$(sha256sum "$SELF" | cut -d ' ' -f 1)" ]] ||
    fail "bridge completion evidence differs from the trusted release inputs"
  local -a retained_inputs=(
    install-downstream-bridges github-bridge-provenance.tsv
    github-snapshot.tsv mlr-org-review.tsv fingerprint.R verify-mlr-org-review
    repository-evidence.R verify-repository-evidence.R resource-jobs
  )
  if [[ $EVIDENCE_PROFILE != default ]]; then
    retained_inputs=(
      install-downstream-bridges downstream-evidence-profile.R
      resolve-downstream-evidence-profile.R downstream-evidence-profiles.tsv
      paradox-evidence-axes.tsv github-repositories.tsv
      dependency-github-repositories.tsv dependency-github-snapshot.tsv
      github-bridge-provenance.tsv
      github-snapshot.tsv mlr-org-review.tsv fingerprint.R verify-mlr-org-review
      repository-evidence.R verify-repository-evidence.R resource-jobs
    )
  fi
  for input in "${retained_inputs[@]}"; do
    cmp -s "$EVIDENCE/inputs/$input" "$(trusted_input_path "$input")" ||
      fail "retained bridge input differs: $input"
  done
  local expected observed repository row commit tree archive_sha256
  local observed_archive_sha256 version content package_count
  expected=$(printf '%s\n' "${INSTALL_ORDER[@]}" | LC_ALL=C sort)
  observed=$(find "$BRIDGE_LIBRARY" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | LC_ALL=C sort)
  [[ $observed == "$expected" && -z $(find "$BRIDGE_LIBRARY" -mindepth 1 -maxdepth 1 ! -type d -print -quit) ]] ||
    fail "bridge library has an unexpected top-level inventory"
  [[ -z $(find "$BRIDGE_LIBRARY" -perm /222 -print -quit) ]] ||
    fail "bridge library is not read-only"
  [[ $(tree_fingerprint "$BRIDGE_LIBRARY") == "$(completion_value bridge_library_content_sha256)" ]] ||
    fail "bridge library content differs from its evidence"
  [[ $CANDIDATE_CONTENT == "$(completion_value candidate_content_sha256)" &&
     $DEPENDENCY_CONTENT == "$(completion_value dependency_library_content_sha256)" ]] ||
    fail "bridge evidence belongs to different protected libraries"
  validate_package_evidence_shape "$EVIDENCE/metadata/packages.tsv" ||
    fail "bridge package evidence is incomplete, duplicated, or out of order"
  package_count=0
  {
    IFS= read -r _
    while IFS=$'\t' read -r row repository commit tree archive_sha256 version content; do
    package_count=$((package_count + 1))
    [[ $row =~ ^[1-9][0-9]*$ && $row -le ${#INSTALL_ORDER[@]} &&
       ${INSTALL_ORDER[$((row - 1))]} == "$repository" &&
       $row == "$package_count" &&
       ${BRIDGE_COMMIT[$repository]} == "$commit" && ${BRIDGE_TREE[$repository]} == "$tree" ]] ||
      fail "bridge package evidence has an unexpected order or identity"
    [[ $archive_sha256 =~ ^[0-9a-f]{64}$ ]] ||
      fail "bridge package archive receipt is malformed: $repository"
    observed_archive_sha256=$(
      profile_git "$CONSUMER_ROOT/$repository" \
        archive --format=tar "$commit" | sha256sum | cut -d ' ' -f 1
    )
    [[ $observed_archive_sha256 == "$archive_sha256" ]] ||
      fail "bridge package archive differs from its evidence: $repository"
    [[ -d $BRIDGE_LIBRARY/$repository && ! -L $BRIDGE_LIBRARY/$repository ]] ||
      fail "installed bridge package is absent: $repository"
    [[ $(awk -F ': *' '$1=="Version" {print $2; exit}' "$BRIDGE_LIBRARY/$repository/DESCRIPTION") == "$version" &&
       $(tree_fingerprint "$BRIDGE_LIBRARY/$repository") == "$content" ]] ||
      fail "installed bridge package differs from its evidence: $repository"
    done
  } <"$EVIDENCE/metadata/packages.tsv"
  [[ $package_count -eq ${#INSTALL_ORDER[@]} ]] ||
    fail "bridge package evidence does not contain the profile rows"
  printf '%s\n' "downstream_bridge_evidence=passed" \
    "downstream_bridge_library=$BRIDGE_LIBRARY"
}

if [[ $VERIFY == true ]]; then
