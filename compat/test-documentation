# Render current public documentation consumers and execute pinned corpus
# workloads against one immutable candidate. Full projects are attempted
# first; focused paradox surfaces remain separate gates so unrelated content
# cannot obscure the compatibility signal.

fail <- function(...) stop(..., call. = FALSE)
`%||%` <- function(x, y) if (is.null(x)) y else x

