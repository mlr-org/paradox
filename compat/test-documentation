#!/usr/bin/env Rscript

# Render current public documentation consumers and execute pinned corpus
# workloads against one immutable candidate. Full projects are attempted
# first; focused paradox surfaces remain separate gates so unrelated content
# cannot obscure the compatibility signal.

fail <- function(...) stop(..., call. = FALSE)
`%||%` <- function(x, y) if (is.null(x)) y else x

usage <- function(status = 0L) {
  writeLines(c(
    "Usage: compat/test-documentation [OPTIONS]",
    "",
    "  --root PATH                 paradox checkout (default: current directory)",
    "  --candidate-library PATH    immutable candidate library",
    "  --dependency-library PATH   consumer dependency library",
    "  --extra-library PATH        additional local library; repeatable",
    "  --run-id ID                 new retained run identifier",
    "  --scope all|essential|full  workload scope (default: all)",
    "  --timeout SECONDS           per-command timeout (default: 7200)",
    "  --help                      show this help"
  ))
  quit(save = "no", status = status)
}

args <- commandArgs(trailingOnly = TRUE)
options <- list(
  root = getwd(), candidate_library = NULL, dependency_library = NULL,
  extra_library = character(), run_id = NULL, scope = "all", timeout = 7200
)
i <- 1L
while (i <= length(args)) {
  arg <- args[[i]]
  if (arg == "--help") usage()
  key <- sub("^--", "", arg)
  key <- gsub("-", "_", key, fixed = TRUE)
  if (!startsWith(arg, "--") || !key %in% names(options)) {
    fail("unknown argument: ", arg)
  }
  if (i == length(args)) fail(arg, " requires a value")
  value <- args[[i + 1L]]
  if (key == "extra_library") {
    options$extra_library <- c(options$extra_library, value)
  } else {
    options[[key]] <- value
  }
  i <- i + 2L
}

root <- normalizePath(options$root, mustWork = TRUE)
require_plain_local_library_argument <- function(path, label) {
  path <- sub("/+$", "", path)
  local_root <- file.path(root, ".local")
  if (!startsWith(path, paste0(local_root, "/"))) {
    fail(label, " must be an absolute path below ", local_root)
  }
  relative <- substring(path, nchar(root) + 2L)
  components <- strsplit(relative, "/", fixed = TRUE)[[1L]]
  if (any(!nzchar(components) | components %in% c(".", ".."))) {
    fail(label, " has a non-canonical path component")
  }
  current <- root
  for (component in components) {
    current <- file.path(current, component)
    link <- Sys.readlink(current)
    if (length(link) != 1L || is.na(link) || nzchar(link) ||
        !dir.exists(current)) {
      fail(label, " has a missing, non-directory, or symbolic component: ", current)
    }
  }
  normalized <- normalizePath(path, winslash = "/", mustWork = TRUE)
  if (!identical(normalized, path)) {
    fail(label, " must use its canonical absolute path")
  }
  normalized
}
