retain_environment_evidence <- function(label, environment) {
  if (!is.character(environment) || is.null(names(environment)) ||
      anyNA(environment) || anyNA(names(environment)) ||
      any(!nzchar(names(environment))) || anyDuplicated(names(environment))) {
    fail("documentation workload environment is malformed: ", label)
  }
  locale_environment <- documentation_locale_environment()
  if (any(!names(locale_environment) %in% names(environment)) ||
      !identical(unname(environment[names(locale_environment)]),
        unname(locale_environment))) {
    fail("documentation workload locale is not deterministic: ", label)
  }
  value <- data.frame(
    position = seq_along(environment),
    variable = names(environment),
    value = unname(environment),
    stringsAsFactors = FALSE
  )
  path <- file.path(
    run_directory, "metadata", "boundaries", paste0(label, "-environment.tsv")
  )
  documentation_write_tsv(value, path)
  list(
    path = substring(path, nchar(run_directory, type = "chars") + 2L),
    sha256 = unname(tools::sha256sum(path))
  )
}

verify_row_boundary <- function(
  context, label, phase, overlay, environment, environment_evidence
) {
  if (!phase %in% c("pre", "post")) {
    fail("documentation row boundary has an invalid phase")
  }
  if (!file.exists(full_boundary_pre_path) ||
      dir.exists(full_boundary_pre_path) || is_symbolic(full_boundary_pre_path) ||
      !identical(
        unname(tools::sha256sum(full_boundary_pre_path)),
        full_boundary_pre_sha256
      )) {
    fail("pre-workload full-boundary evidence changed ", context)
  }
  observed_metadata <- documentation_metadata_ledger(protected_roots)
  diagnostic <- file.path(
    run_directory, "metadata", "boundaries",
    paste0(label, "-", phase, "-metadata-mismatch.tsv")
  )
  documentation_assert_metadata(
    observed_metadata, protected_metadata_pre, context, diagnostic
  )
  if (!identical(base_environment(overlay), environment)) {
    fail("documentation workload environment changed ", context)
  }
  verify_small_protected_state(context)
  attestation <- data.frame(
    field = c(
      "schema", "label", "phase", "context", "status",
      "full_boundary_pre_sha256", "protected_metadata_sha256",
      "protected_root_count", "protected_inventory_rows",
      "small_input_manifest_sha256", "environment_sha256",
      "candidate_ref", "candidate_commit", "candidate_tree",
      "candidate_source", "candidate_source_receipt_sha256",
      "compat_system_active"
    ),
    value = c(
      "2", label, phase, context, "passed", full_boundary_pre_sha256,
      protected_metadata_pre_sha256, as.character(length(protected_roots)),
      as.character(nrow(protected_metadata_pre)), small_input_manifest_sha256,
      environment_evidence$sha256, candidate_ref, candidate_commit,
      candidate_tree, candidate_source, candidate_source_receipt_sha256,
      if (compat_system_evidence$active) "true" else "false"
    ),
    stringsAsFactors = FALSE
  )
  path <- file.path(
    run_directory, "metadata", "boundaries",
    paste0(label, "-", phase, ".tsv")
  )
  documentation_write_tsv(attestation, path)
  list(
    path = substring(path, nchar(run_directory, type = "chars") + 2L),
    sha256 = unname(tools::sha256sum(path)),
    protected_metadata_sha256 = protected_metadata_pre_sha256,
    environment_sha256 = environment_evidence$sha256
  )
}

classification_log_head_bytes <- 256L * 1024L
classification_log_tail_bytes <- 768L * 1024L
classification_log_max_bytes <-
  classification_log_head_bytes + classification_log_tail_bytes
sample_classification_log <- function(path) {
  if (!file.exists(path) || dir.exists(path) || is_symbolic(path)) {
    fail("documentation workload log is absent, non-regular, or symbolic: ", path)
  }
  info <- fs::file_info(path, follow = FALSE)
  if (nrow(info) != 1L || !identical(as.character(info$type), "file")) {
    fail("documentation workload log has an unexpected lstat type: ", path)
  }
  log_bytes <- as.numeric(info$size)
  if (length(log_bytes) != 1L || is.na(log_bytes) ||
      !is.finite(log_bytes) || log_bytes < 0 || log_bytes != floor(log_bytes)) {
    fail("documentation workload log has an invalid size: ", path)
  }
  connection <- file(path, open = "rb")
  on.exit(close(connection), add = TRUE)
  if (log_bytes <= classification_log_max_bytes) {
    head_raw <- readBin(connection, what = "raw", n = as.integer(log_bytes))
    tail_raw <- raw()
    truncated <- FALSE
  } else {
    head_raw <- readBin(
      connection, what = "raw", n = classification_log_head_bytes
    )
    seek(
      connection,
      where = log_bytes - classification_log_tail_bytes,
      origin = "start",
      rw = "read"
    )
    position <- seek(connection, where = NA, rw = "read")
    if (!identical(as.numeric(position), log_bytes - classification_log_tail_bytes)) {
      fail("could not seek within oversized documentation log: ", path)
    }
    tail_raw <- readBin(
      connection, what = "raw", n = classification_log_tail_bytes
    )
    truncated <- TRUE
  }
  expected_sample_bytes <- if (truncated) {
    classification_log_max_bytes
  } else {
    as.integer(log_bytes)
  }
  if (length(head_raw) + length(tail_raw) != expected_sample_bytes) {
    fail("documentation workload log changed while it was sampled: ", path)
  }
  nul_bytes <- sum(head_raw == as.raw(0L)) + sum(tail_raw == as.raw(0L))
  if (nul_bytes) {
    head_raw[head_raw == as.raw(0L)] <- as.raw(32L)
    tail_raw[tail_raw == as.raw(0L)] <- as.raw(32L)
  }
  text <- if (truncated) {
    paste0(
      rawToChar(head_raw),
      "\n...[classification sample omitted middle of retained log]...\n",
      rawToChar(tail_raw)
    )
  } else {
    rawToChar(head_raw)
  }
  list(
    text = text,
    log_bytes = log_bytes,
    sample_bytes = length(head_raw) + length(tail_raw),
    head_bytes = length(head_raw),
    tail_bytes = length(tail_raw),
    truncated = truncated,
    nul_bytes = nul_bytes,
    pathological = if (nul_bytes) {
      "nul_bytes_sanitized"
    } else {
      "none_observed"
    }
  )
}

results <- list()
