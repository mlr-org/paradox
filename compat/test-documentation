capture <- function(command, arguments = character(), wd = root, env = character()) {
  processx::run(
    command, arguments, wd = wd, env = env, error_on_status = FALSE,
    echo = FALSE, windows_verbatim_args = FALSE
  )
}

git_output <- function(checkout, arguments) {
  value <- capture(git, c("-C", checkout, arguments))
  if (value$status != 0L) fail("Git validation failed for ", checkout, ": ", value$stderr)
  trimws(value$stdout)
}

