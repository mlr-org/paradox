verify_protected_libraries <- function(context, verify_toolchain_tree = FALSE) {
  compat_system_verify_evidence(compat_system_evidence, context)
  source_ref_commit <- tolower(git_output(
    root, c("rev-parse", paste0(candidate_ref, "^{commit}"))
  ))
  source_ref_tree <- tolower(git_output(
    root, c("rev-parse", paste0(candidate_ref, "^{tree}"))
  ))
  source_commit_tree <- tolower(git_output(
    root, c("rev-parse", paste0(candidate_commit, "^{tree}"))
  ))
  if (!identical(source_ref_commit, candidate_commit) ||
      !identical(source_ref_tree, candidate_tree) ||
      !identical(source_commit_tree, candidate_tree)) {
    fail("candidate ref, commit, or tree changed ", context)
  }
  live_metadata_sha256 <- setNames(
    vapply(metadata_inputs, tools::sha256sum, character(1L), USE.NAMES = FALSE),
    metadata_inputs
  )
  retained_metadata_sha256 <- vapply(
    retained_metadata_inputs,
    tools::sha256sum,
    character(1L),
    USE.NAMES = FALSE
  )
  if (!identical(live_metadata_sha256, metadata_input_sha256) ||
      !identical(unname(metadata_input_sha256), retained_metadata_sha256)) {
    fail("documentation harness or retained input changed ", context)
  }
  package_now <- normalizePath(find.package("paradox", lib.loc = candidate_library), mustWork = TRUE)
  if (!identical(package_now, candidate_package) ||
      !identical(compat_tree_content_sha256(package_now), declared_content) ||
      !identical(compat_tree_content_sha256(candidate_library), candidate_library_fingerprint)) {
    fail("candidate library changed ", context)
  }
  if (!identical(
      compat_tree_content_sha256(dependency_library),
      dependency_library_fingerprint
    )) {
    fail("dependency library changed ", context)
  }
  if (length(extra_libraries)) {
    extra_now <- setNames(
      vapply(extra_libraries, compat_tree_content_sha256, character(1L)),
      extra_libraries
    )
    if (!identical(extra_now, extra_library_fingerprints)) {
      fail("an extra documentation library changed ", context)
    }
  }
  for (receipt in c(toolchain_explicit_receipt, toolchain_tree_receipt)) {
    if (!file.exists(receipt) || dir.exists(receipt) || is_symbolic(receipt)) {
      fail("ordinary-toolchain receipt is absent, non-regular, or symbolic ",
        context)
    }
  }
  if (!identical(
      unname(tools::sha256sum(toolchain_explicit_receipt)),
      toolchain_explicit_receipt_sha256
    ) || !identical(
      unname(tools::sha256sum(toolchain_tree_receipt)),
      toolchain_tree_receipt_sha256
    )) {
    fail("ordinary-toolchain receipt changed ", context)
  }
  if (!identical(live_toolchain_explicit(), initial_toolchain_explicit)) {
    fail("ordinary toolchain package set changed ", context)
  }
  if (!identical(
      compat_tree_content_sha256(r_base_library),
      r_base_library_fingerprint
    )) {
    fail("R base library changed ", context)
  }
  if (isTRUE(verify_toolchain_tree)) {
    toolchain_now <- processx::run(
      local_rscript,
      c("--vanilla", retained_tree_helper, "verify", toolchain_root,
        toolchain_tree_receipt),
      error_on_status = FALSE,
      echo = FALSE
    )
    if (toolchain_now$status != 0L) {
      fail("repository-local ordinary toolchain changed ", context, ": ",
        toolchain_now$stderr)
    }
  }
  quarto_now <- processx::run(
    quarto_bootstrap,
    "--verify",
    wd = root,
    error_on_status = FALSE,
    echo = FALSE
  )
  if (quarto_now$status != 0L) {
    fail("repository-local Quarto changed ", context, ": ", quarto_now$stderr)
  }
  verify_tinytex_tree(context)
  invisible(TRUE)
}

