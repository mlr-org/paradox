result_index <- 0L
classify_failure <- function(text) {
  if (grepl(
    "there is no package called|package .+ is not installed|dependency .+ is not available|namespace .+ required|package or namespace load failed",
    text, ignore.case = TRUE, perl = TRUE, useBytes = TRUE
  )) return("missing_r_dependency")
  if (grepl(
    "could not resolve host|network is unreachable|HTTP [45][0-9][0-9]|OpenML|LaTeX|pdflatex|xelatex|chromium|system library|timed out|timeout",
    text, ignore.case = TRUE, perl = TRUE, useBytes = TRUE
  )) return("environmental")
  "execution_failure"
}

run_retained <- function(
  repository, workload, required, command, arguments, wd, overlay,
  prerequisite = TRUE
) {
  result_index <<- result_index + 1L
  label <- sprintf("%02d-%s-%s", result_index, repository, workload)
  log <- file.path(run_directory, "logs", paste0(label, ".log"))
  isolated_environment <- base_environment(overlay)
  environment_evidence <- retain_environment_evidence(
    label, isolated_environment
  )
  pre_boundary <- verify_row_boundary(
    paste0("before ", repository, "/", workload),
    label, "pre", overlay, isolated_environment, environment_evidence
  )
  started <- Sys.time()
  if (!isTRUE(prerequisite)) {
    status <- 125L
    writeLines("prerequisite failed; command was not run", log)
  } else {
    environment_arguments <- paste0(
      names(isolated_environment), "=", unname(isolated_environment)
    )
    process <- processx::run(
      environment_command,
      c("-i", environment_arguments, command, arguments),
      wd = wd,
      timeout = timeout_seconds, error_on_status = FALSE,
      stdout = log, stderr = "2>&1", echo = FALSE,
      windows_verbatim_args = FALSE
    )
    status <- process$status
  }
  log_sample <- sample_classification_log(log)
  classification <- if (!isTRUE(prerequisite)) {
    "blocked_by_prerequisite"
  } else if (status == 0L) {
    "passed"
  } else {
    classify_failure(log_sample$text)
  }
  elapsed <- as.numeric(difftime(Sys.time(), started, units = "secs"))
  post_boundary <- verify_row_boundary(
    paste0("after ", repository, "/", workload),
    label, "post", overlay, isolated_environment, environment_evidence
  )
  result <- data.frame(
    repository = repository, workload = workload, required = required,
    status = status, classification = classification,
    elapsed_seconds = elapsed, log = normalizePath(log, mustWork = TRUE),
    pre_boundary = pre_boundary$path,
    pre_boundary_sha256 = pre_boundary$sha256,
    post_boundary = post_boundary$path,
    post_boundary_sha256 = post_boundary$sha256,
    protected_metadata_pre_sha256 = pre_boundary$protected_metadata_sha256,
    protected_metadata_post_sha256 = post_boundary$protected_metadata_sha256,
    environment_evidence = environment_evidence$path,
    environment_sha256 = environment_evidence$sha256,
    log_bytes = format(
      log_sample$log_bytes, scientific = FALSE, trim = TRUE, digits = 22L
    ),
    classification_sample_bytes = log_sample$sample_bytes,
    classification_sample_head_bytes = log_sample$head_bytes,
    classification_sample_tail_bytes = log_sample$tail_bytes,
    classification_sample_truncated = log_sample$truncated,
    classification_sample_nul_bytes = log_sample$nul_bytes,
    classification_sample_pathological = log_sample$pathological,
    stringsAsFactors = FALSE
  )
  result_index_local <- length(results) + 1L
  results[[result_index_local]] <<- result
  commands[[result_index_local]] <<- data.frame(
    repository = repository, workload = workload,
    command = command, arguments = paste(shQuote(arguments), collapse = " "),
    working_directory = wd, libraries = library_environment(overlay),
    environment = paste(
      paste0(names(isolated_environment), "=", unname(isolated_environment)),
      collapse = " "
    ),
    stringsAsFactors = FALSE
  )
  status == 0L
}

