documentation_write_tsv <- function(value, path) {
  if (file.exists(path) || dir.exists(path) || is_symbolic(path)) {
    fail("documentation evidence path already exists: ", path)
  }
  temporary <- paste0(path, ".new")
  if (file.exists(temporary) || dir.exists(temporary) || is_symbolic(temporary)) {
    fail("documentation evidence temporary path already exists: ", temporary)
  }
  on.exit(unlink(temporary), add = TRUE)
  utils::write.table(
    value, temporary, sep = "\t", quote = TRUE, row.names = FALSE, na = "",
    fileEncoding = "UTF-8"
  )
  if (!file.rename(temporary, path)) {
    fail("could not atomically retain documentation evidence: ", path)
  }
  invisible(path)
}

documentation_format_metadata_number <- function(value) {
  value <- as.numeric(value)
  if (anyNA(value) || any(!is.finite(value))) {
    fail("protected metadata contains a missing or non-finite number")
  }
  format(value, scientific = FALSE, trim = TRUE, digits = 22L)
}

# fs performs the recursive scan in native code without following directory
# symlinks.  file_info(follow = FALSE) then supplies lstat data for the root and
# every descendant, including directories and symbolic links themselves.
documentation_metadata_ledger <- function(roots) {
  if (!is.character(roots) || !length(roots) || is.null(names(roots)) ||
      anyNA(roots) || any(!nzchar(roots)) || anyNA(names(roots)) ||
      any(!nzchar(names(roots))) || anyDuplicated(names(roots))) {
    fail("protected metadata roots require unique nonempty names and paths")
  }
  normalized_roots <- vapply(seq_along(roots), function(index) {
    path <- roots[[index]]
    if (!dir.exists(path) || is_symbolic(path)) {
      fail("protected metadata root is absent, non-directory, or symbolic: ", path)
    }
    normalizePath(path, winslash = "/", mustWork = TRUE)
  }, character(1L))
  names(normalized_roots) <- names(roots)
  if (anyDuplicated(normalized_roots)) {
    fail("protected metadata roots must be distinct")
  }
  if (length(normalized_roots) > 1L) {
    nested <- vapply(seq_along(normalized_roots), function(index) {
      any(startsWith(
        normalized_roots[-index], paste0(normalized_roots[[index]], "/")
      ))
    }, logical(1L))
    if (any(nested)) fail("protected metadata roots must be disjoint")
  }

  rows <- vector("list", length(normalized_roots))
  for (root_index in seq_along(normalized_roots)) {
    protected_root <- normalized_roots[[root_index]]
    paths <- c(
      protected_root,
      as.character(fs::dir_ls(
        protected_root, all = TRUE, recurse = TRUE, type = "any", fail = TRUE
      ))
    )
    if (anyDuplicated(paths)) {
      fail("protected metadata traversal returned duplicate paths below ",
        protected_root)
    }
    info <- fs::file_info(paths, follow = FALSE)
    types <- as.character(info$type)
    modes <- as.integer(info$permissions)
    if (anyNA(types) || anyNA(modes)) {
      fail("could not lstat every protected metadata entry below ", protected_root)
    }
    relative <- ifelse(
      paths == protected_root, ".",
      substring(paths, nchar(protected_root, type = "chars") + 2L)
    )
    ordering <- order(relative, method = "radix")
    rows[[root_index]] <- data.frame(
      root = names(normalized_roots)[[root_index]],
      root_path = protected_root,
      path = relative[ordering],
      type = types[ordering],
      mode = sprintf("%06o", modes[ordering]),
      size = documentation_format_metadata_number(info$size[ordering]),
      mtime = documentation_format_metadata_number(
        as.numeric(info$modification_time[ordering])
      ),
      ctime = documentation_format_metadata_number(
        as.numeric(info$change_time[ordering])
      ),
      device = documentation_format_metadata_number(info$device_id[ordering]),
      inode = documentation_format_metadata_number(info$inode[ordering]),
      nlink = documentation_format_metadata_number(info$hard_links[ordering]),
      link_target = Sys.readlink(paths[ordering]),
      stringsAsFactors = FALSE
    )
  }
  value <- do.call(rbind, rows)
  rownames(value) <- NULL
  value
}

documentation_assert_metadata <- function(
  observed, expected, context, diagnostic = NULL
) {
  if (identical(observed, expected)) return(invisible(TRUE))
  detail <- ""
  if (!is.null(diagnostic)) {
    documentation_write_tsv(observed, diagnostic)
    detail <- paste0(
      "; diagnostic ledger ", diagnostic, " has SHA-256 ",
      unname(tools::sha256sum(diagnostic))
    )
  }
  fail("protected metadata changed ", context, detail)
}

