  }
  observed_commit <- tolower(git_output(checkout, c("rev-parse", "HEAD^{commit}")))
  observed_tree <- tolower(git_output(checkout, c("rev-parse", "HEAD^{tree}")))
  dirty <- git_output(checkout, c("status", "--porcelain=v1", "--untracked-files=all"))
