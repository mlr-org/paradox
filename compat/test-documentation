usage <- function(status = 0L) {
  writeLines(c(
    "Usage: compat/test-documentation [OPTIONS]",
    "",
    "  --root PATH                 paradox checkout (default: current directory)",
    "  --candidate-library PATH    immutable candidate library",
    "  --candidate-source PATH     clean detached candidate worktree",
    "  --dependency-library PATH   consumer dependency library",
    "  --extra-library PATH        additional local library; repeatable",
    "  --run-id ID                 new retained run identifier",
    "  --scope all|essential|full  workload scope (default: all)",
    "  --timeout SECONDS           per-command timeout (default: 7200)",
    "  --help                      show this help"
  ))
  quit(save = "no", status = status)
}

args <- commandArgs(trailingOnly = TRUE)
options <- list(
  root = getwd(), candidate_library = NULL, candidate_source = NULL,
  dependency_library = NULL, extra_library = character(), run_id = NULL,
  scope = "all", timeout = 7200
)
i <- 1L
while (i <= length(args)) {
  arg <- args[[i]]
  if (arg == "--help") usage()
  key <- sub("^--", "", arg)
  key <- gsub("-", "_", key, fixed = TRUE)
  if (!startsWith(arg, "--") || !key %in% names(options)) {
    fail("unknown argument: ", arg)
  }
  if (i == length(args)) fail(arg, " requires a value")
  value <- args[[i + 1L]]
  if (key == "extra_library") {
    options$extra_library <- c(options$extra_library, value)
  } else {
    options[[key]] <- value
  }
  i <- i + 2L
}

