run_micromamba <- function(arguments, error_on_status = FALSE) {
  processx::run(
    environment_command,
    c(
      "-i",
      paste0(names(micromamba_environment), "=", unname(micromamba_environment)),
      micromamba,
      arguments
    ),
    error_on_status = error_on_status,
    echo = FALSE
  )
}
