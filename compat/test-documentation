  if (!identical(observed_commit, tolower(row$commit)) || nzchar(dirty) ||
      !identical(sub("[.]git$", "", origin), sub("[.]git$", "", row$url))) {
    fail("documentation checkout differs from its pinned clean snapshot: ", repository)
  }
