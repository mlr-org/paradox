      expected_toolchain_explicit[-(1:2)]
    )) || any(grepl(root, expected_toolchain_explicit, fixed = TRUE))) {
  fail("ordinary toolchain lock has an invalid explicit shape")
}
live_toolchain_explicit <- function() {
  if (!identical(
      unname(tools::sha256sum(micromamba_archive)),
      micromamba_archive_sha256
    ) || !identical(
      unname(tools::sha256sum(micromamba)),
      micromamba_binary_sha256
    )) {
    fail("repository-local micromamba changed during documentation validation")
  }
  result <- run_micromamba(
    c("list", "--no-rc", "--prefix", toolchain_root, "--explicit", "--sha256")
  )
  lines <- strsplit(result$stdout, "\n", fixed = TRUE)[[1L]]
  if (result$status != 0L || length(lines) < 3L ||
      !startsWith(lines[[1L]], "List of packages in environment: ") ||
      nzchar(lines[[2L]]) ||
      any(!grepl("^https://[^[:space:]#]+#[0-9a-f]{64}$", lines[-(1:2)]))) {
    fail("could not obtain a canonical explicit ordinary-toolchain package set")
  }
  value <- c("# platform: linux-64", "@EXPLICIT", lines[-(1:2)])
  if (!identical(value, expected_toolchain_explicit)) {
    fail("installed ordinary toolchain differs from its pinned explicit lock")
  }
  value
}
