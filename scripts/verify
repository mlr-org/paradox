#!/usr/bin/env sh

# One unattended entry point for the repository's verification DAG.  The
# controller itself uses only Python's standard library.  Expensive commands
# still enter the existing, evidence-producing gate drivers.

set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)

# The worker image is user-owned state, not root configuration: an explicit
# PARADOX_VERIFY_WORKER_IMAGE wins, then the machine-local pin below, and
# only then any legacy image in the root-owned helper configuration.  The
# pin travels through the aggregate launcher's existing --worker-image
# override, so refreshing a rebuilt image digest never needs root.
WORKER_IMAGE_PIN="$ROOT/.local/verify/worker-image.pin"
if [ -z "${PARADOX_VERIFY_WORKER_IMAGE:-}" ] &&
    [ -f "$WORKER_IMAGE_PIN" ] && [ ! -L "$WORKER_IMAGE_PIN" ]; then
  IFS= read -r PARADOX_VERIFY_WORKER_IMAGE < "$WORKER_IMAGE_PIN" || :
  case "${PARADOX_VERIFY_WORKER_IMAGE:-}" in
    ''|*[!A-Za-z0-9@:._/-]*)
      printf '%s\n' \
        "scripts/verify: $WORKER_IMAGE_PIN is empty or malformed" >&2
      exit 2
      ;;
  esac
  if [ "${#PARADOX_VERIFY_WORKER_IMAGE}" -gt 512 ]; then
    printf '%s\n' \
      "scripts/verify: $WORKER_IMAGE_PIN is unexpectedly long" >&2
    exit 2
  fi
  export PARADOX_VERIFY_WORKER_IMAGE
fi

# A root-owned helper is a machine-local opt-in. Once installed, ordinary
# doctor/plan/run commands enter the dedicated aggregate systemd envelope by
# default. Help and self-tests stay daemon/root-free, and an operator can
# explicitly bypass the local default to use a proved per-worker engine.
case "${1:-}" in
  doctor|plan|run)
    if [ "${PARADOX_VERIFY_AGGREGATE_SYSTEMD:-}" != 1 ] &&
        [ "${PARADOX_VERIFY_SYSTEMD_DEFAULT:-auto}" != off ] &&
        [ -x /usr/local/libexec/paradox-verify-systemd ] &&
        [ -f /etc/paradox-verify-systemd.conf ] &&
        [ ! -L /etc/paradox-verify-systemd.conf ] &&
        /usr/bin/grep -Fxq "repository=$ROOT" \
          /etc/paradox-verify-systemd.conf; then
      exec "$ROOT/scripts/verify-systemd" "$@"
    fi
    ;;
esac

if [ -x "$ROOT/.local/toolchain/bin/R" ] &&
    [ -x "$ROOT/.local/toolchain/bin/Rscript" ]; then
  if [ "${PARADOX_ACTIVE_ROOT:-}" != "$ROOT" ]; then
    cd "$ROOT"
    # shellcheck source=activate
    # shellcheck disable=SC1091
    . "$ROOT/scripts/activate"
  fi
fi

if [ -x "$ROOT/.local/toolchain/bin/python3" ]; then
  PYTHON="$ROOT/.local/toolchain/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=$(command -v python3)
else
  printf '%s\n' \
    "scripts/verify: no Python 3 is available; run scripts/bootstrap first" >&2
  exit 2
fi
if ! "$PYTHON" -c \
    'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)'
then
  printf '%s\n' \
    "scripts/verify: Python 3.10 or newer is required; run scripts/bootstrap first" >&2
  exit 2
fi

cd "$ROOT"
exec "$PYTHON" "$ROOT/verification/harness.py" \
  --root "$ROOT" --manifest "$ROOT/verification/tasks.json" "$@"
