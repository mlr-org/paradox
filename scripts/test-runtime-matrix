#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
PREFIX_RECEIPT="$ROOT/scripts/environment/runtime-matrix-prefix-receipt"
PREFIX_HANDOFF="$ROOT/scripts/environment/runtime-matrix-prefix-handoff"
GIT_HELPER="$ROOT/scripts/environment/runtime-matrix-git"
LOCAL_GIT="$ROOT/.local/toolchain/bin/git"
RESOURCE_JOBS="$ROOT/scripts/environment/resource-jobs"
STAGE_WORKER="$ROOT/scripts/environment/run-runtime-matrix-stage"
WAVE_RUNNER="$ROOT/scripts/environment/run-runtime-matrix-wave"
CROSS_SERIALIZATION_WORKER="$ROOT/scripts/environment/run-runtime-matrix-cross-serialization"
MBO_CONFIG_FIXTURE_HELPER="$ROOT/scripts/environment/mbo-config-fixtures"
MBO_CONFIG_CHECKOUT="$ROOT/.local/compat/github/mbo_config"
REGISTRY="$ROOT/scripts/environment/runtime-matrix-registry"
LIBRARY_MANAGER="$ROOT/scripts/environment/runtime-matrix-library"
TRUSTED_INPUT_HELPER="$ROOT/scripts/environment/runtime-matrix-trusted-inputs"
MANAGED_PATH_HELPER="$ROOT/scripts/environment/runtime-matrix-managed-path"
STAGE_TIMEOUT_SECONDS=7200
CROSS_SERIALIZATION_TIMEOUT_SECONDS=900
DATATABLE_VERSION=1.18.4
DATATABLE_SHA256=d65256f0050a6443770d5982b5098a2a8c894f9675ed17053416c7815cbddeb9
DATATABLE_ARCHIVE="$ROOT/.cache/downloads/r-packages/data.table_${DATATABLE_VERSION}.tar.gz"

usage() {
  cat <<'USAGE'
Usage: scripts/test-runtime-matrix [OPTIONS]

Build and test one committed paradox source tree under registered actual local
runtimes.

Options:
  --runtime VERSION  Select one registered runtime or all (default: all).
  --source-ref REF   Immutable full refs/... Git ref to archive (required).
  --run-id ID        New retained run ID (required).
  -h, --help         Show this help.

Each stage builds a source archive, installs it in a fresh run-specific
library, executes a focused r_api_compat probe and the authenticated supported
source-test scope with NOT_CRAN=false, audits the DSO's version-specific
undefined public R symbols, and seals all retained artifacts below
.local/checks/ID/.  R 3.6 and R 4.0 additionally execute the authenticated,
source-derived old-runtime GC/reentry slice with NOT_CRAN=true.  A complete
`--runtime all` run then serializes one nested current-v2 R6/ParamSet graph
under R 4.0 and loads, exercises, mutates, and reserializes it under R 3.6.
The R 3.6 stage also reinstalls the candidate against the exact declared
direct-dependency floors and runs a dependency-origin and imported-path smoke.
The isolated stages share one resource-aware light-test admission. All
selected minor-version stages may run concurrently when the aggregate
containment envelope admits them; PARADOX_RUNTIME_MATRIX_JOBS may lower that
ceiling.
USAGE
}

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

selection=all
source_ref=
run_id=
while (($#)); do
  case "$1" in
    --runtime)
      (($# >= 2)) || fail "--runtime requires a value"
      selection=$2
      shift 2
      ;;
    --source-ref)
      (($# >= 2)) || fail "--source-ref requires a value"
      source_ref=$2
      shift 2
      ;;
    --run-id)
      (($# >= 2)) || fail "--run-id requires a value"
      run_id=$2
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    *) fail "Unknown test-runtime-matrix argument: $1" ;;
  esac
done
[[ -x "$REGISTRY" && -x "$LIBRARY_MANAGER" ]] ||
  fail "runtime registry or dependency-library manager is absent"
"$REGISTRY" validate >/dev/null
if [[ "$selection" == all ]]; then
  mapfile -t versions < <("$REGISTRY" versions)
elif "$REGISTRY" contains "$selection"; then
  versions=("$selection")
else
  fail "Runtime must be registered or all: $selection"
fi
runtime_jobs_limit=${#versions[@]}
if [[ -n "${PARADOX_RUNTIME_MATRIX_JOBS:-}" ]]; then
  [[ "$PARADOX_RUNTIME_MATRIX_JOBS" =~ ^[1-9][0-9]*$ &&
    "$PARADOX_RUNTIME_MATRIX_JOBS" -le "$runtime_jobs_limit" ]] ||
    fail "PARADOX_RUNTIME_MATRIX_JOBS must lower the selected stage count"
  runtime_jobs_limit=$PARADOX_RUNTIME_MATRIX_JOBS
fi
[[ "$run_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]] ||
  fail "--run-id is required and must have a safe shape"
[[ "$source_ref" =~ ^refs/[A-Za-z0-9][A-Za-z0-9._/-]*$ &&
  "$source_ref" != *..* && "$source_ref" != */ &&
  "$source_ref" != *//* ]] ||
  fail "--source-ref is required and must be one safe full refs/... ref"
[[ "${PARADOX_ACTIVE_ROOT:-}" == "$ROOT" &&
  "$(command -v git)" == "$LOCAL_GIT" ]] ||
  fail "activate the exact repository-local toolchain first: . scripts/activate"
[[ -x "$GIT_HELPER" && -f "$GIT_HELPER" && ! -L "$GIT_HELPER" ]] ||
  fail "Authenticated runtime-matrix Git helper is absent"
"$GIT_HELPER" audit "$ROOT" >/dev/null
source_commit=$("$GIT_HELPER" resolve-commit "$ROOT" "$source_ref") ||
  fail "Source ref does not resolve to a commit: $source_ref"
source_tree=$("$GIT_HELPER" resolve-tree "$ROOT" "$source_commit")
[[ "$source_commit" =~ ^[0-9a-f]{40}$ && "$source_tree" =~ ^[0-9a-f]{40}$ ]] ||
  fail "Git returned malformed source provenance"
"$GIT_HELPER" verify-ref "$ROOT" "$source_ref" "$source_commit" \
  "$source_tree" >/dev/null

for relative in \
    scripts/environment/runtime-matrix-registry \
    scripts/environment/runtime-matrix-trusted-inputs; do
  [[ -f "$ROOT/$relative" && ! -L "$ROOT/$relative" ]] ||
    fail "Trusted-input bootstrap is absent or symbolic: $relative"
  "$GIT_HELPER" cat-file-exists "$ROOT" "$source_commit:$relative" 2>/dev/null ||
    fail "Source commit does not contain trusted-input bootstrap: $relative"
  "$GIT_HELPER" show-file "$ROOT" "$source_commit:$relative" |
    cmp -s -- "$ROOT/$relative" - ||
    fail "Trusted-input bootstrap differs from the committed source ref: $relative"
done
mapfile -t trusted_inputs < <("$TRUSTED_INPUT_HELPER")
[[ ${#trusted_inputs[@]} -gt 0 ]] ||
  fail "Trusted-input inventory is empty"
for relative in "${trusted_inputs[@]}"; do
  [[ -f "$ROOT/$relative" && ! -L "$ROOT/$relative" ]] ||
    fail "Runtime-matrix input is absent or symbolic: $relative"
  "$GIT_HELPER" cat-file-exists "$ROOT" "$source_commit:$relative" 2>/dev/null ||
    fail "Source commit does not contain runtime-matrix input: $relative"
  "$GIT_HELPER" show-file "$ROOT" "$source_commit:$relative" |
    cmp -s -- "$ROOT/$relative" - ||
    fail "Runtime-matrix input differs from the committed source ref: $relative"
done
lock_record=$(awk -F '\t' -v version="$DATATABLE_VERSION" '
  $1 == "data.table" && $2 == version { print $2 "\t" $4 }
' "$ROOT/environment/r-packages-linux-64.lock")
needs_data_table_overlay=false
for version in "${versions[@]}"; do
  if [[ "$("$REGISTRY" field "$version" dependency_mode)" == data-table-overlay ]]; then
    needs_data_table_overlay=true
  fi
done
if [[ "$needs_data_table_overlay" == true ]]; then
  [[ "$lock_record" == "$DATATABLE_VERSION"$'\t'"$DATATABLE_SHA256" ]] ||
    fail "authenticated data.table source lock is absent or ambiguous"
  [[ -f "$DATATABLE_ARCHIVE" && ! -L "$DATATABLE_ARCHIVE" ]] ||
    fail "cached data.table source is absent: run scripts/bootstrap"
  [[ "$(sha256sum -- "$DATATABLE_ARCHIVE" | cut -d ' ' -f 1)" == "$DATATABLE_SHA256" ]] ||
    fail "cached data.table source does not match its authenticated lock"
fi

"$ROOT/scripts/bootstrap-runtime-matrix" --runtime "$selection" --verify
run_root="$ROOT/.local/checks/$run_id/runtime-matrix"
"$MANAGED_PATH_HELPER" "$ROOT" "$run_root" allow-missing
[[ ! -e "$run_root" && ! -L "$run_root" ]] ||
  fail "Run directory already exists: $run_root"
mkdir -p -- "$run_root/metadata"
"$MANAGED_PATH_HELPER" "$ROOT" "$run_root/metadata" existing

sha256_file() {
  sha256sum -- "$1" | cut -d ' ' -f 1
}

trusted_inputs_manifest="$run_root/metadata/trusted-inputs.tsv"
{
  printf 'relative\tsha256\n'
  for relative in "${trusted_inputs[@]}"; do
    printf '%s\t%s\n' "$relative" "$(sha256_file "$ROOT/$relative")"
  done
} > "$trusted_inputs_manifest"
trusted_inputs_sha256=$(sha256_file "$trusted_inputs_manifest")

verify_live_trusted_inputs() {
  local index=0 relative digest extra
  IFS=$'\t' read -r relative digest extra < "$trusted_inputs_manifest"
  [[ "$relative" == relative && "$digest" == sha256 && -z "${extra:-}" ]] ||
    fail "Trusted-input manifest has the wrong header"
  while IFS=$'\t' read -r relative digest extra; do
    [[ -z "${extra:-}" && "$index" -lt "${#trusted_inputs[@]}" &&
      "$relative" == "${trusted_inputs[index]}" &&
      "$digest" =~ ^[0-9a-f]{64}$ &&
      -f "$ROOT/$relative" && ! -L "$ROOT/$relative" &&
      "$(sha256_file "$ROOT/$relative")" == "$digest" ]] ||
      fail "Trusted runtime-matrix input changed during execution: $relative"
    index=$((index + 1))
  done < <(tail -n +2 "$trusted_inputs_manifest")
  [[ "$index" -eq "${#trusted_inputs[@]}" ]] ||
    fail "Trusted-input manifest has the wrong row count"
  [[ "$(sha256_file "$trusted_inputs_manifest")" == "$trusted_inputs_sha256" ]] ||
    fail "Trusted-input manifest changed during execution"
}

printf 'field\tvalue\nstatus\tfailed\nrun_id\t%s\nsource_ref\t%s\nsource_commit\t%s\nsource_tree\t%s\n' \
  "$run_id" "$source_ref" "$source_commit" "$source_tree" > "$run_root/metadata/run.tsv"

seal_metadata() {
  local metadata=$1
  shift
  (
    cd "$metadata"
    : > completion.inputs.tsv
    local input
    for input in "$@"; do
      sha256sum "$input" >> completion.inputs.tsv
    done
    printf '%s  completion.inputs.tsv\n' "$(sha256_file completion.inputs.tsv)" > completion.seal
  )
}

declare -A source_git_tar_hashes=()
declare -A source_manifest_hashes=()
declare -A git_identity_hashes=()

# Prepare every immutable input before admitting external R workers.  The
# version-specific mutable trees do not overlap, so the expensive stages can
# then run as one bounded sibling wave.
for version in "${versions[@]}"; do
  stage="$run_root/R-$version"
  artifacts="$stage/artifacts"
  metadata="$stage/metadata"
  source="$artifacts/source"
  build="$artifacts/build"
  check="$artifacts/check"
  library="$artifacts/library"
  logs="$artifacts/logs"
  inputs="$artifacts/inputs"
  mkdir -p -- "$source" "$build" "$check" "$library" "$logs" "$inputs" \
    "$metadata"
  printf 'field\tvalue\nstatus\tfailed\nrun_id\t%s\nruntime\t%s\nsource_ref\t%s\nsource_commit\t%s\nsource_tree\t%s\n' \
    "$run_id" "$version" "$source_ref" "$source_commit" "$source_tree" > "$metadata/run.tsv"

  "$GIT_HELPER" archive "$ROOT" "$source_commit" "$inputs/source.git.tar"
  "$GIT_HELPER" verify-archive "$ROOT" "$source_commit" \
    "$inputs/source.git.tar" >/dev/null
  source_git_tar_sha256=$(sha256_file "$inputs/source.git.tar")
  /usr/bin/tar -xf "$inputs/source.git.tar" -C "$source"
  "$PREFIX_RECEIPT" create "$source" "$inputs/source.manifest.tsv" >/dev/null
  source_manifest_sha256=$(sha256_file "$inputs/source.manifest.tsv")
  "$GIT_HELPER" identity "$ROOT" > "$inputs/git-identity.tsv"
  git_identity_sha256=$(sha256_file "$inputs/git-identity.tsv")
  source_git_tar_hashes[$version]=$source_git_tar_sha256
  source_manifest_hashes[$version]=$source_manifest_sha256
  git_identity_hashes[$version]=$git_identity_sha256
  for relative in "${trusted_inputs[@]}"; do
    mkdir -p -- "$inputs/${relative%/*}"
    cp -- "$ROOT/$relative" "$inputs/$relative"
  done
  dependency_mode=$("$REGISTRY" field "$version" dependency_mode)
  if [[ "$dependency_mode" == data-table-overlay ]]; then
    cp -- "$DATATABLE_ARCHIVE" "$inputs/data.table_${DATATABLE_VERSION}.tar.gz"
  fi
  cp -R -- "$ROOT/.local/runtime-matrix/receipts/R-$version" "$inputs/bootstrap-receipt"
  "$PREFIX_HANDOFF" "$version" "$inputs/bootstrap-receipt" >/dev/null
  if [[ "$dependency_mode" == source-library ]]; then
    dependency_library=$("$LIBRARY_MANAGER" \
      --runtime "$version" --verify --print-path)
    dependency_key=${dependency_library%/library}
    dependency_key=${dependency_key##*/}
    cp -R -- "$ROOT/.local/runtime-matrix/dependency-receipts/R-$version/$dependency_key" \
      "$inputs/dependency-library-receipt"
  fi
  if [[ "$version" == 3.6.3 ]]; then
    declared_floor_library=$(
      "$LIBRARY_MANAGER" --runtime 3.6.3 --profile declared-floor \
        --verify --print-path
    )
    declared_floor_key=${declared_floor_library%/library}
    declared_floor_key=${declared_floor_key##*/}
    cp -R -- \
      "$ROOT/.local/runtime-matrix/dependency-receipts/R-3.6.3-declared-floor/$declared_floor_key" \
      "$inputs/declared-floor-library-receipt"
  fi
  {
    printf 'step\tcommand\n'
    printf 'snapshot\treplacement-disabled Git archive with isolated attributes and pre/post repository audits\n'
    printf 'source-integrity\tpre-execution source receipt; post-execution source and archive verification\n'
    printf 'prefix-receipt\texact five-file staged handoff compared with the freshly authenticated live prefix receipt\n'
    printf 'git-identity\tauthenticated repository-local Git executable hash, version, path, and exec path\n'
    printf 'mbo-config-fixtures\treviewed commit/tree Git objects staged once as read-only retained source-test inputs\n'
    printf 'build\tR CMD build --no-build-vignettes --no-manual SOURCE\n'
    printf 'install\tR CMD INSTALL --preclean --clean --install-tests --library=LIBRARY ARCHIVE\n'
    if [[ "$version" == 3.6.3 ]]; then
      printf 'declared-minimum-check\tPATH=authenticated-target-tool-bin _R_CHECK_FORCE_SUGGESTS_=false R CMD check --no-tests --ignore-vignettes --no-manual ARCHIVE\n'
      printf 'declared-floor-install\tR CMD INSTALL into a fresh candidate library with the exact declared direct-dependency floors\n'
      printf 'declared-floor-smoke\texact R 3.6.3 dependency-origin and representative imported-path probe\n'
    fi
    if [[ "$dependency_mode" == data-table-overlay ]]; then
      printf 'dependency-overlay\tSHA-256-authenticated R CMD INSTALL of data.table %s into the fresh stage library\n' "$DATATABLE_VERSION"
    elif [[ "$dependency_mode" == source-library ]]; then
      printf 'dependency-overlay\tverified sealed source-package library from the exact runtime dependency lock\n'
    else
      printf 'dependency-overlay\tvalidated prefix data.table %s\n' "$DATATABLE_VERSION"
    fi
    printf 'focused\tRscript runtime-matrix-probe.R LIBRARY\n'
    printf 'symbols\tauthenticated prefix NM -D --undefined-only paradox.so\n'
    printf 'tests\tNOT_CRAN=false Rscript run-runtime-matrix-tests.R SOURCE LIBRARY ABSENT_SCOPE_DIRECTORY\n'
    if [[ "$version" == 3.6.3 || "$version" == 4.0.5 ]]; then
      printf 'old-runtime-stress\tNOT_CRAN=true Rscript run-runtime-matrix-old-r-stress.R SOURCE LIBRARY ABSENT_SCOPE_DIRECTORY\n'
    fi
    printf 'scheduling\tresource-jobs light-test; up to every selected minor-version stage; all nested make, testthat, BLAS, and OpenMP pools fixed to one\n'
  } > "$inputs/commands.tsv"
done

# Validate source-derived skip policy from one authenticated extracted candidate
# before resource admission or any build/install worker can start.  All
# runtime stages use the same exact Git archive bytes.
preflight_source="$run_root/R-${versions[0]}/artifacts/source"
mkdir -p -- "$run_root/inputs"
mbo_config_bundle="$run_root/inputs/mbo-config-fixtures"
"$MBO_CONFIG_FIXTURE_HELPER" stage "$preflight_source" \
  "$MBO_CONFIG_CHECKOUT" "$mbo_config_bundle" \
  > "$run_root/metadata/mbo-config-fixtures.log"
"$PREFIX_RECEIPT" create "$mbo_config_bundle" \
  "$run_root/metadata/mbo-config-fixtures.manifest.tsv" >/dev/null
mbo_config_provenance="$mbo_config_bundle/provenance.tsv"
mbo_config_value() {
  local key=$1
  awk -F '\t' -v key="$key" '$1 == key {print $2}' \
    "$mbo_config_provenance"
}
mbo_config_commit=$(mbo_config_value commit)
mbo_config_tree=$(mbo_config_value tree)
mbo_config_mixed_sha256=$(mbo_config_value mixed_search_space_sha256)
mbo_config_numeric_sha256=$(mbo_config_value numeric_search_space_sha256)
mbo_config_provenance_sha256=$(sha256_file "$mbo_config_provenance")
mbo_config_manifest_sha256=$(sha256_file \
  "$run_root/metadata/mbo-config-fixtures.manifest.tsv")
Rscript --vanilla \
  "$preflight_source/scripts/environment/runtime-matrix-skip-policy.R" \
  "$preflight_source"
Rscript --vanilla \
  "$preflight_source/scripts/environment/runtime-matrix-old-r-stress-policy.R" \
  "$preflight_source"

resource_report="$run_root/metadata/resource-jobs.tsv"
task_list="$run_root/metadata/stage-tasks.tsv"
wave_directory="$run_root/metadata/stage-wave"
"$RESOURCE_JOBS" light-test --max-jobs "$runtime_jobs_limit" --report \
  > "$resource_report.staging"
mv "$resource_report.staging" "$resource_report"
runtime_jobs=$(awk -F '\t' '$1 == "jobs" {print $2}' "$resource_report")
[[ "$runtime_jobs" =~ ^[1-9][0-9]*$ &&
  "$runtime_jobs" -le "${#versions[@]}" ]] ||
  fail "Runtime stage admission returned an invalid worker count"
{
  printf 'ordinal\tversion\n'
  for ((index = 0; index < ${#versions[@]}; index++)); do
    printf '%s\t%s\n' "$((index + 1))" "${versions[index]}"
  done
} > "$task_list"
bash_path=$(command -v bash)
setsid_path=$(command -v setsid)
timeout_path=$(command -v timeout)
wave_status=0
wave_pid=
forward_wave_signal() {
  local signal=$1 exit_status
  trap - HUP INT TERM
  if [[ -n "$wave_pid" ]]; then
    kill -s "$signal" "$wave_pid" 2>/dev/null || true
    wait "$wave_pid" 2>/dev/null || true
  fi
  case "$signal" in HUP) exit_status=129 ;; INT) exit_status=130 ;; TERM) exit_status=143 ;; esac
  exit "$exit_status"
}
trap 'forward_wave_signal HUP' HUP
trap 'forward_wave_signal INT' INT
trap 'forward_wave_signal TERM' TERM
verify_live_trusted_inputs
"$WAVE_RUNNER" --jobs "$runtime_jobs" --admission-report "$resource_report" \
  --task-list "$task_list" --output-directory "$wave_directory" \
  --worker "$STAGE_WORKER" --root "$ROOT" --run-root "$run_root" \
  --bash "$bash_path" --setsid "$setsid_path" --timeout-tool "$timeout_path" \
  --task-timeout-seconds "$STAGE_TIMEOUT_SECONDS" &
wave_pid=$!
wait "$wave_pid" || wave_status=$?
wave_pid=
trap - HUP INT TERM
verify_live_trusted_inputs

[[ -f "$wave_directory/task-ledger.tsv" &&
  -f "$wave_directory/wave-plan.tsv" ]] ||
  fail "Runtime stage scheduler did not retain its complete result"
"$PREFIX_RECEIPT" create "$wave_directory" \
  "$run_root/metadata/stage-wave.manifest.tsv" >/dev/null
resource_report_sha256=$(sha256_file "$resource_report")
stage_tasks_sha256=$(sha256_file "$task_list")
wave_plan_sha256=$(sha256_file "$wave_directory/wave-plan.tsv")
wave_task_ledger_sha256=$(sha256_file "$wave_directory/task-ledger.tsv")
wave_manifest_sha256=$(sha256_file "$run_root/metadata/stage-wave.manifest.tsv")
stage_worker_sha256=$(sha256_file "$STAGE_WORKER")

# Promote and seal successful siblings in deterministic runtime order, even if
# another stage failed.  This preserves all useful diagnostics from one wave.
for version in "${versions[@]}"; do
  worker_status=$(awk -F '\t' -v version="$version" \
    '$3 == version {print $4 ":" $5 ":" $6}' "$wave_directory/task-ledger.tsv")
  [[ "$worker_status" == 0:false:true ]] || continue

  stage="$run_root/R-$version"
  artifacts="$stage/artifacts"
  metadata="$stage/metadata"
  source="$artifacts/source"
  build="$artifacts/build"
  check="$artifacts/check"
  library="$artifacts/library"
  logs="$artifacts/logs"
  inputs="$artifacts/inputs"
  source_git_tar_sha256=${source_git_tar_hashes[$version]}
  source_manifest_sha256=${source_manifest_hashes[$version]}
  git_identity_sha256=${git_identity_hashes[$version]}

  branch=$(awk -F = '$1 == "r_api_compat_branch" {print $2}' "$logs/r-api-symbol-audit.log")
  dependency_mode=$("$REGISTRY" field "$version" dependency_mode)
  archive=$(find "$build" -maxdepth 1 -type f -name 'paradox_*.tar.gz' -print)
  scope="$inputs/source-test-scope"
  [[ -n "$branch" && -f "$archive" && -d "$scope" && ! -L "$scope" &&
    -f "$scope/scope.tsv" && -f "$scope/testthat-reported-files.tsv" &&
    -f "$scope/observed-whole-file-skips.tsv" &&
    -f "$scope/observed-result-skips.tsv" ]] ||
    fail "Runtime stage outputs are incomplete"
  old_stress_scope="$inputs/old-r-stress-scope"
  old_stress_log="$logs/old-r-stress.log"
  if [[ "$version" == 3.6.3 || "$version" == 4.0.5 ]]; then
    [[ -d "$old_stress_scope" && ! -L "$old_stress_scope" &&
      -d "$old_stress_scope/testthat" &&
      ! -L "$old_stress_scope/testthat" &&
      -f "$old_stress_scope/selection.tsv" &&
      ! -L "$old_stress_scope/selection.tsv" &&
      -f "$old_stress_scope/results.tsv" &&
      ! -L "$old_stress_scope/results.tsv" &&
      -f "$old_stress_scope/testthat-reported-files.tsv" &&
      ! -L "$old_stress_scope/testthat-reported-files.tsv" &&
      -f "$old_stress_log" && ! -L "$old_stress_log" ]] ||
      fail "Old-runtime stress evidence is incomplete"
  else
    [[ ! -e "$old_stress_scope" && ! -L "$old_stress_scope" &&
      ! -e "$old_stress_log" && ! -L "$old_stress_log" ]] ||
      fail "A newer runtime retained unexpected old-runtime stress evidence"
  fi
  compiled_code_policy_log="$logs/r45-compiled-code-policy.log"
  if [[ "$version" == 4.5.2 ]]; then
    [[ -f "$compiled_code_policy_log" &&
      ! -L "$compiled_code_policy_log" ]] ||
      fail "R 4.5 compiled-code policy evidence is incomplete"
  else
    [[ ! -e "$compiled_code_policy_log" &&
      ! -L "$compiled_code_policy_log" ]] ||
      fail "A non-4.5 runtime retained unexpected compiled-code policy evidence"
  fi
  if [[ "$dependency_mode" == data-table-overlay ]]; then
    [[ -f "$inputs/data.table_${DATATABLE_VERSION}.tar.gz" &&
      ! -L "$inputs/data.table_${DATATABLE_VERSION}.tar.gz" &&
      -f "$logs/data.table-install.log" &&
      ! -L "$logs/data.table-install.log" &&
      -f "$logs/data.table-version.tsv" &&
      ! -L "$logs/data.table-version.tsv" ]] ||
      fail "data.table overlay evidence is incomplete"
  else
    [[ ! -e "$inputs/data.table_${DATATABLE_VERSION}.tar.gz" &&
      ! -L "$inputs/data.table_${DATATABLE_VERSION}.tar.gz" &&
      ! -e "$logs/data.table-install.log" &&
      ! -L "$logs/data.table-install.log" &&
      ! -e "$logs/data.table-version.tsv" &&
      ! -L "$logs/data.table-version.tsv" ]] ||
      fail "A non-overlay runtime retained unexpected data.table overlay evidence"
  fi
  if [[ "$version" == 3.6.3 ]]; then
    [[ -f "$logs/r-cmd-check.log" && ! -L "$logs/r-cmd-check.log" &&
      -f "$logs/r-cmd-check-status.tsv" &&
      ! -L "$logs/r-cmd-check-status.tsv" &&
      -f "$check/paradox.Rcheck/00check.log" &&
      ! -L "$check/paradox.Rcheck/00check.log" &&
      -d "$inputs/declared-floor-library-receipt" &&
      ! -L "$inputs/declared-floor-library-receipt" &&
      -d "$artifacts/declared-floor-candidate-library" &&
      ! -L "$artifacts/declared-floor-candidate-library" &&
      -f "$logs/declared-floor-install.log" &&
      ! -L "$logs/declared-floor-install.log" &&
      -f "$logs/declared-floor-smoke.log" &&
      ! -L "$logs/declared-floor-smoke.log" ]] ||
      fail "Declared-minimum R CMD check or dependency-floor evidence is incomplete"
  else
    [[ -d "$check" && ! -L "$check" &&
      -z $(find "$check" -mindepth 1 -print -quit) &&
      ! -e "$logs/r-cmd-check.log" && ! -L "$logs/r-cmd-check.log" &&
      ! -e "$logs/r-cmd-check-status.tsv" &&
      ! -L "$logs/r-cmd-check-status.tsv" &&
      ! -e "$inputs/declared-floor-library-receipt" &&
      ! -L "$inputs/declared-floor-library-receipt" &&
      ! -e "$artifacts/declared-floor-candidate-library" &&
      ! -L "$artifacts/declared-floor-candidate-library" &&
      ! -e "$logs/declared-floor-install.log" &&
      ! -L "$logs/declared-floor-install.log" &&
      ! -e "$logs/declared-floor-smoke.log" &&
      ! -L "$logs/declared-floor-smoke.log" ]] ||
      fail "A non-minimum runtime retained unexpected R CMD check or dependency-floor evidence"
  fi
  [[ $(sha256_file "$inputs/source.git.tar") == "$source_git_tar_sha256" &&
    $(sha256_file "$inputs/source.manifest.tsv") == "$source_manifest_sha256" &&
    $(sha256_file "$inputs/git-identity.tsv") == "$git_identity_sha256" ]] ||
    fail "Runtime source or Git identity input changed during execution"
  "$GIT_HELPER" verify-archive "$ROOT" "$source_commit" \
    "$inputs/source.git.tar" >/dev/null ||
    fail "Runtime Git archive is not the canonical selected commit archive"
  "$PREFIX_RECEIPT" verify "$source" "$inputs/source.manifest.tsv" >/dev/null ||
    fail "Runtime source changed during execution"
  log_value() {
    local key=$1
    awk -F = -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print}' \
      "$logs/source-tests.log"
  }
  discovered_test_files=$(log_value discovered_test_file_count)
  discovered_test_contexts=$(log_value discovered_test_context_count)
  executed_test_files=$(log_value executed_test_file_count)
  executed_test_contexts=$(log_value executed_test_context_count)
  excluded_test_files=$(log_value excluded_test_file_count)
  excluded_test_contexts=$(log_value excluded_test_context_count)
  staged_test_support_files=$(log_value staged_test_support_file_count)
  reported_test_files=$(log_value testthat_reported_file_count)
  expected_whole_file_skips=$(log_value expected_whole_file_skip_count)
  whole_file_skips=$(log_value observed_whole_file_skip_count)
  expectations_passed=$(log_value expectations_passed)
  result_skips=$(log_value result_test_blocks_skipped)
  total_skips=$(log_value total_test_skips)
  expected_result_skips=$(log_value expected_result_test_block_skip_count)
  for value in "$discovered_test_files" "$discovered_test_contexts" \
      "$executed_test_files" "$executed_test_contexts" \
      "$excluded_test_files" "$excluded_test_contexts" \
      "$staged_test_support_files" "$reported_test_files" \
      "$expected_whole_file_skips" "$whole_file_skips" \
      "$expectations_passed" "$result_skips" "$total_skips" \
      "$expected_result_skips"; do
    [[ "$value" =~ ^(0|[1-9][0-9]*)$ ]] ||
      fail "Runtime source-test counts are malformed"
  done
  manifest_whole_file_skips=$(awk 'END {print NR - 1}' \
    "$inputs/environment/runtime-matrix-whole-file-skips.tsv")
  manifest_result_skips=$(awk -F '\t' -v runtime="$version" \
    'NR > 1 && $1 == runtime {count++} END {print count + 0}' \
    "$inputs/environment/runtime-matrix-result-skips.tsv")
  scope_discovered=$(awk 'END {print NR - 1}' "$scope/scope.tsv")
  scope_executed=$(awk -F '\t' '$1 == "executed" {count++} END {print count + 0}' \
    "$scope/scope.tsv")
  scope_excluded=$(awk -F '\t' '$1 == "excluded" {count++} END {print count + 0}' \
    "$scope/scope.tsv")
  retained_reported=$(awk 'END {print NR - 1}' \
    "$scope/testthat-reported-files.tsv")
  retained_staged_files=$(find "$scope/testthat" -maxdepth 1 -type f | wc -l)
  ((discovered_test_files > 0 && expectations_passed > 0 &&
    discovered_test_files == discovered_test_contexts &&
    executed_test_files == executed_test_contexts &&
    excluded_test_files == excluded_test_contexts &&
    discovered_test_files == executed_test_files + excluded_test_files &&
    excluded_test_files == 0 &&
    discovered_test_files == scope_discovered &&
    executed_test_files == scope_executed &&
    excluded_test_files == scope_excluded &&
    reported_test_files == retained_reported &&
    retained_staged_files == executed_test_files + staged_test_support_files &&
    reported_test_files + whole_file_skips == executed_test_files &&
    expected_whole_file_skips == manifest_whole_file_skips &&
    whole_file_skips == expected_whole_file_skips &&
    expected_result_skips == manifest_result_skips &&
    result_skips == expected_result_skips &&
    total_skips == result_skips + whole_file_skips)) ||
    fail "Runtime source-test inventory or skip accounting is inconsistent"
  old_stress_manifest_sha256=-
  old_stress_selection_sha256=-
  old_stress_results_sha256=-
  old_stress_reported_files_sha256=-
  old_stress_log_sha256=-
  old_stress_selected_files=-
  old_stress_selected_targets=-
  old_stress_test_blocks=-
  old_stress_target_passes=-
  old_stress_non_target_skips=-
  old_stress_support_files=-
  old_stress_expectations_passed=-
  if [[ "$version" == 3.6.3 || "$version" == 4.0.5 ]]; then
    old_stress_manifest="$inputs/environment/runtime-matrix-old-r-stress.tsv"
    old_stress_selection="$old_stress_scope/selection.tsv"
    old_stress_results="$old_stress_scope/results.tsv"
    old_stress_reported="$old_stress_scope/testthat-reported-files.tsv"
    stress_log_value() {
      local key=$1
      awk -F = -v key="$key" '$1 == key {
        sub(/^[^=]*=/, "")
        print
      }' "$old_stress_log"
    }
    cmp -s -- "$old_stress_manifest" "$old_stress_selection" ||
      fail "Old-runtime stress selection differs from its source manifest"
    old_stress_selected_files=$(stress_log_value selected_file_count)
    old_stress_selected_targets=$(stress_log_value selected_target_count)
    old_stress_support_files=$(stress_log_value \
      staged_test_support_file_count)
    old_stress_test_blocks=$(stress_log_value test_block_count)
    old_stress_target_passes=$(stress_log_value target_pass_count)
    old_stress_non_target_skips=$(stress_log_value non_target_skip_count)
    old_stress_expectations_passed=$(stress_log_value expectations_passed)
    for value in "$old_stress_selected_files" \
        "$old_stress_selected_targets" "$old_stress_support_files" \
        "$old_stress_test_blocks" "$old_stress_target_passes" \
        "$old_stress_non_target_skips" \
        "$old_stress_expectations_passed"; do
      [[ "$value" =~ ^(0|[1-9][0-9]*)$ ]] ||
        fail "Old-runtime stress count is malformed"
    done
    manifest_stress_targets=$(awk 'END {print NR - 1}' \
      "$old_stress_manifest")
    manifest_stress_files=$(tail -n +2 "$old_stress_manifest" |
      cut -f 1 | LC_ALL=C sort -u | wc -l)
    retained_stress_results=$(awk 'END {print NR - 1}' \
      "$old_stress_results")
    retained_stress_reported=$(awk 'END {print NR - 1}' \
      "$old_stress_reported")
    retained_stress_target_passes=$(awk -F '\t' \
      'NR > 1 && $3 == "true" && $11 == "passed" {count++}
       END {print count + 0}' "$old_stress_results")
    retained_stress_non_target_skips=$(awk -F '\t' \
      'NR > 1 && $3 == "false" && $11 == "skipped" {count++}
       END {print count + 0}' "$old_stress_results")
    retained_stress_files=$(find "$old_stress_scope/testthat" -maxdepth 1 \
      -type f | wc -l)
    ((old_stress_selected_files > 0 &&
      old_stress_selected_targets > 0 &&
      old_stress_test_blocks == old_stress_selected_targets &&
      old_stress_target_passes == old_stress_selected_targets &&
      old_stress_non_target_skips == 0 &&
      old_stress_expectations_passed > 0 &&
      old_stress_selected_files == manifest_stress_files &&
      old_stress_selected_targets == manifest_stress_targets &&
      old_stress_test_blocks == retained_stress_results &&
      old_stress_selected_files == retained_stress_reported &&
      old_stress_target_passes == retained_stress_target_passes &&
      old_stress_non_target_skips == retained_stress_non_target_skips &&
      retained_stress_files ==
        old_stress_selected_files + old_stress_support_files)) ||
      fail "Old-runtime stress inventory or result accounting is inconsistent"
    [[ $(stress_log_value not_cran) == true &&
      $(stress_log_value lc_all) == unset &&
      $(stress_log_value stress_scope) == \
        old-runtime-source-derived-selection &&
      $(stress_log_value stress_manifest) == \
        environment/runtime-matrix-old-r-stress.tsv &&
      $(stress_log_value stress_selection) == \
        old-r-stress-scope/selection.tsv &&
      $(stress_log_value selection_filter) == \
        helper_zz_runtime_old_r_stress_filter.R &&
      $(stress_log_value selection_filter_self_test) == passed &&
      $(stress_log_value testthat_reported_file_count) == \
        "$old_stress_selected_files" &&
      $(stress_log_value expectations_failed) == 0 &&
      $(stress_log_value warnings) == 0 &&
      $(stress_log_value errors) == 0 ]] ||
      fail "Old-runtime stress policy or clean status is inconsistent"
    grep -Fqx 'runtime_matrix_old_r_stress=passed' "$old_stress_log" ||
      fail "Old-runtime stress completion marker is absent"
    old_stress_manifest_sha256=$(sha256_file "$old_stress_manifest")
    old_stress_selection_sha256=$(sha256_file "$old_stress_selection")
    old_stress_results_sha256=$(sha256_file "$old_stress_results")
    old_stress_reported_files_sha256=$(sha256_file "$old_stress_reported")
    old_stress_log_sha256=$(sha256_file "$old_stress_log")
    unset -f stress_log_value
  fi
  declared_floor_lock_sha256=-
  declared_floor_library_receipt_sha256=-
  declared_floor_install_log_sha256=-
  declared_floor_smoke_log_sha256=-
  declared_floor_candidate_dso_sha256=-
  if [[ "$version" == 3.6.3 ]]; then
    declared_floor_lock_sha256=$(sha256_file \
      "$inputs/environment/runtime-r-3.6.3-declared-floor-packages.lock")
    declared_floor_library_receipt_sha256=$(sha256_file \
      "$inputs/declared-floor-library-receipt/receipt.tsv")
    declared_floor_install_log_sha256=$(sha256_file \
      "$logs/declared-floor-install.log")
    declared_floor_smoke_log_sha256=$(sha256_file \
      "$logs/declared-floor-smoke.log")
    declared_floor_candidate_dso_sha256=$(sha256_file \
      "$artifacts/declared-floor-candidate-library/paradox/libs/paradox.so")
  fi
  "$PREFIX_RECEIPT" create "$artifacts" "$metadata/artifacts.manifest.tsv" >/dev/null
  {
    printf 'field\tvalue\n'
    printf 'status\tpassed\n'
    printf 'run_id\t%s\n' "$run_id"
    printf 'runtime\t%s\n' "$version"
    printf 'source_ref\t%s\n' "$source_ref"
    printf 'source_commit\t%s\n' "$source_commit"
    printf 'source_tree\t%s\n' "$source_tree"
    printf 'r_api_compat_branch\t%s\n' "$branch"
    runtime_lock_relative=$("$REGISTRY" field "$version" runtime_lock)
    dependency_lock_relative=$("$REGISTRY" field "$version" dependency_lock)
    printf 'lock_sha256\t%s\n' "$(sha256_file "$ROOT/$runtime_lock_relative")"
    if [[ "$dependency_lock_relative" == - ]]; then
      printf 'dependency_lock_sha256\t-\n'
      printf 'dependency_library_receipt_sha256\t-\n'
    else
      printf 'dependency_lock_sha256\t%s\n' \
        "$(sha256_file "$ROOT/$dependency_lock_relative")"
      printf 'dependency_library_receipt_sha256\t%s\n' \
        "$(sha256_file "$inputs/dependency-library-receipt/receipt.tsv")"
    fi
    if [[ "$dependency_mode" == data-table-overlay ]]; then
      printf 'dependency_overlay_archive_sha256\t%s\n' \
        "$(sha256_file "$inputs/data.table_${DATATABLE_VERSION}.tar.gz")"
      printf 'dependency_overlay_install_log_sha256\t%s\n' \
        "$(sha256_file "$logs/data.table-install.log")"
      printf 'dependency_overlay_version_log_sha256\t%s\n' \
        "$(sha256_file "$logs/data.table-version.tsv")"
    else
      printf 'dependency_overlay_archive_sha256\t-\n'
      printf 'dependency_overlay_install_log_sha256\t-\n'
      printf 'dependency_overlay_version_log_sha256\t-\n'
    fi
    printf 'bootstrap_receipt_sha256\t%s\n' "$(sha256_file "$inputs/bootstrap-receipt/receipt.tsv")"
    printf 'pre46_exclusion_manifest_sha256\t%s\n' \
      "$(sha256_file "$inputs/environment/runtime-matrix-pre46-exclusions.tsv")"
    printf 'whole_file_skip_manifest_sha256\t%s\n' \
      "$(sha256_file "$inputs/environment/runtime-matrix-whole-file-skips.tsv")"
    printf 'result_skip_manifest_sha256\t%s\n' \
      "$(sha256_file "$inputs/environment/runtime-matrix-result-skips.tsv")"
    printf 'test_scope_manifest_sha256\t%s\n' "$(sha256_file "$scope/scope.tsv")"
    printf 'testthat_reported_files_sha256\t%s\n' \
      "$(sha256_file "$scope/testthat-reported-files.tsv")"
    printf 'observed_whole_file_skips_sha256\t%s\n' \
      "$(sha256_file "$scope/observed-whole-file-skips.tsv")"
    printf 'observed_result_skips_sha256\t%s\n' \
      "$(sha256_file "$scope/observed-result-skips.tsv")"
    printf 'source_git_tar_sha256\t%s\n' "$source_git_tar_sha256"
    printf 'source_manifest_sha256\t%s\n' "$source_manifest_sha256"
    printf 'git_identity_sha256\t%s\n' "$git_identity_sha256"
    printf 'trusted_inputs_manifest_sha256\t%s\n' "$trusted_inputs_sha256"
    printf 'mbo_config_commit\t%s\n' "$mbo_config_commit"
    printf 'mbo_config_tree\t%s\n' "$mbo_config_tree"
    printf 'mbo_config_provenance_sha256\t%s\n' "$mbo_config_provenance_sha256"
    printf 'mbo_config_fixture_manifest_sha256\t%s\n' "$mbo_config_manifest_sha256"
    printf 'mbo_config_mixed_search_space_sha256\t%s\n' "$mbo_config_mixed_sha256"
    printf 'mbo_config_numeric_search_space_sha256\t%s\n' "$mbo_config_numeric_sha256"
    printf 'scheduler_resource_report_sha256\t%s\n' "$resource_report_sha256"
    printf 'scheduler_stage_tasks_sha256\t%s\n' "$stage_tasks_sha256"
    printf 'scheduler_wave_plan_sha256\t%s\n' "$wave_plan_sha256"
    printf 'scheduler_task_ledger_sha256\t%s\n' "$wave_task_ledger_sha256"
    printf 'scheduler_wave_manifest_sha256\t%s\n' "$wave_manifest_sha256"
    printf 'stage_worker_sha256\t%s\n' "$stage_worker_sha256"
    printf 'discovered_test_file_count\t%s\n' "$discovered_test_files"
    printf 'discovered_test_context_count\t%s\n' "$discovered_test_contexts"
    printf 'executed_test_file_count\t%s\n' "$executed_test_files"
    printf 'executed_test_context_count\t%s\n' "$executed_test_contexts"
    printf 'excluded_test_file_count\t%s\n' "$excluded_test_files"
    printf 'excluded_test_context_count\t%s\n' "$excluded_test_contexts"
    printf 'staged_test_support_file_count\t%s\n' "$staged_test_support_files"
    printf 'testthat_reported_file_count\t%s\n' "$reported_test_files"
    printf 'expected_whole_file_skip_count\t%s\n' "$expected_whole_file_skips"
    printf 'whole_file_skip_count\t%s\n' "$whole_file_skips"
    printf 'expected_result_test_block_skip_count\t%s\n' "$expected_result_skips"
    printf 'expectations_passed\t%s\n' "$expectations_passed"
    printf 'result_test_blocks_skipped\t%s\n' "$result_skips"
    printf 'total_test_skips\t%s\n' "$total_skips"
    printf 'old_r_stress_manifest_sha256\t%s\n' \
      "$old_stress_manifest_sha256"
    printf 'old_r_stress_selection_sha256\t%s\n' \
      "$old_stress_selection_sha256"
    printf 'old_r_stress_results_sha256\t%s\n' \
      "$old_stress_results_sha256"
    printf 'old_r_stress_reported_files_sha256\t%s\n' \
      "$old_stress_reported_files_sha256"
    printf 'old_r_stress_log_sha256\t%s\n' "$old_stress_log_sha256"
    printf 'old_r_stress_selected_file_count\t%s\n' \
      "$old_stress_selected_files"
    printf 'old_r_stress_selected_target_count\t%s\n' \
      "$old_stress_selected_targets"
    printf 'old_r_stress_test_block_count\t%s\n' \
      "$old_stress_test_blocks"
    printf 'old_r_stress_target_pass_count\t%s\n' \
      "$old_stress_target_passes"
    printf 'old_r_stress_non_target_skip_count\t%s\n' \
      "$old_stress_non_target_skips"
    printf 'old_r_stress_support_file_count\t%s\n' \
      "$old_stress_support_files"
    printf 'old_r_stress_expectations_passed\t%s\n' \
      "$old_stress_expectations_passed"
    printf 'declared_floor_lock_sha256\t%s\n' \
      "$declared_floor_lock_sha256"
    printf 'declared_floor_library_receipt_sha256\t%s\n' \
      "$declared_floor_library_receipt_sha256"
    printf 'declared_floor_install_log_sha256\t%s\n' \
      "$declared_floor_install_log_sha256"
    printf 'declared_floor_smoke_log_sha256\t%s\n' \
      "$declared_floor_smoke_log_sha256"
    printf 'declared_floor_candidate_dso_sha256\t%s\n' \
      "$declared_floor_candidate_dso_sha256"
    printf 'archive_sha256\t%s\n' "$(sha256_file "$archive")"
    printf 'candidate_dso_sha256\t%s\n' "$(sha256_file "$library/paradox/libs/paradox.so")"
    if [[ "$version" == 4.5.2 ]]; then
      printf 'r45_compiled_code_policy_sha256\t%s\n' \
        "$(sha256_file "$compiled_code_policy_log")"
    else
      printf 'r45_compiled_code_policy_sha256\t-\n'
    fi
    if [[ "$version" == 3.6.3 ]]; then
      printf 'declared_minimum_check_status_sha256\t%s\n' \
        "$(sha256_file "$logs/r-cmd-check-status.tsv")"
      printf 'declared_minimum_check_driver_sha256\t%s\n' \
        "$(sha256_file "$logs/r-cmd-check.log")"
      printf 'declared_minimum_check_log_sha256\t%s\n' \
        "$(sha256_file "$check/paradox.Rcheck/00check.log")"
    else
      printf 'declared_minimum_check_status_sha256\t-\n'
      printf 'declared_minimum_check_driver_sha256\t-\n'
      printf 'declared_minimum_check_log_sha256\t-\n'
    fi
    printf 'artifacts_manifest_sha256\t%s\n' "$(sha256_file "$metadata/artifacts.manifest.tsv")"
  } > "$metadata/run.tsv"
  seal_metadata "$metadata" run.tsv artifacts.manifest.tsv
done

((wave_status == 0)) ||
  fail "Runtime stage wave failed after every sibling result was retained"

"$GIT_HELPER" verify-ref "$ROOT" "$source_ref" "$source_commit" \
  "$source_tree" >/dev/null ||
  fail "Source ref or tree moved during the runtime-matrix run"

cross_serialization_status=not-applicable
cross_serialization_producer_runtime=-
cross_serialization_consumer_runtime=-
cross_serialization_seal_sha256=-
cross_serialization_driver_log_sha256=-
cross_serialization_driver_log="$run_root/metadata/cross-runtime-serialization-driver.log"
if [[ "$selection" == all ]]; then
  mapfile -t registered_versions < <("$REGISTRY" versions)
  [[ "${versions[*]}" == "${registered_versions[*]}" ]] ||
    fail "Complete cross-runtime serialization requires every registered runtime"
  verify_live_trusted_inputs
  cross_serialization_exit=0
  "$timeout_path" --signal=TERM --kill-after=10s \
    "$CROSS_SERIALIZATION_TIMEOUT_SECONDS" \
    "$CROSS_SERIALIZATION_WORKER" "$ROOT" "$run_root" \
    > "$cross_serialization_driver_log" 2>&1 ||
    cross_serialization_exit=$?
  if ((cross_serialization_exit != 0)); then
    fail "Cross-runtime serialization gate failed with status $cross_serialization_exit"
  fi
  verify_live_trusted_inputs
  grep -Fqx 'cross_runtime_serialization=passed' \
    "$cross_serialization_driver_log" ||
    fail "Cross-runtime serialization completion marker is absent"
  cross_serialization_metadata="$run_root/cross-runtime-serialization/metadata"
  [[ -f "$cross_serialization_metadata/completion.seal" &&
    ! -L "$cross_serialization_metadata/completion.seal" ]] ||
    fail "Cross-runtime serialization completion seal is absent"
  cross_serialization_status=passed
  cross_serialization_producer_runtime=4.0.5
  cross_serialization_consumer_runtime=3.6.3
  cross_serialization_seal_sha256=$(sha256_file \
    "$cross_serialization_metadata/completion.seal")
  cross_serialization_driver_log_sha256=$(sha256_file \
    "$cross_serialization_driver_log")
else
  [[ ! -e "$run_root/cross-runtime-serialization" &&
    ! -L "$run_root/cross-runtime-serialization" &&
    ! -e "$cross_serialization_driver_log" &&
    ! -L "$cross_serialization_driver_log" ]] ||
    fail "A partial matrix retained unexpected cross-runtime evidence"
fi

{
  printf 'runtime\tstage_seal_sha256\n'
  for version in "${versions[@]}"; do
    printf '%s\t%s\n' "$version" \
      "$(sha256_file "$run_root/R-$version/metadata/completion.seal")"
  done
} > "$run_root/metadata/stages.tsv"
{
  printf 'field\tvalue\nstatus\tpassed\nrun_id\t%s\nsource_ref\t%s\nsource_commit\t%s\nsource_tree\t%s\nstage_count\t%s\nruntime_jobs\t%s\nstage_timeout_seconds\t%s\nresource_report_sha256\t%s\nstage_tasks_sha256\t%s\nwave_plan_sha256\t%s\nwave_task_ledger_sha256\t%s\nwave_manifest_sha256\t%s\ntrusted_inputs_manifest_sha256\t%s\nmbo_config_commit\t%s\nmbo_config_tree\t%s\nmbo_config_provenance_sha256\t%s\nmbo_config_fixture_manifest_sha256\t%s\nmbo_config_mixed_search_space_sha256\t%s\nmbo_config_numeric_search_space_sha256\t%s\n' \
    "$run_id" "$source_ref" "$source_commit" "$source_tree" \
    "${#versions[@]}" "$runtime_jobs" "$STAGE_TIMEOUT_SECONDS" \
    "$resource_report_sha256" "$stage_tasks_sha256" "$wave_plan_sha256" \
    "$wave_task_ledger_sha256" "$wave_manifest_sha256" \
    "$trusted_inputs_sha256" \
    "$mbo_config_commit" "$mbo_config_tree" \
    "$mbo_config_provenance_sha256" "$mbo_config_manifest_sha256" \
    "$mbo_config_mixed_sha256" "$mbo_config_numeric_sha256"
  printf 'cross_runtime_serialization_status\t%s\n' \
    "$cross_serialization_status"
  printf 'cross_runtime_serialization_producer_runtime\t%s\n' \
    "$cross_serialization_producer_runtime"
  printf 'cross_runtime_serialization_consumer_runtime\t%s\n' \
    "$cross_serialization_consumer_runtime"
  printf 'cross_runtime_serialization_timeout_seconds\t%s\n' \
    "$CROSS_SERIALIZATION_TIMEOUT_SECONDS"
  printf 'cross_runtime_serialization_seal_sha256\t%s\n' \
    "$cross_serialization_seal_sha256"
  printf 'cross_runtime_serialization_driver_log_sha256\t%s\n' \
    "$cross_serialization_driver_log_sha256"
} > "$run_root/metadata/run.tsv"
(
  cd "$run_root/metadata"
  : > completion.inputs.tsv
  sha256sum run.tsv stages.tsv trusted-inputs.tsv resource-jobs.tsv stage-tasks.tsv \
    mbo-config-fixtures.log mbo-config-fixtures.manifest.tsv \
    stage-wave.manifest.tsv stage-wave/wave-plan.tsv \
    stage-wave/task-ledger.tsv >> completion.inputs.tsv
  for version in "${versions[@]}"; do
    sha256sum "../R-$version/metadata/completion.seal" >> completion.inputs.tsv
  done
  if [[ "$cross_serialization_status" == passed ]]; then
    sha256sum cross-runtime-serialization-driver.log \
      ../cross-runtime-serialization/metadata/completion.seal \
      >> completion.inputs.tsv
  fi
  printf '%s  completion.inputs.tsv\n' "$(sha256_file completion.inputs.tsv)" > completion.seal
)
"$ROOT/scripts/verify-runtime-matrix-evidence" --run-id "$run_id"
printf 'runtime_matrix=passed\nrun_id=%s\nsource_commit=%s\nsource_tree=%s\n' \
  "$run_id" "$source_commit" "$source_tree"
