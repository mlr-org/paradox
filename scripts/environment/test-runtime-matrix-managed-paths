prepare_bootstrap_fixture() {
  local root=$1 digest
  digest=$(printf '%064d' 0)
  mkdir -p -- "$root/scripts/environment" "$root/environment" \
    "$root/.local/runtime-matrix/receipts"
  cp -- "$BOOTSTRAP" "$root/scripts/bootstrap-runtime-matrix"
  chmod 0755 "$root/scripts/bootstrap-runtime-matrix"
  cat > "$root/scripts/environment/runtime-matrix-registry" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
runtime=9.8.7
case "${1:-}" in
  validate) exit 0 ;;
  versions) printf '%s\n' "$runtime" ;;
  contains) [[ "${2:-}" == "$runtime" ]] ;;
  field)
    [[ "${2:-}" == "$runtime" ]]
    case "${3:-}" in
      runtime_lock)
        printf '%s\n' environment/runtime-r-9.8.7-linux-64.lock
        ;;
      dependency_mode) printf '%s\n' prefix-library ;;
      prefix_repair) printf '%s\n' - ;;
      *) exit 1 ;;
    esac
    ;;
  *) exit 1 ;;
esac
EOF
  chmod 0755 "$root/scripts/environment/runtime-matrix-registry"
  for helper in runtime-matrix-library runtime-matrix-prefix-receipt \
      runtime-matrix-prefix-repair; do
    printf '#!/usr/bin/env bash\nexit 0\n' \
      > "$root/scripts/environment/$helper"
    chmod 0755 "$root/scripts/environment/$helper"
  done
  printf 'invisible(NULL)\n' \
    > "$root/scripts/environment/runtime-matrix-inventory.R"
  {
    printf '# platform: linux-64\n'
    printf '# runtime: R %s\n' "$RUNTIME"
    printf '@EXPLICIT\n'
    printf 'https://conda.anaconda.org/conda-forge/linux-64/r-base-%s-0.conda#%s\n' \
      "$RUNTIME" "$digest"
    for index in {1..49}; do
      printf 'https://conda.anaconda.org/conda-forge/linux-64/fixture-%s-0.conda#%s\n' \
        "$index" "$digest"
    done
  } > "$root/environment/runtime-r-$RUNTIME-linux-64.lock"
}

