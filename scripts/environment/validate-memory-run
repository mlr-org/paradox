  [[ "$validation_output" == \
      "resource_report_verified=$expected_profile" ]] ||
    fail "retained $expected_profile resource validation output differs"
}

verify_dso_receipt() {
  local mode=$1 dso="$MODES/$1/library/paradox/libs/paradox.so"
  local receipt="$MODES/$1/artifacts/paradox.so.sha256" hash
  require_regular "$dso"
  require_bounded_regular "$receipt" 1024
  hash=$(sha256 "$dso")
  [[ "$(<"$receipt")" == "$hash  paradox.so" ]] ||
    fail "$mode DSO receipt differs from the retained DSO"
  printf '%s' "$hash"
}

verify_probe_ledger() {
  local mode=$1 hash=$2 result="$MODES/$1/artifacts/native-probes.tsv"
  require_bounded_regular "$result" 16777216
  run_trusted_r "$TRUSTED_PROBE_VERIFIER" \
    "--manifest=$SOURCE/environment/native-routine-coverage.tsv" \
    "--result=$result" "--mode=$mode" \
    "--expected-dso-sha256=$hash" > "$SCRATCH/$mode-probes.log"
  [[ $(awk -F '\t' '$1 == "meta" && $2 == "rounds" && $3 == "pass" && $4 == "1" { n++ } END { print n + 0 }' "$result") -eq 1 ]] ||
    fail "$mode probe evidence did not retain exactly one round"
}

