  require_hash "$analyzed_dso_sha" "rchk analyzed DSO hash"
  [[ "$mounted_description_sha" == \
      "$(sha256 "$RCHK_DIRECTORY/work/source/DESCRIPTION")" &&
     "$mounted_description_sha" == "$(sha256 "$SOURCE/DESCRIPTION")" ]] ||
    fail "rchk mounted DESCRIPTION differs from the retained source"
  [[ "$analyzed_dso_sha" == "$(sha256 "$RCHK_REPORTS/analyzed-paradox.so")" ]] ||
    fail "rchk analyzed DSO receipt differs from the retained DSO"
  analyzed_bitcode_sha=$(awk 'NR == 1 { print $1 }' \
    "$RCHK_REPORTS/analyzed-bitcode.sha256")
