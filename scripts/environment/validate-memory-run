      fail "retained $analyzer process did not inherit the exact address-space limit"
    require_exact_lines "$RCHK_REPORTS/$analyzer-runtime.tsv" \
      $'key\tvalue' $'schema\t1' \
      "$(awk -F '\t' '$1 == "elapsed_seconds" && $2 ~ /^(0|[1-9][0-9]*)$/ { print $0 }' \
        "$RCHK_REPORTS/$analyzer-runtime.tsv")" \
      $'exit_status\t0'
  done
  require_regular "$RCHK_DIRECTORY/artifacts/auxiliary-images.tsv"
  cmp -s "$RCHK_DIRECTORY/artifacts/auxiliary-images.tsv" \
    "$SOURCE/environment/auxiliary-images.tsv" ||
    fail "rchk auxiliary-image manifest differs from the frozen source"
  rchk_manifest_row=$(awk -F '\t' '$1 == "rchk" { print }' \
    "$RCHK_DIRECTORY/artifacts/auxiliary-images.tsv")
  [[ $(awk -F '\t' '$1 == "rchk" { n++ } END { print n + 0 }' \
    "$RCHK_DIRECTORY/artifacts/auxiliary-images.tsv") -eq 1 ]] ||
    fail "rchk image manifest row inventory differs"
  IFS=$'\t' read -r purpose image digest source_commit resolved_utc extra \
    <<< "$rchk_manifest_row"
  [[ -z "${extra:-}" && "$purpose" == rchk &&
     "$image" == ghcr.io/r-hub/containers/rchk &&
     "$digest" =~ ^sha256:[0-9a-f]{64}$ &&
     "$source_commit" =~ ^[0-9a-f]{40}$ &&
     "$resolved_utc" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
    fail "rchk image manifest row is malformed"
  # Populated and consumed through namerefs.
  # shellcheck disable=SC2034
  declare -A image_fields=()
  # shellcheck disable=SC2034
  declare -a image_order=()
  read_fields "$RCHK_DIRECTORY/artifacts/image.txt" image_fields image_order
  require_order image_order purpose reference source_commit resolved_utc
  require_value image_fields purpose rchk
  require_value image_fields reference "$image@$digest"
  require_value image_fields source_commit "$source_commit"
  require_value image_fields resolved_utc "$resolved_utc"
  grep -F "$digest" "$RCHK_DIRECTORY/artifacts/image-digest-evidence.txt" \
    >/dev/null || fail "rchk image inspection evidence lacks the pinned digest"
fi

printf 'memory_run_verified=%s\n' "$RUN_ID"
printf 'selected_modes=%s\n' "$(for mode in gct valgrind rchk; do
  [[ "${run_fields[$mode]}" == true ]] && printf '%s,' "$mode"
done | sed 's/,$//')"
printf 'validator_sha256=%s\n' "$(sha256 "${BASH_SOURCE[0]}")"
printf 'candidate_code_executed=false\n'
