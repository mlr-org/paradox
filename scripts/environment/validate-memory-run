validate_valgrind_receipts() {
  local base="$MODES/valgrind/artifacts/prerequisite-receipts"
  [[ -d "$base/R-4.6.1" && ! -L "$base/R-4.6.1" &&
     -d "$base/library" && ! -L "$base/library" ]] ||
    fail "retained Valgrind receipt directories are absent or symbolic"
  validate_relative_hash_list "$base/receipt-files.sha256" "$base" \
    R-4.6.1/inputs.tsv R-4.6.1/source-tree.tsv \
    R-4.6.1/toolchain-tree.tsv R-4.6.1/installed-tree.tsv \
    R-4.6.1/seal.tsv library/inputs.tsv library/package-manifest.tsv \
    library/installed-tree.tsv library/seal.tsv
  validate_key_hash_seal "$base/R-4.6.1/seal.tsv" \
    "inputs_sha256:$base/R-4.6.1/inputs.tsv" \
    "source_tree_sha256:$base/R-4.6.1/source-tree.tsv" \
    "toolchain_tree_sha256:$base/R-4.6.1/toolchain-tree.tsv" \
    "installed_tree_sha256:$base/R-4.6.1/installed-tree.tsv"
  validate_key_hash_seal "$base/library/seal.tsv" \
    "inputs_sha256:$base/library/inputs.tsv" \
    "package_manifest_sha256:$base/library/package-manifest.tsv" \
    "installed_tree_sha256:$base/library/installed-tree.tsv"
  grep -Fx $'schema\t2' "$base/R-4.6.1/inputs.tsv" >/dev/null ||
    fail "retained instrumented-R receipt is not schema 2"
  grep -Fx $'kind\tinstrumented-r' "$base/R-4.6.1/inputs.tsv" >/dev/null ||
    fail "retained instrumented-R receipt kind differs"
  grep -Fx $'prefix\t'"$ROOT/.local/r-valgrind/4.6.1" \
    "$base/R-4.6.1/inputs.tsv" >/dev/null ||
    fail "retained instrumented-R receipt prefix differs"
  grep -Fx $'schema\t2' "$base/library/inputs.tsv" >/dev/null ||
    fail "retained instrumented-library receipt is not schema 2"
  grep -Fx $'kind\tinstrumented-r-package-library' \
    "$base/library/inputs.tsv" >/dev/null ||
    fail "retained instrumented-library receipt kind differs"
  grep -Fx $'library\t'"$ROOT/.local/r-valgrind/library" \
    "$base/library/inputs.tsv" >/dev/null ||
    fail "retained instrumented-library receipt path differs"
  local r_seal_hash package_manifest_hash package_count
  r_seal_hash=$(sha256 "$base/R-4.6.1/seal.tsv")
  [[ $(awk -F '\t' '$1 == "r_receipt_seal_sha256" { print $2 }' \
    "$base/library/inputs.tsv") == "$r_seal_hash" ]] ||
    fail "instrumented-library receipt does not bind the R receipt seal"
  package_manifest_hash=$(sha256 "$base/library/package-manifest.tsv")
  [[ $(awk -F '\t' '$1 == "package_manifest_sha256" { print $2 }' \
    "$base/library/inputs.tsv") == "$package_manifest_hash" ]] ||
    fail "instrumented-library input does not bind its package manifest"
  package_count=$(awk -F '\t' 'NR > 1 { n++ } END { print n + 0 }' \
    "$base/library/package-manifest.tsv")
  [[ $(awk -F '\t' '$1 == "package_count" { print $2 }' \
    "$base/library/inputs.tsv") == "$package_count" ]] ||
    fail "instrumented-library package count differs"
  cmp -s "$base/library/package-manifest.tsv" \
    "$MODES/valgrind/artifacts/valgrind-r-packages.tsv" ||
    fail "retained package receipt differs from the consumed package manifest"
}

if [[ "${run_fields[valgrind]}" == true ]]; then
  require_exact_lines "$MODES/valgrind/artifacts/scope.txt" \
    'mode=valgrind' \
    'r_executable=separate unoptimized repository-local R 4.6.1' \
    'instrumentation=--with-valgrind-instrumentation=2' \
    'blas=R reference BLAS (validated as project-local libRblas)' \
    'source_archive=sealed archive reused from the frozen native run' \
    'coverage=every registered routine plus four reviewed allocation/callback hazards' \
    'rounds=1' \
    'analyzer_subset=8 exact reviewed files; exact block and expectation accounting is bound by the trusted ledger' \
    'NOT_CRAN=false (eight exact reviewed expensive scopes skipped)' \
    'full_functional_tests=false (owned by the frozen native run)' \
    'examples_vignettes_manual=false (documentation and policy are separate gates)' \
    'configuration=stage wrapper passes exact CLI options with --command-line-only=yes' \
    'VALGRIND_OPTS=empty' \
    'leak_detail=definite,indirect,possible; full summary retained' \
    'read_var_info=false (avoids non-actionable DWARF parser warnings)' \
    'child_silent_after_fork=true (rejects header-only fork-child logs)' \
    'resource_admission=serial valgrind profile with 16384 MiB working-set allowance and at least 16384 MiB host reserve' \
    "extra_debuginfo_path=$ROOT/.local/debug/libc6-dbg-2.31-0ubuntu9.18"
  validate_serial_resource_report \
    "$MODES/valgrind/artifacts/resource-jobs.tsv" valgrind
  valgrind_dso_sha=$(verify_dso_receipt valgrind)
  verify_probe_ledger valgrind "$valgrind_dso_sha"
  VALGRIND_LEDGER="$MODES/valgrind/artifacts/native-tests-analyzer.tsv"
  require_bounded_regular "$VALGRIND_LEDGER" 67108864
  run_trusted_r "$TRUSTED_TEST_VERIFIER" \
    "--source=$SOURCE" "--ledger=$VALGRIND_LEDGER" --selection=analyzer \
    "--expected-dso-sha256=$valgrind_dso_sha" \
    > "$SCRATCH/valgrind-analyzer-ledger.log"

  # Four independent log families can be scanned in parallel without loading
  # the candidate.  The trusted helper requires exact suppressed-zero terminal
  # summaries and complete heap/leak summaries in every retained process log.
  valgrind_pids=()
  for stem in valgrind-smoke valgrind-baseline valgrind-probes valgrind-analyzer; do
    mkdir "$SCRATCH/$stem"
    start_background "$SCRATCH/$stem/output.log" \
      env -i "HOME=$SCRATCH/$stem" "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
      "PATH=/usr/bin:/bin" "LC_ALL=C.UTF-8" "TZ=UTC" \
      "$TRUSTED_MEMORY_EVIDENCE" valgrind "$MODES/valgrind/logs" "$stem" \
      "$SCRATCH/$stem/diagnostics.txt"
    valgrind_pids+=("$LAST_BACKGROUND_PID")
  done
  valgrind_scan_status=0
  for pid in "${valgrind_pids[@]}"; do
    wait "$pid" || valgrind_scan_status=1
  done
  ACTIVE_CHILD_GROUPS=()
  if [[ "$valgrind_scan_status" -ne 0 ]]; then
    find "$SCRATCH" -path '*/valgrind-*/output.log' -type f -exec cat {} + >&2 || true
    fail "retained Valgrind logs failed trusted zero-error replay"
  fi
  require_exact_lines "$MODES/valgrind/logs/valgrind-version.log" \
    'valgrind-3.27.1'
  while IFS= read -r valgrind_log; do
    valgrind_name=$(basename "$valgrind_log")
    [[ "$valgrind_name" == valgrind-version.log ]] && continue
    [[ "$valgrind_name" =~ ^valgrind-(smoke|baseline|probes|analyzer)\.[0-9]+\.log$ ]] ||
      fail "unexpected Valgrind process-log family: $valgrind_name"
  done < <(find "$MODES/valgrind/logs" -maxdepth 1 -type f \
    -name 'valgrind-*.log' -print)

  require_regular "$MODES/valgrind/artifacts/instrumented-R-configuration.txt"
  require_regular "$MODES/valgrind/artifacts/instrumented-R-fingerprint.txt"
  grep -q -- '--with-valgrind-instrumentation=2' \
    "$MODES/valgrind/artifacts/instrumented-R-configuration.txt" ||
    fail "retained R configuration lacks Valgrind instrumentation level 2"
  if grep -q -- '--with-blas' \
      "$MODES/valgrind/artifacts/instrumented-R-configuration.txt"; then
    fail "retained R configuration selected an external BLAS"
  fi
  [[ "$(<"$MODES/valgrind/artifacts/instrumented-R-fingerprint.txt")" == \
    "$(sha256 "$MODES/valgrind/artifacts/instrumented-R-configuration.txt")" ]] ||
    fail "retained instrumented-R build fingerprint differs"
  validate_relative_hash_list \
    "$MODES/valgrind/artifacts/valgrind-wrappers/wrappers.sha256" \
    "$MODES/valgrind/artifacts/valgrind-wrappers" \
    smoke/valgrind baseline/valgrind probes/valgrind analyzer/valgrind
  validate_valgrind_receipts
  validate_relative_hash_list \
    "$MODES/valgrind/artifacts/debug-symbol-receipt/seal.sha256" \
    "$MODES/valgrind/artifacts/debug-symbol-receipt" \
    inputs.tsv installed-tree.tsv

  VALGRIND_METADATA="$MODES/valgrind/artifacts/prerequisite-metadata"
  VALGRIND_METADATA_LEDGER="$VALGRIND_METADATA/metadata-ledger.tsv"
  require_hash "${completion_fields[valgrind_prerequisite_metadata_ledger_sha256]}" \
    valgrind_prerequisite_metadata_ledger_sha256
  [[ "${completion_fields[valgrind_prerequisite_metadata_ledger_sha256]}" == \
    "$(sha256 "$VALGRIND_METADATA_LEDGER")" ]] ||
    fail "completion does not bind the Valgrind prerequisite metadata ledger"
  validate_metadata_ledger "$VALGRIND_METADATA_LEDGER" "$VALGRIND_METADATA" \
    valgrind start post-before post-after
else
  require_value completion_fields valgrind_prerequisite_metadata_ledger_sha256 absent
fi

if [[ "${run_fields[valgrind]}" == true ]]; then
  shopt -s nullglob
  source_archives=("$ARTIFACTS/source-package/build/"paradox_*.tar.gz)
  shopt -u nullglob
  [[ ${#source_archives[@]} -eq 1 && -f "${source_archives[0]}" &&
