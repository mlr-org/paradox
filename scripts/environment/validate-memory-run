  require_exact_lines "$SCRATCH/rchk-policy-directory.log" \
    'rchk_policy_directory=matched' \
    'rchk_policy_files=3'
  require_exact_lines "$RCHK_DIRECTORY/artifacts/scope.txt" \
    'mode=rchk' \
    "$(sed -n 's/^reference=/image=/p' "$RCHK_DIRECTORY/artifacts/image.txt")" \
    'network=none' \
    'container_pull=never' \
    'source=verified snapshot copied to a writable run-local tree' \
    'tools=source-pinned bounded bcheck,image-pinned maacheck,image-pinned fficheck' \
    'bcheck_state_budget=800000' \
    'analyzer_address_space_limit_bytes=21474836480' \
    'resource_admission=serial rchk profile with 20480 MiB analyzer budget and at least 16384 MiB reserve' \
    'fatal_diagnostics=all package ERROR: and every report change outside the source-bound reviewed bcheck policy' \
    'required_registration_calls=1' \
    'required_analyzed_functions=positive' \
    'host_container_state=scripts/podman-local repository-local vfs store'
  for bounded_input in \
      scripts/prepare-bounded-rchk-bcheck \
      scripts/environment/build-bounded-rchk-bcheck \
      environment/rchk-bounded-bcheck.tsv \
      environment/rchk-bounded-bcheck-command.tsv \
      environment/rchk-bounded-bcheck-environment.tsv \
      environment/rchk-bounded-bcheck-tool-identity.tsv; do
    require_regular "$SOURCE/$bounded_input"
    cmp -s "$SOURCE/$bounded_input" "$ROOT/$bounded_input" ||
      fail "retained bounded-rchk input differs from the trusted current copy: $bounded_input"
  done

  RCHK_CACHE_PARENT="$RCHK_DIRECTORY/artifacts/bounded-bcheck-cache"
  [[ -d "$RCHK_CACHE_PARENT" && ! -L "$RCHK_CACHE_PARENT" ]] ||
    fail "retained bounded-rchk cache parent is absent or symbolic"
  mapfile -t rchk_cache_entries < <(
    find "$RCHK_CACHE_PARENT" -mindepth 1 -maxdepth 1 \
      -printf '%f\t%y\n' | sort
  )
  rchk_cache_entry_pattern=$'^([0-9a-f]{64})\td$'
  [[ ${#rchk_cache_entries[@]} -eq 1 &&
     "${rchk_cache_entries[0]}" =~ $rchk_cache_entry_pattern ]] ||
    fail "retained bounded-rchk cache has an unexpected entry inventory"
  rchk_cache_key=${BASH_REMATCH[1]}
  RCHK_CACHE_ENTRY="$RCHK_CACHE_PARENT/$rchk_cache_key"
  mkdir "$SCRATCH/rchk-cache-home"
  env -i "HOME=$SCRATCH/rchk-cache-home" "USER=$LOCAL_USER" \
    "LOGNAME=$LOCAL_USER" \
    "PATH=$ROOT/.local/toolchain/bin:/usr/bin:/bin" \
    "LD_LIBRARY_PATH=$ROOT/.local/toolchain/lib" \
    "CONDA_PREFIX=$ROOT/.local/toolchain" "PARADOX_ACTIVE_ROOT=$ROOT" \
    "R_ENVIRON_USER=/dev/null" "R_PROFILE_USER=/dev/null" \
    "R_MAKEVARS_USER=/dev/null" "R_HISTFILE=/dev/null" \
    "TMPDIR=$SCRATCH" "LC_ALL=C.UTF-8" "TZ=UTC" \
    "$TRUSTED_BOUNDED_RCHK_PREPARER" --verify-entry "$RCHK_CACHE_ENTRY" \
    > "$SCRATCH/rchk-cache-verify.log"
  require_exact_lines "$SCRATCH/rchk-cache-verify.log" \
    "cache_directory=$RCHK_CACHE_ENTRY" \
    "bcheck=$RCHK_CACHE_ENTRY/payload/bin/bcheck"

  RCHK_RESOURCE_REPORT="$RCHK_DIRECTORY/artifacts/resource-jobs.tsv"
  validate_serial_resource_report "$RCHK_RESOURCE_REPORT" rchk

  mkdir "$SCRATCH/rchk"
  env -i "HOME=$SCRATCH/rchk" "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
    "PATH=/usr/bin:/bin" "LC_ALL=C.UTF-8" "TZ=UTC" \
    "$TRUSTED_MEMORY_EVIDENCE" rchk "$RCHK_REPORTS" \
    "$RCHK_DIRECTORY/logs/rchk.log" "$SCRATCH/rchk/artifacts" \
    "$SOURCE/environment/rchk-bcheck-policy" \
    > "$SCRATCH/rchk/output.log"
  for report_input in mounted-description.sha256 analyzed-dso.sha256 \
      analyzed-bitcode.sha256 analyzed-paradox.so analyzed-paradox.so.bc \
      analyzer-identity.tsv tool-status.tsv Makevars.rchk install.log \
      bcheck-process-limits.txt bcheck-runtime.tsv \
      maacheck-process-limits.txt maacheck-runtime.tsv \
      fficheck-process-limits.txt fficheck-runtime.tsv; do
    require_regular "$RCHK_REPORTS/$report_input"
  done
  mounted_description_sha=$(awk 'NR == 1 { print $1 }' \
