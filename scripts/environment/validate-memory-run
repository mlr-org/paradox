  [[ "$analyzed_bitcode_sha" == \
     "$(sha256 "$RCHK_REPORTS/analyzed-paradox.so.bc")" ]] ||
    fail "rchk analyzed bitcode receipt differs from the retained bitcode"
  bounded_bcheck_sha=$(awk -F '\t' \
    '$1 == "bounded_bcheck_sha256" { print $2 }' \
    "$RCHK_REPORTS/analyzer-identity.tsv")
