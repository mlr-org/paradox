{
  awk -F '\t' '{print "required\t" $0}' "$stage_required"
  awk -F '\t' '{print "forbidden\t" $0}' "$stage_forbidden"
} | awk -F '\t' '
  {
    count[$1 SUBSEP $2 SUBSEP $3]++
  }
  function exact(symbol, version, is_required, required_count, forbidden_count) {
    required_count = count["required" SUBSEP version SUBSEP symbol]
    forbidden_count = count["forbidden" SUBSEP version SUBSEP symbol]
    return is_required ?
      required_count == 1 && forbidden_count == 0 :
      required_count == 0 && forbidden_count == 1
  }
  END {
    split("3.6.3 4.0.5 4.3.3 4.5.2", versions, " ")
    for (version_index = 1; version_index <= 4; version_index++) {
      version = versions[version_index]
      if (!exact("R_getVar", version, 0) ||
          !exact("Rf_GetOption1", version, version_index == 4) ||
          !exact("ANY_ATTRIB", version, version_index == 4) ||
          !exact("FORMALS", version, version_index <= 3) ||
          !exact("R_HasFancyBindings", version, version_index <= 2) ||
          !exact("R_ActiveBindingFunction", version, version_index >= 2) ||
          !exact("R_existsVarInFrame", version, version_index >= 3) ||
          !exact("SET_COMPLEX_ELT", version, version_index >= 3) ||
          !exact("SET_RAW_ELT", version, version_index >= 3) ||
          !exact("R_PromiseExpr", version, version_index <= 3) ||
          !exact("PRENV", version, version_index <= 3) ||
          !exact("PRVALUE", version, version_index <= 3)) {
        exit 1
      }
    }
  }
' || {
  echo "Runtime R-API symbol transition policy is incomplete" >&2
  rm -f -- "$stage_required" "$verifier_required" \
    "$stage_forbidden" "$verifier_forbidden"
  exit 1
