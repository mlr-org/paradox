cmp -s "$stage_forbidden" "$verifier_forbidden" || {
  echo "Runtime producer/verifier forbidden-symbol policies differ" >&2
  rm -f -- "$stage_required" "$verifier_required" \
    "$stage_forbidden" "$verifier_forbidden"
