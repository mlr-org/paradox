extract_runtime_symbols() {
  awk -v selector="$2" '
    $0 ~ /"\$version" == [0-9]+\.[0-9]+\.[0-9]+/ {
      version = $0
      sub(/^.*== /, "", version)
      sub(/ .*/, "", version)
    }
    index($0, selector "=(") {
      capture = 1
    }
    capture {
      line = $0
      start = index(line, selector "=(")
      if (start) {
        line = substr(line, start + length(selector) + 2)
      }
      closed = index(line, ")") != 0
      sub(/\).*/, "", line)
      count = split(line, fields, /[[:space:]]+/)
      for (field_index = 1; field_index <= count; field_index++) {
        if (fields[field_index] ~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
          print version "\t" fields[field_index]
        }
      }
      if (closed) capture = 0
    }
  ' "$1"
}
