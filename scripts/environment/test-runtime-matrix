#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
scripts=(
  scripts/bootstrap-runtime-matrix
  scripts/activate-runtime-matrix
  scripts/test-runtime-matrix
  scripts/verify-runtime-matrix-evidence
  scripts/environment/runtime-matrix-prefix-receipt
  scripts/environment/runtime-matrix-prefix-handoff
  scripts/environment/runtime-matrix-prefix-repair
  scripts/environment/runtime-matrix-registry
  scripts/environment/runtime-matrix-trusted-inputs
  scripts/environment/runtime-matrix-managed-path
  scripts/environment/runtime-matrix-library
  scripts/environment/runtime-matrix-git
  scripts/environment/mbo-config-fixtures
  scripts/environment/run-runtime-matrix-stage
  scripts/environment/run-runtime-matrix-wave
  scripts/environment/test-runtime-matrix
  scripts/environment/test-runtime-matrix-managed-paths
  scripts/environment/test-runtime-matrix-installed
)
for script in "${scripts[@]}"; do
  bash -n "$ROOT/$script"
done
if rg -q '^BUILD=' "$ROOT/scripts/environment/run-runtime-matrix-stage"; then
  echo "Runtime stage reuses activation's BUILD compiler-triplet variable" >&2
  exit 1
fi

"$ROOT/scripts/bootstrap-runtime-matrix" --help >/dev/null
"$ROOT/scripts/test-runtime-matrix" --help >/dev/null
"$ROOT/scripts/verify-runtime-matrix-evidence" --help >/dev/null
"$ROOT/scripts/bootstrap-runtime-matrix" --verify-locks >/dev/null
registry="$ROOT/scripts/environment/runtime-matrix-registry"
"$registry" validate >/dev/null
mapfile -t registered_runtimes < <("$registry" versions)
[[ ${#registered_runtimes[@]} -eq 4 &&
  "${registered_runtimes[*]}" == "3.6.3 4.0.5 4.3.3 4.5.2" ]] || {
  echo "Runtime registry differs from the reviewed compatibility axes" >&2
  exit 1
}
trusted_input_helper="$ROOT/scripts/environment/runtime-matrix-trusted-inputs"
mapfile -t trusted_inputs < <("$trusted_input_helper")
[[ ${#trusted_inputs[@]} -eq \
    "$(printf '%s\n' "${trusted_inputs[@]}" | LC_ALL=C sort -u | wc -l)" ]] ||
  {
    echo "Runtime trusted-input policy contains a duplicate" >&2
    exit 1
  }
for required_trusted_input in \
    scripts/environment/runtime-matrix-prefix-repair \
    scripts/environment/runtime-matrix-prefix-handoff \
    scripts/environment/runtime-matrix-managed-path \
    environment/r-packages-linux-64.lock \
    environment/runtime-r-3.6.3-prefix-repair.lock \
    environment/runtime-r-4.0.5-linux-64.lock \
    environment/runtime-r-4.0.5-packages.lock; do
  [[ " ${trusted_inputs[*]} " == *" $required_trusted_input "* ]] || {
    echo "Runtime trusted-input policy omits $required_trusted_input" >&2
    exit 1
  }
done

exclusions="$ROOT/environment/runtime-matrix-pre46-exclusions.tsv"
whole_skips="$ROOT/environment/runtime-matrix-whole-file-skips.tsv"
result_skips="$ROOT/environment/runtime-matrix-result-skips.tsv"
for manifest in "$exclusions" "$whole_skips" "$result_skips"; do
  [[ -f "$manifest" && ! -L "$manifest" ]] || {
    echo "Runtime source-scope manifest is absent or symbolic: $manifest" >&2
    exit 1
  }
done
awk -F '\t' '
  NR == 1 {if ($0 != "context\treason") exit 1; next}
  NF != 2 || $1 !~ /^native-[a-z0-9][a-z0-9-]*$/ || $2 == "" || seen[$1]++ {exit 1}
  END {if (NR != 1) exit 1}
' "$exclusions"
expected_exclusions=()
mapfile -t actual_exclusions < <(tail -n +2 "$exclusions" | cut -f 1)
[[ "${actual_exclusions[*]}" == "${expected_exclusions[*]}" ]] || {
  echo "Runtime pre-R-4.6 exclusion policy differs from the reviewed contexts" >&2
  exit 1
}
for context in "${actual_exclusions[@]}"; do
  test_file="$ROOT/tests/testthat/test-$context.R"
  [[ -f "$test_file" && ! -L "$test_file" ]] || {
    echo "Runtime exclusion names an absent or symbolic test: $context" >&2
    exit 1
  }
done
awk -F '\t' '
  NR == 1 {
    if ($0 != "file\tcontext\tmissing_package\tleading_guards\treason") exit 1
    next
  }
  NF != 5 || $1 !~ /^test[-_][A-Za-z0-9_-]+[.]R$/ ||
    $2 == "" || $3 !~ /^[A-Za-z][A-Za-z0-9.]*$/ ||
    $4 !~ /^[A-Za-z0-9_:.,-]+$/ || $5 == "" || seen[$1]++ {exit 1}
  END {if (NR != 3) exit 1}
' "$whole_skips"
mapfile -t actual_whole_skips < <(tail -n +2 "$whole_skips" | cut -f 1)
expected_whole_skips=(test_paramset_to_configspace.R test_paramset_to_configspace_old.R)
[[ "${actual_whole_skips[*]}" == "${expected_whole_skips[*]}" ]] || {
  echo "Runtime whole-file skip policy differs from the reviewed files" >&2
  exit 1
}
for test_name in "${actual_whole_skips[@]}"; do
  [[ -f "$ROOT/tests/testthat/$test_name" && ! -L "$ROOT/tests/testthat/$test_name" ]] || {
    echo "Runtime whole-file skip names an absent or symbolic test: $test_name" >&2
    exit 1
  }
done
[[ $(awk -F '\t' 'NR == 2 {print $4}' "$whole_skips") == \
    skip_if_not_installed:reticulate,skip_on_cran &&
  $(awk -F '\t' 'NR == 3 {print $4}' "$whole_skips") == \
    skip_if_not_installed:callr,skip_if_not_installed:reticulate,skip_on_cran ]] || {
  echo "Runtime whole-file leading-guard policy differs from review" >&2
  exit 1
}
awk -F '\t' '
  NR == 1 {if ($0 != "runtime\tfile\ttest\treason") exit 1; next}
  NF != 4 || $1 !~ /^(3[.]6[.]3|4[.]0[.]5|4[.]3[.]3|4[.]5[.]2)$/ ||
    $2 !~ /^test[-_][A-Za-z0-9_-]+[.]R$/ || $3 == "" ||
    ($4 != "Reason: On CRAN" &&
      $4 != "Reason: R < 4.0 cannot safely inspect active-binding functions" &&
      $4 != "Reason: R < 4.3 cannot construct list ALTREP test fixtures") ||
    seen[$1 FS $2 FS $3]++ {exit 1}
  $4 == "Reason: On CRAN" {count[$1]++}
  $4 == "Reason: R < 4.0 cannot safely inspect active-binding functions" {
    active[$1]++
  }
  $4 == "Reason: R < 4.3 cannot construct list ALTREP test fixtures" {
    list_altrep[$1]++
  }
  END {
    if (count["3.6.3"] != count["4.0.5"] ||
        count["4.0.5"] != count["4.3.3"] ||
        count["4.3.3"] != count["4.5.2"] ||
        active["3.6.3"] != 19 ||
        list_altrep["3.6.3"] != 14 || list_altrep["4.0.5"] != 14 ||
        active["4.0.5"] || active["4.3.3"] || active["4.5.2"] ||
        list_altrep["4.3.3"] || list_altrep["4.5.2"]) exit 1
  }
' "$result_skips"
diff -u \
  <(awk -F '\t' '$1 == "3.6.3" && $4 == "Reason: On CRAN" {print $2 "\t" $3 "\t" $4}' "$result_skips") \
  <(awk -F '\t' '$1 == "4.0.5" && $4 == "Reason: On CRAN" {print $2 "\t" $3 "\t" $4}' "$result_skips") \
  >/dev/null || {
  echo "Runtime result-skip baseline inventories differ between R 3.6 and R 4.0" >&2
  exit 1
}
diff -u \
  <(awk -F '\t' '$1 == "4.0.5" && $4 == "Reason: On CRAN" {print $2 "\t" $3 "\t" $4}' "$result_skips") \
  <(awk -F '\t' '$1 == "4.3.3" && $4 == "Reason: On CRAN" {print $2 "\t" $3 "\t" $4}' "$result_skips") \
  >/dev/null || {
  echo "Runtime result-skip baseline inventories differ between R 4.0 and R 4.3" >&2
  exit 1
}
diff -u \
  <(awk -F '\t' '$1 == "4.3.3" {print $2 "\t" $3 "\t" $4}' "$result_skips") \
  <(awk -F '\t' '$1 == "4.5.2" {print $2 "\t" $3 "\t" $4}' "$result_skips") \
  >/dev/null || {
  echo "Runtime result-skip inventories differ between runtimes" >&2
  exit 1
}
diff -u <(tail -n +2 "$result_skips") \
  <(tail -n +2 "$result_skips" | LC_ALL=C sort) >/dev/null || {
  echo "Runtime result-skip manifest is not byte-sorted" >&2
  exit 1
}
while IFS=$'\t' read -r runtime test_name _; do
  [[ "$runtime" == runtime ]] && continue
  [[ -f "$ROOT/tests/testthat/$test_name" && ! -L "$ROOT/tests/testthat/$test_name" ]] || {
    echo "Runtime result skip names an absent or symbolic test: $test_name" >&2
    exit 1
  }
done < "$result_skips"
[[ -z $(find "$ROOT/tests/testthat" -mindepth 1 -maxdepth 1 \
    ! -type f ! -type d -print -quit) &&
  $(find "$ROOT/tests/testthat" -maxdepth 1 -type f \
    \( -name 'test*.R' -o -name 'test*.r' \) | wc -l) -gt 0 ]] || {
  echo "Runtime source-test inventory is empty or contains a non-regular input" >&2
  exit 1
}
rg -q 'Sys.setenv\(NOT_CRAN = "false"\)' \
  "$ROOT/scripts/environment/run-runtime-matrix-tests.R"
rg -q 'PARADOX_MBO_CONFIG_ROOT is required by the complete runtime suite' \
  "$ROOT/scripts/environment/run-runtime-matrix-tests.R"
rg -Fq 'NOT_CRAN=false PARADOX_MBO_CONFIG_ROOT="$MBO_CONFIG_FIXTURE_ROOT"' \
  "$ROOT/scripts/environment/run-runtime-matrix-stage"
rg -Fq 'verify_mbo_config_evidence "$top_metadata"' \
  "$ROOT/scripts/verify-runtime-matrix-evidence"
rg -Fq '"$MBO_CONFIG_FIXTURE_HELPER" stage "$SOURCE_DIRECTORY"' \
  "$ROOT/scripts/native-check"
if rg -q 'MBO_CONFIG_CHECKOUT/common|git -C "[$]MBO_CONFIG_CHECKOUT"' \
    "$ROOT/scripts/native-check"; then
  echo "Native verification retains a second worktree-based mbo_config authority" >&2
  exit 1
fi
if rg -q 'minimum_expectations_required|4900L else 6000L|\b(79|57|22|55)\b' \
    "$ROOT/scripts/environment/run-runtime-matrix-tests.R" \
    "$ROOT/scripts/verify-runtime-matrix-evidence"; then
  echo "Runtime verification retains an obsolete count floor" >&2
  exit 1
fi
if rg -q 'pre-4.5-evaluated-public-fallback|authenticated-r-fallback' \
    "$ROOT/scripts/environment/runtime-matrix-probe.R" \
    "$ROOT/scripts/environment/run-runtime-matrix-stage" \
    "$ROOT/scripts/verify-runtime-matrix-evidence"; then
  echo "Runtime verification retains the deleted R-evaluation shim contract" >&2
  exit 1
fi
for symbol_policy in \
    "$ROOT/scripts/environment/run-runtime-matrix-stage" \
    "$ROOT/scripts/verify-runtime-matrix-evidence"; do
  rg -Fq 'required=(Rf_eval ATTRIB FORMALS R_ClosureExpr Rf_findVarInFrame' \
    "$symbol_policy"
  rg -Fq 'R_ActiveBindingFunction)' "$symbol_policy"
  rg -Fq 'required=(Rf_eval ATTRIB FORMALS Rf_findVarInFrame' \
    "$symbol_policy"
  rg -Fq 'required=(Rf_eval ATTRIB R_ClosureFormals R_ClosureExpr R_ClosureEnv' \
    "$symbol_policy"
done
[[ "$("$registry" field 4.3.3 api_branch)" == \
    pre-4.5-documented-public-backports ]]
[[ "$("$registry" field 4.0.5 api_branch)" == \
    r-4.0-active-binding-pre-4.2-compatibility ]]
rg -Fq 'branch=$("$REGISTRY" field "$version" api_branch)' \
  "$ROOT/scripts/environment/run-runtime-matrix-stage"
rg -Fq 'public_api_compatibility_policy=documented-versioned-accessors' \
  "$ROOT/scripts/environment/runtime-matrix-probe.R"
rg -Fq 'verify_package_cache' \
  "$ROOT/scripts/environment/runtime-matrix-library"
rg -Fq -- '--silent --show-error' \
  "$ROOT/scripts/environment/runtime-matrix-library"
for prefix_handoff_consumer in \
    "$ROOT/scripts/test-runtime-matrix" \
    "$ROOT/scripts/verify-runtime-matrix-evidence"; do
  rg -Fq '"$PREFIX_HANDOFF" "$version" "$inputs/bootstrap-receipt"' \
    "$prefix_handoff_consumer" || {
    echo "Runtime coordination or evidence replay omits the staged prefix receipt" >&2
    exit 1
  }
done
source_library_key=$(sed -n '/^key=[$]($/,/^)/p' \
  "$ROOT/scripts/environment/runtime-matrix-library")
for selected_build_input in \
    SOURCE_LIBRARY_BUILD_SCHEMA runtime_lock_sha256 prefix_manifest_sha256 \
    dependency_lock_sha256; do
  grep -Fq "$selected_build_input" <<<"$source_library_key" || {
    echo "Source-library cache key omits $selected_build_input" >&2
    exit 1
  }
done
if grep -Eq \
    'registry_sha256|registry_helper_sha256|library_manager_sha256|library_helper_sha256|tree_receipt_helper_sha256|runtime_receipt_sha256|runtime_seal_sha256' \
    <<<"$source_library_key"; then
  echo "Source-library cache key still depends on verification provenance" >&2
  exit 1
fi
for receipt_provenance in \
    registry_sha256 registry_helper_sha256 library_manager_sha256 \
    library_helper_sha256 tree_receipt_helper_sha256 \
    runtime_receipt_sha256 runtime_seal_sha256; do
  rg -Fq "${receipt_provenance}" \
    "$ROOT/scripts/environment/runtime-matrix-library" || {
    echo "Source-library receipt omits $receipt_provenance" >&2
    exit 1
  }
done
if rg -Fq 'tools::sha256sum' \
    "$ROOT/scripts/environment/runtime-matrix-library.R"; then
  echo "R 3.6 dependency bootstrap depends on an unavailable tools API" >&2
  exit 1
fi
[[ $(rg -Fc '_R_CHECK_FORCE_SUGGESTS_=false' \
    "$ROOT/scripts/environment/run-runtime-matrix-stage") -eq 1 ]]
rg -Fq 'R CMD check --no-tests --no-manual --no-build-vignettes "$archive"' \
  "$ROOT/scripts/environment/run-runtime-matrix-stage"
rg -Fq 'verify_declared_minimum_check "$version" "$artifacts" "$metadata"' \
  "$ROOT/scripts/verify-runtime-matrix-evidence"
rg -Fq -- '--refresh-receipts' "$ROOT/scripts/bootstrap-runtime-matrix"
"$ROOT/scripts/environment/test-runtime-matrix-managed-paths" >/dev/null

if command -v Rscript >/dev/null 2>&1; then
  Rscript --vanilla -e 'for (path in commandArgs(TRUE)) parse(path)' \
    "$ROOT/scripts/environment/runtime-matrix-inventory.R" \
    "$ROOT/scripts/environment/runtime-matrix-probe.R" \
    "$ROOT/scripts/environment/runtime-matrix-skip-policy.R" \
    "$ROOT/scripts/environment/runtime-matrix-testthat-audit.R" \
    "$ROOT/scripts/environment/run-runtime-matrix-tests.R"
  Rscript --vanilla - "$ROOT" <<'RSCRIPT'
root <- commandArgs(trailingOnly = TRUE)[[1L]]
whole_policy <- read.delim(
  file.path(root, "environment", "runtime-matrix-whole-file-skips.tsv"),
  quote = "", comment.char = "", colClasses = "character",
  check.names = FALSE
)
guard_label <- function(expression) {
  if (!is.call(expression) || !is.name(expression[[1L]])) return(NA_character_)
  name <- as.character(expression[[1L]])
  if (identical(name, "skip_on_cran") && length(expression) == 1L) {
    return("skip_on_cran")
  }
  if (identical(name, "skip_if_not_installed") &&
      length(expression) == 2L && is.character(expression[[2L]]) &&
      length(expression[[2L]]) == 1L) {
    return(paste0("skip_if_not_installed:", expression[[2L]]))
  }
  NA_character_
}
for (i in seq_len(nrow(whole_policy))) {
  expressions <- parse(file.path(
    root, "tests", "testthat", whole_policy$file[[i]]
  ))
  first_test <- which(vapply(expressions, function(expression) {
    is.call(expression) && is.name(expression[[1L]]) &&
      identical(as.character(expression[[1L]]), "test_that")
  }, logical(1L)))[[1L]]
  observed <- vapply(
    expressions[seq_len(first_test - 1L)], guard_label, character(1L)
  )
  stopifnot(
    !anyNA(observed),
    identical(
      paste(observed, collapse = ","), whole_policy$leading_guards[[i]]
    )
  )
}

policy_environment <- new.env(parent = globalenv())
sys.source(
  file.path(root, "scripts", "environment", "runtime-matrix-skip-policy.R"),
  envir = policy_environment
)
invisible(
  policy_environment$runtime_matrix_validate_pre46_exclusion_policy(root)
)
invisible(policy_environment$runtime_matrix_validate_result_skip_policy(root))

audit_environment <- new.env(parent = globalenv())
sys.source(
  file.path(
    root, "scripts", "environment", "runtime-matrix-testthat-audit.R"
  ),
  envir = audit_environment
)
make_expectation <- function(type) {
  structure(
    list(message = paste(type, "fixture")),
    class = c(
      paste0("expectation_", type),
      "expectation",
      if (identical(type, "error")) "error",
      if (identical(type, "warning")) "warning",
      "condition"
    )
  )
}
raw_results <- structure(
  list(list(
    file = "test-fixture.R",
    context = "fixture",
    test = "error followed by warning",
    user = 0,
    system = 0,
    real = 0,
    results = list(make_expectation("error"), make_expectation("warning"))
  )),
  class = "testthat_results"
)
# testthat 3.2.1.1 can summarize this sequence as clean. The retained audit
# must instead classify each raw expectation and preserve both diagnostics.
misleading_summary <- data.frame(
  file = "test-fixture.R",
  context = "fixture",
  test = "error followed by warning",
  nb = 2L,
  failed = 0L,
  skipped = FALSE,
  error = FALSE,
  warning = 0L,
  user = 0,
  system = 0,
  real = 0,
  stringsAsFactors = FALSE
)
audited <- audit_environment$runtime_matrix_audit_testthat_results(
  raw_results, misleading_summary
)
stopifnot(identical(audited$expectation_types, c("error", "warning")))
malformed <- raw_results
malformed[[1L]]$results[[1L]] <- structure(
  list(message = "ambiguous fixture"),
  class = c(
    "expectation_error", "expectation_warning", "expectation",
    "error", "warning", "condition"
  )
)
malformed_error <- tryCatch(
  audit_environment$runtime_matrix_audit_testthat_results(
    malformed, misleading_summary
  ),
  error = identity
)
stopifnot(
  inherits(malformed_error, "error"),
  grepl("ambiguous expectation class", conditionMessage(malformed_error))
)

local({
  temporary_parent <- file.path(root, ".local", "tmp")
  dir.create(temporary_parent, recursive = TRUE, showWarnings = FALSE)
  fixture <- tempfile("runtime-skip-policy.", tmpdir = temporary_parent)
  dir.create(file.path(fixture, "tests", "testthat"), recursive = TRUE)
  dir.create(file.path(fixture, "environment"), recursive = TRUE)
  on.exit(unlink(fixture, recursive = TRUE, force = TRUE), add = TRUE)
  writeLines(c(
    'test_that("fixture result skip", {',
    '  skip_on_cran()',
    '  expect_true(TRUE)',
    '})',
    'test_that("fixture list ALTREP skip", {',
    '  skip_if_no_list_altrep()',
    '  expect_true(TRUE)',
    '})'
  ), file.path(fixture, "tests", "testthat", "test-fixture.R"))
  manifest_path <- file.path(
    fixture, "environment", "runtime-matrix-result-skips.tsv"
  )
  exclusion_path <- file.path(
    fixture, "environment", "runtime-matrix-pre46-exclusions.tsv"
  )
  valid <- rbind(
    data.frame(
      runtime = rep(c("3.6.3", "4.0.5", "4.3.3", "4.5.2"), each = 1L),
      file = "test-fixture.R",
      test = "fixture result skip",
      reason = "Reason: On CRAN",
      stringsAsFactors = FALSE
    ),
    data.frame(
      runtime = c("3.6.3", "4.0.5"),
      file = "test-fixture.R",
      test = "fixture list ALTREP skip",
      reason = "Reason: R < 4.3 cannot construct list ALTREP test fixtures",
      stringsAsFactors = FALSE
    )
  )
  valid <- valid[do.call(order, c(
    valid[c("runtime", "file", "test", "reason")], list(method = "radix")
  )), , drop = FALSE]
  row.names(valid) <- NULL
  write.table(
    data.frame(
      ordinal = as.character(seq_len(4L)),
      runtime = c("3.6.3", "4.0.5", "4.3.3", "4.5.2"),
      platform = rep("linux-64", 4L),
      runtime_lock = paste0(
        "environment/runtime-r-",
        c("3.6.3", "4.0.5", "4.3.3", "4.5.2"),
        "-linux-64.lock"
      ),
      dependency_mode = c(
        "source-library", "source-library", "data-table-overlay",
        "prefix-library"
      ),
      dependency_lock = c(
        "environment/runtime-r-3.6.3-packages.lock",
        "environment/runtime-r-4.0.5-packages.lock", "-", "-"
      ),
      api_branch = c(
        "r-3.6-public-compatibility",
        "r-4.0-active-binding-pre-4.2-compatibility",
        "pre-4.5-documented-public-backports",
        "4.5-direct-public-accessors"
      ),
      prefix_repair = c(
        "environment/runtime-r-3.6.3-prefix-repair.lock", "-", "-", "-"
      ),
      stringsAsFactors = FALSE
    ),
    file.path(fixture, "environment", "runtime-matrix.tsv"),
    sep = "\t", quote = FALSE, row.names = FALSE, col.names = TRUE
  )
  write_policy <- function(value) {
    write.table(
      value, manifest_path, sep = "\t", quote = FALSE,
      row.names = FALSE, col.names = TRUE
    )
  }
  expect_policy_error <- function(value, pattern) {
    write_policy(value)
    error <- tryCatch(
      policy_environment$runtime_matrix_validate_result_skip_policy(fixture),
      error = identity
    )
    stopifnot(inherits(error, "error"), grepl(pattern, conditionMessage(error)))
  }
  write_policy(valid)
  writeLines("context\treason", exclusion_path)
  exclusions <-
    policy_environment$runtime_matrix_validate_pre46_exclusion_policy(fixture)
  stopifnot(
    identical(names(exclusions), c("context", "reason")),
    nrow(exclusions) == 0L
  )
  invisible(
    policy_environment$runtime_matrix_validate_result_skip_policy(fixture)
  )
  preflight <- capture.output(
    policy_environment$runtime_matrix_skip_policy_main(fixture)
  )
  stopifnot(
    "runtime_matrix_skip_policy_preflight=passed" %in% preflight,
    "reviewed_pre46_exclusion_row_count=0" %in% preflight
  )
  writeLines(c(
    "context\treason",
    "native-fixture\tobsolete exclusion"
  ), exclusion_path)
  exclusion_error <- tryCatch(
    policy_environment$runtime_matrix_validate_pre46_exclusion_policy(fixture),
    error = identity
  )
  stopifnot(
    inherits(exclusion_error, "error"),
    grepl("exclusion manifest is malformed", conditionMessage(exclusion_error))
  )
  writeLines("context\treason", exclusion_path)
  missing_baseline <- valid[-which(valid$reason == "Reason: On CRAN")[[1L]],
    , drop = FALSE]
  expect_policy_error(
    missing_baseline,
    "differs from current skip_on_cran test titles"
  )
  wrong_version <- rbind(
    valid,
    transform(
      valid[
        valid$runtime == "4.0.5" &
          valid$reason ==
            "Reason: R < 4.3 cannot construct list ALTREP test fixtures",
        ,
        drop = FALSE
      ],
      runtime = "4.3.3"
    )
  )
  wrong_version <- wrong_version[do.call(order, c(
    wrong_version[c("runtime", "file", "test", "reason")],
    list(method = "radix")
  )), , drop = FALSE]
  expect_policy_error(
    wrong_version,
    "unreviewed version-specific skip"
  )
  tampered <- valid
  tampered$reason[[1L]] <- "Reason: Tampered"
  expect_policy_error(
    tampered,
    "unreviewed version-specific skip"
  )
})
RSCRIPT
fi

