#!/usr/bin/env bash

# Run independent compiler admissions concurrently while preserving one log per
# task and a deterministic input-order aggregate.  A failing task never stops
# later tasks from running, so one bounded admission reports the whole batch.

set -euo pipefail

# GNU timeout must supervise a process whose own diagnostics are isolated from
# compiler output.  The ordinary runner therefore invokes this same,
# content-bound file through an absolute Bash executable as a deliberately
# tiny task wrapper.  The wrapper redirects only compiler output; timeout's
# --verbose diagnostics remain on the separate supervisor descriptor.
if [[ "${1:-}" == --internal-task-wrapper ]]; then
  (($# >= 6)) || exit 125
  task_log=$2
  compiler_canonical=$3
  compiler_argv0=$4
  [[ "$5" == -- && "$task_log" == /* && -f "$task_log" &&
     ! -L "$task_log" && "$compiler_canonical" == /* &&
     -f "$compiler_canonical" && -x "$compiler_canonical" &&
     ! -L "$compiler_canonical" && "$compiler_argv0" == /* ]] || exit 125
  shift 5
  exec -a "$compiler_argv0" "$compiler_canonical" "$@" \
    >> "$task_log" 2>&1
fi

fail() {
  printf 'run-compiler-batch: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: run-compiler-batch --jobs N --label NAME --compiler PATH
       --source-root PATH --source-list FILE --output-directory PATH
       --aggregate-log FILE --admission-report FILE
       --setsid PATH
       [--task-timeout-seconds N]
       [--timeout-tool PATH] -- COMPILER_ARGUMENT ...
EOF
}

sha256_value() {
  sha256sum "$1" | cut -d ' ' -f 1
}

argument_vector_sha256() {
  if (($#)); then
    printf '%s\0' "$@"
  fi | sha256sum | cut -d ' ' -f 1
}

compiler_identity_sha256() {
  (
    export LC_ALL=C
    exec -a "$COMPILER_INVOKED_PATH" "$COMPILER_CANONICAL_PATH" --version
  ) 2>&1 | sha256sum | cut -d ' ' -f 1
}

read_compiler_link_target() {
  if [[ -L "$COMPILER_INVOKED_PATH" ]]; then
    readlink -- "$COMPILER_INVOKED_PATH"
  else
    printf '%s\n' -
  fi
}

verify_compiler_identity() {
  [[ "$(read_compiler_link_target)" == "$COMPILER_LINK_TARGET" &&
     "$(readlink -f -- "$COMPILER_INVOKED_PATH")" == \
       "$COMPILER_CANONICAL_PATH" &&
     "$(sha256_value "$COMPILER_CANONICAL_PATH")" == \
       "$COMPILER_CANONICAL_SHA256" &&
     "$(compiler_identity_sha256)" == "$COMPILER_IDENTITY_SHA256" ]]
}

setsid_identity_sha256() {
  LC_ALL=C "$SETSID" --version 2>&1 | sha256sum | cut -d ' ' -f 1
}

verify_setsid_identity() {
  [[ -f "$SETSID" && -x "$SETSID" && ! -L "$SETSID" &&
     "$(cd "$(dirname "$SETSID")" && pwd -P)/$(basename "$SETSID")" == \
       "$SETSID" &&
     "$(sha256_value "$SETSID")" == "$SETSID_SHA256" &&
     "$(setsid_identity_sha256)" == "$SETSID_IDENTITY_SHA256" ]]
}

timeout_identity_sha256() {
  LC_ALL=C "$TIMEOUT_TOOL" --version 2>&1 | sha256sum | cut -d ' ' -f 1
}

verify_timeout_identity() {
  [[ -f "$TIMEOUT_TOOL" && -x "$TIMEOUT_TOOL" && ! -L "$TIMEOUT_TOOL" &&
     "$(cd "$(dirname "$TIMEOUT_TOOL")" && pwd -P)/$(basename "$TIMEOUT_TOOL")" == \
       "$TIMEOUT_TOOL" &&
     "$(sha256_value "$TIMEOUT_TOOL")" == "$TIMEOUT_TOOL_SHA256" &&
     "$(timeout_identity_sha256)" == "$TIMEOUT_TOOL_IDENTITY_SHA256" ]]
}

validate_admission_report() {
  local report=$1 mode=$2 expected_fields actual_fields
  local online affinity cgroup_cpu cpu_limit cpu_reserve cpu_per cpu_jobs
  local memory_available cgroup_memory memory_reserve memory_per memory_jobs
  local operator jobs expected_cpu_limit expected_cpu_reserve expected_jobs value
  local expected_cpu_jobs expected_memory_reserve expected_memory_jobs
  [[ "$report" == /* && -f "$report" && ! -L "$report" ]] ||
    fail "--admission-report must be one plain absolute file"
  [[ "$(cd "$(dirname "$report")" && pwd -P)/$(basename "$report")" == \
     "$report" ]] || fail "--admission-report is not canonical"
  awk -F '\t' 'NF != 2 { exit 1 }' "$report" ||
    fail "admission report is not an exact two-column TSV"
  expected_fields=$'field\nschema\nprofile\nplatform\nonline_cpus\naffinity_cpus\ncgroup_cpu_limit\ncpu_limit\ncpu_reserve\ncpu_per_job\ncpu_jobs\nmemory_source\nmemory_available_mib\ncgroup_memory_available_mib\nmemory_reserve_mib\nmemory_mib_per_job\nmemory_jobs\nprofile_max_jobs\noperator_max_jobs\njobs\nselection'
  actual_fields=$(cut -f 1 "$report")
  [[ "$actual_fields" == "$expected_fields" ]] ||
    fail "admission report has an unexpected field inventory"
  report_value() {
    awk -F '\t' -v field="$1" '$1 == field { print $2 }' "$report"
  }
  canonical_positive() { [[ "$1" =~ ^[1-9][0-9]{0,8}$ ]]; }
  canonical_nonnegative() { [[ "$1" =~ ^(0|[1-9][0-9]{0,8})$ ]]; }
  [[ "$(report_value schema)" == 1 &&
     "$(report_value profile)" == api-compile &&
     "$(report_value selection)" == \
       live_ceiling_lowered_against_retained_initial ]] ||
    fail "admission report has an unsupported identity or policy"
  online=$(report_value online_cpus)
  affinity=$(report_value affinity_cpus)
  cgroup_cpu=$(report_value cgroup_cpu_limit)
  cpu_limit=$(report_value cpu_limit)
  cpu_reserve=$(report_value cpu_reserve)
  cpu_per=$(report_value cpu_per_job)
  cpu_jobs=$(report_value cpu_jobs)
  memory_available=$(report_value memory_available_mib)
  cgroup_memory=$(report_value cgroup_memory_available_mib)
  memory_reserve=$(report_value memory_reserve_mib)
  memory_per=$(report_value memory_mib_per_job)
  memory_jobs=$(report_value memory_jobs)
  operator=$(report_value operator_max_jobs)
  jobs=$(report_value jobs)
  for value in "$online" "$affinity" "$cpu_limit" "$cpu_per" \
      "$cpu_jobs" "$memory_available" "$memory_reserve" "$memory_per" \
      "$memory_jobs" "$operator" "$jobs"; do
    canonical_positive "$value" ||
      fail "admission report contains a non-canonical positive integer"
  done
  canonical_nonnegative "$cpu_reserve" ||
    fail "admission report contains a non-canonical CPU reserve"
  [[ "$cgroup_cpu" == unlimited ]] || canonical_positive "$cgroup_cpu" ||
    fail "admission report contains a malformed cgroup CPU limit"
  [[ "$cgroup_memory" == unlimited ]] || canonical_positive "$cgroup_memory" ||
    fail "admission report contains malformed cgroup memory headroom"
  [[ "$(report_value profile_max_jobs)" == unlimited && "$cpu_per" -eq 1 &&
     "$memory_per" -eq 768 ]] ||
    fail "admission report is not the reviewed api-compile profile"
  expected_cpu_limit=$online
  ((affinity < expected_cpu_limit)) && expected_cpu_limit=$affinity
  if [[ "$cgroup_cpu" != unlimited ]] &&
      ((cgroup_cpu < expected_cpu_limit)); then
    expected_cpu_limit=$cgroup_cpu
  fi
  if ((expected_cpu_limit >= 16)); then
    expected_cpu_reserve=2
  elif ((expected_cpu_limit >= 4)); then
    expected_cpu_reserve=1
  else
    expected_cpu_reserve=0
  fi
  expected_cpu_jobs=$(((expected_cpu_limit - expected_cpu_reserve) / cpu_per))
  ((expected_cpu_jobs > 0)) || expected_cpu_jobs=1
  expected_memory_reserve=$((memory_available / 4))
  ((expected_memory_reserve >= 12288)) || expected_memory_reserve=12288
  ((memory_available > expected_memory_reserve)) ||
    fail "admission report violates the memory safety reserve"
  expected_memory_jobs=$(((memory_available - expected_memory_reserve) / memory_per))
  [[ "$cpu_limit" -eq "$expected_cpu_limit" &&
     "$cpu_reserve" -eq "$expected_cpu_reserve" &&
     "$cpu_jobs" -eq "$expected_cpu_jobs" &&
     "$memory_reserve" -eq "$expected_memory_reserve" &&
     "$memory_jobs" -eq "$expected_memory_jobs" ]] ||
    fail "admission report arithmetic is internally inconsistent"
  if [[ "$cgroup_memory" != unlimited ]] &&
      ((memory_available > cgroup_memory)); then
    fail "admission report exceeds cgroup memory headroom"
  fi
  expected_jobs=$cpu_jobs
  ((memory_jobs < expected_jobs)) && expected_jobs=$memory_jobs
  ((operator < expected_jobs)) && expected_jobs=$operator
  [[ "$jobs" -eq "$expected_jobs" ]] ||
    fail "admission report jobs row is not its exact safe minimum"
  if [[ "$mode" == exact ]]; then
    [[ "$JOBS" -eq "$jobs" ]] ||
      fail "--jobs does not exactly match its admission report"
  else
    [[ "$JOBS" -le "$jobs" ]] ||
      fail "--jobs exceeds its admitted shared ceiling"
  fi
  ADMITTED_JOBS=$jobs
  ADMISSION_REPORT_SHA256=$(sha256_value "$report")
}

JOBS=
LABEL=
COMPILER=
SOURCE_ROOT=
SOURCE_LIST=
OUTPUT_DIRECTORY=
AGGREGATE_LOG=
ADMISSION_REPORT=
SETSID=
TASK_TIMEOUT_SECONDS=300
TIMEOUT_TOOL=
while (($#)); do
  case "$1" in
    --jobs|--label|--compiler|--source-root|--source-list|--output-directory|--aggregate-log|--admission-report|--setsid|--task-timeout-seconds|--timeout-tool)
      (($# >= 2)) || fail "$1 requires a value"
      case "$1" in
        --jobs) JOBS=$2 ;;
        --label) LABEL=$2 ;;
        --compiler) COMPILER=$2 ;;
        --source-root) SOURCE_ROOT=$2 ;;
        --source-list) SOURCE_LIST=$2 ;;
        --output-directory) OUTPUT_DIRECTORY=$2 ;;
        --aggregate-log) AGGREGATE_LOG=$2 ;;
        --admission-report) ADMISSION_REPORT=$2 ;;
        --setsid) SETSID=$2 ;;
        --task-timeout-seconds) TASK_TIMEOUT_SECONDS=$2 ;;
        --timeout-tool) TIMEOUT_TOOL=$2 ;;
      esac
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *) fail "unknown argument '$1' (see --help)" ;;
  esac
done
COMPILER_ARGUMENTS=("$@")
COMPILER_ARGUMENTS_COUNT=${#COMPILER_ARGUMENTS[@]}
COMPILER_ARGUMENTS_SHA256=$(argument_vector_sha256 "${COMPILER_ARGUMENTS[@]}")

if [[ ! "$JOBS" =~ ^[1-9][0-9]{0,8}$ ]] || ((JOBS > 65536)); then
  fail "--jobs must be a canonical bounded positive integer"
fi
[[ "$LABEL" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
  fail "--label must be one safe name"
[[ "$TASK_TIMEOUT_SECONDS" =~ ^[1-9][0-9]{0,8}$ ]] ||
  fail "--task-timeout-seconds must be a canonical bounded positive integer"
[[ "$COMPILER" == /* && -f "$COMPILER" && -x "$COMPILER" &&
   "$COMPILER" != *$'\t'* &&
   "$COMPILER" != *$'\r'* && "$COMPILER" != *$'\n'* ]] ||
  fail "compiler must be one absolute executable or executable symlink: $COMPILER"
[[ "$(cd "$(dirname "$COMPILER")" && pwd -P)/$(basename "$COMPILER")" == \
   "$COMPILER" ]] || fail "compiler invocation parent is not canonical"
COMPILER_INVOKED_PATH=$COMPILER
COMPILER_LINK_TARGET=$(read_compiler_link_target)
[[ "$COMPILER_LINK_TARGET" != *$'\t'* &&
   "$COMPILER_LINK_TARGET" != *$'\r'* &&
   "$COMPILER_LINK_TARGET" != *$'\n'* ]] ||
  fail "compiler link target contains an unsupported character"
COMPILER_CANONICAL_PATH=$(readlink -f -- "$COMPILER_INVOKED_PATH")
[[ "$COMPILER_CANONICAL_PATH" == /* && -f "$COMPILER_CANONICAL_PATH" &&
   -x "$COMPILER_CANONICAL_PATH" && ! -L "$COMPILER_CANONICAL_PATH" ]] ||
  fail "compiler does not resolve to one plain executable"
COMPILER_CANONICAL_SHA256=$(sha256_value "$COMPILER_CANONICAL_PATH")
COMPILER_IDENTITY_SHA256=$(compiler_identity_sha256)
TASK_WRAPPER=$(readlink -f -- "${BASH_SOURCE[0]}")
[[ "$TASK_WRAPPER" == /* && -f "$TASK_WRAPPER" && -x "$TASK_WRAPPER" &&
   ! -L "$TASK_WRAPPER" ]] || fail "task wrapper is not one plain executable"
TASK_WRAPPER_SHA256=$(sha256_value "$TASK_WRAPPER")
TASK_WRAPPER_BASH=$(readlink -f -- "${BASH:-}")
[[ "$TASK_WRAPPER_BASH" == /* && -f "$TASK_WRAPPER_BASH" &&
   -x "$TASK_WRAPPER_BASH" && ! -L "$TASK_WRAPPER_BASH" &&
   "$TASK_WRAPPER_BASH" != *"'"* ]] ||
  fail "task-wrapper Bash is not one safely quotable plain executable"
TASK_WRAPPER_BASH_SHA256=$(sha256_value "$TASK_WRAPPER_BASH")
if [[ -z "$TIMEOUT_TOOL" ]]; then
  TIMEOUT_TOOL=$(command -v timeout 2>/dev/null || true)
fi
[[ "$TIMEOUT_TOOL" == /* && -f "$TIMEOUT_TOOL" && -x "$TIMEOUT_TOOL" &&
   ! -L "$TIMEOUT_TOOL" && "$TIMEOUT_TOOL" != *$'\t'* &&
   "$TIMEOUT_TOOL" != *$'\r'* && "$TIMEOUT_TOOL" != *$'\n'* ]] ||
  fail "--timeout-tool must name a plain absolute executable"
[[ "$(cd "$(dirname "$TIMEOUT_TOOL")" && pwd -P)/$(basename "$TIMEOUT_TOOL")" == \
   "$TIMEOUT_TOOL" ]] || fail "--timeout-tool path is not canonical"
LC_ALL=C "$TIMEOUT_TOOL" --version 2>&1 | head -n 1 |
  grep -Fq 'timeout (GNU coreutils)' ||
  fail "--timeout-tool is not GNU coreutils timeout"
TIMEOUT_TOOL_SHA256=$(sha256_value "$TIMEOUT_TOOL")
TIMEOUT_TOOL_IDENTITY_SHA256=$(timeout_identity_sha256)
[[ "$SETSID" == /* && -f "$SETSID" && -x "$SETSID" && ! -L "$SETSID" &&
   "$SETSID" != *$'\t'* && "$SETSID" != *$'\r'* &&
   "$SETSID" != *$'\n'* ]] ||
  fail "--setsid must name one plain absolute executable"
[[ "$(cd "$(dirname "$SETSID")" && pwd -P)/$(basename "$SETSID")" == \
   "$SETSID" ]] || fail "--setsid path is not canonical"
SETSID_SHA256=$(sha256_value "$SETSID")
SETSID_IDENTITY_SHA256=$(setsid_identity_sha256)
LC_ALL=C "$SETSID" --version 2>&1 | head -n 1 |
  grep -Fq 'setsid from util-linux' ||
  fail "--setsid is not util-linux setsid"
[[ -d "$SOURCE_ROOT" && ! -L "$SOURCE_ROOT" ]] ||
  fail "source root is absent, non-directory, or symbolic"
SOURCE_ROOT=$(cd "$SOURCE_ROOT" && pwd -P)
[[ -f "$SOURCE_LIST" && ! -L "$SOURCE_LIST" ]] ||
  fail "source list is absent, non-regular, or symbolic"
[[ -d "$(dirname "$OUTPUT_DIRECTORY")" &&
   ! -L "$(dirname "$OUTPUT_DIRECTORY")" ]] ||
  fail "output parent is absent, non-directory, or symbolic"
[[ ! -e "$OUTPUT_DIRECTORY" && ! -L "$OUTPUT_DIRECTORY" ]] ||
  fail "output directory already exists or is symbolic"
[[ -d "$(dirname "$AGGREGATE_LOG")" && ! -L "$(dirname "$AGGREGATE_LOG")" ]] ||
  fail "aggregate-log parent is absent, non-directory, or symbolic"
[[ ! -e "$AGGREGATE_LOG" && ! -L "$AGGREGATE_LOG" ]] ||
  fail "aggregate log already exists or is symbolic"
validate_admission_report "$ADMISSION_REPORT" ceiling

sources=()
while IFS= read -r source || [[ -n "$source" ]]; do
  [[ -n "$source" && "$source" == "$SOURCE_ROOT/"* &&
     "$source" != *$'\n'* && "$source" != *$'\r'* && "$source" != *$'\t'* &&
     "$source" != *//* && "$source" != */../* && "$source" != */./* &&
     -f "$source" && ! -L "$source" ]] ||
    fail "source list contains an unsafe, absent, or symbolic path"
  [[ "$(cd "$(dirname "$source")" && pwd -P)/$(basename "$source")" == "$source" ]] ||
    fail "source list contains a non-canonical path"
  for existing in "${sources[@]}"; do
    [[ "$existing" != "$source" ]] || fail "source list contains a duplicate path"
  done
  sources+=("$source")
done < "$SOURCE_LIST"
((${#sources[@]} > 0)) || fail "source list is empty"
mkdir "$OUTPUT_DIRECTORY"
{
  printf 'field\tvalue\n'
  printf 'schema\t4\n'
  printf 'jobs\t%s\n' "$JOBS"
  printf 'admitted_jobs\t%s\n' "$ADMITTED_JOBS"
  printf 'admission_report_path\t%s\n' "$ADMISSION_REPORT"
  printf 'admission_report_sha256\t%s\n' "$ADMISSION_REPORT_SHA256"
  printf 'label\t%s\n' "$LABEL"
  printf 'tasks\t%s\n' "${#sources[@]}"
  printf 'compiler_invoked_path\t%s\n' "$COMPILER_INVOKED_PATH"
  printf 'compiler_link_target\t%s\n' "$COMPILER_LINK_TARGET"
  printf 'compiler_canonical_path\t%s\n' "$COMPILER_CANONICAL_PATH"
  printf 'compiler_canonical_sha256\t%s\n' "$COMPILER_CANONICAL_SHA256"
  printf 'compiler_identity_sha256\t%s\n' "$COMPILER_IDENTITY_SHA256"
  printf 'source_root\t%s\n' "$SOURCE_ROOT"
  printf 'source_list_sha256\t%s\n' "$(sha256_value "$SOURCE_LIST")"
  printf 'compiler_arguments_count\t%s\n' "$COMPILER_ARGUMENTS_COUNT"
  printf 'compiler_arguments_sha256\t%s\n' "$COMPILER_ARGUMENTS_SHA256"
  printf 'setsid_path\t%s\n' "$SETSID"
  printf 'setsid_sha256\t%s\n' "$SETSID_SHA256"
  printf 'setsid_identity_sha256\t%s\n' "$SETSID_IDENTITY_SHA256"
  printf 'task_timeout_seconds\t%s\n' "$TASK_TIMEOUT_SECONDS"
  printf 'timeout_tool_path\t%s\n' "$TIMEOUT_TOOL"
  printf 'timeout_tool_sha256\t%s\n' "$TIMEOUT_TOOL_SHA256"
  printf 'timeout_tool_identity_sha256\t%s\n' \
    "$TIMEOUT_TOOL_IDENTITY_SHA256"
  printf 'task_wrapper_path\t%s\n' "$TASK_WRAPPER"
  printf 'task_wrapper_sha256\t%s\n' "$TASK_WRAPPER_SHA256"
  printf 'task_wrapper_bash_path\t%s\n' "$TASK_WRAPPER_BASH"
  printf 'task_wrapper_bash_sha256\t%s\n' "$TASK_WRAPPER_BASH_SHA256"
  printf 'supervisor_log_suffix\t.supervisor.log\n'
  printf 'task_ledger\ttask-ledger.tsv\n'
} > "$OUTPUT_DIRECTORY/batch-plan.tsv"

pids=()
labels=()
logs=()
launched=0
waited=0
failures=0
timeouts=0
supervisor_evidence_failures=0
statuses=()
timed_out=()
source_sha256=()
log_relative=()
supervisor_logs=()
supervisor_log_relative=()

cleanup_children() {
  local status=$? pid attempt alive
  trap - EXIT HUP INT TERM
  for pid in "${pids[@]}"; do
    [[ -n "$pid" ]] || continue
    kill -TERM -- "-$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
  done
  # A compiler wrapper can be waiting on a child that deliberately ignores
  # TERM.  Give every group one bounded grace interval, then remove the whole
  # group before reaping its leader.  Never wait indefinitely during cleanup.
  for ((attempt = 0; attempt < 20; ++attempt)); do
    alive=false
    for pid in "${pids[@]}"; do
      [[ -n "$pid" ]] || continue
      if kill -0 -- "-$pid" 2>/dev/null; then
        alive=true
        break
      fi
    done
    [[ "$alive" == true ]] || break
    sleep 0.05
  done
  for pid in "${pids[@]}"; do
    [[ -n "$pid" ]] || continue
    kill -KILL -- "-$pid" 2>/dev/null || true
    kill -KILL "$pid" 2>/dev/null || true
  done
  for pid in "${pids[@]}"; do
    [[ -n "$pid" ]] || continue
    wait "$pid" 2>/dev/null || true
  done
  exit "$status"
}
trap cleanup_children EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

wait_one() {
  local task_index=$1 pid attempt status=0 timeout=false line
  local timeout_name term_marker term_marker_short
  local kill_marker kill_marker_short supervisor_valid=true
  local term_markers=0 kill_markers=0
  local classification_valid=true task_failed=false
  pid=${pids[$task_index]}
  if wait "${pids[$task_index]}"; then
    status=0
  else
    status=$?
  fi
  timeout_name=${TIMEOUT_TOOL##*/}
  term_marker="$TIMEOUT_TOOL: sending signal TERM to command '$TASK_WRAPPER_BASH'"
  term_marker_short="$timeout_name: sending signal TERM to command '$TASK_WRAPPER_BASH'"
  kill_marker="$TIMEOUT_TOOL: sending signal KILL to command '$TASK_WRAPPER_BASH'"
  kill_marker_short="$timeout_name: sending signal KILL to command '$TASK_WRAPPER_BASH'"
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      "$term_marker"|"$term_marker_short")
        term_markers=$((term_markers + 1))
        ;;
      "$kill_marker"|"$kill_marker_short")
        kill_markers=$((kill_markers + 1))
        ;;
      *) supervisor_valid=false ;;
    esac
  done < "${supervisor_logs[$task_index]}"
  # Status 124 and 137 are both ambiguous: an ordinary compiler may return
  # either.  GNU timeout normally returns 124 after TERM, while versions that
  # escalate a TERM-resistant child to KILL may report 137.  Authenticate
  # either result only from the exact, singleton diagnostics on the
  # supervisor-only descriptor.  Compiler output never reaches that
  # descriptor and therefore cannot forge a deadline.
  if [[ "$supervisor_valid" != true || "$term_markers" -gt 1 ||
      "$kill_markers" -gt 1 || "$kill_markers" -gt "$term_markers" ]]; then
    classification_valid=false
  elif [[ "$term_markers" -eq 0 ]]; then
    :
  elif [[ "$status" -eq 124 ||
      ( "$status" -eq 137 && "$kill_markers" -eq 1 ) ]]; then
    timeout=true
  else
    classification_valid=false
  fi
  if [[ "$timeout" == true ]]; then
    printf 'compiler_timeout_seconds=%s\n' "$TASK_TIMEOUT_SECONDS" \
      >> "${logs[$task_index]}"
    timeouts=$((timeouts + 1))
  elif [[ "$classification_valid" != true ]]; then
    printf 'compiler supervisor evidence invalid: %s\n' \
      "${labels[$task_index]}" >&2
    supervisor_evidence_failures=$((supervisor_evidence_failures + 1))
    task_failed=true
  fi
  statuses[task_index]=$status
  timed_out[task_index]=$timeout
  if [[ "$status" -ne 0 ]]; then
    printf 'compiler task failed: %s\n' "${labels[$task_index]}" >&2
    task_failed=true
  fi
  [[ "$task_failed" == false ]] || failures=$((failures + 1))
  # A compiler is not allowed to leave a background descendant behind after
  # its own result has been collected.
  if kill -0 -- "-$pid" 2>/dev/null; then
    kill -TERM -- "-$pid" 2>/dev/null || true
    for ((attempt = 0; attempt < 10; ++attempt)); do
      kill -0 -- "-$pid" 2>/dev/null || break
      sleep 0.05
    done
    kill -KILL -- "-$pid" 2>/dev/null || true
  fi
  pids[task_index]=
}

for source in "${sources[@]}"; do
  task_number=$((launched + 1))
  log=$(printf '%s/%04d.log' "$OUTPUT_DIRECTORY" "$task_number")
  supervisor_log=$(printf '%s/%04d.supervisor.log' \
    "$OUTPUT_DIRECTORY" "$task_number")
  relative=${source#"$SOURCE_ROOT/"}
  printf '%s\n' "$relative" > "$log"
  : > "$supervisor_log"
  [[ ! -L "$log" && ! -L "$supervisor_log" ]] ||
    fail "task output unexpectedly became symbolic"
  verify_compiler_identity ||
    fail "compiler identity changed before task $task_number was launched"
  verify_timeout_identity ||
    fail "timeout identity changed before task $task_number was launched"
  [[ "$(sha256_value "$TASK_WRAPPER")" == "$TASK_WRAPPER_SHA256" &&
     "$(sha256_value "$TASK_WRAPPER_BASH")" == \
       "$TASK_WRAPPER_BASH_SHA256" ]] ||
    fail "task-wrapper identity changed before task launch"
  source_sha256+=("$(sha256_value "$source")")
  log_relative+=("$(basename "$log")")
  supervisor_logs+=("$supervisor_log")
  supervisor_log_relative+=("$(basename "$supervisor_log")")
  # A fresh session makes the returned PID the process-group identity for the
  # compiler and ordinary descendants.  --wait preserves the compiler status.
  LC_ALL=C "$SETSID" --wait -- "$TIMEOUT_TOOL" --foreground --verbose \
    --signal=TERM \
    --kill-after=2s "${TASK_TIMEOUT_SECONDS}s" \
    "$TASK_WRAPPER_BASH" "$TASK_WRAPPER" --internal-task-wrapper \
    "$log" "$COMPILER_CANONICAL_PATH" "$COMPILER_INVOKED_PATH" -- \
    "${COMPILER_ARGUMENTS[@]}" "$source" \
    > "$supervisor_log" 2>&1 &
  pids+=("$!")
  labels+=("$LABEL:$relative")
  logs+=("$log")
  launched=$((launched + 1))
  if ((launched - waited >= JOBS)); then
    wait_one "$waited"
    waited=$((waited + 1))
  fi
done
while ((waited < launched)); do
  wait_one "$waited"
  waited=$((waited + 1))
done

verify_compiler_identity ||
  fail "compiler identity changed while the batch was running"
verify_setsid_identity ||
  fail "setsid identity changed while the batch was running"
verify_timeout_identity ||
  fail "timeout identity changed while the batch was running"
[[ "$(sha256_value "$TASK_WRAPPER")" == "$TASK_WRAPPER_SHA256" &&
   "$(sha256_value "$TASK_WRAPPER_BASH")" == \
     "$TASK_WRAPPER_BASH_SHA256" ]] ||
  fail "task-wrapper identity changed while the batch was running"

TASK_LEDGER="$OUTPUT_DIRECTORY/task-ledger.tsv"
TASK_LEDGER_NEW="${TASK_LEDGER}.new.$$"
[[ ! -e "$TASK_LEDGER" && ! -L "$TASK_LEDGER" &&
   ! -e "$TASK_LEDGER_NEW" && ! -L "$TASK_LEDGER_NEW" ]] ||
  fail "task ledger output already exists or is symbolic"
printf 'schema\tordinal\tsource_relative\tsource_sha256\tcompiler_invoked_path\tcompiler_link_target\tcompiler_canonical_path\tcompiler_canonical_sha256\tcompiler_identity_sha256\ttask_wrapper_path\ttask_wrapper_sha256\ttask_wrapper_bash_path\ttask_wrapper_bash_sha256\texit_status\ttimed_out\tlog_relative\tlog_sha256\tsupervisor_log_relative\tsupervisor_log_sha256\n' \
  > "$TASK_LEDGER_NEW"
for task_index in "${!sources[@]}"; do
  [[ -n "${statuses[$task_index]+present}" &&
     -n "${timed_out[$task_index]+present}" &&
     -n "${source_sha256[$task_index]+present}" &&
     -n "${log_relative[$task_index]+present}" &&
     -n "${supervisor_log_relative[$task_index]+present}" ]] ||
    fail "task ledger is missing collected task $((task_index + 1))"
  task_log="$OUTPUT_DIRECTORY/${log_relative[$task_index]}"
  task_supervisor_log="$OUTPUT_DIRECTORY/${supervisor_log_relative[$task_index]}"
  [[ -f "$task_log" && ! -L "$task_log" ]] ||
    fail "task ledger log is absent or symbolic: $task_log"
  [[ -f "$task_supervisor_log" && ! -L "$task_supervisor_log" ]] ||
    fail "task supervisor log is absent or symbolic: $task_supervisor_log"
  relative=${sources[$task_index]#"$SOURCE_ROOT/"}
  printf '1\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$((task_index + 1))" "$relative" "${source_sha256[$task_index]}" \
    "$COMPILER_INVOKED_PATH" "$COMPILER_LINK_TARGET" \
    "$COMPILER_CANONICAL_PATH" "$COMPILER_CANONICAL_SHA256" \
    "$COMPILER_IDENTITY_SHA256" "$TASK_WRAPPER" "$TASK_WRAPPER_SHA256" \
    "$TASK_WRAPPER_BASH" "$TASK_WRAPPER_BASH_SHA256" \
    "${statuses[$task_index]}" "${timed_out[$task_index]}" \
    "${log_relative[$task_index]}" "$(sha256_value "$task_log")" \
    "${supervisor_log_relative[$task_index]}" \
    "$(sha256_value "$task_supervisor_log")" \
    >> "$TASK_LEDGER_NEW"
done
[[ "$(awk 'END { print NR - 1 }' "$TASK_LEDGER_NEW")" -eq \
   "${#sources[@]}" ]] || fail "task ledger row count is incomplete"
mv -- "$TASK_LEDGER_NEW" "$TASK_LEDGER"

: > "$AGGREGATE_LOG"
for task_number in "${!sources[@]}"; do
  cat "$(printf '%s/%04d.log' "$OUTPUT_DIRECTORY" "$((task_number + 1))")" \
    >> "$AGGREGATE_LOG"
done
((failures == 0)) || {
  printf 'run-compiler-batch: %s of %s %s task(s) failed (%s timeout(s)); %s supervisor-evidence failure(s); every log was retained\n' \
    "$failures" "${#sources[@]}" "$LABEL" "$timeouts" \
    "$supervisor_evidence_failures" >&2
  exit 1
}
