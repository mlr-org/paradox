cp "$INTERRUPT_COMPILER" "$SCRATCH/interrupt-left"
cp "$INTERRUPT_COMPILER" "$SCRATCH/interrupt-right"
INTERRUPT_LIST="$SCRATCH/interrupt-sources.txt"
printf 'WAIT\n' > "$SCRATCH/source/interrupt.c"
printf '%s\n' "$SCRATCH/source/interrupt.c" > "$INTERRUPT_LIST"

"$WAVE_RUNNER" --jobs 2 --batch-runner "$RUNNER" \
  --setsid "$SETSID" \
  --source-root "$SCRATCH/source" --source-list "$INTERRUPT_LIST" \
  --admission-report "$SCRATCH/admission-2.tsv" \
  --output-directory "$SCRATCH/output/interrupted-wave" \
  --left-label gcc --left-compiler "$SCRATCH/interrupt-left" \
  --left-aggregate-log "$SCRATCH/output/interrupted-gcc.log" \
  --right-label clang --right-compiler "$SCRATCH/interrupt-right" \
  --right-aggregate-log "$SCRATCH/output/interrupted-clang.log" \
  > "$SCRATCH/interrupted-wave.stdout" \
  2> "$SCRATCH/interrupted-wave.stderr" &
wave_pid=$!
for ((attempt = 0; attempt < 200; ++attempt)); do
  [[ -s "$STATE/interrupt-left.pid" && -s "$STATE/interrupt-right.pid" ]] && break
  sleep 0.01
done
[[ -s "$STATE/interrupt-left.pid" && -s "$STATE/interrupt-right.pid" ]] || {
  printf '%s\n' 'test-compiler-batch: interrupt grandchildren did not start' >&2
  exit 1
}
left_grandchild=$(<"$STATE/interrupt-left.pid")
right_grandchild=$(<"$STATE/interrupt-right.pid")
kill -TERM "$wave_pid"
if wait "$wave_pid"; then
  wave_status=0
else
  wave_status=$?
fi
[[ "$wave_status" -eq 143 ]]
for ((attempt = 0; attempt < 200; ++attempt)); do
  if ! kill -0 "$left_grandchild" 2>/dev/null &&
      ! kill -0 "$right_grandchild" 2>/dev/null; then
    break
  fi
  sleep 0.01
done
if kill -0 "$left_grandchild" 2>/dev/null ||
    kill -0 "$right_grandchild" 2>/dev/null; then
  printf '%s\n' 'test-compiler-batch: interrupted compiler left a grandchild' >&2
  exit 1
fi

if [[ "$SCOPE" == interrupt ]]; then
  printf '%s\n' 'compiler_interrupt_self_test=passed'
  exit 0
fi

printf '%s\n' \
  'compiler_batch_self_test=passed' \
  'tasks=6' \
  'retained_failures=2' \
  'compiler_wave_self_test=passed' \
  'shared_ceiling=3' \
  'retained_lane_failures=2' \
  'task_deadline_seconds=1' \
  'interrupted_grandchildren=2'
