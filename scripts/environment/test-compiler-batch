    'target=${PARADOX_COMPILER_TEST_TARGET:?}' \
    'expected_strict="-DSTRICT_${lane}_API"' \
    'expected_include="-I${state}/include-${lane,,}"' \
    'strict_seen=false' \
    'include_seen=false' \
    'for argument in "$@"; do' \
    '  [[ "$argument" != "$expected_strict" ]] || strict_seen=true' \
    '  [[ "$argument" != "$expected_include" ]] || include_seen=true' \
    'done' \
    '[[ "$strict_seen" == true && "$include_seen" == true ]] || {' \
    '  printf "lane %s lost exact strict/include arguments\n" "$lane" >&2' \
    '  exit 96' \
    '}' \
    'source=${!#}' \
