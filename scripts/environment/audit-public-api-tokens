#!/usr/bin/env bash

# Reject unsupported R internals even when they occur in inactive preprocessor
# branches. Clang's raw lexer distinguishes identifiers from comments and
# string literals without preprocessing the source. The nine non-API
# exceptions remain centralized and authenticated by their external ledger.
# Public APIs that entered after R 3.6 are a separate concern: the exact table
# below confines every reviewed occurrence to its version adapter or
# version-gated graph implementation and rejects count drift.

set -euo pipefail

fail() {
  printf 'audit-public-api-tokens: %s\n' "$*" >&2
  exit 1
}

[[ $# -eq 3 ]] || fail "usage: audit-public-api-tokens CLANG SOURCE REPORT"

CLANG=$1
SOURCE=$2
REPORT=$3
[[ -x "$CLANG" ]] || fail "Clang is not executable: $CLANG"
[[ -d "$SOURCE/src" && ! -L "$SOURCE" && ! -L "$SOURCE/src" ]] ||
  fail "source and src must be plain directories: $SOURCE"
[[ ! -e "$REPORT" && ! -L "$REPORT" ]] || fail "report already exists: $REPORT"
[[ -d "$(dirname "$REPORT")" ]] || fail "report parent does not exist"

SOURCE=$(cd "$SOURCE" && pwd -P)
REPORT_PARENT=$(cd "$(dirname "$REPORT")" && pwd -P)
REPORT="$REPORT_PARENT/$(basename "$REPORT")"

shopt -s nullglob
SOURCE_FILES=("$SOURCE"/src/*.c "$SOURCE"/src/*.h)
shopt -u nullglob
((${#SOURCE_FILES[@]} > 0)) || fail "source tree has no C source or headers"
for source_file in "${SOURCE_FILES[@]}"; do
  [[ -f "$source_file" && ! -L "$source_file" ]] ||
    fail "C sources and headers must be regular, non-symbolic files: $source_file"
done

WORK=$(mktemp -d "$REPORT_PARENT/.public-api-token-audit.XXXXXX")
cleanup() {
  rm -rf "$WORK"
}
trap cleanup EXIT HUP INT TERM

TOKENS_PATTERN='ATTRIB|BODY|CLOENV|ENCLOS|FORMALS|NO_ATTRIB'
TOKENS_PATTERN+='|R_NamespaceRegistry|Rf_findVar|Rf_findVarInFrame3'
TOKENS_PATTERN+='|R_HasFancyBindings'
TOKENS_PATTERN+='|SET_ATTRIB|SET_BODY|SET_CLOENV'
TOKENS_PATTERN+='|SET_ENCLOS|SET_FORMALS|findVar|findVarInFrame'
TOKENS_PATTERN+='|findVarInFrame3'
TOKENS_PATTERN+='|ENVFLAGS|SET_ENVFLAGS|FRAME|SET_FRAME|HASHTAB|SET_HASHTAB'
TOKENS_PATTERN+='|PRVALUE|SET_PRVALUE|PRCODE|SET_PRCODE|PRENV|SET_PRENV'
TOKENS_PATTERN+='|R_PromiseExpr|OBJECT|SET_OBJECT|IS_S4_OBJECT'
TOKENS_PATTERN+='|SET_S4_OBJECT|UNSET_S4_OBJECT|Rf_allocSExp|R_GetCurrentEnv'
TOKENS_PATTERN+='|R_data_class|isFrame|IS_ASCII|IS_UTF8|SETLENGTH'
TOKENS_PATTERN+='|EXTPTR_PROT|EXTPTR_TAG|EXTPTR_PTR|GetOption|R_lsInternal'
TOKENS_PATTERN+='|REAL0|COMPLEX0|STRING_PTR|DATAPTR|STDVEC_DATAPTR'
TOKENS_PATTERN+='|R_ClosureExpr'
LINE_PATTERN="^(raw_identifier '($TOKENS_PATTERN)'([[:space:]]|$)|hashhash )"
REPORT_TEMP="$WORK/report"
{
  printf 'policy=forbidden-r-object-layout-and-binding-identifiers\n'
  printf 'forbidden_identifiers=%s\n' "$TOKENS_PATTERN"
  printf 'token_pasting=forbidden\n'
  printf 'source=%s\n' "$SOURCE"
  printf 'files=%s\n' "${#SOURCE_FILES[@]}"
} > "$REPORT_TEMP"

failed=false
EXCEPTION_SOURCE=src/r_api_compat.c
EXCEPTION_SYMBOLS=(
  ATTRIB
  FORMALS
  R_ClosureExpr
  CLOENV
  Rf_findVarInFrame
  R_HasFancyBindings
  R_PromiseExpr
  PRENV
  PRVALUE
)
declare -A EXCEPTION_COUNTS=(
  [ATTRIB]=0
  [FORMALS]=0
  [R_ClosureExpr]=0
  [CLOENV]=0
  [Rf_findVarInFrame]=0
  [R_HasFancyBindings]=0
  [R_PromiseExpr]=0
  [PRENV]=0
  [PRVALUE]=0
)
EXCEPTION_PATTERN=$(IFS='|'; printf '%s' "${EXCEPTION_SYMBOLS[*]}")

# Keep this ordered table source-bound. It is intentionally not part of the
# non-API exception ledger: every entry is a public API on the runtime branch
# where it is compiled. A symbol may have more than one reviewed owner, so the
# source path is part of the key. A zero count retains a recently removed API
# in the token inventory and therefore rejects any accidental reintroduction.
VERSIONED_PUBLIC_API=(
  'R_ClosureFormals|src/r_api_compat.c|1'
  'R_ClosureExpr|src/r_api_compat.c|1'
  'R_BytecodeExpr|src/r_api_compat.c|1'
  'R_ClosureEnv|src/r_api_compat.c|1'
  'R_ParentEnv|src/r_api_compat.c|1'
  'Rf_GetOption1|src/r_api_compat.c|1'
  'ANY_ATTRIB|src/r_api_compat.c|1'
  'R_getAttribCount|src/r_api_compat.c|0'
  'R_hasAttrib|src/r_api_compat.c|0'
  'R_mapAttrib|src/r_api_compat.c|2'
  'R_existsVarInFrame|src/r_api_compat.c|3'
  'R_ActiveBindingFunction|src/r_api_compat.c|1'
  'R_GetBindingType|src/r_api_compat.c|1'
  'R_getVar|src/r_api_compat.c|1'
  'SET_RAW_ELT|src/r_api_compat.h|1'
  'SET_COMPLEX_ELT|src/r_api_compat.h|1'
  'IDENT_USE_CLOENV|src/r_api_compat.h|1'
  'R_GetBindingType|src/upgrade_graph.c|1'
  'R_getVar|src/upgrade_graph.c|2'
  'R_DotsExist|src/upgrade_graph.c|2'
  'R_DotsLength|src/upgrade_graph.c|2'
  'R_GetDotType|src/upgrade_graph.c|1'
  'R_DotsElt|src/upgrade_graph.c|2'
  'R_DotDelayedExpression|src/upgrade_graph.c|1'
  'R_DotDelayedEnvironment|src/upgrade_graph.c|1'
  'R_DotForcedExpression|src/upgrade_graph.c|1'
  'R_DelayedBindingExpression|src/upgrade_graph.c|1'
  'R_DelayedBindingEnvironment|src/upgrade_graph.c|1'
  'R_ForcedBindingExpression|src/upgrade_graph.c|1'
)
VERSIONED_PUBLIC_SYMBOLS=()
declare -A VERSIONED_PUBLIC_SYMBOL_SEEN=()
declare -A VERSIONED_PUBLIC_EXPECTED_COUNTS=()
declare -A VERSIONED_PUBLIC_OBSERVED_COUNTS=()
for versioned_entry in "${VERSIONED_PUBLIC_API[@]}"; do
  IFS='|' read -r versioned_symbol versioned_source versioned_count \
    versioned_extra <<< "$versioned_entry"
  [[ -n "$versioned_symbol" && -n "$versioned_source" &&
      "$versioned_count" =~ ^[0-9]+$ && -z "${versioned_extra:-}" ]] ||
    fail "invalid versioned public API policy entry: $versioned_entry"
  versioned_key="$versioned_symbol|$versioned_source"
  [[ -z "${VERSIONED_PUBLIC_EXPECTED_COUNTS[$versioned_key]+set}" ]] ||
    fail "duplicate versioned public API policy entry: $versioned_key"
  VERSIONED_PUBLIC_EXPECTED_COUNTS[$versioned_key]=$versioned_count
  VERSIONED_PUBLIC_OBSERVED_COUNTS[$versioned_key]=0
  if [[ -z "${VERSIONED_PUBLIC_SYMBOL_SEEN[$versioned_symbol]+set}" ]]; then
    VERSIONED_PUBLIC_SYMBOL_SEEN[$versioned_symbol]=true
    VERSIONED_PUBLIC_SYMBOLS+=("$versioned_symbol")
  fi
done
for source_file in "${SOURCE_FILES[@]}"; do
  token_file="$WORK/tokens"
  if ! "$CLANG" -Xclang -dump-raw-tokens -fsyntax-only "$source_file" \
      > /dev/null 2> "$token_file"; then
    printf 'lexer_error=%s\n' "${source_file#"$SOURCE/"}" >> "$REPORT_TEMP"
    cat "$token_file" >> "$REPORT_TEMP"
    failed=true
    continue
  fi
  relative_source=${source_file#"$SOURCE/"}
  LC_ALL=C grep -E "$LINE_PATTERN" "$token_file" > "$WORK/all-hits" || {
    matcher_status=$?
    if ((matcher_status != 1)); then
      printf 'matcher_error=%s:%s\n' \
        "$relative_source" "$matcher_status" >> "$REPORT_TEMP"
      failed=true
    fi
    : > "$WORK/all-hits"
  }
  if [[ "$relative_source" == "$EXCEPTION_SOURCE" ]]; then
    LC_ALL=C grep -Ev \
      "^raw_identifier '($EXCEPTION_PATTERN)'([[:space:]]|$)" \
      "$WORK/all-hits" > "$WORK/hits" || {
      filter_status=$?
      ((filter_status == 1)) || {
        printf 'matcher_error=%s:%s\n' \
          "$relative_source" "$filter_status" >> "$REPORT_TEMP"
        failed=true
      }
      : > "$WORK/hits"
    }
  else
    cp "$WORK/all-hits" "$WORK/hits"
  fi
  if [[ -s "$WORK/hits" ]]; then
    printf 'forbidden_file=%s\n' "${source_file#"$SOURCE/"}" \
      >> "$REPORT_TEMP"
    cat "$WORK/hits" >> "$REPORT_TEMP"
    failed=true
  fi
  for exception_symbol in "${EXCEPTION_SYMBOLS[@]}"; do
    exception_count=$(LC_ALL=C grep -Ec \
      "^raw_identifier '$exception_symbol'([[:space:]]|$)" \
      "$token_file" || true)
    if ((exception_count != 0)); then
      if [[ "$relative_source" != "$EXCEPTION_SOURCE" ]]; then
        printf 'unreviewed_exception_file=%s:%s:%s\n' \
          "$relative_source" "$exception_symbol" "$exception_count" \
          >> "$REPORT_TEMP"
        failed=true
      fi
      current_exception_count=${EXCEPTION_COUNTS[$exception_symbol]}
      EXCEPTION_COUNTS[$exception_symbol]=$((current_exception_count + exception_count))
    fi
  done
  for versioned_symbol in "${VERSIONED_PUBLIC_SYMBOLS[@]}"; do
    versioned_count=$(LC_ALL=C grep -Ec \
      "^raw_identifier '$versioned_symbol'([[:space:]]|$)" \
      "$token_file" || true)
    if ((versioned_count != 0)); then
      versioned_key="$versioned_symbol|$relative_source"
      if [[ -z \
          "${VERSIONED_PUBLIC_EXPECTED_COUNTS[$versioned_key]+set}" ]]; then
        printf 'versioned_api_unreviewed_file=%s:%s:%s\n' \
          "$relative_source" "$versioned_symbol" "$versioned_count" \
          >> "$REPORT_TEMP"
        failed=true
      else
        VERSIONED_PUBLIC_OBSERVED_COUNTS[$versioned_key]=$versioned_count
      fi
    fi
  done
done

for versioned_entry in "${VERSIONED_PUBLIC_API[@]}"; do
  IFS='|' read -r versioned_symbol versioned_source versioned_expected \
    <<< "$versioned_entry"
  versioned_key="$versioned_symbol|$versioned_source"
  versioned_observed=${VERSIONED_PUBLIC_OBSERVED_COUNTS[$versioned_key]}
  if ((versioned_observed != versioned_expected)); then
    printf 'versioned_api_count_mismatch=%s:%s:%s:%s\n' \
      "$versioned_symbol" "$versioned_source" \
      "$versioned_expected" "$versioned_observed" >> "$REPORT_TEMP"
    failed=true
  fi
  printf 'reviewed_versioned_api=%s:%s:%s\n' \
    "$versioned_symbol" "$versioned_source" "$versioned_observed" \
    >> "$REPORT_TEMP"
done

EXCEPTION_LEDGER="$SOURCE/environment/r-api-exceptions.tsv"
exception_total=0
for exception_symbol in "${EXCEPTION_SYMBOLS[@]}"; do
  exception_total=$((exception_total + EXCEPTION_COUNTS[$exception_symbol]))
done
if [[ -e "$EXCEPTION_LEDGER" ]] ||
    ((exception_total != 0)); then
  [[ -f "$EXCEPTION_LEDGER" && ! -L "$EXCEPTION_LEDGER" ]] || {
    printf 'legacy_exception_ledger=missing-or-unsafe\n' >> "$REPORT_TEMP"
    failed=true
  }
  if [[ -f "$EXCEPTION_LEDGER" && ! -L "$EXCEPTION_LEDGER" ]]; then
    mapfile -t exception_lines < "$EXCEPTION_LEDGER"
    expected_header=$'symbol\tsource\tcount\tversions\tpolicy\trationale'
    if ((${#exception_lines[@]} != ${#EXCEPTION_SYMBOLS[@]} + 1)) ||
        [[ "${exception_lines[0]:-}" != "$expected_header" ]]; then
      printf 'legacy_exception_ledger=malformed\n' >> "$REPORT_TEMP"
      failed=true
    else
      for ((ledger_index = 1;
          ledger_index <= ${#EXCEPTION_SYMBOLS[@]};
          ++ledger_index)); do
        IFS=$'\t' read -r exception_symbol exception_source \
          exception_count exception_versions exception_policy \
          exception_rationale exception_extra \
          <<< "${exception_lines[$ledger_index]}"
        expected_symbol=${EXCEPTION_SYMBOLS[$((ledger_index - 1))]}
        expected_source=$EXCEPTION_SOURCE
        expected_count=${EXCEPTION_COUNTS[$expected_symbol]}
        case "$expected_symbol" in
          ATTRIB)
            expected_versions='R-3.6.x--R-4.5.x'
            expected_policy='raw-attribute-traversal-pre-4.6-only'
            ;;
          FORMALS)
            expected_versions='R-3.6.x--R-4.4.x'
            expected_policy='closure-formals-hot-path-pre-4.5-only'
            ;;
          R_ClosureExpr|CLOENV)
            expected_versions='R-3.6.x--R-4.4.x'
            expected_policy='closure-generation-snapshot-pre-4.5-only'
            ;;
          Rf_findVarInFrame)
            expected_versions='R-3.6.x--R-4.5.x'
            expected_policy='declared-exported-pre-4.6-only'
            ;;
          R_HasFancyBindings)
            expected_versions='R-3.6.x--R-4.1.x'
            expected_policy='fancy-frame-terminal-scan-pre-4.2-only'
            ;;
          *)
            expected_versions='R-3.6.x--R-4.4.x'
            expected_policy='detached-promise-snapshot-pre-4.5-only'
            ;;
        esac
        if [[ "$exception_symbol" != "$expected_symbol" ||
              "$exception_source" != "$expected_source" ||
              "$exception_count" != "$expected_count" ||
              "$exception_versions" != "$expected_versions" ||
              "$exception_policy" != "$expected_policy" ||
              -n "${exception_extra:-}" || -z "$exception_rationale" ]]; then
          printf 'legacy_exception_ledger=content-mismatch\n' \
            >> "$REPORT_TEMP"
          failed=true
          break
        fi
      done
    fi
  fi
fi
printf 'reviewed_attribute_accessor=%s:%s:%s\n' \
  ATTRIB "$EXCEPTION_SOURCE" \
  "${EXCEPTION_COUNTS[ATTRIB]}" >> "$REPORT_TEMP"
printf 'reviewed_closure_formals=%s:%s:%s\n' \
  FORMALS "$EXCEPTION_SOURCE" \
  "${EXCEPTION_COUNTS[FORMALS]}" >> "$REPORT_TEMP"
for closure_symbol in R_ClosureExpr CLOENV; do
  printf 'reviewed_closure_accessor=%s:%s:%s\n' \
    "$closure_symbol" "$EXCEPTION_SOURCE" \
    "${EXCEPTION_COUNTS[$closure_symbol]}" >> "$REPORT_TEMP"
done
printf 'reviewed_legacy_binding=%s:%s:%s\n' \
  Rf_findVarInFrame "$EXCEPTION_SOURCE" \
  "${EXCEPTION_COUNTS[Rf_findVarInFrame]}" >> "$REPORT_TEMP"
printf 'reviewed_fancy_binding=%s:%s:%s\n' \
  R_HasFancyBindings "$EXCEPTION_SOURCE" \
  "${EXCEPTION_COUNTS[R_HasFancyBindings]}" >> "$REPORT_TEMP"
for promise_symbol in R_PromiseExpr PRENV PRVALUE; do
  printf 'reviewed_promise_accessor=%s:%s:%s\n' \
    "$promise_symbol" "$EXCEPTION_SOURCE" \
    "${EXCEPTION_COUNTS[$promise_symbol]}" >> "$REPORT_TEMP"
done

if "$failed"; then
  printf 'result=failed\n' >> "$REPORT_TEMP"
  mv "$REPORT_TEMP" "$REPORT"
  printf 'forbidden R C internals found; see %s\n' "$REPORT" >&2
  exit 1
fi

printf 'result=passed\n' >> "$REPORT_TEMP"
mv "$REPORT_TEMP" "$REPORT"
printf 'R C API token audit passed: %s files, %s binding and %s promise tokens reviewed\n' \
  "${#SOURCE_FILES[@]}" \
  "$((EXCEPTION_COUNTS[Rf_findVarInFrame] + EXCEPTION_COUNTS[R_HasFancyBindings]))" \
  "$((EXCEPTION_COUNTS[R_PromiseExpr] + EXCEPTION_COUNTS[PRENV] + EXCEPTION_COUNTS[PRVALUE]))"
