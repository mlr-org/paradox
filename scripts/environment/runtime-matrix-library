#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
MANAGER="$ROOT/scripts/environment/runtime-matrix-library"
REGISTRY="$ROOT/scripts/environment/runtime-matrix-registry"
R_HELPER="$ROOT/scripts/environment/runtime-matrix-library.R"
TREE_RECEIPT="$ROOT/scripts/environment/runtime-matrix-prefix-receipt"
MATRIX_ROOT="$ROOT/.local/runtime-matrix"
CACHE_ROOT="$ROOT/.cache/downloads/runtime-matrix"
TEMP_ROOT="$ROOT/.local/tmp"
# Bump this only when the package-install algorithm or its isolated build
# environment changes in a way that can alter installed bytes.  Verification,
# registry, and receipt-tool changes deliberately do not invalidate a built
# package closure.
SOURCE_LIBRARY_BUILD_SCHEMA=1

fail() {
  printf 'runtime-matrix-library: %s\n' "$*" >&2
  exit 1
}

assert_plain_directory_chain() {
  local path=$1 current remainder component
  [[ "$path" != *//* && ("$path" == "$ROOT" || "$path" != */) ]] ||
    fail "managed source-library path is not component-canonical: $path"
  case "$path" in
    "$ROOT"|"$ROOT"/*) ;;
    *) fail "managed source-library path escaped the repository: $path" ;;
  esac
  [[ -d "$ROOT" && ! -L "$ROOT" &&
    "$(cd "$ROOT" && pwd -P)" == "$ROOT" ]] ||
    fail "repository root is absent, symbolic, or non-canonical: $ROOT"
  current=$ROOT
  remainder=${path#"$ROOT"}
  while [[ -n "$remainder" ]]; do
    remainder=${remainder#/}
    component=${remainder%%/*}
    if [[ "$component" == "$remainder" ]]; then
      remainder=
    else
      remainder=${remainder#*/}
    fi
    [[ -n "$component" && "$component" != . && "$component" != .. ]] ||
      fail "managed source-library path has an invalid component: $path"
    current="$current/$component"
    [[ ! -L "$current" ]] ||
      fail "refusing symbolic managed source-library directory: $current"
    [[ ! -e "$current" || -d "$current" ]] ||
      fail "managed source-library path is not a directory: $current"
    if [[ -d "$current" ]]; then
      [[ "$(cd "$current" && pwd -P)" == "$current" ]] ||
        fail "managed source-library directory is not canonical: $current"
    fi
  done
}

require_plain_directory() {
  local path=$1
  assert_plain_directory_chain "$path"
  [[ -d "$path" && ! -L "$path" ]] ||
    fail "required source-library directory is absent or symbolic: $path"
  [[ "$(cd "$path" && pwd -P)" == "$path" ]] ||
    fail "required source-library directory is not canonical: $path"
}

ensure_plain_directory() {
  local path=$1 current remainder component
  assert_plain_directory_chain "$path"
  current=$ROOT
  remainder=${path#"$ROOT"}
  while [[ -n "$remainder" ]]; do
    remainder=${remainder#/}
    component=${remainder%%/*}
    if [[ "$component" == "$remainder" ]]; then
      remainder=
    else
      remainder=${remainder#*/}
    fi
    current="$current/$component"
    if [[ ! -e "$current" && ! -L "$current" ]] &&
        ! mkdir -- "$current" 2>/dev/null; then
      [[ -d "$current" && ! -L "$current" ]] ||
        fail "could not create managed source-library directory: $current"
    fi
    require_plain_directory "$current"
  done
}

assert_plain_file_or_absent() {
  local path=$1
  assert_plain_directory_chain "${path%/*}"
  [[ ! -L "$path" ]] ||
    fail "refusing symbolic managed source-library file: $path"
  [[ ! -e "$path" || -f "$path" ]] ||
    fail "managed source-library path is not a regular file: $path"
}

require_plain_file() {
  local path=$1
  assert_plain_file_or_absent "$path"
  [[ -f "$path" && ! -L "$path" ]] ||
    fail "required source-library file is absent or symbolic: $path"
}

path_identity() {
  /usr/bin/stat -c '%d:%i' -- "$1"
}

require_owned_directory() {
  local path=$1 expected=$2 label=$3 actual
  require_plain_directory "$path"
  actual=$(path_identity "$path")
  [[ "$actual" == "$expected" ]] ||
    fail "$label identity changed after creation: $path"
}

require_owned_file() {
  local path=$1 expected=$2 label=$3 actual
  require_plain_file "$path"
  actual=$(path_identity "$path")
  [[ "$actual" == "$expected" ]] ||
    fail "$label identity changed after creation: $path"
}

clear_open_owned_directory_after_use() {
  local descriptor=$1 path=$2 expected=$3 label=$4 fd_identity
  verify_open_directory "$descriptor" "$path" "$expected" "$label"
  fd_identity=$(/usr/bin/stat -Lc '%d:%i' "/proc/$$/fd/$descriptor")
  [[ "$fd_identity" == "$expected" ]] ||
    fail "$label changed before its contents were cleared: $path"
  /usr/bin/find -H "/proc/$$/fd/$descriptor" -xdev -depth -mindepth 1 \
    -delete
  fd_identity=$(/usr/bin/stat -Lc '%d:%i' "/proc/$$/fd/$descriptor")
  [[ "$fd_identity" == "$expected" ]] ||
    fail "$label changed while its contents were cleared: $path"
  verify_open_directory "$descriptor" "$path" "$expected" "$label"
}

verify_open_directory() {
  local descriptor=$1 path=$2 expected=$3 label=$4
  local fd_identity path_identity_now
  require_plain_directory "$path"
  fd_identity=$(/usr/bin/stat -Lc '%d:%i' "/proc/$$/fd/$descriptor")
  path_identity_now=$(path_identity "$path")
  [[ "$fd_identity" == "$expected" && "$path_identity_now" == "$expected" ]] ||
    fail "$label was substituted while opening: $path"
}

require_open_regular_file() {
  local path=$1 label=$2
  [[ -f "$path" && ! -L "$path" ]] ||
    fail "$label is absent, non-regular, or symbolic: $path"
}

verify_open_file() {
  local descriptor=$1 expected=$2 label=$3
  local fd_path="/proc/$$/fd/$descriptor"
  [[ -f "$fd_path" ]] ||
    fail "$label is not an opened regular file"
  [[ "$(/usr/bin/stat -Lc '%d:%i' "$fd_path")" == "$expected" ]] ||
    fail "$label changed while it was opened"
}

usage() {
  cat <<'EOF'
Usage: runtime-matrix-library --runtime VERSION [--verify|--verify-lock]
                              [--verified-receipt-handoff DIRECTORY]
                              [--offline]
                              [--print-path]

Provision or verify the exact sealed source-package library registered for an
old runtime. The cache and installed library remain inside this checkout.
EOF
}

version=
mode=provision
offline=false
print_path=false
handoff_receipt=
while (($#)); do
  case "$1" in
    --runtime)
      (($# >= 2)) || fail "--runtime requires a value"
      version=$2
      shift 2
      ;;
    --verify)
      [[ "$mode" == provision ]] || fail "verification modes are mutually exclusive"
      mode=verify
      shift
      ;;
    --verify-lock)
      [[ "$mode" == provision ]] || fail "verification modes are mutually exclusive"
      mode=verify_lock
      shift
      ;;
    --verified-receipt-handoff)
      (($# >= 2)) || fail "--verified-receipt-handoff requires a directory"
      [[ "$mode" == provision ]] || fail "verification modes are mutually exclusive"
      mode=verify_handoff
      handoff_receipt=$2
      shift 2
      ;;
    --offline) offline=true; shift ;;
    --print-path) print_path=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown argument: $1" ;;
  esac
done
[[ -n "$version" ]] || fail "--runtime is required"
[[ "$version" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]] ||
  fail "runtime version has an invalid shape: $version"
[[ "$mode" == provision || "$offline" == false ]] ||
  fail "--offline is meaningful only while provisioning"
for input in "$MANAGER" "$REGISTRY" "$R_HELPER" "$TREE_RECEIPT"; do
  require_plain_file "$input"
done
"$REGISTRY" contains "$version" ||
  fail "runtime is not registered: $version"
[[ "$("$REGISTRY" field "$version" dependency_mode)" == source-library ]] ||
  fail "runtime does not use a source-package library: $version"

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) ;;
  *) fail "the local runtime library is pinned for Linux x86_64" ;;
esac

lock_relative=$("$REGISTRY" field "$version" dependency_lock)
lock="$ROOT/$lock_relative"
runtime_lock_relative=$("$REGISTRY" field "$version" runtime_lock)
runtime_lock="$ROOT/$runtime_lock_relative"
registry_manifest="$ROOT/environment/runtime-matrix.tsv"
prefix="$MATRIX_ROOT/prefixes/R-$version"
prefix_receipt_directory="$MATRIX_ROOT/receipts/R-$version"
prefix_manifest="$prefix_receipt_directory/prefix.manifest.tsv"
prefix_receipt="$prefix_receipt_directory/receipt.tsv"
prefix_seal="$prefix_receipt_directory/receipt.sha256"
cache="$CACHE_ROOT/R-$version"
for input in "$lock" "$runtime_lock" "$registry_manifest"; do
  require_plain_file "$input"
done

sha256_file() {
  sha256sum -- "$1" | cut -d ' ' -f 1
}

verify_package_cache() {
  local package package_version expected_hash archive
  require_plain_directory "$cache"
  while IFS=$'\t' read -r package package_version _ expected_hash _ _; do
    [[ "$package" != Package ]] || continue
    archive="$cache/${package}_${package_version}.tar.gz"
    require_plain_file "$archive"
    [[ "$(sha256_file "$archive")" == "$expected_hash" ]] ||
      fail "cached source archive failed SHA-256: $archive"
  done < "$lock"
}

metadata_value() {
  local path=$1 field=$2
  awk -F '\t' -v field="$field" '
    $1 == field {
      if (NF != 2 || found++) exit 2
      value = $2
    }
    END {
      if (found != 1) exit 1
      print value
    }
  ' "$path"
}

verify_prefix_receipt_identity() {
  local expected_seal
  require_plain_directory "$prefix_receipt_directory"
  require_plain_file "$prefix_manifest"
  require_plain_file "$prefix_receipt"
  require_plain_file "$prefix_seal"
  expected_seal="$(sha256_file "$prefix_receipt")  receipt.tsv"
  [[ $(wc -l < "$prefix_seal") -eq 1 &&
    "$(<"$prefix_seal")" == "$expected_seal" ]] ||
    fail "runtime prefix receipt seal is malformed or stale"
  [[ "$(metadata_value "$prefix_receipt" format)" == 1 &&
    "$(metadata_value "$prefix_receipt" runtime)" == "$version" &&
    "$(metadata_value "$prefix_receipt" platform)" == linux-64 &&
    "$(metadata_value "$prefix_receipt" prefix_relative)" == \
      ".local/runtime-matrix/prefixes/R-$version" &&
    "$(metadata_value "$prefix_receipt" lock_relative)" == \
      "$runtime_lock_relative" &&
    "$(metadata_value "$prefix_receipt" lock_sha256)" == \
      "$(sha256_file "$runtime_lock")" &&
    "$(metadata_value "$prefix_receipt" prefix_manifest_sha256)" == \
      "$(sha256_file "$prefix_manifest")" ]] ||
    fail "runtime prefix receipt differs from the selected build inputs"
}

expected_header=$'Package\tVersion\tRole\tSHA256\tURL\tFallbackURL'
[[ $(head -n 1 "$lock") == "$expected_header" ]] ||
  fail "dependency lock header is malformed"
awk -F '\t' '
  NR == 1 {next}
  NF != 6 {exit 1}
  $1 !~ /^[A-Za-z][A-Za-z0-9.]*$/ || package[$1]++ {exit 1}
  $2 !~ /^[A-Za-z0-9][A-Za-z0-9.-]*$/ {exit 1}
  $3 !~ /^(runtime-import|runtime-dependency|test-framework|test-support)$/ {exit 1}
  $4 !~ /^[0-9a-f]+$/ || length($4) != 64 {exit 1}
  $5 !~ /^https:\/\/(cloud[.]r-project[.]org|packagemanager[.]posit[.]co)\// {exit 1}
  $6 != "-" &&
    $6 !~ /^https:\/\/cloud[.]r-project[.]org\/src\/contrib\/Archive\// {exit 1}
  END {if (NR < 2) exit 1}
' "$lock" || fail "dependency lock rows are malformed"
if [[ "$mode" == verify_lock ]]; then
  printf 'runtime_matrix_dependency_lock=passed\nruntime=%s\npackages=%s\nlock_sha256=%s\n' \
    "$version" "$(( $(wc -l < "$lock") - 1 ))" "$(sha256_file "$lock")"
  exit 0
fi

require_plain_directory "$MATRIX_ROOT"
matrix_root_identity=$(path_identity "$MATRIX_ROOT")
exec 9< "$MATRIX_ROOT"
verify_open_directory 9 "$MATRIX_ROOT" "$matrix_root_identity" \
  "source-library publication lock"
if [[ "$mode" == verify || "$mode" == verify_handoff ]]; then
  /usr/bin/flock -s 9
else
  /usr/bin/flock -x 9
fi
verify_open_directory 9 "$MATRIX_ROOT" "$matrix_root_identity" \
  "source-library publication lock"

for input in "$prefix_receipt" "$prefix_seal"; do
  require_plain_file "$input"
done
require_plain_directory "$prefix"
verify_prefix_receipt_identity
runtime_lock_sha256=$(sha256_file "$runtime_lock")
prefix_manifest_sha256=$(sha256_file "$prefix_manifest")
dependency_lock_sha256=$(sha256_file "$lock")
runtime_receipt_sha256=$(sha256_file "$prefix_receipt")
runtime_seal_sha256=$(sha256_file "$prefix_seal")
registry_sha256=$(sha256_file "$registry_manifest")
registry_helper_sha256=$(sha256_file "$REGISTRY")
library_manager_sha256=$(sha256_file "$MANAGER")
library_helper_sha256=$(sha256_file "$R_HELPER")
tree_receipt_helper_sha256=$(sha256_file "$TREE_RECEIPT")
runtime_r_version=$(
  "$prefix/bin/Rscript" --vanilla -e 'cat(as.character(getRversion()))'
)
[[ "$runtime_r_version" == "$version" ]] ||
  fail "source-library runtime does not report R $version"

key=$(
  {
    printf 'schema\t%s\n' "$SOURCE_LIBRARY_BUILD_SCHEMA"
    printf 'runtime\t%s\n' "$version"
    printf 'platform\t%s\n' \
      "$("$REGISTRY" field "$version" platform)"
    printf 'dependency_mode\t%s\n' \
      "$("$REGISTRY" field "$version" dependency_mode)"
    printf 'runtime_lock_relative\t%s\n' "$runtime_lock_relative"
    printf 'runtime_lock\t%s\n' "$runtime_lock_sha256"
    printf 'prefix_manifest\t%s\n' "$prefix_manifest_sha256"
    printf 'dependency_lock_relative\t%s\n' "$lock_relative"
    printf 'dependency_lock\t%s\n' "$dependency_lock_sha256"
  } | sha256sum | cut -d ' ' -f 1
)
library="$MATRIX_ROOT/dependencies/R-$version/$key/library"
receipt_directory="$MATRIX_ROOT/dependency-receipts/R-$version/$key"
manifest="$receipt_directory/library.manifest.tsv"
identity_manifest="$receipt_directory/library.identity.tsv"
inventory="$receipt_directory/packages.tsv"
receipt="$receipt_directory/receipt.tsv"
seal="$receipt_directory/receipt.sha256"
dependency_version_root="$MATRIX_ROOT/dependencies/R-$version"
dependency_key_root="${library%/*}"
receipt_version_root="${receipt_directory%/*}"

managed_paths=(
  "$ROOT/.local"
  "$MATRIX_ROOT"
  "$MATRIX_ROOT/dependencies"
  "$dependency_version_root"
  "$dependency_key_root"
  "$library"
  "$MATRIX_ROOT/dependency-receipts"
  "$receipt_version_root"
  "$receipt_directory"
)
for managed_path in "${managed_paths[@]}"; do
  assert_plain_directory_chain "$managed_path"
done

write_expected_receipt() {
  cat <<EOF
format	2
runtime	$version
platform	linux-64
build_schema	$SOURCE_LIBRARY_BUILD_SCHEMA
build_identity	$key
cache_key	$key
library_relative	.local/runtime-matrix/dependencies/R-$version/$key/library
runtime_lock_relative	$runtime_lock_relative
runtime_lock_sha256	$runtime_lock_sha256
prefix_manifest_sha256	$prefix_manifest_sha256
lock_relative	$lock_relative
lock_sha256	$dependency_lock_sha256
runtime_receipt_sha256	$runtime_receipt_sha256
runtime_seal_sha256	$runtime_seal_sha256
registry_sha256	$registry_sha256
registry_helper_sha256	$registry_helper_sha256
library_manager_sha256	$library_manager_sha256
library_helper_sha256	$library_helper_sha256
tree_receipt_helper_sha256	$tree_receipt_helper_sha256
library_manifest_sha256	$(sha256_file "$manifest")
library_identity_sha256	$(sha256_file "$identity_manifest")
package_inventory_sha256	$(sha256_file "$inventory")
r_version	$runtime_r_version
EOF
}

write_library_identity() {
  local root=$1
  printf 'path\tkind\tdevice\tinode\tmode\tsize\tctime\n'
  LC_ALL=C find -H "$root" -mindepth 1 \
    -printf '%P\t%y\t%D\t%i\t%m\t%s\t%C@\0' |
    LC_ALL=C sort -z |
    tr '\0' '\n'
}

run_inventory() {
  local selected_library=${1:-$library}
  PARADOX_ROOT="$ROOT" R_ENVIRON_USER=/dev/null R_PROFILE_USER=/dev/null \
    R_LIBS_USER="$selected_library" R_LIBS_SITE='' \
    "$prefix/bin/Rscript" --vanilla "$R_HELPER" \
    inventory "$version" "$lock" "$cache" "$selected_library"
}

verify_reusable_receipt() {
  local expected_seal field receipt_field receipt_value extra
  local -a build_fields=(
    format runtime platform build_schema build_identity cache_key
    library_relative runtime_lock_relative runtime_lock_sha256
    prefix_manifest_sha256 lock_relative lock_sha256
    library_manifest_sha256 library_identity_sha256 package_inventory_sha256
    r_version
  )
  local -a expected_fields=()
  local -A expected=()
  while IFS=$'\t' read -r receipt_field receipt_value extra; do
    [[ -n "$receipt_field" && -z "${extra:-}" &&
      ! -v "expected[$receipt_field]" ]] ||
      fail "generated dependency-library receipt schema is malformed"
    expected["$receipt_field"]=$receipt_value
    expected_fields+=("$receipt_field")
  done < <(write_expected_receipt)
  cut -f 1 "$receipt" |
    cmp -s -- <(printf '%s\n' "${expected_fields[@]}") - ||
    fail "dependency-library receipt schema is malformed"
  expected_seal="$(sha256_file "$receipt")  receipt.tsv"
  [[ $(wc -l < "$seal") -eq 1 && "$(<"$seal")" == "$expected_seal" ]] ||
    fail "dependency-library receipt seal is malformed or stale"
  for field in "${build_fields[@]}"; do
    [[ "$(metadata_value "$receipt" "$field")" == \
      "${expected[$field]}" ]] ||
      fail "dependency-library receipt has stale build identity: $field"
  done
}

verify_library_artifacts() {
  local library_identity_value library_descriptor open_library
  require_plain_directory "$library"
  library_identity_value=$(path_identity "$library")
  exec {library_descriptor}< "$library"
  verify_open_directory "$library_descriptor" "$library" \
    "$library_identity_value" "sealed dependency library"
  open_library="/proc/$$/fd/$library_descriptor"
  require_plain_directory "$receipt_directory"
  for input in "$manifest" "$identity_manifest" "$inventory" "$receipt" "$seal"; do
    require_plain_file "$input"
  done
  verify_reusable_receipt
  "$TREE_RECEIPT" verify "$library" "$manifest" >/dev/null
  run_inventory | cmp -s -- "$inventory" - ||
    fail "installed dependency inventory differs from its receipt"
  write_library_identity "$open_library" |
    cmp -s -- "$identity_manifest" - ||
    fail "dependency-library identity receipt differs from the live tree"
  require_plain_directory "$library"
  require_plain_directory "$receipt_directory"
  verify_open_directory "$library_descriptor" "$library" \
    "$library_identity_value" "sealed dependency library"
  exec {library_descriptor}<&-
}

verify_library_receipt_current() {
  local expected_seal
  cmp -s -- "$receipt" <(write_expected_receipt) ||
    fail "dependency-library receipt differs from current inputs"
  expected_seal="$(sha256_file "$receipt")  receipt.tsv"
  [[ $(wc -l < "$seal") -eq 1 && "$(<"$seal")" == "$expected_seal" ]] ||
    fail "dependency-library receipt seal is malformed or stale"
}

verify_library() {
  verify_library_artifacts
  verify_library_receipt_current
}

refresh_library_receipt() {
  local receipt_directory_identity replacement_receipt replacement_seal
  local replacement_receipt_identity replacement_seal_identity
  local replacement_receipt_descriptor replacement_seal_descriptor
  local replacement_receipt_handle replacement_seal_handle
  require_plain_directory "$receipt_directory"
  receipt_directory_identity=$(path_identity "$receipt_directory")
  exec {receipt_directory_descriptor}< "$receipt_directory"
  verify_open_directory "$receipt_directory_descriptor" "$receipt_directory" \
    "$receipt_directory_identity" "dependency-library receipt refresh"
  replacement_receipt=$(mktemp \
    "/proc/$$/fd/$receipt_directory_descriptor/.receipt.tsv.XXXXXX")
  replacement_seal=$(mktemp \
    "/proc/$$/fd/$receipt_directory_descriptor/.receipt.sha256.XXXXXX")
  replacement_receipt_identity=$(/usr/bin/stat -Lc '%d:%i' \
    "$replacement_receipt")
  replacement_seal_identity=$(/usr/bin/stat -Lc '%d:%i' \
    "$replacement_seal")
  exec {replacement_receipt_descriptor}<> "$replacement_receipt"
  exec {replacement_seal_descriptor}<> "$replacement_seal"
  verify_open_file "$replacement_receipt_descriptor" \
    "$replacement_receipt_identity" "replacement dependency-library receipt"
  verify_open_file "$replacement_seal_descriptor" \
    "$replacement_seal_identity" "replacement dependency-library seal"
  replacement_receipt_handle="/proc/$$/fd/$replacement_receipt_descriptor"
  replacement_seal_handle="/proc/$$/fd/$replacement_seal_descriptor"
  write_expected_receipt > "$replacement_receipt_handle"
  printf '%s  receipt.tsv\n' "$(sha256_file "$replacement_receipt_handle")" \
    > "$replacement_seal_handle"
  verify_open_file "$replacement_receipt_descriptor" \
    "$replacement_receipt_identity" "replacement dependency-library receipt"
  verify_open_file "$replacement_seal_descriptor" \
    "$replacement_seal_identity" "replacement dependency-library seal"
  chmod 0444 "$replacement_receipt_handle" "$replacement_seal_handle"
  verify_open_directory "$receipt_directory_descriptor" "$receipt_directory" \
    "$receipt_directory_identity" "dependency-library receipt refresh"
  trap '' HUP INT TERM
  mv -T -- "$replacement_receipt" \
    "/proc/$$/fd/$receipt_directory_descriptor/receipt.tsv"
  mv -T -- "$replacement_seal" \
    "/proc/$$/fd/$receipt_directory_descriptor/receipt.sha256"
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  exec {replacement_receipt_descriptor}<&-
  exec {replacement_seal_descriptor}<&-
  verify_open_directory "$receipt_directory_descriptor" "$receipt_directory" \
    "$receipt_directory_identity" "dependency-library receipt refresh"
  exec {receipt_directory_descriptor}<&-
}

verify_receipt_handoff() {
  local handoff=$1 relative run_id expected_handoff handoff_file
  local expected_handoff_seal expected_live_seal
  local handoff_identity live_identity handoff_descriptor live_descriptor
  local handoff_root live_root public_handoff_file public_live_file
  local public_identity open_identity index
  local library_identity_value library_descriptor open_library
  local -a receipt_files=(
    library.manifest.tsv
    library.identity.tsv
    packages.tsv
    receipt.tsv
    receipt.sha256
  )
  local -a sorted_receipt_files observed_entries
  mapfile -t sorted_receipt_files < <(
    printf '%s\n' "${receipt_files[@]}" | LC_ALL=C sort
  )
  case "$handoff" in
    "$ROOT/.local/checks/"*) ;;
    *) fail "verified receipt handoff is outside the retained stage tree: $handoff" ;;
  esac
  relative=${handoff#"$ROOT/.local/checks/"}
  run_id=${relative%%/*}
  [[ "$run_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]] ||
    fail "verified receipt handoff has an invalid run ID"
  expected_handoff="$ROOT/.local/checks/$run_id/runtime-matrix/R-$version/artifacts/inputs/dependency-library-receipt"
  [[ "$handoff" == "$expected_handoff" ]] ||
    fail "verified receipt handoff is not the exact runtime stage input"
  require_plain_directory "$handoff"
  handoff_identity=$(path_identity "$handoff")
  exec {handoff_descriptor}< "$handoff"
  verify_open_directory "$handoff_descriptor" "$handoff" "$handoff_identity" \
    "verified receipt handoff"
  handoff_root="/proc/$$/fd/$handoff_descriptor"
  mapfile -d '' -t observed_entries < <(
    find -H "$handoff_root" -mindepth 1 -maxdepth 1 -printf '%f\0' |
      LC_ALL=C sort -z
  )
  [[ ${#observed_entries[@]} -eq ${#sorted_receipt_files[@]} ]] ||
    fail "verified receipt handoff has unexpected entries"
  for index in "${!sorted_receipt_files[@]}"; do
    [[ "${observed_entries[$index]}" == "${sorted_receipt_files[$index]}" ]] ||
      fail "verified receipt handoff has unexpected entries"
  done
  require_plain_directory "$library"
  library_identity_value=$(path_identity "$library")
  exec {library_descriptor}< "$library"
  verify_open_directory "$library_descriptor" "$library" \
    "$library_identity_value" "sealed dependency library"
  open_library="/proc/$$/fd/$library_descriptor"
  require_plain_directory "$receipt_directory"
  live_identity=$(path_identity "$receipt_directory")
  exec {live_descriptor}< "$receipt_directory"
  verify_open_directory "$live_descriptor" "$receipt_directory" "$live_identity" \
    "live dependency-library receipt"
  live_root="/proc/$$/fd/$live_descriptor"
  observed_entries=()
  mapfile -d '' -t observed_entries < <(
    find -H "$live_root" -mindepth 1 -maxdepth 1 -printf '%f\0' |
      LC_ALL=C sort -z
  )
  [[ ${#observed_entries[@]} -eq ${#sorted_receipt_files[@]} ]] ||
    fail "live dependency-library receipt has unexpected entries"
  for index in "${!sorted_receipt_files[@]}"; do
    [[ "${observed_entries[$index]}" == "${sorted_receipt_files[$index]}" ]] ||
      fail "live dependency-library receipt has unexpected entries"
  done
  for handoff_file in "${receipt_files[@]}"; do
    public_handoff_file="$handoff/$handoff_file"
    public_live_file="$receipt_directory/$handoff_file"
    require_plain_file "$public_handoff_file"
    require_plain_file "$public_live_file"
    require_open_regular_file "$handoff_root/$handoff_file" \
      "verified receipt handoff file"
    require_open_regular_file "$live_root/$handoff_file" \
      "live dependency-library receipt file"
    public_identity=$(path_identity "$public_handoff_file")
    open_identity=$(/usr/bin/stat -Lc '%d:%i' \
      "$handoff_root/$handoff_file")
    [[ "$public_identity" == "$open_identity" ]] ||
      fail "verified receipt handoff file was substituted: $public_handoff_file"
    public_identity=$(path_identity "$public_live_file")
    open_identity=$(/usr/bin/stat -Lc '%d:%i' "$live_root/$handoff_file")
    [[ "$public_identity" == "$open_identity" ]] ||
      fail "live dependency-library receipt file was substituted: $public_live_file"
    cmp -s -- "$handoff_root/$handoff_file" \
      "$live_root/$handoff_file" ||
      fail "verified receipt handoff differs from the live sealed receipt"
  done
  local manifest="$live_root/library.manifest.tsv"
  local identity_manifest="$live_root/library.identity.tsv"
  local receipt="$live_root/receipt.tsv"
  local seal="$live_root/receipt.sha256"
  write_library_identity "$open_library" |
    cmp -s -- "$identity_manifest" - ||
    fail "dependency-library identity receipt differs from the live tree"
  cmp -s -- "$handoff_root/receipt.tsv" <(write_expected_receipt) ||
    fail "verified receipt handoff is stale for current authenticated inputs"
  expected_handoff_seal="$(sha256_file "$handoff_root/receipt.tsv")  receipt.tsv"
  [[ $(wc -l < "$handoff_root/receipt.sha256") -eq 1 &&
    "$(<"$handoff_root/receipt.sha256")" == "$expected_handoff_seal" ]] ||
    fail "verified receipt handoff seal is malformed or stale"
  expected_live_seal="$(sha256_file "$receipt")  receipt.tsv"
  [[ $(wc -l < "$seal") -eq 1 && "$(<"$seal")" == "$expected_live_seal" ]] ||
    fail "live dependency-library receipt seal is malformed or stale"
  verify_open_directory "$handoff_descriptor" "$handoff" "$handoff_identity" \
    "verified receipt handoff"
  verify_open_directory "$live_descriptor" "$receipt_directory" "$live_identity" \
    "live dependency-library receipt"
  verify_open_directory "$library_descriptor" "$library" \
    "$library_identity_value" "sealed dependency library"
  exec {handoff_descriptor}<&-
  exec {live_descriptor}<&-
  exec {library_descriptor}<&-
}

