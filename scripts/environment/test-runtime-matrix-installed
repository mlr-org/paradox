#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
selection=${1:-all}
case "$selection" in
  all) versions=(4.3.3 4.5.2) ;;
  4.3.3|4.5.2) versions=("$selection") ;;
  *) echo "usage: scripts/environment/test-runtime-matrix-installed [4.3.3|4.5.2|all]" >&2; exit 2 ;;
esac

for version in "${versions[@]}"; do
  env \
    HOME="$HOME" \
    PATH="/usr/bin:/bin" \
    R_HOME=/tmp/host-r \
    R_LIBS=/tmp/host-library \
    R_LIBS_USER=/tmp/host-user-library \
    R_LIBS_SITE=/tmp/host-site-library \
    R_ENVIRON_USER=/tmp/host-renviron \
    R_PROFILE_USER=/tmp/host-rprofile \
    R_MAKEVARS_USER=/tmp/host-makevars \
    CC=/tmp/host-cc \
    CPPFLAGS=-I/tmp/host-include \
    LDFLAGS=-L/tmp/host-lib \
    LD_LIBRARY_PATH=/tmp/host-lib \
    PKG_CONFIG_PATH=/tmp/host-pkgconfig \
    XDG_RUNTIME_DIR=/tmp/host-runtime \
    CCACHE_TEMPDIR=/tmp/host-ccache \
    bash -s -- "$ROOT" "$version" <<'SHELL'
set -euo pipefail
root=$1
version=$2
cd "$root"
. scripts/activate-runtime-matrix "$version"
prefix="$root/.local/runtime-matrix/prefixes/R-$version"
[[ "$PARADOX_ACTIVE_ROOT" == "$root" ]]
[[ "$PARADOX_RUNTIME_MATRIX_ACTIVE" == 1 ]]
[[ "$PARADOX_RUNTIME_MATRIX_VERSION" == "$version" ]]
[[ "$(command -v R)" == "$prefix/bin/R" ]]
[[ "$(command -v Rscript)" == "$prefix/bin/Rscript" ]]
[[ "$(R RHOME)" == "$prefix/lib/R" ]]
[[ "$(Rscript --vanilla -e 'cat(as.character(getRversion()))')" == "$version" ]]
[[ "$R_LIBS_USER" == "$root/.local/runtime-matrix/libraries/R-$version" ]]
[[ "$TMPDIR" == "$root/.local/runtime-matrix/tmp/R-$version" ]]
[[ "$XDG_RUNTIME_DIR" == "$root/.local/runtime-matrix/runtime/R-$version" ]]
[[ "$(stat -c '%a' "$XDG_RUNTIME_DIR")" == 700 ]]
Rscript --vanilla -e '
  root <- normalizePath(commandArgs(TRUE)[[1L]], mustWork = TRUE)
  paths <- normalizePath(.libPaths(), mustWork = TRUE)
  stopifnot(length(paths) >= 2L)
  stopifnot(all(startsWith(paths, paste0(root, .Platform$file.sep))))
  stopifnot(!any(startsWith(paths, "/usr/") | startsWith(paths, "/tmp/host")))
' "$root"
first_path=$PATH
first_cflags=$CFLAGS
first_cppflags=$CPPFLAGS
first_ldflags=$LDFLAGS
first_debug_cflags=$DEBUG_CFLAGS
first_cmake_args=$CMAKE_ARGS
. scripts/activate-runtime-matrix "$version"
[[ "$PATH" == "$first_path" ]]
[[ "$CFLAGS" == "$first_cflags" ]]
[[ "$CPPFLAGS" == "$first_cppflags" ]]
[[ "$LDFLAGS" == "$first_ldflags" ]]
[[ "$DEBUG_CFLAGS" == "$first_debug_cflags" ]]
[[ "$CMAKE_ARGS" == "$first_cmake_args" ]]
[[ "$(command -v R)" == "$prefix/bin/R" ]]
configured_cc=$(R CMD config CC)
case "$(command -v "${configured_cc%% *}")" in "$prefix"/*) ;; *) exit 1 ;; esac
case "$(command -v "${CC%% *}")" in "$prefix"/*) ;; *) exit 1 ;; esac
SHELL
  printf 'runtime_matrix_activation_fixture=passed runtime=%s\n' "$version"
done
