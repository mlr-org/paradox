set_rchk_policy_value() {
  local policy=$1 key=$2 value=$3 temporary
  temporary="$policy.new"
  chmod u+w "$policy"
  awk -F '\t' -v OFS='\t' -v target="$key" -v replacement="$value" '
    $1 == target { $2 = replacement; changed++ }
    { print }
    END { if (changed != 1) exit 1 }
  ' "$policy" > "$temporary"
  mv "$temporary" "$policy"
}

refresh_rchk_policy_hash() {
  local case_directory=$1 input=$2 key=$3 hash
  hash=$(sha256sum "$case_directory/policy/$input" | cut -d ' ' -f 1)
  set_rchk_policy_value "$case_directory/policy/policy.tsv" "$key" "$hash"
}

