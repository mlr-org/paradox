  printf 'summary\tcomplete\tpass\trecords_before_summary=%d;failures=0\n' \
    "$probe_records_before_summary" >> "$probe_result"
  if [[ "$FIXTURE_TESTS" == full ]]; then
    for checked_profile in check-as-cran check-depends-only; do
      printf '%s\n' "$checked_profile-ok" \
        > "$RUN_DIRECTORY/modes/strict-gcc/logs/$checked_profile.log"
      mkdir -p \
        "$RUN_DIRECTORY/modes/strict-gcc/$checked_profile/paradox.Rcheck"
      printf '%s\n' 'Status: OK' \
        > "$RUN_DIRECTORY/modes/strict-gcc/$checked_profile/paradox.Rcheck/00check.log"
    done
