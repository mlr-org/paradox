  > "$TEST_ROOT/reverse-dependency-preparation.log" 2>&1 || {
  cat "$TEST_ROOT/reverse-dependency-preparation.log" >&2
  fail "reverse-dependency preparation fixtures failed"
}
grep -qx 'reverse-dependency preparation fixtures: PASS' \
  "$TEST_ROOT/reverse-dependency-preparation.log" ||
  fail "reverse-dependency preparation fixture result is malformed"

printf '%s\n' "validation hardening helper tests passed"
