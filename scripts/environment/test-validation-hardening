      git-status.txt source-files.zlist; do
    : > "$RUN_DIRECTORY/metadata/$provenance"
  done
  write_functional_ledger_fixture
  write_source_manifest

  for mode in strict-gcc strict-clang; do
    mkdir -p "$RUN_DIRECTORY/modes/$mode/logs" \
      "$RUN_DIRECTORY/modes/$mode/artifacts" \
      "$RUN_DIRECTORY/modes/$mode/library/paradox/libs"
    printf '%s\n' install-ok > "$RUN_DIRECTORY/modes/$mode/logs/install.log"
    printf '%s\n' dso > "$RUN_DIRECTORY/modes/$mode/library/paradox/libs/paradox.so"
    sha256sum "$RUN_DIRECTORY/modes/$mode/library/paradox/libs/paradox.so" \
      > "$RUN_DIRECTORY/modes/$mode/artifacts/paradox.so.sha256"
    : > "$RUN_DIRECTORY/modes/$mode/installed.ok"
