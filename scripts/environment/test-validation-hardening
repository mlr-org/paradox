  sha256sum "$RUN_DIRECTORY/modes/analyzer-gcc/library/paradox/libs/paradox.so" \
    > "$RUN_DIRECTORY/modes/analyzer-gcc/artifacts/paradox.so.sha256"
  : > "$RUN_DIRECTORY/modes/analyzer-gcc/installed.ok"
  printf '%s\n' plist > "$RUN_DIRECTORY/modes/analyzer-clang/artifacts/reports/dummy.plist"
  sha256sum "$RUN_DIRECTORY/modes/analyzer-clang/artifacts/reports/dummy.plist" \
    > "$RUN_DIRECTORY/modes/analyzer-clang/artifacts/reports.sha256"
  printf '%s\n' cppcheck-ok > "$RUN_DIRECTORY/modes/cppcheck/logs/cppcheck.log"
  for evidence in registration dynamic-symbols program-headers dynamic-section; do
    printf '%s\n' "$evidence-ok" > "$RUN_DIRECTORY/modes/symbols/logs/$evidence.log"
  done
  printf '%s\n' '                 U R_GetBindingType' \
    > "$RUN_DIRECTORY/modes/symbols/logs/undefined-symbols.log"
  write_fixture_resource_evidence
  {
    printf 'mode\tstatus\tevidence\tsha256\n'
    for entry in \
      "strict-gcc strict-gcc/logs/tests-$FIXTURE_TESTS.log" \
      'strict-clang strict-clang/logs/tests-probes.log' \
      'analyzer-gcc analyzer-gcc/logs/install.log' \
      'analyzer-clang analyzer-clang/artifacts/reports.sha256' \
      'cppcheck cppcheck/logs/cppcheck.log' \
      'symbols symbols/logs/registration.log'; do
      mode=${entry%% *}
      evidence=${entry#* }
      printf '%s\t0\t%s\t%s\n' "$mode" "$evidence" \
        "$(sha256sum "$RUN_DIRECTORY/modes/$evidence" | cut -d ' ' -f 1)"
    done
  } > "$RUN_DIRECTORY/modes/tool-status.tsv"
  "$RSCRIPT" --vanilla "$TREE_HELPER" create "$RUN_DIRECTORY/source" \
    "$RUN_DIRECTORY/metadata/source-tree.tsv" >/dev/null
  "$RSCRIPT" --vanilla "$TREE_HELPER" create "$RUN_DIRECTORY/modes" \
    "$RUN_DIRECTORY/metadata/modes-tree.tsv" >/dev/null
  write_run_metadata
  write_completion
  printf '%s\n' 'status=passed' 'exit_code=0' \
    'finished_utc=2026-07-14T00:01:00Z' > "$RUN_DIRECTORY/metadata/result.txt"
  mkdir -p "$NATIVE_FIXTURE_CACHE"
  cp -a -- "$RUN_DIRECTORY" "$cached_fixture"
}

