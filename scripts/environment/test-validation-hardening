# Memory probe evidence is mode-specific and bound to the exact analyzed DSO.
# Exercise both dynamic memory modes without compiling a package or starting an
# analyzer, then prove that a substituted DSO and a structurally complete GCT
# result with no activation transition are rejected.
PROBE_VERIFIER="$ROOT/scripts/environment/verify-native-probes.R"
PROBE_MANIFEST="$ROOT/environment/native-routine-coverage.tsv"
PROBE_FIXTURE="$TEST_ROOT/memory-probes"
mkdir -p "$PROBE_FIXTURE"
printf '%s\n' 'fixture dso' > "$PROBE_FIXTURE/paradox.so"
probe_dso_sha=$(sha256sum "$PROBE_FIXTURE/paradox.so" | cut -d ' ' -f 1)
write_memory_probe_fixture() {
  local mode=$1 result=$2 records
  {
    printf 'kind\tid\tstatus\tdetail\n'
    printf 'meta\tschema\tpass\t1\n'
    printf 'meta\tmode\tpass\t%s\n' "$mode"
    printf 'meta\trounds\tpass\t1\n'
    if [[ "$mode" == gct ]]; then
      printf 'meta\tgct_step\tpass\t10\n'
    else
      printf 'meta\tgct_step\tpass\tdisabled\n'
    fi
    printf 'meta\tcandidate_version\tpass\t2.0.0\n'
    printf 'meta\tdso_sha256\tpass\t%s\n' "$probe_dso_sha"
    printf 'meta\tdynamic_lookup\tpass\tfalse\n'
    printf 'meta\tforce_symbols\tpass\ttrue\n'
    awk -F '\t' 'NR > 1 {
      printf "registration\t%s\tpass\tarity=%s\n", $1, $2
    }' "$PROBE_MANIFEST"
    awk -F '\t' 'NR > 1 {
      printf "probe\tdirect_%s\tpass\trounds=1\n", $1
    }' "$PROBE_MANIFEST"
    for hazard in hazard_altrep_snapshot_reentry \
        hazard_callback_reentry_rooting hazard_finalizer_column_mutation \
        hazard_finalize_names_alias; do
      printf 'hazard\t%s\tpass\trounds=1\n' "$hazard"
    done
    if [[ "$mode" == gct ]]; then
      printf 'gct\ttransition\tpass\tprevious=0;active=10;restored=0\n'
    fi
  } > "$result"
  records=$(( $(wc -l < "$result") - 1 ))
  printf 'summary\tcomplete\tpass\trecords_before_summary=%s;failures=0\n' \
    "$records" >> "$result"
}
write_memory_probe_fixture gct "$PROBE_FIXTURE/gct.tsv"
write_memory_probe_fixture valgrind "$PROBE_FIXTURE/valgrind.tsv"
"$EVIDENCE_HELPER" native-probes "$RSCRIPT" "$PROBE_VERIFIER" \
  "$PROBE_MANIFEST" "$PROBE_FIXTURE/gct.tsv" gct \
  "$PROBE_FIXTURE/paradox.so" >/dev/null
"$EVIDENCE_HELPER" native-probes "$RSCRIPT" "$PROBE_VERIFIER" \
  "$PROBE_MANIFEST" "$PROBE_FIXTURE/valgrind.tsv" valgrind \
  "$PROBE_FIXTURE/paradox.so" >/dev/null
awk -F '\t' '
  $1 == "gct" && $2 == "transition" { next }
  $1 == "summary" { next }
  { print }
' "$PROBE_FIXTURE/gct.tsv" > "$PROBE_FIXTURE/gct-no-transition.tsv"
probe_records_before_summary=$((
  $(wc -l < "$PROBE_FIXTURE/gct-no-transition.tsv") - 1
))
printf 'summary\tcomplete\tpass\trecords_before_summary=%d;failures=0\n' \
  "$probe_records_before_summary" >> "$PROBE_FIXTURE/gct-no-transition.tsv"
expect_failure "$EVIDENCE_HELPER" native-probes "$RSCRIPT" "$PROBE_VERIFIER" \
  "$PROBE_MANIFEST" "$PROBE_FIXTURE/gct-no-transition.tsv" gct \
  "$PROBE_FIXTURE/paradox.so"
