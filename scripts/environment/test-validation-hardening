#!/usr/bin/env bash
# shellcheck disable=SC2016 # literal source-code patterns in structural tests

# Lightweight adversarial tests for validation receipts and source-run policy.
# This deliberately does not build R, install packages, or start containers.

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
TOOLCHAIN="$ROOT/.local/toolchain"
RSCRIPT="$TOOLCHAIN/bin/Rscript"
TREE_HELPER="$ROOT/scripts/environment/tree-receipt.R"
SOURCE_VALIDATOR="$ROOT/scripts/environment/validate-native-source-run"
RECEIPT_HELPER="$ROOT/scripts/environment/valgrind-receipts"
EVIDENCE_HELPER="$ROOT/scripts/environment/validate-memory-evidence"
API_TOKEN_AUDITOR="$ROOT/scripts/environment/audit-public-api-tokens"
API_COMPATIBILITY_GATE="$ROOT/scripts/check-r-api-compatibility"
COMPILER_BATCH_RUNNER="$ROOT/scripts/environment/run-compiler-batch"
COMPILER_WAVE_RUNNER="$ROOT/scripts/environment/run-compiler-wave"
REVERSE_DEPENDENCY_PREP_TEST="$ROOT/scripts/environment/test-reverse-dependency-preparation.R"
SNAPSHOT_HELPER="$ROOT/scripts/environment/snapshot-worktree.R"
COPY_SNAPSHOT_HELPER="$ROOT/scripts/environment/copy-check-snapshot.R"
CANDIDATE_GIT_AUTHENTICATOR="$ROOT/compat/authenticate-candidate-git"
CLANG="$TOOLCHAIN/bin/x86_64-conda-linux-gnu-clang"
PACKAGE_MANIFEST="$ROOT/environment/valgrind-r-packages.tsv"
mkdir -p "$ROOT/.local/tmp" "$ROOT/.local/checks"
TEST_ROOT=$(mktemp -d "$ROOT/.local/tmp/validation-hardening.XXXXXX")
RUN_ID="validation-helper-test-$$"
RUN_DIRECTORY="$ROOT/.local/checks/$RUN_ID"
NATIVE_FIXTURE_CACHE="$TEST_ROOT/native-fixture-cache"

cleanup() {
  local status=$?
  if [[ "$status" -ne 0 &&
      "${PARADOX_KEEP_HARDENING_FAILURES:-false}" == true ]]; then
    printf '%s\n' \
      "retained failed hardening fixtures: $TEST_ROOT $RUN_DIRECTORY" >&2
    return
  fi
  rm -rf "$TEST_ROOT" "$RUN_DIRECTORY"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
  printf '%s\n' "test-validation-hardening: $*" >&2
  exit 1
}

expect_failure() {
  if "$@" > "$TEST_ROOT/unexpected-success.log" 2>&1; then
    cat "$TEST_ROOT/unexpected-success.log" >&2
    fail "command unexpectedly succeeded: $*"
  fi
}

[[ -x "$RSCRIPT" ]] || fail "local Rscript is missing"
[[ -x "$SOURCE_VALIDATOR" && -x "$RECEIPT_HELPER" && \
    -x "$EVIDENCE_HELPER" && -x "$API_TOKEN_AUDITOR" && -x "$CLANG" && \
    -x "$COMPILER_BATCH_RUNNER" && -x "$COMPILER_WAVE_RUNNER" && \
    -x "$REVERSE_DEPENDENCY_PREP_TEST" && \
    -x "$CANDIDATE_GIT_AUTHENTICATOR" ]] ||
  fail "validation helpers are not executable"
[[ -f "$SNAPSHOT_HELPER" && ! -L "$SNAPSHOT_HELPER" && \
    -f "$COPY_SNAPSHOT_HELPER" && ! -L "$COPY_SNAPSHOT_HELPER" ]] ||
  fail "snapshot helpers are missing or symbolic"
for fast_preflight in test-resource-jobs test-compiler-batch \
    test-verification-economy test-memory-run-validator \
    test-bounded-rchk-bcheck-cache; do
  [[ -x "$ROOT/scripts/environment/$fast_preflight" &&
      ! -L "$ROOT/scripts/environment/$fast_preflight" ]] ||
    fail "fast verification preflight is missing: $fast_preflight"
  "$ROOT/scripts/environment/$fast_preflight" >/dev/null
done

# A dirty Git snapshot must distinguish a deleted tracked path from a symbolic
# link. Its retained replay must preserve that deletion instead of treating
# Sys.readlink()'s NA result for the absent path as a nonempty link target.
SNAPSHOT_FIXTURE="$TEST_ROOT/snapshot fixture"
SNAPSHOT_SOURCE="$SNAPSHOT_FIXTURE/source"
SNAPSHOT_DESTINATION="$SNAPSHOT_FIXTURE/snapshot"
SNAPSHOT_METADATA="$SNAPSHOT_FIXTURE/metadata"
SNAPSHOT_REPLAY="$SNAPSHOT_FIXTURE/replay"
SNAPSHOT_REPLAY_METADATA="$SNAPSHOT_FIXTURE/replay-metadata"
SNAPSHOT_TMP="$TEST_ROOT/snapshot-tmp"
mkdir -p "$SNAPSHOT_SOURCE" "$SNAPSHOT_TMP"
git -C "$SNAPSHOT_SOURCE" init -q
git -C "$SNAPSHOT_SOURCE" config user.name 'Paradox fixture'
git -C "$SNAPSHOT_SOURCE" config user.email 'fixture@example.invalid'
git -C "$SNAPSHOT_SOURCE" config commit.gpgsign false
printf '%s\n' retained > "$SNAPSHOT_SOURCE/retained.txt"
printf '%s\n' deleted > "$SNAPSHOT_SOURCE/deleted.txt"
ln -s retained.txt "$SNAPSHOT_SOURCE/retained-link"
git -C "$SNAPSHOT_SOURCE" add retained.txt deleted.txt retained-link
git -C "$SNAPSHOT_SOURCE" commit -q -m fixture
rm "$SNAPSHOT_SOURCE/deleted.txt"
printf '%s\n' untracked > "$SNAPSHOT_SOURCE/untracked.txt"
env TMPDIR="$SNAPSHOT_TMP" "$RSCRIPT" --vanilla "$SNAPSHOT_HELPER" \
  "$SNAPSHOT_SOURCE" "$SNAPSHOT_DESTINATION" "$SNAPSHOT_METADATA" \
  > "$SNAPSHOT_FIXTURE/snapshot.log"
grep -qx 'snapshot_files=3' "$SNAPSHOT_FIXTURE/snapshot.log" ||
  fail "dirty snapshot reported the wrong existing-file count"
grep -qx 'snapshot_deleted_tracked=1' "$SNAPSHOT_FIXTURE/snapshot.log" ||
  fail "dirty snapshot did not report its deleted tracked path"
[[ -f "$SNAPSHOT_DESTINATION/retained.txt" && \
    -f "$SNAPSHOT_DESTINATION/untracked.txt" && \
    -L "$SNAPSHOT_DESTINATION/retained-link" && \
    ! -e "$SNAPSHOT_DESTINATION/deleted.txt" ]] ||
  fail "dirty snapshot copied the wrong path set"
env TMPDIR="$SNAPSHOT_TMP" "$RSCRIPT" --vanilla "$COPY_SNAPSHOT_HELPER" \
  "$SNAPSHOT_DESTINATION" "$SNAPSHOT_METADATA" \
  "$SNAPSHOT_REPLAY" "$SNAPSHOT_REPLAY_METADATA" \
  > "$SNAPSHOT_FIXTURE/replay.log"
cmp "$SNAPSHOT_METADATA/source-manifest.tsv" \
  "$SNAPSHOT_REPLAY_METADATA/source-manifest.tsv" >/dev/null ||
  fail "snapshot replay changed the retained source manifest"
[[ -f "$SNAPSHOT_REPLAY/retained.txt" && \
    -f "$SNAPSHOT_REPLAY/untracked.txt" && \
    -L "$SNAPSHOT_REPLAY/retained-link" && \
    ! -e "$SNAPSHOT_REPLAY/deleted.txt" ]] ||
  fail "snapshot replay did not preserve the deleted tracked path"

# Frozen-candidate Git authentication rejects every state that can substitute
# bytes for an exported object identity: a dirty root or source worktree, a
# moved ref, a replacement ref, a graft, or inherited Git object/config input.
CANDIDATE_FIXTURE="$TEST_ROOT/candidate git fixture"
CANDIDATE_SOURCE_FIXTURE="$TEST_ROOT/candidate source fixture"
mkdir -p "$CANDIDATE_FIXTURE/.local/toolchain/bin"
ln "$TOOLCHAIN/bin/git" "$CANDIDATE_FIXTURE/.local/toolchain/bin/git"
ln -s "$TOOLCHAIN/lib" "$CANDIDATE_FIXTURE/.local/toolchain/lib"
CANDIDATE_GIT="$CANDIDATE_FIXTURE/.local/toolchain/bin/git"
PATH="$CANDIDATE_FIXTURE/.local/toolchain/bin:$PATH" \
  "$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" init -q
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" config user.name 'Paradox fixture'
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" config user.email \
  'fixture@example.invalid'
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" config commit.gpgsign false
printf '%s\n' '.local/' > "$CANDIDATE_FIXTURE/.gitignore"
printf '%s\n' canonical > "$CANDIDATE_FIXTURE/candidate.txt"
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" add .gitignore candidate.txt
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" commit -q -m canonical
CANDIDATE_COMMIT=$("$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" rev-parse HEAD)
CANDIDATE_TREE=$("$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" rev-parse 'HEAD^{tree}')
CANDIDATE_REF=refs/paradox-test/candidate
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" update-ref \
  "$CANDIDATE_REF" "$CANDIDATE_COMMIT"
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" worktree add -q --detach \
  "$CANDIDATE_SOURCE_FIXTURE" "$CANDIDATE_COMMIT"
CANDIDATE_AUTH_ENV=(env "PATH=$CANDIDATE_FIXTURE/.local/toolchain/bin:$PATH")
"${CANDIDATE_AUTH_ENV[@]}" "$CANDIDATE_GIT_AUTHENTICATOR" \
  "$CANDIDATE_FIXTURE" "$CANDIDATE_REF" "$CANDIDATE_COMMIT" \
  "$CANDIDATE_TREE" "$CANDIDATE_SOURCE_FIXTURE" >/dev/null

printf '%s\n' dirty > "$CANDIDATE_FIXTURE/untracked.txt"
expect_failure "${CANDIDATE_AUTH_ENV[@]}" "$CANDIDATE_GIT_AUTHENTICATOR" \
  "$CANDIDATE_FIXTURE" "$CANDIDATE_REF" "$CANDIDATE_COMMIT" "$CANDIDATE_TREE"
rm "$CANDIDATE_FIXTURE/untracked.txt"

printf '%s\n' dirty > "$CANDIDATE_SOURCE_FIXTURE/untracked.txt"
expect_failure "${CANDIDATE_AUTH_ENV[@]}" "$CANDIDATE_GIT_AUTHENTICATOR" \
  "$CANDIDATE_FIXTURE" "$CANDIDATE_REF" "$CANDIDATE_COMMIT" \
  "$CANDIDATE_TREE" "$CANDIDATE_SOURCE_FIXTURE"
rm "$CANDIDATE_SOURCE_FIXTURE/untracked.txt"

"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" update-index \
  --assume-unchanged candidate.txt
expect_failure "${CANDIDATE_AUTH_ENV[@]}" "$CANDIDATE_GIT_AUTHENTICATOR" \
  "$CANDIDATE_FIXTURE" "$CANDIDATE_REF" "$CANDIDATE_COMMIT" "$CANDIDATE_TREE"
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" update-index \
  --no-assume-unchanged candidate.txt

"$CANDIDATE_GIT" -C "$CANDIDATE_SOURCE_FIXTURE" update-index \
  --skip-worktree candidate.txt
expect_failure "${CANDIDATE_AUTH_ENV[@]}" "$CANDIDATE_GIT_AUTHENTICATOR" \
  "$CANDIDATE_FIXTURE" "$CANDIDATE_REF" "$CANDIDATE_COMMIT" \
  "$CANDIDATE_TREE" "$CANDIDATE_SOURCE_FIXTURE"
"$CANDIDATE_GIT" -C "$CANDIDATE_SOURCE_FIXTURE" update-index \
  --no-skip-worktree candidate.txt

printf '%s\n' "$CANDIDATE_FIXTURE/.git/objects" \
  > "$CANDIDATE_FIXTURE/.git/objects/info/alternates"
expect_failure "${CANDIDATE_AUTH_ENV[@]}" "$CANDIDATE_GIT_AUTHENTICATOR" \
  "$CANDIDATE_FIXTURE" "$CANDIDATE_REF" "$CANDIDATE_COMMIT" "$CANDIDATE_TREE"
rm "$CANDIDATE_FIXTURE/.git/objects/info/alternates"

"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" config core.fsmonitor \
  /definitely/absent/paradox-fsmonitor
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" config core.untrackedCache true
"${CANDIDATE_AUTH_ENV[@]}" "$CANDIDATE_GIT_AUTHENTICATOR" \
  "$CANDIDATE_FIXTURE" "$CANDIDATE_REF" "$CANDIDATE_COMMIT" \
  "$CANDIDATE_TREE" "$CANDIDATE_SOURCE_FIXTURE" >/dev/null
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" config --unset core.fsmonitor
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" config --unset core.untrackedCache
grep -Fq 'core.fsmonitor=false' "$CANDIDATE_GIT_AUTHENTICATOR" ||
  fail "candidate Git authentication does not disable filesystem monitors"
grep -Fq 'core.untrackedCache=false' "$CANDIDATE_GIT_AUTHENTICATOR" ||
  fail "candidate Git authentication does not disable the untracked cache"

printf '%s\n' replacement > "$CANDIDATE_FIXTURE/candidate.txt"
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" add candidate.txt
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" commit -q -m replacement
REPLACEMENT_COMMIT=$("$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" rev-parse HEAD)
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" checkout -q --detach \
  "$CANDIDATE_COMMIT"
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" replace \
  "$CANDIDATE_COMMIT" "$REPLACEMENT_COMMIT"
expect_failure "${CANDIDATE_AUTH_ENV[@]}" "$CANDIDATE_GIT_AUTHENTICATOR" \
  "$CANDIDATE_FIXTURE" "$CANDIDATE_REF" "$CANDIDATE_COMMIT" "$CANDIDATE_TREE"
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" archive --format=tar \
  -o "$TEST_ROOT/unsafe-replacement.tar" "$CANDIDATE_COMMIT"
GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
  GIT_CONFIG_NOSYSTEM=1 GIT_NO_REPLACE_OBJECTS=1 \
  "$CANDIDATE_GIT" --no-replace-objects -c tar.umask=0002 \
  -C "$CANDIDATE_FIXTURE" archive --format=tar \
  -o "$TEST_ROOT/safe-replacement.tar" "$CANDIDATE_COMMIT"
[[ $(tar -xOf "$TEST_ROOT/unsafe-replacement.tar" candidate.txt) == replacement &&
   $(tar -xOf "$TEST_ROOT/safe-replacement.tar" candidate.txt) == canonical ]] ||
  fail "replacement-disabled archive did not preserve canonical candidate bytes"
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" replace -d "$CANDIDATE_COMMIT" \
  >/dev/null

printf '%s\n' "$REPLACEMENT_COMMIT" > "$CANDIDATE_FIXTURE/.git/info/grafts"
expect_failure "${CANDIDATE_AUTH_ENV[@]}" "$CANDIDATE_GIT_AUTHENTICATOR" \
  "$CANDIDATE_FIXTURE" "$CANDIDATE_REF" "$CANDIDATE_COMMIT" "$CANDIDATE_TREE"
rm "$CANDIDATE_FIXTURE/.git/info/grafts"

printf '%s\n' 'candidate.txt export-ignore' \
  > "$CANDIDATE_FIXTURE/.git/info/attributes"
expect_failure "${CANDIDATE_AUTH_ENV[@]}" "$CANDIDATE_GIT_AUTHENTICATOR" \
  "$CANDIDATE_FIXTURE" "$CANDIDATE_REF" "$CANDIDATE_COMMIT" "$CANDIDATE_TREE"
rm "$CANDIDATE_FIXTURE/.git/info/attributes"

mkdir -p "$TEST_ROOT/git-home/.config/git"
printf '%s\n' 'candidate.txt export-ignore' \
  > "$TEST_ROOT/git-home/.config/git/attributes"
printf '%s\n' '[tar]' '  umask = 0777' > "$TEST_ROOT/git-home/.gitconfig"
printf '%s\n' '[tar]' '  umask = 0777' > "$TEST_ROOT/git-system.config"
GIT_ATTR_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
  GIT_CONFIG_NOSYSTEM=1 GIT_NO_REPLACE_OBJECTS=1 \
  "$CANDIDATE_GIT" --no-replace-objects -c core.attributesFile=/dev/null \
  -c tar.umask=0002 -C "$CANDIDATE_FIXTURE" archive --format=tar \
  -o "$TEST_ROOT/baseline-canonical.tar" "$CANDIDATE_COMMIT"
"$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" config tar.umask 0777
HOME="$TEST_ROOT/git-home" GIT_CONFIG_SYSTEM="$TEST_ROOT/git-system.config" \
  "$CANDIDATE_GIT" -C "$CANDIDATE_FIXTURE" \
  archive --format=tar -o "$TEST_ROOT/unsafe-attributes.tar" \
  "$CANDIDATE_COMMIT"
HOME="$TEST_ROOT/git-home" GIT_ATTR_NOSYSTEM=1 \
  GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
  GIT_CONFIG_NOSYSTEM=1 GIT_NO_REPLACE_OBJECTS=1 \
  "$CANDIDATE_GIT" --no-replace-objects -c core.attributesFile=/dev/null \
  -c tar.umask=0002 \
  -C "$CANDIDATE_FIXTURE" \
  archive --format=tar -o "$TEST_ROOT/safe-attributes.tar" "$CANDIDATE_COMMIT"
if tar -tf "$TEST_ROOT/unsafe-attributes.tar" | grep -qx candidate.txt; then
  fail "global attributes fixture did not alter the ordinary Git archive"
fi
tar -tf "$TEST_ROOT/safe-attributes.tar" | grep -qx candidate.txt ||
  fail "canonical Git archive did not disable global/system attributes"
[[ $(sha256sum "$TEST_ROOT/baseline-canonical.tar" | cut -d ' ' -f 1) == \
   $(sha256sum "$TEST_ROOT/safe-attributes.tar" | cut -d ' ' -f 1) ]] ||
  fail "hostile Git configuration changed the canonical archive SHA-256"
tar -tvf "$TEST_ROOT/baseline-canonical.tar" \
  > "$TEST_ROOT/baseline-canonical.modes"
tar -tvf "$TEST_ROOT/safe-attributes.tar" > "$TEST_ROOT/safe-attributes.modes"
cmp "$TEST_ROOT/baseline-canonical.modes" \
  "$TEST_ROOT/safe-attributes.modes" >/dev/null ||
  fail "hostile Git configuration changed canonical archive modes"
for archive_harness in \
    "$ROOT/compat/install-candidate" \
    "$ROOT/compat/test-repositories.R" \
    "$ROOT/compat/test-reverse-dependencies.R" \
    "$ROOT/compat/test-documentation" \
    "$ROOT/benchmarks/release.R"; do
  grep -Fq 'core.attributesFile=/dev/null' "$archive_harness" ||
    fail "candidate archive does not disable global attributes: $archive_harness"
  grep -Fq 'GIT_ATTR_NOSYSTEM' "$archive_harness" ||
    fail "candidate archive does not disable system attributes: $archive_harness"
  grep -Fq 'GIT_CONFIG_GLOBAL' "$archive_harness" ||
    fail "candidate archive does not isolate global Git config: $archive_harness"
  grep -Fq 'GIT_CONFIG_SYSTEM' "$archive_harness" ||
    fail "candidate archive does not isolate system Git config: $archive_harness"
  grep -Fq 'GIT_CONFIG_NOSYSTEM' "$archive_harness" ||
    fail "candidate archive does not disable system Git config: $archive_harness"
  grep -Fq 'tar.umask=0002' "$archive_harness" ||
    fail "candidate archive does not pin its permission mask: $archive_harness"
  grep -Fq 'GIT_NO_REPLACE_OBJECTS' "$archive_harness" ||
    fail "candidate archive does not disable object replacement: $archive_harness"
  grep -Fq -- '--no-replace-objects' "$archive_harness" ||
    fail "candidate archive lacks Git's replacement-disable option: $archive_harness"
done

# processx::run() accepts timeout values in seconds. Keep the documentation
# harness's public seconds contract connected to the actual retained command.
"$RSCRIPT" --vanilla - "$ROOT/compat/test-documentation" <<'RSCRIPT'
path <- commandArgs(TRUE)[[1L]]
expected_documentation_sha256 <-
  "ebc713a061bf1576fa5a5ca9818575bb0bce826a3425be672620c7c7921803ec"
if (!identical(unname(tools::sha256sum(path)), expected_documentation_sha256)) {
  stop("documentation timeout source snapshot changed", call. = FALSE)
}
missing_argument <- unname(as.list(alist(value = )))
ast_sha256 <- function(tree) {
  payload <- serialize(tree, NULL, version = 3L, xdr = TRUE)
  temporary <- tempfile("paradox-timeout-ast-")
  on.exit(unlink(temporary), add = TRUE)
  connection <- file(temporary, open = "wb")
  writeBin(payload, connection)
  close(connection)
  unname(tools::sha256sum(temporary))
}
timeout_records <- function(tree) {
  records <- list()
  walk <- function(x) {
    if (is.call(x) || is.pairlist(x)) {
      elements <- as.list(x)
      positions <- as.integer(which(names(elements) == "timeout"))
      if (length(positions)) {
        records[[length(records) + 1L]] <<- list(
          node = x, positions = positions
        )
      }
    }
    if (is.expression(x) || is.call(x) || is.pairlist(x)) {
      elements <- as.list(x)
      for (i in seq_along(elements)) {
        if (!identical(unname(elements[i]), missing_argument)) walk(elements[[i]])
      }
    }
    invisible(NULL)
  }
  walk(tree)
  records
}
contains_symbol <- function(tree, symbol) {
  if (is.symbol(tree)) return(identical(tree, symbol))
  if (!is.expression(tree) && !is.call(tree) && !is.pairlist(tree)) {
    return(FALSE)
  }
  elements <- as.list(tree)
  any(vapply(seq_along(elements), function(i) {
    !identical(unname(elements[i]), missing_argument) &&
      contains_symbol(elements[[i]], symbol)
  }, logical(1L)))
}
head_matches <- function(head, choices) {
  any(vapply(choices, function(choice) identical(head, choice), logical(1L)))
}
binding_records <- function(tree, symbol) {
  records <- list()
  walk <- function(x) {
    if (is.call(x)) {
      head <- x[[1L]]
      if (head_matches(head, list(quote(`<-`), quote(`<<-`), quote(`=`))) &&
          length(x) >= 3L && contains_symbol(x[[2L]], symbol)) {
        records[[length(records) + 1L]] <<- x
      } else if (head_matches(head, list(
        quote(assign), quote(delayedAssign), quote(makeActiveBinding)
      )) && length(x) >= 2L &&
          identical(x[[2L]], as.character(symbol))) {
        records[[length(records) + 1L]] <<- x
      }
    }
    if (is.expression(x) || is.call(x) || is.pairlist(x)) {
      elements <- as.list(x)
      for (i in seq_along(elements)) {
        if (!identical(unname(elements[i]), missing_argument)) walk(elements[[i]])
      }
    }
    invisible(NULL)
  }
  walk(tree)
  records
}
call_records <- function(tree, heads) {
  records <- list()
  walk <- function(x) {
    if (is.call(x) && (is.null(heads) || head_matches(x[[1L]], heads))) {
      records[[length(records) + 1L]] <<- x
    }
    if (is.expression(x) || is.call(x) || is.pairlist(x)) {
      elements <- as.list(x)
      for (i in seq_along(elements)) {
        if (!identical(unname(elements[i]), missing_argument)) walk(elements[[i]])
      }
    }
    invisible(NULL)
  }
  walk(tree)
  records
}
audit_timeout_ast <- function(tree, production = FALSE) {
  reject <- function(...) {
    stop("timeout AST audit: ", ..., call. = FALSE)
  }
  records <- timeout_records(tree)
  if (length(records) != 2L) {
    reject("expected two named timeout records, found ", length(records))
  }
  if (any(lengths(lapply(records, `[[`, "positions")) != 1L)) {
    reject("the named timeout must occupy exactly one numeric call position")
  }
  is_direct <- vapply(records, function(record) {
    is.call(record$node) &&
      identical(record$node[[1L]], quote(processx::run))
  }, logical(1L))
  is_default <- vapply(records, function(record) {
    is.call(record$node) && identical(record$node[[1L]], quote(list))
  }, logical(1L))
  if (sum(is_direct) != 1L || sum(is_default) != 1L) {
    reject("expected one direct processx::run timeout and one list default")
  }
  direct <- records[[which(is_direct)]]
  direct_argument <- unname(as.list(direct$node)[direct$positions])
  if (!identical(direct_argument, list(quote(timeout_seconds)))) {
    reject("the direct timeout argument is not the exact seconds symbol")
  }
  default <- records[[which(is_default)]]
  default_argument <- unname(as.list(default$node)[default$positions])
  if (!identical(default_argument, list(7200))) {
    reject("the command-line timeout default is not exactly 7200 seconds")
  }
  timeout_bindings <- binding_records(tree, quote(timeout_seconds))
  expected_timeout_rhs <- quote(
    suppressWarnings(as.numeric(options$timeout))
  )
  if (length(timeout_bindings) != 1L ||
      !identical(timeout_bindings[[1L]][[1L]], quote(`<-`)) ||
      !identical(timeout_bindings[[1L]][[2L]], quote(timeout_seconds)) ||
      !identical(timeout_bindings[[1L]][[3L]], expected_timeout_rhs)) {
    reject("timeout_seconds must have one exact seconds-valued binding")
  }
  is_timeout_index <- function(index) {
    identical(index, quote(timeout)) || identical(index, "timeout") ||
      identical(index, 1L) || identical(index, 1) ||
