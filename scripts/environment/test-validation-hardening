expect_failure "$EVIDENCE_HELPER" rchk "$RCHK_REPORTS" "$RCHK_LOG" \
  "$RCHK_ARTIFACTS"

# The build, bootstrap, and memory harnesses share this nonblocking exclusive
# flock protocol. A second process cannot enter while the descriptor is held.
LOCK_FIXTURE="$TEST_ROOT/valgrind-state.lock"
exec 8> "$LOCK_FIXTURE"
/usr/bin/flock -n -x 8
expect_failure /usr/bin/flock -n -x "$LOCK_FIXTURE" -c true
/usr/bin/flock -u 8
exec 8>&-
/usr/bin/flock -n -x "$LOCK_FIXTURE" -c true

# Transaction ownership is cleared immediately after the new library receipt
# verifies, before either obsolete backup is deleted. An interruption in the
# cleanup window therefore preserves the verified new pair.
PACKAGE_BOOTSTRAP="$ROOT/scripts/bootstrap-valgrind-r-packages"
verify_line=$(grep -n '^"\$RECEIPT_HELPER" verify-library ' \
  "$PACKAGE_BOOTSTRAP" | tail -n 1 | cut -d: -f1)
commit_line=$(awk -v start="$verify_line" \
  'NR > start && $0 == "LIBRARY_SELECTED=false" { print NR; exit }' \
  "$PACKAGE_BOOTSTRAP")
delete_line=$(grep -n '^rm -rf "\$obsolete_library"$' \
  "$PACKAGE_BOOTSTRAP" | cut -d: -f1)
[[ "$verify_line" -lt "$commit_line" && "$commit_line" -lt "$delete_line" ]] ||
  fail "package-library transaction commits after backup deletion"
DEBUG_BOOTSTRAP="$ROOT/scripts/bootstrap-valgrind-debug-symbols"
debug_verify_line=$(grep -n '^verify_receipt$' "$DEBUG_BOOTSTRAP" | tail -n 1 | cut -d: -f1)
debug_commit_line=$(awk -v start="$debug_verify_line" \
  'NR > start && $0 == "SELECTION_ACTIVE=false" { print NR; exit }' \
  "$DEBUG_BOOTSTRAP")
debug_delete_line=$(grep -n '^rm -rf "\$obsolete_prefix" "\$obsolete_receipt"$' \
  "$DEBUG_BOOTSTRAP" | cut -d: -f1)
[[ "$debug_verify_line" -lt "$debug_commit_line" && \
   "$debug_commit_line" -lt "$debug_delete_line" ]] ||
  fail "debug-symbol transaction commits after backup deletion"

# Production lock descriptors are append-opened and inode-checked; none may
# truncate the shared coordination path before flock is acquired.
for lock_harness in scripts/build-valgrind-r \
    scripts/bootstrap-valgrind-r-packages scripts/memory-check; do
  grep -Eq 'exec 9>>"\$(STATE_LOCK|VALGRIND_STATE_LOCK)"' \
    "$ROOT/$lock_harness" || fail "$lock_harness does not append-open its lock"
  if grep -Eq 'exec 9>"\$(STATE_LOCK|VALGRIND_STATE_LOCK)"' \
      "$ROOT/$lock_harness"; then
    fail "$lock_harness still truncates its shared lock"
  fi
done

"$RSCRIPT" --vanilla "$REVERSE_DEPENDENCY_PREP_TEST" \
  > "$TEST_ROOT/reverse-dependency-preparation.log" 2>&1 || {
  cat "$TEST_ROOT/reverse-dependency-preparation.log" >&2
  fail "reverse-dependency preparation fixtures failed"
}
grep -qx 'reverse-dependency preparation fixtures: PASS' \
  "$TEST_ROOT/reverse-dependency-preparation.log" ||
  fail "reverse-dependency preparation fixture result is malformed"

printf '%s\n' "validation hardening helper tests passed"
