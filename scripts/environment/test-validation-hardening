ln -s "$(printf 'missing\nline')" "$METADATA_ROOT/newline-link"
"$EVIDENCE_HELPER" metadata-fingerprint "$METADATA_ROOT" \
  "$METADATA_FIXTURE/output/first.sha256" >/dev/null
