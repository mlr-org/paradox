      printf 'test_that("%s", {\n  skip_on_cran()\n  expect_true(TRUE)\n})\n' \
        "$description" > "$RUN_DIRECTORY/source/tests/testthat/$file"
    elif [[ "$FIXTURE_TESTS" == full && ( $index -eq 13 || $index -eq 14 ) ]]; then
      printf 'skip_on_cran()\ntest_that("%s", expect_true(TRUE))\n' \
        "$description" > "$RUN_DIRECTORY/source/tests/testthat/$file"
    else
      printf 'test_that("%s", expect_true(TRUE))\n' "$description" \
        > "$RUN_DIRECTORY/source/tests/testthat/$file"
    fi
  done

  analyzer_files=(
    test-native-adversarial-storage.R
    test-native-altrep-lifetimes.R
    test-native-domain-kernels.R
    test-native-gctorture.R
    test-native-paramset-qunif.R
    test-native-paramset-trafo-gctorture.R
    test-native-paramset-value-mutation.R
    test-native-paramsetcollection-construction.R
  )
  for analyzer_file in "${analyzer_files[@]}"; do
    : > "$RUN_DIRECTORY/source/tests/testthat/$analyzer_file"
  done
  printf '%s\n' \
    'test_that("materialized and rejected inputs remain safe under forced collection", { skip_on_cran(); expect_true(TRUE) })' \
    >> "$RUN_DIRECTORY/source/tests/testthat/test-native-altrep-lifetimes.R"
  printf '%s\n' \
    'test_that("translated ParamUty diagnostics survive forced collection", { skip_on_cran(); expect_true(TRUE) })' \
    >> "$RUN_DIRECTORY/source/tests/testthat/test-native-domain-kernels.R"
  printf '%s\n' \
    'test_that("every allocating native entry point survives forced collection", { skip_on_cran(); expect_true(TRUE) })' \
    >> "$RUN_DIRECTORY/source/tests/testthat/test-native-gctorture.R"
  printf '%s\n' \
    'test_that("bulk qunif remains rooted under adversarial collection", { skip_on_cran(); expect_true(TRUE) })' \
    >> "$RUN_DIRECTORY/source/tests/testthat/test-native-paramset-qunif.R"
  printf '%s\n' \
    'test_that("authoritative ParamSet trafo survives forced collection", { skip_on_cran(); expect_true(TRUE) })' \
    >> "$RUN_DIRECTORY/source/tests/testthat/test-native-paramset-trafo-gctorture.R"
  printf '%s\n' \
    'test_that("batched nested collection name translation releases transient state", { skip_on_cran(); expect_true(TRUE) })' \
    >> "$RUN_DIRECTORY/source/tests/testthat/test-native-paramset-trafo-gctorture.R"
  printf '%s\n' \
    'test_that("live and detached mixed-encoding trafo names survive forced collection", { skip_on_cran(); expect_true(TRUE) })' \
    >> "$RUN_DIRECTORY/source/tests/testthat/test-native-paramset-trafo-gctorture.R"
  printf '%s\n' \
    'test_that("collection construction remains rooted under forced collection", { skip_on_cran(); expect_true(TRUE) })' \
    >> "$RUN_DIRECTORY/source/tests/testthat/test-native-paramsetcollection-construction.R"
  for analyzer_index in $(seq 1 8); do
    analyzer_file=${analyzer_files[$(( (analyzer_index - 1) % 8 ))]}
    printf 'test_that("analyzer passing block %03d", expect_true(TRUE))\n' \
      "$analyzer_index" \
      >> "$RUN_DIRECTORY/source/tests/testthat/$analyzer_file"
  done

  ledger="$RUN_DIRECTORY/modes/strict-gcc/artifacts/native-tests-$FIXTURE_TESTS.tsv"
  printf '%s\n' \
    $'kind\tschema\tselection\tnot_cran\tdso_sha256\tfile\tcontext\ttest\texpectations\tpassed\tfailed\tskipped\terrors\twarnings\tskip_reason\tdetail' \
    > "$ledger"
  for index in $(seq 1 "$block_count"); do
    if [[ $index -eq 1 ]]; then
      file=test-native-altrep-lifetimes.R
      description='materialized and rejected inputs remain safe under forced collection'
    elif [[ $index -eq 2 ]]; then
      file=test-native-domain-kernels.R
      description='translated ParamUty diagnostics survive forced collection'
    elif [[ $index -eq 3 ]]; then
      file=test-native-gctorture.R
      description='every allocating native entry point survives forced collection'
    elif [[ $index -eq 4 ]]; then
      file=test-native-paramset-qunif.R
      description='bulk qunif remains rooted under adversarial collection'
    elif [[ $index -eq 5 ]]; then
      file=test-native-paramset-trafo-gctorture.R
      description='authoritative ParamSet trafo survives forced collection'
    elif [[ $index -eq 6 ]]; then
      file=test-native-paramset-trafo-gctorture.R
      description='batched nested collection name translation releases transient state'
    elif [[ $index -eq 7 ]]; then
      file=test-native-paramset-trafo-gctorture.R
      description='live and detached mixed-encoding trafo names survive forced collection'
    elif [[ $index -eq 8 ]]; then
      file=test-native-paramsetcollection-construction.R
      description='collection construction remains rooted under forced collection'
    elif [[ $index -le 12 ]]; then
      scoped_index=$index
      file=$(fixture_test_file "$scoped_index")
      description=$(printf 'fixture test %03d' "$scoped_index")
    else
      file_count=$(( (index - 12) % selected_count + 1 ))
      file=$(fixture_test_file "$file_count")
      description=$(printf 'synthetic ledger block %03d' "$index")
    fi
    printf 'test\t1\t%s\tTRUE\t%s\t%s\tfixture\t%s\t20\t20\t0\t0\t0\t0\t-\t-\n' \
      "$FIXTURE_TESTS" "$fixture_dso_sha" "$file" "$description" >> "$ledger"
  done
  workers=${ledger%.tsv}-workers.tsv
  printf '%s\n' \
    $'schema\tselection\tjobs\ttask\tlane\tfiles\tdso_sha256_before\tdso_sha256_after\ttest_blocks\texpectations\tpassed\tfailed\tskipped\terrors\twarnings\tstatus' \
    > "$workers"
  worker_task=0
  while IFS= read -r worker_file; do
    if [[ "$FIXTURE_TESTS" == focused ]]; then
      case "$worker_file" in
        *characterization*|*native*|*regression*) ;;
        *) continue ;;
      esac
    fi
    worker_counts=$(awk -F '\t' -v file="$worker_file" '
      $1 == "test" && $6 == file {
        blocks += 1; expectations += $9; passed += $10; failed += $11
        skipped += $12; errors += $13; warnings += $14
      }
      END {
        printf "%d\t%d\t%d\t%d\t%d\t%d\t%d", blocks, expectations,
          passed, failed, skipped, errors, warnings
      }
    ' "$ledger")
    worker_task=$((worker_task + 1))
    printf '1\t%s\t4\t%03d\tparallel\t%s\t%s\t%s\t%s\tcomplete\n' \
      "$FIXTURE_TESTS" "$worker_task" "$worker_file" \
      "$fixture_dso_sha" "$fixture_dso_sha" "$worker_counts" >> "$workers"
  done < <(find "$RUN_DIRECTORY/source/tests/testthat" -type f \
    -printf '%f\n' | sort)
  [[ "$worker_task" -eq "$selected_count" ]] ||
    fail "fixture worker inventory does not match selected files"
  worker_sha=$(sha256sum "$workers" | cut -d ' ' -f 1)
  printf 'summary\t1\t%s\tTRUE\t%s\t-\t-\tcomplete\t%d\t%d\t0\t0\t0\t0\t-\tfiles=%d;test_blocks=%d;requested_jobs=4;effective_jobs=4;scheduler_backend=linux-isolated;worker_evidence_sha256=%s\n' \
    "$FIXTURE_TESTS" "$fixture_dso_sha" \
    "$((block_count * 20))" "$((block_count * 20))" \
    "$selected_count" "$block_count" "$worker_sha" >> "$ledger"
  printf '%s\n' ledger-ok \
    > "$RUN_DIRECTORY/modes/strict-gcc/logs/tests-$FIXTURE_TESTS-ledger.log"

  mkdir -p "$RUN_DIRECTORY/modes/strict-clang/logs" \
    "$RUN_DIRECTORY/modes/strict-clang/artifacts"
  analyzer_ledger="$RUN_DIRECTORY/modes/strict-clang/artifacts/native-tests-analyzer.tsv"
  printf '%s\n' \
    $'kind\tschema\tselection\tnot_cran\tdso_sha256\tfile\tcontext\ttest\texpectations\tpassed\tfailed\tskipped\terrors\twarnings\tskip_reason\tdetail' \
    > "$analyzer_ledger"
  printf 'test\t1\tanalyzer\tFALSE\t%s\t%s\tfixture\t%s\t1\t0\t0\t1\t0\t0\tReason: On CRAN\t-\n' \
    "$fixture_dso_sha" test-native-altrep-lifetimes.R \
    'materialized and rejected inputs remain safe under forced collection' \
    "$fixture_dso_sha" test-native-domain-kernels.R \
    'translated ParamUty diagnostics survive forced collection' \
    "$fixture_dso_sha" test-native-gctorture.R \
    'every allocating native entry point survives forced collection' \
    "$fixture_dso_sha" test-native-paramset-qunif.R \
    'bulk qunif remains rooted under adversarial collection' \
    "$fixture_dso_sha" test-native-paramset-trafo-gctorture.R \
    'authoritative ParamSet trafo survives forced collection' \
    "$fixture_dso_sha" test-native-paramset-trafo-gctorture.R \
    'batched nested collection name translation releases transient state' \
    "$fixture_dso_sha" test-native-paramset-trafo-gctorture.R \
    'live and detached mixed-encoding trafo names survive forced collection' \
    "$fixture_dso_sha" test-native-paramsetcollection-construction.R \
    'collection construction remains rooted under forced collection' \
    >> "$analyzer_ledger"
  for analyzer_index in $(seq 1 8); do
    analyzer_file=${analyzer_files[$(( (analyzer_index - 1) % 8 ))]}
    description=$(printf 'analyzer passing block %03d' "$analyzer_index")
    printf 'test\t1\tanalyzer\tFALSE\t%s\t%s\tfixture\t%s\t10\t10\t0\t0\t0\t0\t-\t-\n' \
      "$fixture_dso_sha" "$analyzer_file" "$description" >> "$analyzer_ledger"
  done
  analyzer_expectations=$((8 + 8 * 10))
  analyzer_passed=$((8 * 10))
  printf 'summary\t1\tanalyzer\tFALSE\t%s\t-\t-\tcomplete\t%d\t%d\t0\t8\t0\t0\t-\tfiles=8;test_blocks=16;requested_jobs=1;effective_jobs=1;scheduler_backend=serial\n' \
    "$fixture_dso_sha" "$analyzer_expectations" "$analyzer_passed" \
    >> "$analyzer_ledger"
  printf '%s\n' analyzer-tests-ok \
    > "$RUN_DIRECTORY/modes/strict-clang/logs/tests-analyzer.log"
  printf '%s\n' analyzer-ledger-ok \
    > "$RUN_DIRECTORY/modes/strict-clang/logs/tests-analyzer-ledger.log"
  printf '%s\n' analyzer-final-ledger-ok \
    > "$RUN_DIRECTORY/modes/strict-clang/logs/tests-analyzer-final-ledger.log"
}

build_valid_native_fixture() {
  local cached_fixture="$NATIVE_FIXTURE_CACHE/$FIXTURE_TESTS"
  case "$FIXTURE_TESTS" in
    focused|full) ;;
    *) fail "unsupported native fixture scope: $FIXTURE_TESTS" ;;
