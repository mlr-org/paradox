  mkdir -p "$RUN_DIRECTORY/modes/analyzer-gcc/logs" \
    "$RUN_DIRECTORY/modes/analyzer-gcc/artifacts" \
    "$RUN_DIRECTORY/modes/analyzer-gcc/library/paradox/libs" \
    "$RUN_DIRECTORY/modes/analyzer-clang/artifacts/reports" \
    "$RUN_DIRECTORY/modes/cppcheck/logs" "$RUN_DIRECTORY/modes/symbols/logs"
