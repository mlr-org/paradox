write_source_manifest() {
  local manifest="$RUN_DIRECTORY/metadata/source-manifest.tsv"
  printf '"path"\t"kind"\t"sha256_or_target"\t"size"\t"mode"\n' > "$manifest"
  for relative in environment/tinytex-linux-x86_64.tsv \
      environment/toolchain-linux-64.lock src/dummy.c; do
    path="$RUN_DIRECTORY/source/$relative"
