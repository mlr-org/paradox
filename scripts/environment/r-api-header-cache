require_managed_path() {
  local path=$1 current remainder component
  case "$path" in
    "$ROOT"|"$ROOT"/*) ;;
    *) fail "managed path escaped the repository: $path" ;;
  esac
  current=$ROOT
  remainder=${path#"$ROOT"}
  while [[ -n "$remainder" ]]; do
    remainder=${remainder#/}
    component=${remainder%%/*}
    if [[ "$component" == "$remainder" ]]; then
      remainder=
    else
      remainder=${remainder#*/}
    fi
    [[ -n "$component" ]] || continue
    [[ "$component" != . && "$component" != .. ]] ||
      fail "managed path contains a dot component: $path"
    current="$current/$component"
    [[ ! -L "$current" ]] || fail "managed path is symbolic: $current"
    [[ ! -e "$current" || -d "$current" ]] ||
      fail "managed directory path is not a directory: $current"
  done
}

