CURL_PREFLIGHT_COMPILE_POLICY=not-required
if [[ "$CURL_PREFLIGHT_REQUIRED" == true ]]; then
  CURL_PREFLIGHT_SOURCE_FILE="$CURL_PREFLIGHT_ROOT/probe.c"
  CURL_PREFLIGHT_BINARY="$CURL_PREFLIGHT_ROOT/probe"
  {
    printf '%s\n' \
      '#include <curl/curl.h>' \
      '#include <stdio.h>' \
      '#include <string.h>' \
      '' \
      'int main(void) {' \
      '  const curl_version_info_data *info = curl_version_info(CURLVERSION_NOW);' \
      '  const char *const *protocol;' \
      '  int have_https = 0;' \
      '  if (info == NULL) return 10;' \
      '  if (LIBCURL_VERSION_MAJOR != 7) return 11;' \
      '  if ((unsigned long) LIBCURL_VERSION_NUM < PARADOX_CURL_MINIMUM) return 12;' \
      '  if ((unsigned long) info->version_num != (unsigned long) LIBCURL_VERSION_NUM) return 13;' \
      '  for (protocol = info->protocols; protocol != NULL && *protocol != NULL; ++protocol) {' \
      '    if (strcmp(*protocol, "https") == 0) {' \
      '      have_https = 1;' \
      '      break;' \
      '    }' \
      '  }' \
      '  if (!have_https) return 14;' \
      '  printf("header_version_hex=%06lx\n", (unsigned long) LIBCURL_VERSION_NUM);' \
      '  printf("runtime_version_hex=%06lx\n", (unsigned long) info->version_num);' \
      '  printf("https=true\n");' \
      '  return 0;' \
      '}'
  } > "$CURL_PREFLIGHT_SOURCE_FILE"
  CURL_PREFLIGHT_SOURCE_SHA256=$(sha256_value "$CURL_PREFLIGHT_SOURCE_FILE")
  CURL_CONFIG_CFLAGS_VALUE=$(LC_ALL=C \
    "$CURL_CONFIG_EXECUTABLE" --cflags)
  CURL_CONFIG_LIBS_VALUE=$(LC_ALL=C "$CURL_CONFIG_EXECUTABLE" --libs)
  for flag_value in "$CPPFLAGS_VALUE" "$LDFLAGS_VALUE" \
      "$CURL_CONFIG_CFLAGS_VALUE" "$CURL_CONFIG_LIBS_VALUE"; do
    [[ "$flag_value" != *$'\t'* && "$flag_value" != *$'\r'* &&
       "$flag_value" != *$'\n'* ]] ||
      fail "libcurl preflight received flags with unsupported control bytes"
  done
  curl_cppflags=()
  curl_ldflags=()
  curl_config_cflags=()
  curl_config_libs=()
  read -r -a curl_cppflags <<< "$CPPFLAGS_VALUE"
  read -r -a curl_ldflags <<< "$LDFLAGS_VALUE"
  read -r -a curl_config_cflags <<< "$CURL_CONFIG_CFLAGS_VALUE"
  read -r -a curl_config_libs <<< "$CURL_CONFIG_LIBS_VALUE"
  CURL_PREFLIGHT_COMPILE_POLICY=gnu-c99-wall-wextra-werror-locked-curl7-v1
  if ! run_supervised_group "$COMMAND_TIMEOUT_SECONDS" \
      "libcurl compile proof R $VERSION" \
      "$ENV_EXECUTABLE" -i PATH="$CONFIGURE_PATH" LC_ALL=C LANG=C TZ=UTC \
      "$GCC" -std=gnu99 -O2 -g -Wall -Wextra -Werror \
      "${curl_cppflags[@]}" "${curl_config_cflags[@]}" \
      "-DPARADOX_CURL_MINIMUM=0x$CURL_PREFLIGHT_MINIMUM_HEX" \
      "$CURL_PREFLIGHT_SOURCE_FILE" \
      "${curl_ldflags[@]}" "${curl_config_libs[@]}" \
      -o "$CURL_PREFLIGHT_BINARY" \
      > "$LOG_DIRECTORY/curl-preflight-compile-R-${VERSION}.log" 2>&1; then
    fail "R $VERSION could not compile/link its authenticated libcurl proof"
  fi
  if ! run_supervised_group "$COMMAND_TIMEOUT_SECONDS" \
      "libcurl runtime proof R $VERSION" \
      "$ENV_EXECUTABLE" -i PATH="$CONFIGURE_PATH" LC_ALL=C LANG=C TZ=UTC \
      LD_LIBRARY_PATH="$LD_LIBRARY_PATH_VALUE" \
      "$CURL_PREFLIGHT_BINARY" \
      > "$CURL_PREFLIGHT_OUTPUT_FILE" \
      2> "$LOG_DIRECTORY/curl-preflight-run-R-${VERSION}.log"; then
    fail "R $VERSION libcurl proof failed at runtime"
  fi
  validate_curl_preflight_output "$CURL_PREFLIGHT_OUTPUT_FILE" \
    "$CURL_PREFLIGHT_MINIMUM_HEX" ||
    fail "R $VERSION libcurl proof returned malformed or insufficient evidence"
else
  printf 'status=not-required\n' > "$CURL_PREFLIGHT_OUTPUT_FILE"
fi
CURL_PREFLIGHT_OUTPUT_SHA256=$(sha256_value "$CURL_PREFLIGHT_OUTPUT_FILE")

{
