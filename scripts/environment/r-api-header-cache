  receipt_row curl_preflight_required "$CURL_PREFLIGHT_REQUIRED"
  receipt_row curl_preflight_minimum_hex "$CURL_PREFLIGHT_MINIMUM_HEX"
  receipt_row curl_preflight_source_sha256 \
    "$CURL_PREFLIGHT_SOURCE_SHA256"
  receipt_row curl_preflight_output_sha256 \
    "$CURL_PREFLIGHT_OUTPUT_SHA256"
  receipt_row curl_preflight_header_version_hex \
    "$CURL_PREFLIGHT_HEADER_VERSION_HEX"
  receipt_row curl_preflight_runtime_version_hex \
    "$CURL_PREFLIGHT_RUNTIME_VERSION_HEX"
  receipt_row curl_preflight_https "$CURL_PREFLIGHT_HTTPS"
  receipt_row curl_preflight_compile_policy \
    "$CURL_PREFLIGHT_COMPILE_POLICY"
  receipt_row curl_config_cflags "$CURL_CONFIG_CFLAGS_VALUE"
  receipt_row curl_config_libs "$CURL_CONFIG_LIBS_VALUE"
  receipt_row configure_arg_01 "--prefix=$CONFIGURE_PREFIX"
  receipt_row configure_arg_02 --without-x
  receipt_row configure_arg_03 --without-recommended-packages
  receipt_row configure_arg_04 --disable-java
  receipt_row configure_arg_05 --with-readline=no
  receipt_row configure_arg_06 --with-blas=no
  receipt_row configure_arg_07 --with-lapack=no
  receipt_row make_directory src/include
  receipt_row make_target_01 Rconfig.h
  receipt_row make_target_02 Rversion.h
  receipt_row make_argument_shell "SHELL=$SHELL_VALUE"
  receipt_row env_path "$CONFIGURE_PATH"
  receipt_row env_home isolated-cache-staging
  receipt_row env_tmpdir isolated-cache-staging
  receipt_row env_lc_all C
  receipt_row env_lang C
  receipt_row env_tz UTC
  receipt_row env_config_site /dev/null
  receipt_row env_config_shell "$CONFIG_SHELL_VALUE"
  receipt_row env_shell "$SHELL_VALUE"
  receipt_row env_cc "$CC_VALUE"
  receipt_row env_cflags "$CFLAGS_VALUE"
  receipt_row env_f77 "$F77_VALUE"
  receipt_row env_fflags "$FFLAGS_VALUE"
  receipt_row env_fc "$FC_VALUE"
  receipt_row env_fcflags "$FCFLAGS_VALUE"
  receipt_row env_cpp "$CPP_VALUE"
  receipt_row env_cppflags "$CPPFLAGS_VALUE"
  receipt_row env_cxx "$CXX_VALUE"
  receipt_row env_cxxflags "$CXXFLAGS_VALUE"
  receipt_row env_ar "$AR_VALUE"
  receipt_row env_as "$AS_VALUE"
  receipt_row env_ld "$LD_VALUE"
  receipt_row env_ldflags "$LDFLAGS_VALUE"
  receipt_row env_curl_config "$CURL_CONFIG_EXECUTABLE"
  receipt_row env_ld_library_path "$LD_LIBRARY_PATH_VALUE"
  receipt_row env_nm "$NM_VALUE"
  receipt_row env_ranlib "$RANLIB_VALUE"
  receipt_row env_strip "$STRIP_VALUE"
  receipt_row env_build "$BUILD_VALUE"
  receipt_row env_host "$HOST_VALUE"
  receipt_row env_conda_build_sysroot "$SYSROOT_VALUE"
  receipt_row env_pkg_config "$PKG_CONFIG_VALUE"
  receipt_row env_pkg_config_libdir "$PKG_CONFIG_LIBDIR_VALUE"
  receipt_row env_pkg_config_path "$PKG_CONFIG_PATH_VALUE"
  receipt_row platform_system "$(uname -s)"
  receipt_row platform_machine "$(uname -m)"
  receipt_row platform_long_bit "$(getconf LONG_BIT)"
  emit_tool_receipt gcc "$GCC"
  receipt_row gcc_target "$($GCC -dumpmachine)"
  emit_tool_receipt gfortran "$GFORTRAN"
  receipt_row gfortran_target "$($GFORTRAN -dumpmachine)"
  emit_tool_receipt make "$MAKE"
  emit_tool_receipt rscript "$RSCRIPT"
  emit_tool_receipt cpp "$CPP_EXECUTABLE"
  emit_tool_receipt cxx "$CXX_EXECUTABLE"
  emit_tool_receipt ar "$AR_EXECUTABLE"
  emit_tool_receipt as "$AS_EXECUTABLE"
  emit_tool_receipt ld "$LD_EXECUTABLE"
  emit_tool_receipt nm "$NM_EXECUTABLE"
  emit_tool_receipt ranlib "$RANLIB_EXECUTABLE"
  emit_tool_receipt strip "$STRIP_EXECUTABLE"
  emit_tool_receipt pkg_config "$PKG_CONFIG_EXECUTABLE"
  emit_tool_receipt curl_config "$CURL_CONFIG_EXECUTABLE"
  emit_tool_receipt env "$ENV_EXECUTABLE"
  emit_tool_receipt bash "$BASH_EXECUTABLE"
  emit_tool_receipt setsid "$SETSID"
  emit_tool_receipt flock "$FLOCK"
  receipt_row toolchain_lock_sha256 "$(sha256_value "$TOOLCHAIN_LOCK")"
} > "$INPUT_RECEIPT"

CACHE_KEY=$(sha256_value "$INPUT_RECEIPT")
ENTRY="$ENTRIES_ROOT/$CACHE_KEY"
LOCK_FILE="$LOCKS_ROOT/$CACHE_KEY.lock"
[[ ! -L "$LOCK_FILE" && ( ! -e "$LOCK_FILE" || -f "$LOCK_FILE" ) ]] ||
  fail "cache lock is symbolic or not a regular file: $LOCK_FILE"
exec {LOCK_FD}>"$LOCK_FILE"
lock_started=$SECONDS
until "$FLOCK" -x -n "$LOCK_FD"; do
  if ((SECONDS - lock_started >= LOCK_TIMEOUT_SECONDS)); then
    fail "timed out after ${LOCK_TIMEOUT_SECONDS}s waiting for cache key $CACHE_KEY"
  fi
  sleep 0.1
done
LOCK_WAIT_SECONDS=$((SECONDS - lock_started))

verify_recipe_sources_unchanged() {
  [[ "$(sha256_value "$HELPER_SOURCE")" == "$BUILDER_HELPER_SHA256" &&
     "$(sha256_value "$TREE_RECEIPT_HELPER")" == \
       "$TREE_RECEIPT_HELPER_SHA256" ]] ||
    fail "header-cache builder recipe changed during execution"
}

verify_curl7_inputs_unchanged() {
  [[ "$(sha256_value "$CURL_CONFIG_EXECUTABLE")" == \
       "$CURL_CONFIG_SELECTED_SHA256" ]] ||
    fail "authenticated libcurl7 inputs changed during header preparation"
  if [[ "$CURL_PREFLIGHT_REQUIRED" == true ]]; then
    [[ "$(sha256_value "$CURL7_MANIFEST")" == \
         "$CURL7_MANIFEST_SHA256" &&
       "$(sha256_value "$CURL7_RECEIPT")" == \
         "$CURL7_RECEIPT_SHA256" &&
       "$(sha256_value "$CURL7_SEAL")" == "$CURL7_SEAL_SHA256" &&
       "$(sha256_value "$CURL7_LOCK")" == "$CURL7_LOCK_SHA256" &&
       "$(sha256_value "$CURL7_RECEIPT_HELPER")" == \
         "$CURL7_RECEIPT_HELPER_SHA256" ]] ||
      fail "authenticated libcurl7 receipt inputs changed during preparation"
  fi
}

verify_tool_inventory_unchanged() {
  local observed
  observed=$(mktemp "$LOCAL_TMP/r-api-header-tools-post.XXXXXX")
  if ! create_external_tool_inventory "$observed" "$CONFIGURE_PATH" \
      "${CONFIGURE_TOOL_NAMES[@]}" ||
      ! cmp -s "$TOOL_INVENTORY" "$observed"; then
    rm -f -- "$observed"
    fail "configure/make tool inventory changed during cache construction"
  fi
  rm -f -- "$observed"
}

validate_headers_shape() {
  local headers=$1 generated_count
  [[ -d "$headers" && ! -L "$headers" &&
     -d "$headers/source" && ! -L "$headers/source" &&
     -d "$headers/generated" && ! -L "$headers/generated" &&
     -f "$headers/source/R.h" && ! -L "$headers/source/R.h" &&
     -f "$headers/source/Rinternals.h" && ! -L "$headers/source/Rinternals.h" &&
     -d "$headers/source/R_ext" && ! -L "$headers/source/R_ext" &&
     -f "$headers/generated/Rconfig.h" && ! -L "$headers/generated/Rconfig.h" &&
     -f "$headers/generated/Rversion.h" && ! -L "$headers/generated/Rversion.h" ]] ||
    return 1
  if find "$headers" -type l -print -quit | grep -q .; then
    return 1
  fi
  generated_count=$(find "$headers/generated" -mindepth 1 -maxdepth 1 \
    -type f -printf '.' | wc -c)
  [[ "$generated_count" -eq 2 ]] || return 1
  [[ -z "$(find "$headers/generated" -mindepth 1 -maxdepth 1 \
    ! -name Rconfig.h ! -name Rversion.h -print -quit)" ]] || return 1
}

validate_entry() {
  local entry=$1 input_sha receipt_sha tools_sha seal_sha
  local expected_members actual_members
  [[ -d "$entry" && ! -L "$entry" &&
     -f "$entry/inputs.tsv" && ! -L "$entry/inputs.tsv" &&
     -f "$entry/configure-tools.tsv" &&
     ! -L "$entry/configure-tools.tsv" &&
     -f "$entry/headers-tree.tsv" && ! -L "$entry/headers-tree.tsv" &&
     -f "$entry/seal.tsv" && ! -L "$entry/seal.tsv" &&
     -f "$entry/seal.sha256" && ! -L "$entry/seal.sha256" ]] || return 1
  expected_members=$'configure-tools.tsv\nheaders\nheaders-tree.tsv\ninputs.tsv\nseal.sha256\nseal.tsv'
  actual_members=$(find "$entry" -mindepth 1 -maxdepth 1 -printf '%f\n' |
    LC_ALL=C sort)
  [[ "$actual_members" == "$expected_members" ]] || return 1
  cmp -s "$INPUT_RECEIPT" "$entry/inputs.tsv" || return 1
  cmp -s "$TOOL_INVENTORY" "$entry/configure-tools.tsv" || return 1
  [[ "$(wc -l < "$entry/seal.tsv")" -eq 7 ]] || return 1
  [[ "$(wc -l < "$entry/seal.sha256")" -eq 1 ]] || return 1
  input_sha=$(sha256_value "$entry/inputs.tsv")
  receipt_sha=$(sha256_value "$entry/headers-tree.tsv")
  tools_sha=$(sha256_value "$entry/configure-tools.tsv")
  seal_sha=$(sha256_value "$entry/seal.tsv")
  [[ "$input_sha" == "$CACHE_KEY" ]] || return 1
  grep -Fqx $'schema\t'"$CACHE_SCHEMA" "$entry/seal.tsv" || return 1
  grep -Fqx $'cache_key\t'"$CACHE_KEY" "$entry/seal.tsv" || return 1
  grep -Fqx $'inputs_sha256\t'"$input_sha" "$entry/seal.tsv" || return 1
  grep -Fqx $'headers_tree_sha256\t'"$receipt_sha" "$entry/seal.tsv" || return 1
  grep -Fqx $'configure_tools_sha256\t'"$tools_sha" "$entry/seal.tsv" ||
    return 1
  [[ "$tools_sha" == "$TOOL_INVENTORY_SHA256" ]] || return 1
  grep -Fqx $'version\t'"$VERSION" "$entry/seal.tsv" || return 1
  grep -Fqx $'archive_sha256\t'"$ARCHIVE_SHA256" "$entry/seal.tsv" || return 1
  grep -Fqx "$seal_sha  seal.tsv" "$entry/seal.sha256" || return 1
  validate_headers_shape "$entry/headers" || return 1
  "$RSCRIPT" --vanilla "$TREE_RECEIPT_HELPER" verify \
    "$entry/headers" "$entry/headers-tree.tsv" >/dev/null 2>&1 || return 1
}

verify_recipe_sources_unchanged
verify_curl7_inputs_unchanged
CACHE_RESULT=hit
if ! validate_entry "$ENTRY"; then
  CACHE_RESULT=miss
  if [[ -e "$ENTRY" || -L "$ENTRY" ]]; then
    CACHE_RESULT=rebuilt
    quarantine="$QUARANTINE_ROOT/${CACHE_KEY}.$(date -u +%Y%m%dT%H%M%SZ).$$.$RANDOM"
    [[ -d "$ENTRY" && ! -L "$ENTRY" ]] ||
      fail "invalid cache target is not a plain directory: $ENTRY"
    publish_directory_no_clobber "$ENTRY" "$quarantine" ||
      fail "could not atomically quarantine invalid cache entry"
  fi

  # The per-key lock makes removal of abandoned same-key staging safe.  Such
  # directories can only outlive a process killed before its EXIT trap ran.
  shopt -s nullglob
  stale_staging=("$STAGING_ROOT/${CACHE_KEY}.staging."*)
  shopt -u nullglob
  for stale in "${stale_staging[@]}"; do
    [[ -d "$stale" && ! -L "$stale" ]] ||
      fail "abandoned cache staging is symbolic or not a directory: $stale"
    chmod -R u+w "$stale" 2>/dev/null || true
    rm -rf -- "$stale"
  done

  [[ -f "$ARCHIVE" && ! -L "$ARCHIVE" ]] ||
    fail "cache miss requires $ARCHIVE; run scripts/fetch-reference-sources"
  verify_sha256 "$ARCHIVE_SHA256" "$ARCHIVE"

  STAGING=$(mktemp -d "$STAGING_ROOT/${CACHE_KEY}.staging.XXXXXX")
  work_root="$STAGING/work"
  source_parent="$work_root/source"
  source_root="$source_parent/R-${VERSION}"
  build_root="$work_root/build"
  isolated_home="$work_root/home"
  isolated_tmp="$work_root/tmp"
  mkdir -p "$source_parent" "$build_root" "$isolated_home" "$isolated_tmp"

  archive_listing="$work_root/archive-members.txt"
  tar -tzf "$ARCHIVE" > "$archive_listing"
  awk -v prefix="R-${VERSION}/" '
    $0 != substr(prefix, 1, length(prefix) - 1) && index($0, prefix) != 1 { bad = 1 }
    $0 ~ /(^|\/)\.\.($|\/)/ || $0 ~ /^\// { bad = 1 }
    END { exit bad }
  ' "$archive_listing" || fail "R $VERSION archive has an unsafe member inventory"
  tar -xzf "$ARCHIVE" --no-same-owner -C "$source_parent"
  [[ -x "$source_root/configure" ]] || fail "R $VERSION source extraction failed"

  run_group_in_directory() {
    local directory=$1 label=$2
    shift 2
    run_supervised_group "$COMMAND_TIMEOUT_SECONDS" "$label" \
      "$BASH_EXECUTABLE" -c \
      "directory=\$1; shift; cd \"\$directory\" && exec \"\$@\"" \
      r-api-header-prepare "$directory" "$@"
  }

  configure_log="$LOG_DIRECTORY/configure-R-${VERSION}.log"
  make_log="$LOG_DIRECTORY/make-Rconfig-R-${VERSION}.log"
  run_group_in_directory "$build_root" "configure R $VERSION" \
    "$ENV_EXECUTABLE" -i \
    PATH="$CONFIGURE_PATH" HOME="$isolated_home" TMPDIR="$isolated_tmp" \
    LC_ALL=C LANG=C TZ=UTC CONFIG_SITE=/dev/null \
    CONFIG_SHELL="$CONFIG_SHELL_VALUE" SHELL="$SHELL_VALUE" \
    CC="$CC_VALUE" CFLAGS="$CFLAGS_VALUE" \
    F77="$F77_VALUE" FFLAGS="$FFLAGS_VALUE" \
    FC="$FC_VALUE" FCFLAGS="$FCFLAGS_VALUE" \
    CPP="$CPP_VALUE" CPPFLAGS="$CPPFLAGS_VALUE" \
    CXX="$CXX_VALUE" CXXFLAGS="$CXXFLAGS_VALUE" \
    AR="$AR_VALUE" AS="$AS_VALUE" LD="$LD_VALUE" \
    LDFLAGS="$LDFLAGS_VALUE" NM="$NM_VALUE" \
    RANLIB="$RANLIB_VALUE" STRIP="$STRIP_VALUE" \
    BUILD="$BUILD_VALUE" HOST="$HOST_VALUE" \
    CONDA_BUILD_SYSROOT="$SYSROOT_VALUE" \
    PKG_CONFIG="$PKG_CONFIG_VALUE" \
    PKG_CONFIG_LIBDIR="$PKG_CONFIG_LIBDIR_VALUE" \
    PKG_CONFIG_PATH="$PKG_CONFIG_PATH_VALUE" \
    "${CONFIGURE_CURL_ENVIRONMENT[@]}" \
    "$BASH_EXECUTABLE" "$source_root/configure" \
      "--prefix=$CONFIGURE_PREFIX" \
      --without-x --without-recommended-packages --disable-java \
      --with-readline=no --with-blas=no --with-lapack=no \
      > "$configure_log" 2>&1
  run_supervised_group "$COMMAND_TIMEOUT_SECONDS" "make headers R $VERSION" \
    "$ENV_EXECUTABLE" -i \
    PATH="$CONFIGURE_PATH" HOME="$isolated_home" TMPDIR="$isolated_tmp" \
    LC_ALL=C LANG=C TZ=UTC CONFIG_SITE=/dev/null \
    CONFIG_SHELL="$CONFIG_SHELL_VALUE" SHELL="$SHELL_VALUE" \
    "$MAKE" -C "$build_root/src/include" \
      "SHELL=$SHELL_VALUE" Rconfig.h Rversion.h \
      > "$make_log" 2>&1

  if [[ "$CURL_PREFLIGHT_REQUIRED" == true ]]; then
    "$CURL7_RECEIPT_HELPER" verify "$CURL7_PREFIX" "$CURL7_MANIFEST" \
      > "$LOG_DIRECTORY/curl7-prefix-final-verify-R-${VERSION}.log" 2>&1 ||
      fail "R $VERSION locked libcurl7 prefix changed during preparation"
  fi
  verify_recipe_sources_unchanged
  verify_curl7_inputs_unchanged
  verify_tool_inventory_unchanged

  [[ -f "$build_root/src/include/Rconfig.h" &&
     -f "$build_root/src/include/Rversion.h" ]] ||
    fail "R $VERSION did not generate both public configuration headers"
  mkdir -p "$STAGING/headers/generated"
  cp -a -- "$source_root/src/include" "$STAGING/headers/source"
  cp -p -- "$build_root/src/include/Rconfig.h" \
    "$build_root/src/include/Rversion.h" "$STAGING/headers/generated/"
  validate_headers_shape "$STAGING/headers" ||
    fail "prepared R $VERSION header tree has an unexpected shape"

  # This is the critical pruning boundary: no extracted source, configure
  # output tree, isolated HOME, or temporary file is publishable cache state.
  rm -rf -- "$work_root"
  [[ ! -e "$STAGING/work" && ! -L "$STAGING/work" ]] ||
    fail "R $VERSION cache staging retained private build material"
  cp -- "$INPUT_RECEIPT" "$STAGING/inputs.tsv"
  cp -- "$TOOL_INVENTORY" "$STAGING/configure-tools.tsv"
  find "$STAGING/headers" -type d -exec chmod 0555 {} +
  find "$STAGING/headers" -type f -exec chmod 0444 {} +
  "$RSCRIPT" --vanilla "$TREE_RECEIPT_HELPER" create \
    "$STAGING/headers" "$STAGING/headers-tree.tsv" >/dev/null
  input_sha=$(sha256_value "$STAGING/inputs.tsv")
  receipt_sha=$(sha256_value "$STAGING/headers-tree.tsv")
  tools_sha=$(sha256_value "$STAGING/configure-tools.tsv")
  {
    printf 'schema\t%s\n' "$CACHE_SCHEMA"
    printf 'cache_key\t%s\n' "$CACHE_KEY"
    printf 'inputs_sha256\t%s\n' "$input_sha"
    printf 'headers_tree_sha256\t%s\n' "$receipt_sha"
    printf 'configure_tools_sha256\t%s\n' "$tools_sha"
    printf 'version\t%s\n' "$VERSION"
    printf 'archive_sha256\t%s\n' "$ARCHIVE_SHA256"
  } > "$STAGING/seal.tsv"
  (
    cd "$STAGING"
    sha256sum seal.tsv
  ) > "$STAGING/seal.sha256"
  chmod 0444 "$STAGING/inputs.tsv" "$STAGING/configure-tools.tsv" \
    "$STAGING/headers-tree.tsv" \
    "$STAGING/seal.tsv" "$STAGING/seal.sha256"
  chmod 0555 "$STAGING"
  validate_entry "$STAGING" || fail "new R $VERSION cache entry failed validation"
  publish_directory_no_clobber "$STAGING" "$ENTRY" ||
    fail "could not atomically publish cache entry without clobbering"
  STAGING=
  validate_entry "$ENTRY" || fail "published R $VERSION cache entry failed validation"
fi

verify_recipe_sources_unchanged
verify_curl7_inputs_unchanged
input_sha=$(sha256_value "$ENTRY/inputs.tsv")
receipt_sha=$(sha256_value "$ENTRY/headers-tree.tsv")
tools_sha=$(sha256_value "$ENTRY/configure-tools.tsv")
seal_sha=$(sha256_value "$ENTRY/seal.tsv")
seal_file_sha=$(sha256_value "$ENTRY/seal.sha256")

RUN_STAGING="${OUTPUT}.new.$$.$RANDOM"
[[ ! -e "$RUN_STAGING" && ! -L "$RUN_STAGING" ]] ||
  fail "run-local header staging already exists: $RUN_STAGING"
mkdir "$RUN_STAGING"
if ! cp -a --reflink=auto -- "$ENTRY/headers/." "$RUN_STAGING/" 2>/dev/null; then
  rm -rf -- "$RUN_STAGING"
  mkdir "$RUN_STAGING"
  cp -a -- "$ENTRY/headers/." "$RUN_STAGING/"
fi
"$RSCRIPT" --vanilla "$TREE_RECEIPT_HELPER" verify \
  "$RUN_STAGING" "$ENTRY/headers-tree.tsv" >/dev/null
publish_directory_no_clobber "$RUN_STAGING" "$OUTPUT" ||
  fail "could not atomically publish run-local headers without clobbering"
RUN_STAGING=

RUN_HEADERS_RECEIPT=$(mktemp "$LOCAL_TMP/r-api-run-headers.XXXXXX")
"$RSCRIPT" --vanilla "$TREE_RECEIPT_HELPER" create \
  "$OUTPUT" "$RUN_HEADERS_RECEIPT" >/dev/null
"$RSCRIPT" --vanilla "$TREE_RECEIPT_HELPER" verify \
  "$OUTPUT" "$RUN_HEADERS_RECEIPT" >/dev/null
cmp -s "$RUN_HEADERS_RECEIPT" "$ENTRY/headers-tree.tsv" ||
  fail "published run-local header receipt differs from its cache source"

input_copy="$METADATA_DIRECTORY/header-cache-input-R-${VERSION}.tsv"
receipt_copy="$METADATA_DIRECTORY/header-cache-headers-R-${VERSION}.tsv"
run_receipt_copy="$METADATA_DIRECTORY/header-cache-run-headers-R-${VERSION}.tsv"
tools_copy="$METADATA_DIRECTORY/header-cache-configure-tools-R-${VERSION}.tsv"
curl_preflight_copy="$METADATA_DIRECTORY/header-cache-curl-preflight-R-${VERSION}.txt"
seal_copy="$METADATA_DIRECTORY/header-cache-seal-R-${VERSION}.tsv"
seal_hash_copy="$METADATA_DIRECTORY/header-cache-seal-R-${VERSION}.sha256"
evidence="$METADATA_DIRECTORY/header-cache-evidence-R-${VERSION}.tsv"
publish_file_no_clobber "$ENTRY/inputs.tsv" "$input_copy" ||
  fail "could not publish cache input metadata without clobbering"
publish_file_no_clobber "$ENTRY/headers-tree.tsv" "$receipt_copy" ||
  fail "could not publish cache header metadata without clobbering"
publish_file_no_clobber "$RUN_HEADERS_RECEIPT" "$run_receipt_copy" ||
  fail "could not publish run-header metadata without clobbering"
publish_file_no_clobber "$ENTRY/configure-tools.tsv" "$tools_copy" ||
  fail "could not publish configure-tool metadata without clobbering"
publish_file_no_clobber "$CURL_PREFLIGHT_OUTPUT_FILE" "$curl_preflight_copy" ||
  fail "could not publish libcurl preflight evidence without clobbering"
publish_file_no_clobber "$ENTRY/seal.tsv" "$seal_copy" ||
  fail "could not publish cache seal metadata without clobbering"
publish_file_no_clobber "$ENTRY/seal.sha256" "$seal_hash_copy" ||
  fail "could not publish cache seal hash without clobbering"
rm -f -- "$RUN_HEADERS_RECEIPT"
RUN_HEADERS_RECEIPT=
EVIDENCE_STAGING=$(mktemp "$LOCAL_TMP/r-api-header-evidence.XXXXXX")
{
  printf 'field\tvalue\n'
  printf 'schema\t%s\n' "$CACHE_SCHEMA"
  printf 'version\t%s\n' "$VERSION"
  printf 'archive_sha256\t%s\n' "$ARCHIVE_SHA256"
  printf 'cache_key\t%s\n' "$CACHE_KEY"
  printf 'cache_result\t%s\n' "$CACHE_RESULT"
  printf 'inputs_sha256\t%s\n' "$input_sha"
  printf 'headers_tree_sha256\t%s\n' "$receipt_sha"
  printf 'configure_tools_sha256\t%s\n' "$tools_sha"
  printf 'builder_helper_sha256\t%s\n' "$BUILDER_HELPER_SHA256"
  printf 'tree_receipt_helper_sha256\t%s\n' \
    "$TREE_RECEIPT_HELPER_SHA256"
  printf 'cache_seal_sha256\t%s\n' "$seal_sha"
  printf 'cache_seal_file_sha256\t%s\n' "$seal_file_sha"
  printf 'run_headers_tree_sha256\t%s\n' \
    "$(sha256_value "$run_receipt_copy")"
  printf 'run_headers_receipt_semantics\t%s\n' \
    actual-published-output-receipt-v1
  printf 'lock_timeout_seconds\t%s\n' "$LOCK_TIMEOUT_SECONDS"
  printf 'lock_wait_seconds\t%s\n' "$LOCK_WAIT_SECONDS"
  printf 'command_timeout_seconds\t%s\n' "$COMMAND_TIMEOUT_SECONDS"
  printf 'termination_grace_tenths\t%s\n' "$TERMINATION_GRACE_TENTHS"
} > "$EVIDENCE_STAGING"
publish_file_no_clobber "$EVIDENCE_STAGING" "$evidence" ||
  fail "could not publish cache evidence without clobbering"
rm -f -- "$EVIDENCE_STAGING"
EVIDENCE_STAGING=

printf 'cache_result=%s\n' "$CACHE_RESULT"
printf 'cache_key=%s\n' "$CACHE_KEY"
printf 'builder_helper_sha256=%s\n' "$BUILDER_HELPER_SHA256"
printf 'configure_tools_sha256=%s\n' "$tools_sha"
printf 'run_headers=%s\n' "$OUTPUT"
printf 'lock_wait_seconds=%s\n' "$LOCK_WAIT_SECONDS"
