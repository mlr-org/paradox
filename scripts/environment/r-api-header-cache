  receipt_row curl7_manifest_sha256 "$CURL7_MANIFEST_SHA256"
  receipt_row curl7_receipt_sha256 "$CURL7_RECEIPT_SHA256"
  receipt_row curl7_seal_sha256 "$CURL7_SEAL_SHA256"
  receipt_row curl7_lock_sha256 "$CURL7_LOCK_SHA256"
  receipt_row curl7_receipt_helper_sha256 \
