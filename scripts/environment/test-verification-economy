  "$API_HEADER_CACHE")
archive_hash_line=$(first_line 'verify_sha256 "$ARCHIVE_SHA256" "$ARCHIVE"' \
  "$API_HEADER_CACHE")
prune_line=$(first_line 'rm -rf -- "$work_root"' "$API_HEADER_CACHE")
