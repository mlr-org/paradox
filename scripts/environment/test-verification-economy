  fail "API header cache synthetic self-test retained no success marker"
printf '%s\n' "$cache_self_test" |
  grep -Fq 'configure_compatibility_selection=passed' ||
  fail "API header cache did not self-test its exact old-R selection"
printf '%s\n' "$cache_self_test" |
  grep -Fq 'curl_preflight_validation=passed' ||
  fail "API header cache did not self-test libcurl proof rejection"
printf '%s\n' "$cache_self_test" |
  grep -Fq 'fast_watchdog_cancellation=passed' ||
  fail "API header cache did not self-test fast watchdog cancellation"

# Compiler batches retain exact admission, deadline, process provenance,
# NUL-framed argument-vector, per-task, and paired-lane evidence.  Plan schema
# changes are intentionally review-visible in this focused preflight.
expected_admission_source="expected_fields=\$'field\\nschema\\nprofile\\ncontainment\\nplatform\\nonline_cpus\\naffinity_cpus\\ncgroup_cpu_limit\\ncpu_limit\\ncpu_reserve\\ncpu_per_job\\ncpu_jobs\\nmemory_source\\nmemory_available_mib\\ncgroup_memory_available_mib\\nmemory_reserve_mib\\nmemory_mib_per_job\\nmemory_jobs\\nprofile_max_jobs\\noperator_max_jobs\\njobs\\nselection'"
for runner in "$COMPILER_BATCH_RUNNER" "$COMPILER_WAVE_RUNNER"; do
  grep -Fq "$expected_admission_source" "$runner" ||
    fail "compiler runner does not require the exact admission-report schema: $runner"
  grep -Fq '"$(report_value profile)" == api-compile' "$runner" ||
    fail "compiler runner accepts an admission report from the wrong profile: $runner"
  grep -Fq '"$memory_per" -eq 768' "$runner" ||
    fail "compiler runner does not recheck the API per-job memory budget: $runner"
  grep -Fq 'expected_memory_reserve=$((memory_available / 4))' "$runner" ||
    fail "compiler runner does not recompute the 25 percent memory reserve: $runner"
  grep -Fq 'direct) reserve_floor=12288 ;;' "$runner" ||
    fail "compiler runner does not recompute the direct reserve floor: $runner"
  grep -Fq 'aggregate-systemd) reserve_floor=4096 ;;' "$runner" ||
    fail "compiler runner does not recompute the aggregate reserve floor: $runner"
  grep -Fq 'worker-hard) reserve_floor=1024 ;;' "$runner" ||
    fail "compiler runner does not recompute the hard-worker reserve floor: $runner"
  grep -Fq '((expected_memory_reserve >= reserve_floor)) ||' "$runner" ||
    fail "compiler runner does not recompute the containment reserve floor: $runner"
  grep -Fq 'fail "admission report arithmetic is internally inconsistent"' \
    "$runner" ||
    fail "compiler runner trusts rather than rederives report arithmetic: $runner"
done
grep -Fq 'validate_admission_report "$ADMISSION_REPORT"' \
  "$COMPILER_WAVE_RUNNER" ||
  fail "compiler wave does not validate its retained admission report"
grep -Fq 'validate_admission_report "$ADMISSION_REPORT" ceiling' \
  "$COMPILER_BATCH_RUNNER" ||
  fail "compiler batch does not validate its retained admission report"

expected_batch_plan_fields=$'field\nschema\njobs\nadmitted_jobs\nadmission_report_path\nadmission_report_sha256\nlabel\ntasks\ncompiler_invoked_path\ncompiler_link_target\ncompiler_canonical_path\ncompiler_canonical_sha256\ncompiler_identity_sha256\nsource_root\nsource_list_sha256\ncompiler_arguments_count\ncompiler_arguments_sha256\nsetsid_path\nsetsid_sha256\nsetsid_identity_sha256\ntask_timeout_seconds\ntimeout_tool_path\ntimeout_tool_sha256\ntimeout_tool_identity_sha256\ntask_wrapper_path\ntask_wrapper_sha256\ntask_wrapper_bash_path\ntask_wrapper_bash_sha256\nsupervisor_log_suffix\ntask_ledger'
[[ "$(compiler_plan_fields "$COMPILER_BATCH_RUNNER")" == \
   "$expected_batch_plan_fields" ]] ||
  fail "compiler batch plan does not have the exact reviewed schema-4 fields"
grep -Fq "printf 'schema\\t4\\n'" "$COMPILER_BATCH_RUNNER" ||
  fail "compiler batch plan is not schema 4"
expected_wave_plan_fields=$'field\nschema\njobs_ceiling\nadmitted_jobs\nadmission_report_path\nadmission_report_sha256\nbatch_runner_path\nbatch_runner_sha256\nexecution\nmax_concurrent_jobs\nleft_label\nleft_jobs\nleft_compiler_invoked_path\nleft_compiler_link_target\nleft_compiler_canonical_path\nleft_compiler_canonical_sha256\nleft_compiler_identity_sha256\nleft_arguments_count\nleft_arguments_sha256\nright_label\nright_jobs\nright_compiler_invoked_path\nright_compiler_link_target\nright_compiler_canonical_path\nright_compiler_canonical_sha256\nright_compiler_identity_sha256\nright_arguments_count\nright_arguments_sha256\nsetsid_path\nsetsid_sha256\nsetsid_identity_sha256\ntask_timeout_seconds\ntimeout_tool_path\ntimeout_tool_sha256\ntimeout_tool_identity_sha256'
[[ "$(compiler_plan_fields "$COMPILER_WAVE_RUNNER")" == \
   "$expected_wave_plan_fields" ]] ||
  fail "compiler wave plan does not have the exact reviewed schema-4 fields"
grep -Fq "printf 'schema\\t4\\n'" "$COMPILER_WAVE_RUNNER" ||
  fail "compiler wave plan is not schema 4"

for argv_runner in "$COMPILER_BATCH_RUNNER" "$COMPILER_WAVE_RUNNER" \
    "$API_GATE"; do
  argv_hash_body=$(function_body argument_vector_sha256 "$argv_runner")
  printf '%s\n' "$argv_hash_body" | grep -Fq 'if (($#)); then' ||
    fail "argument-vector hash does not distinguish zero arguments: $argv_runner"
  printf '%s\n' "$argv_hash_body" | grep -Fq "printf '%s\\0' \"\$@\"" ||
    fail "argument-vector hash is not NUL-framed: $argv_runner"
done
for argument_binding in \
    'compiler_arguments_count' 'compiler_arguments_sha256'; do
  grep -Fq "$argument_binding" "$COMPILER_BATCH_RUNNER" ||
    fail "compiler batch plan omits exact argument identity: $argument_binding"
done
for argument_binding in left_arguments_count left_arguments_sha256 \
    right_arguments_count right_arguments_sha256; do
  grep -Fq "$argument_binding" "$COMPILER_WAVE_RUNNER" ||
    fail "compiler wave plan omits exact argument identity: $argument_binding"
  grep -Fq "$argument_binding" "$API_GATE" ||
    fail "API gate does not postflight compiler arguments: $argument_binding"
done

for runner in "$COMPILER_BATCH_RUNNER" "$COMPILER_WAVE_RUNNER"; do
  for setsid_binding in setsid_path setsid_sha256 setsid_identity_sha256; do
    grep -Fq "$setsid_binding" "$runner" ||
      fail "compiler runner omits setsid provenance: $runner: $setsid_binding"
  done
  grep -Fq 'setsid from util-linux' "$runner" ||
    fail "compiler runner accepts an unidentified setsid: $runner"
  grep -Fq 'verify_setsid_identity' "$runner" ||
    fail "compiler runner does not reauthenticate setsid: $runner"
  for timeout_binding in timeout_tool_path timeout_tool_sha256 \
      timeout_tool_identity_sha256; do
    grep -Fq "$timeout_binding" "$runner" ||
      fail "compiler runner omits timeout provenance: $runner: $timeout_binding"
  done
  grep -Fq 'verify_timeout_identity' "$runner" ||
    fail "compiler runner does not reauthenticate GNU timeout: $runner"
done
grep -Fq 'LC_ALL=C "$SETSID" --wait -- "$TIMEOUT_TOOL" --foreground --verbose \' \
  "$COMPILER_BATCH_RUNNER" ||
  fail "compiler tasks are not launched directly under retained setsid and GNU timeout"
if grep -Fq -- '-- env LC_ALL=C' "$COMPILER_BATCH_RUNNER"; then
  fail "compiler task provenance can be changed through an unreceipted env hop"
fi
grep -Fq -- '--setsid "$SETSID"' "$API_GATE" ||
  fail "API caller does not pass its retained setsid to compiler waves"
for completion_binding in 'setsid_sha256=' 'setsid_identity_sha256='; do
  grep -Fq "$completion_binding" <<< "$api_completion_body" ||
    fail "API completion omits setsid provenance: $completion_binding"
done

task_ledger_source="schema\\tordinal\\tsource_relative\\tsource_sha256\\tcompiler_invoked_path\\tcompiler_link_target\\tcompiler_canonical_path\\tcompiler_canonical_sha256\\tcompiler_identity_sha256\\ttask_wrapper_path\\ttask_wrapper_sha256\\ttask_wrapper_bash_path\\ttask_wrapper_bash_sha256\\texit_status\\ttimed_out\\tlog_relative\\tlog_sha256\\tsupervisor_log_relative\\tsupervisor_log_sha256"
grep -Fq "printf '$task_ledger_source\\n'" "$COMPILER_BATCH_RUNNER" ||
  fail "compiler batch does not publish the exact 19-column task ledger"
grep -Fq "LEDGER_HEADER=\$'$task_ledger_source'" "$COMPILER_WAVE_RUNNER" ||
  fail "compiler wave does not authenticate the exact task-ledger schema"
grep -Fq "expected_header=\$'$task_ledger_source'" "$API_GATE" ||
  fail "API gate does not authenticate the exact task-ledger schema"
grep -Fq 'term_marker="$TIMEOUT_TOOL: sending signal TERM to command '\''$TASK_WRAPPER_BASH'\''"' \
  "$COMPILER_BATCH_RUNNER" ||
  fail "compiler timeout classification lacks its exact supervisor marker"
grep -Fq 'term_marker_short="$timeout_name: sending signal TERM to command '\''$TASK_WRAPPER_BASH'\''"' \
  "$COMPILER_BATCH_RUNNER" ||
  fail "compiler timeout classification lacks GNU timeout's basename marker"
grep -Fq '*) supervisor_valid=false ;;' "$COMPILER_BATCH_RUNNER" ||
  fail "compiler timeout classification accepts unknown supervisor output"
grep -Fq 'supervisor_evidence_failures=$((supervisor_evidence_failures + 1))' \
  "$COMPILER_BATCH_RUNNER" ||
  fail "compiler runner does not fail closed on impossible supervisor evidence"
grep -Fq '"$TIMEOUT_TOOL" --foreground --verbose' \
  "$COMPILER_BATCH_RUNNER" ||
  fail "compiler batch tasks are not supervised by retained GNU timeout"
grep -Fq 'supervisor_log_suffix' "$COMPILER_BATCH_RUNNER" ||
  fail "compiler batch does not separate supervisor diagnostics from compiler output"
[[ $(grep -Fc 'exec "$BATCH_RUNNER"' "$COMPILER_WAVE_RUNNER") -eq 2 ]] ||
  fail "compiler wave does not track exactly two authoritative batch PIDs"
grep -Fq 'kill -KILL -- "-$pid"' "$COMPILER_BATCH_RUNNER" ||
  fail "compiler batch cannot remove TERM-resistant descendants"
grep -Fq "printf 'lane\\ttask_ledger\\ttask_ledger_sha256\\ttasks\\tcompiler_invoked_path\\tcompiler_link_target\\tcompiler_canonical_path\\tcompiler_canonical_sha256\\tcompiler_identity_sha256\\n'" \
  "$COMPILER_WAVE_RUNNER" ||
  fail "compiler wave does not bind both exact lane ledgers and compiler identities"

# The API caller verifies schema-4 plans immediately and again at postflight,
# then promotes per-release resource/plan/lane hashes and complete result counts
# to one exact compiler-wave ledger bound by completion.
grep -Fq "expected_plan_fields=\$'field\\nschema\\njobs\\nadmitted_jobs" \
  "$API_GATE" ||
  fail "API task-ledger verifier does not expect batch plan schema 4"
grep -Fq "expected_wave_plan_fields=\$'field\\nschema\\njobs_ceiling\\nadmitted_jobs" \
  "$API_GATE" ||
  fail "API compiler verifier does not expect wave plan schema 4"
grep -Fq 'expected_arguments_sha256=$(argument_vector_sha256 "$@")' \
  "$API_GATE" ||
  fail "API task verifier does not recompute each exact compiler argument vector"
for api_argument_binding in \
    '"$gcc_jobs" "$resource_report" "$live_jobs" "${left_arguments[@]}"' \
    '"$clang_jobs" "$resource_report" "$live_jobs" "${right_arguments[@]}"' \
    '"$GCC" gcc "$gcc_jobs" "$resource_report" "$live_jobs" \' \
    '"$CLANG" clang "$clang_jobs" "$resource_report" "$live_jobs" \' \
    '"${final_left_arguments[@]}"' \
    '"${final_right_arguments[@]}"'; do
  grep -Fq "$api_argument_binding" "$API_GATE" ||
    fail "API initial/final compiler verification omits an argument vector: $api_argument_binding"
done
compiler_wave_ledger_header="version\\tresource_report_sha256\\twave_plan_sha256\\tjobs\\tgcc_jobs\\tclang_jobs\\texecution\\ttask_timeout_seconds\\ttimeout_tool_sha256\\twave_task_ledgers_sha256\\ttasks_per_compiler\\ttask_failures\\texact_timeouts"
grep -Fq "printf '$compiler_wave_ledger_header\\n'" "$API_GATE" ||
  fail "API gate does not create the expanded compiler-wave ledger"
grep -Fq "\$'${compiler_wave_ledger_header}'" "$API_GATE" ||
  fail "API gate does not postflight the exact compiler-wave ledger schema"
for final_compiler_binding in \
    'verify_sha256 "$resource_sha256"' \
    'verify_sha256 "$wave_plan_sha256" "$wave_plan"' \
    'verify_sha256 "$wave_task_ledgers_sha256" "$wave_task_ledgers"' \
    'final compiler task ledgers disagree with the release result counts' \
    'compiler matrix postflight and collected failure totals disagree'; do
  grep -Fq "$final_compiler_binding" "$API_GATE" ||
    fail "API compiler postflight omits evidence: $final_compiler_binding"
done
compiler_identity_self_test=$(
  "$ROOT/.local/toolchain/bin/Rscript" --vanilla \
    "$COMPILER_IDENTITY_HELPER" self-test 2>&1
) || {
  printf '%s\n' "$compiler_identity_self_test" >&2
  fail "compiler identity synthetic self-test failed"
}
printf '%s\n' "$compiler_identity_self_test" |
  grep -Fq 'compiler_identity_self_test=passed' ||
  fail "compiler identity self-test retained no success marker"
for compiler_closure_binding in \
    'gcc_effective_preprocessing_plan' \
    'clang_effective_preprocessing_plan' \
    'clang_target_config' \
    'gcc_fixed_tree' \
    'compiler_sysroot_include_tree' \
    'explicit_toolchain_include_tree'; do
  grep -Fq "$compiler_closure_binding" "$COMPILER_IDENTITY_HELPER" ||
    fail "compiler identity omits a syntax-admission input: $compiler_closure_binding"
done

# The adversarial validator invokes the same large synthetic native fixture
# many times. Construct it once per focused/full scope and ASan selection, then
# restore independent copies; rebuilding it before every one-line mutation adds
# no information.
hardening_fixture=$(function_body build_valid_native_fixture "$HARDENING")
printf '%s\n' "$hardening_fixture" |
  grep -Fq 'cached_fixture="$NATIVE_FIXTURE_CACHE/$FIXTURE_TESTS-asan-$FIXTURE_ASAN"' ||
  fail "hardening suite has no scope/ASan-specific valid-fixture cache"
printf '%s\n' "$hardening_fixture" |
  grep -Fq 'cp -a -- "$cached_fixture" "$RUN_DIRECTORY"' ||
  fail "hardening suite regenerates valid fixtures instead of restoring copies"
printf '%s\n' "$hardening_fixture" |
  grep -Fq 'cp -a -- "$RUN_DIRECTORY" "$cached_fixture"' ||
  fail "hardening suite never publishes its reusable valid fixture"

printf '%s\n' \
  "verification_economy_preflight=passed" \
  "memory_content_boundaries=2" \
  "valgrind_receipt_compare_boundaries=4" \
  "r_cache_tree_passes=3" \
