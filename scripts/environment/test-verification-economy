#!/usr/bin/env bash

# Cheap structural preflight for the expensive verification harnesses.  Keep
# information-free duplication from reaching a long native or memory run.
# shellcheck disable=SC1003,SC2016 # source-code patterns are deliberately literal

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
MEMORY="$ROOT/scripts/memory-check"
MEMORY_VALIDATOR="$ROOT/scripts/environment/validate-memory-run"
RECEIPTS="$ROOT/scripts/environment/valgrind-receipts"
R_BUILD="$ROOT/scripts/build-valgrind-r"
PACKAGE_BOOTSTRAP="$ROOT/scripts/bootstrap-valgrind-r-packages"
NATIVE="$ROOT/scripts/native-check"
OFFLINE_CHECK_PROFILE="$ROOT/environment/Rprofile-native-check-offline.R"
OFFLINE_REPOSITORY_HELPER="$ROOT/scripts/environment/create-offline-check-repository.R"
API_GATE="$ROOT/scripts/check-r-api-compatibility"
API_HEADER_CACHE="$ROOT/scripts/environment/r-api-header-cache"
RESOURCE_JOBS="$ROOT/scripts/environment/resource-jobs"
COMPILER_BATCH_RUNNER="$ROOT/scripts/environment/run-compiler-batch"
COMPILER_WAVE_RUNNER="$ROOT/scripts/environment/run-compiler-wave"
COMPILER_IDENTITY_HELPER="$ROOT/scripts/environment/compiler-identity.R"
TEST_RUNNER="$ROOT/scripts/environment/run-native-tests.R"
TEST_WORKER_GROUP="$ROOT/scripts/environment/run-native-test-worker-group"
TEST_VERIFIER="$ROOT/scripts/environment/verify-native-test-ledger.R"
RUNTIME_MATRIX_TEST_RUNNER="$ROOT/scripts/environment/run-runtime-matrix-tests.R"
LEGACY_REPOSITORY_RUNNER="$ROOT/compat/test-repositories.R"
HARDENING="$ROOT/scripts/environment/test-validation-hardening"
TASK_ENTRY="$ROOT/scripts/environment/verify-task-entry"

fail() {
  printf '%s\n' "test-verification-economy: $*" >&2
  exit 1
}

for required in "$MEMORY" "$MEMORY_VALIDATOR" "$RECEIPTS" "$R_BUILD" \
    "$PACKAGE_BOOTSTRAP" \
    "$NATIVE" "$OFFLINE_CHECK_PROFILE" "$OFFLINE_REPOSITORY_HELPER" \
    "$API_GATE" "$API_HEADER_CACHE" "$RESOURCE_JOBS" \
    "$COMPILER_BATCH_RUNNER" \
    "$COMPILER_WAVE_RUNNER" "$COMPILER_IDENTITY_HELPER" \
    "$TEST_RUNNER" "$TEST_WORKER_GROUP" "$TEST_VERIFIER" \
    "$RUNTIME_MATRIX_TEST_RUNNER" "$LEGACY_REPOSITORY_RUNNER" \
    "$HARDENING" "$TASK_ENTRY"; do
  [[ -f "$required" && ! -L "$required" ]] ||
    fail "required harness is absent or symbolic: $required"
done

# A dead coordinator can make processx signal both the worker supervisor and
# its detached token watchdog. The watchdog must clean token descendants for
# every terminating signal, not exit directly and race the supervisor.
[[ $(grep -Fxc \
  '  trap '\''terminate_tokens "$supervisor_pid"'\'' HUP TERM USR1' \
  "$TEST_WORKER_GROUP") -eq 1 ]] ||
  fail "native worker watchdog does not clean descendants on every termination path"
[[ $(grep -Fxc "    trap '' HUP TERM USR1" \
  "$TEST_WORKER_GROUP") -eq 1 ]] ||
  fail "native worker watchdog cleanup can be interrupted by a second signal"
if grep -Eq "trap 'exit 0' (HUP|INT|TERM)" "$TEST_WORKER_GROUP"; then
  fail "native worker watchdog can exit without scanning token descendants"
fi

# Worker images have different locale defaults, and R parse/serialization
# metadata can legitimately differ between C and C.UTF-8. Pin the task locale
# at the container entry boundary rather than relying on image ENV state.
for task_environment_line in \
    'export LANG=C.UTF-8' \
    'export LC_ALL=C.UTF-8' \
    'export TZ=UTC' \
    'unset LANGUAGE'; do
  [[ $(grep -Fxc "$task_environment_line" "$TASK_ENTRY") -eq 1 ]] ||
    fail "worker task entry does not pin: $task_environment_line"
done

first_line() {
  local pattern=$1 file=$2
  grep -nF -- "$pattern" "$file" | head -n 1 | cut -d: -f1
}

last_line() {
  local pattern=$1 file=$2
  grep -nF -- "$pattern" "$file" | tail -n 1 | cut -d: -f1
}

exact_line() {
  local pattern=$1 file=$2
  grep -nFx -- "$pattern" "$file" | cut -d: -f1
}

function_body() {
  local function_name=$1 file=$2
  awk -v start="${function_name}() {" '
    $0 == start { inside = 1 }
    inside { print }
    inside && /^}/ { exit }
  ' "$file"
}

compiler_plan_fields() {
  local file=$1
  sed -n "/^  printf 'field\\\\tvalue\\\\n'/,/^} > .*plan.tsv/p" "$file" |
    sed -n "s/^  printf '\\([a-z0-9_]*\\)\\\\t.*$/\\1/p"
}

# A deliberately networkless --as-cran run still retains repository-backed
# dependency-cycle checks.  All standard repository labels must resolve to
# authenticated local metadata; warnings and skipped cycle checks are not
# acceptable substitutes.
native_full_check=$(function_body check_strict_gcc_full "$NATIVE")
[[ $(printf '%s\n' "$native_full_check" |
  grep -Fc '_R_CHECK_CRAN_INCOMING_REMOTE_=false') -eq 2 ]] ||
  fail "both native package checks do not disable only remote incoming work"
[[ $(printf '%s\n' "$native_full_check" |
  grep -Fc '_R_CHECK_SYSTEM_CLOCK_=false') -eq 2 ]] ||
  fail "networkless native package checks still attempt remote clock access"
for repository_variable in PARADOX_OFFLINE_CHECK_CRAN \
    PARADOX_OFFLINE_CHECK_BIOC; do
  [[ $(printf '%s\n' "$native_full_check" |
    grep -Fc "\"$repository_variable=file://") -eq 2 ]] ||
    fail "both native package checks do not select the sealed local repositories"
done
[[ $(printf '%s\n' "$native_full_check" |
  grep -Fc '"R_PROFILE_USER=$offline_profile"') -eq 2 ]] ||
  fail "both native package checks do not select the offline profile"
[[ $(printf '%s\n' "$native_full_check" |
  grep -Fc 'verify_offline_check_repository "$MODE_DIRECTORY/artifacts"') -eq 2 ]] ||
  fail "native package checks do not authenticate repository metadata before and after use"
if printf '%s\n' "$native_full_check" |
    grep -Eq '_R_CHECK_ORPHANED_|options[(]repos[[:space:]]*=[[:space:]]*(NULL|character)'; then
  fail "networkless native check disables a locally meaningful repository check"
fi
for repository_name in CRAN BioCsoft BioCann BioCexp; do
  grep -Eq "^[[:space:]]*$repository_name =" "$OFFLINE_CHECK_PROFILE" ||
    fail "offline check profile omits standard repository label $repository_name"
done
grep -Fq 'tools::write_PACKAGES(cran_contrib, type = "source")' \
  "$OFFLINE_REPOSITORY_HELPER" ||
  fail "offline package metadata is not built with the public repository writer"
grep -Fq 'tools::sha256sum(archive)' "$OFFLINE_REPOSITORY_HELPER" ||
  fail "offline package metadata does not authenticate its locked archives"
grep -Fq 'lock = lock[lock$Role != "bootstrap-only", , drop = FALSE]' \
  "$OFFLINE_REPOSITORY_HELPER" ||
  fail "offline repository can accidentally admit the Paradox 1 bootstrap archive"
grep -Fq 'unlink(staged_archives, force = TRUE)' "$OFFLINE_REPOSITORY_HELPER" ||
  fail "offline repository does not remove its exact staged archive links"
if grep -Eq 'suppressWarnings|withCallingHandlers|warning[[:space:]]*=' \
    "$OFFLINE_CHECK_PROFILE" "$OFFLINE_REPOSITORY_HELPER"; then
  fail "offline repository setup hides warnings instead of preventing them"
fi
for logged_wrapper in run_logged run_in_directory_logged; do
  function_body "$logged_wrapper" "$NATIVE" | grep -Fq 'reject_warnings' ||
    fail "native command wrapper no longer rejects warning text"
done

# The package-only ASan mode depends on preloading the project-local runtime
# into the mounted R executable.  Prove that exact startup plus an XDR
# round-trip before any expensive compiler mode, without a retry or weakened
# sanitizer fallback.
asan_preflight_call=$(exact_line '  run_asan_runtime_startup_preflight' "$NATIVE")
first_native_install=$(first_line \
  '  install_mode strict-gcc "$STRICT_GCC_PROFILE" none' "$NATIVE")
[[ -n "$asan_preflight_call" && -n "$first_native_install" &&
   "$asan_preflight_call" -lt "$first_native_install" ]] ||
  fail "ASan runtime compatibility is not checked before expensive native modes"
asan_preflight=$(function_body run_asan_runtime_startup_preflight "$NATIVE")
printf '%s\n' "$asan_preflight" |
  grep -Fq 'run_mode_r_logged "$asan_startup_log"' ||
  fail "ASan startup preflight does not use the production sanitizer environment"
printf '%s\n' "$asan_preflight" | grep -Fq 'saveRDS(value, path, version = 2L)' ||
  fail "ASan startup preflight does not exercise R XDR serialization"
printf '%s\n' "$asan_preflight" | grep -Fq 'identical(readRDS(path), value)' ||
  fail "ASan startup preflight does not exercise R XDR deserialization"
[[ $(grep -Fc 'ASAN_RUNTIME=$(env -i "PATH=$LOCAL_PATH"' "$NATIVE") -eq 1 ]] ||
  fail "ASan runtime discovery is duplicated or absent"
grep -Fq 'handle_segv=2:fast_unwind_on_fatal=0' "$NATIVE" ||
  fail "ASan does not retain ownership of fatal-signal diagnostics"
if printf '%s\n' "$asan_preflight" |
    grep -Eqi 'retry|seccomp|privileged|host[ -]?fallback|verify_asan_link_order'; then
  fail "ASan startup preflight weakens or retries around an incompatible worker"
fi

# Memory verification has two content boundaries, with no semantic execution
# until the corresponding content receipt has authenticated every runtime tree.
[[ $(grep -Fc '  run_valgrind_receipt_structure_verification \' "$MEMORY") -eq 2 ]] ||
  fail "memory gate does not have exactly two structure boundaries"
[[ $(grep -Fc '  run_valgrind_receipt_content_verification \' "$MEMORY") -eq 2 ]] ||
  fail "memory gate does not have exactly two content boundaries"
[[ $(grep -Fc '  run_valgrind_receipt_semantic_verification \' "$MEMORY") -eq 2 ]] ||
  fail "memory gate does not have exactly two semantic boundaries"

mapfile -t receipt_compares < <(grep -nF \
  '  compare_retained_valgrind_receipts "$VALGRIND_RECEIPT_COPY"' \
  "$MEMORY" | cut -d: -f1)
[[ ${#receipt_compares[@]} -eq 4 ]] ||
  fail "live Valgrind receipts are not checked before and after both uses"

valgrind_admission=$(first_line \
  '    "$RETAINED_RESOURCE_JOBS_HELPER" valgrind --report' "$MEMORY")
valgrind_admission_validation=$(first_line \
  '  validate_serial_resource_report "$MODE_ARTIFACTS/resource-jobs.tsv" \' \
  "$MEMORY")
valgrind_lock=$(first_line '  acquire_valgrind_state_lock' "$MEMORY")
[[ -n "$valgrind_admission" && -n "$valgrind_admission_validation" &&
   -n "$valgrind_lock" ]] ||
  fail "Valgrind resource admission boundary is absent"
((valgrind_admission < valgrind_admission_validation &&
  valgrind_admission_validation < valgrind_lock)) ||
  fail "Valgrind takes its state lock or starts work before resource admission"
grep -Fq '    "$MODES/valgrind/artifacts/resource-jobs.tsv" valgrind' \
  "$MEMORY_VALIDATOR" ||
  fail "memory replay does not enforce retained Valgrind resource admission"
grep -Fq '    --verify-report "$resource_report"' "$MEMORY" ||
  fail "memory harness does not validate its retained resource decision"
grep -Fq \
  'resource_admission=serial valgrind profile with 16384 MiB working-set allowance and at least 16384 MiB host reserve' \
  "$MEMORY" ||
  fail "Valgrind scope evidence does not name its exact resource policy"

retain=$(first_line \
  '  retain_valgrind_receipts "$VALGRIND_RECEIPT_COPY"' "$MEMORY")
structure_pre=$(last_line \
  '"$MODE_LOGS/prerequisite-structure-pre.log"' "$MEMORY")
content_pre=$(last_line \
  '"$MODE_LOGS/prerequisite-content-pre.log"' "$MEMORY")
semantic_pre=$(last_line \
  '"$MODE_LOGS/prerequisite-semantics-pre.log"' "$MEMORY")
metadata_start=$(first_line \
  '  initialize_valgrind_prerequisite_metadata' "$MEMORY")
ordinary_post=$(first_line \
  '  verify_ordinary_input_metadata post-valgrind' "$MEMORY")
metadata_before=$(first_line \
  '  verify_valgrind_prerequisite_metadata post-before' "$MEMORY")
structure_post=$(last_line \
  '"$MODE_LOGS/prerequisite-structure-post.log"' "$MEMORY")
content_post=$(last_line \
  '"$MODE_LOGS/prerequisite-content-post.log"' "$MEMORY")
semantic_post=$(last_line \
  '"$MODE_LOGS/prerequisite-semantics-post.log"' "$MEMORY")
metadata_after=$(first_line \
  '  verify_valgrind_prerequisite_metadata post-after' "$MEMORY")
metadata_ledger=$(first_line \
  '  verify_valgrind_prerequisite_metadata_ledger' "$MEMORY")
release=$(first_line '  release_valgrind_state_lock' "$MEMORY")

(( retain < receipt_compares[0] &&
   receipt_compares[0] < structure_pre &&
   structure_pre < content_pre && content_pre < semantic_pre &&
   semantic_pre < receipt_compares[1] &&
   receipt_compares[1] < metadata_start &&
   metadata_start < ordinary_post && ordinary_post < metadata_before &&
   metadata_before < receipt_compares[2] &&
   receipt_compares[2] < structure_post &&
   structure_post < content_post && content_post < semantic_post &&
   semantic_post < metadata_after &&
   metadata_after < receipt_compares[3] &&
   receipt_compares[3] < metadata_ledger && metadata_ledger < release )) ||
  fail "Valgrind authentication/content/semantic boundaries are misordered"

[[ $(grep -Ec '^verify_ordinary_inputs final$' "$MEMORY") -eq 1 ]] ||
  fail "ordinary multi-gigabyte inputs are not content-verified exactly once at postflight"
modes_receipt=$(first_line \
  '"$RUN_DIRECTORY/metadata/memory-modes-tree.tsv"' "$MEMORY")
ordinary_ledger=$(exact_line 'verify_ordinary_metadata_ledger' "$MEMORY")
ordinary_final=$(exact_line 'verify_ordinary_inputs final' "$MEMORY")
completion=$(first_line \
  'mv "$MEMORY_COMPLETION_NEW" "$RUN_DIRECTORY/metadata/completion.txt"' \
  "$MEMORY")
(( modes_receipt < ordinary_ledger && ordinary_ledger < ordinary_final &&
   ordinary_final < completion )) ||
  fail "memory completion precedes its final evidence/content boundary"

if grep -Fq 'mkdir -p "$(dirname -- "$VALGRIND_STATE_LOCK")"' "$MEMORY"; then
  fail "memory state lock parent can be redirected through a symbolic path"
fi
grep -Fq 'ensure_plain_state_directory "$(dirname -- "$VALGRIND_STATE_LOCK")"' \
  "$MEMORY" || fail "memory state lock parent is not authenticated"

# Receipt schema changes do not invalidate unchanged runtime bytes.  Cache-hit
# verifiers make one pass per tree; source archives are read only when consumed.
r_writer=$(function_body write_r_inputs "$RECEIPTS")
library_writer=$(function_body write_library_inputs "$RECEIPTS")
if printf '%s\n%s\n' "$r_writer" "$library_writer" | \
    grep -Eq 'receipt_helper_sha256|tree_helper_sha256'; then
  fail "verifier implementation bytes remain part of the artifact cache key"
fi
printf '%s\n' "$library_writer" | grep -Fq declared_archive_set_sha256 ||
  fail "package cache-hit input generation rereads every package archive"

r_verify=$(function_body verify_r_receipt "$RECEIPTS")
library_verify=$(function_body verify_library_receipt "$RECEIPTS")
[[ $(printf '%s\n' "$r_verify" | \
  grep -Fc '"$RSCRIPT" --vanilla "$TREE_HELPER" verify') -eq 3 ]] ||
  fail "R cache verification does not traverse each of its three trees once"
[[ $(printf '%s\n' "$library_verify" | \
  grep -Fc '"$RSCRIPT" --vanilla "$TREE_HELPER" verify') -eq 1 ]] ||
  fail "package-library cache verification does not traverse its tree once"
if printf '%s\n' "$library_verify" | grep -Fq verify_package_archives; then
  fail "no-op package verification rereads source archives it does not consume"
fi

structure_body=$(function_body verify_memory_structure "$RECEIPTS")
if printf '%s\n' "$structure_body" | \
    grep -Eq 'validate_r_runtime|validate_installed_library|\$RSCRIPT|\$R_BINARY'; then
  fail "instrumented runtime code can execute before content authentication"
fi

[[ $(grep -Ec '^if "\$RECEIPT_HELPER" verify-library ' \
  "$PACKAGE_BOOTSTRAP") -eq 1 ]] ||
  fail "package bootstrap repeats its combined no-op cache verification"
refresh_library=$(first_line \
  'if "$RECEIPT_HELPER" refresh-library "$ROOT" "$MANIFEST" \' \
  "$PACKAGE_BOOTSTRAP")
stage_library=$(first_line \
  'STAGING_LIBRARY="$ROOT/.local/r-valgrind/library.new.$$"' \
  "$PACKAGE_BOOTSTRAP")
(( refresh_library < stage_library )) ||
  fail "package reinstall begins before authenticated receipt migration"
refresh_r=$(first_line 'if "$RECEIPT_HELPER" refresh-r "$ROOT"' "$R_BUILD")
clean_r=$(first_line 'rm -rf "$BUILD" "$PREFIX"' "$R_BUILD")
(( refresh_r < clean_r )) ||
  fail "instrumented R is deleted before authenticated receipt migration"

# Functional batches finish their selected inventory, seal every failure, and
# bind the result to the DSO that was loaded throughout the run.
grep -Fq '"expected-dso-sha256"' "$TEST_VERIFIER" ||
  fail "functional ledger verifier has no expected DSO identity"
grep -Fq 'any(ledger$dso_sha256 != expected_dso_sha256)' "$TEST_VERIFIER" ||
  fail "functional ledger rows are not bound to the expected DSO"
runner_assert=$(last_line 'assert_dso_unchanged(loaded_dso)' "$TEST_RUNNER")
runner_write=$(last_line 'write_ledger(' "$TEST_RUNNER")
runner_fail=$(last_line 'testthat:::test_files_check(' "$TEST_RUNNER")
(( runner_assert < runner_write && runner_write < runner_fail )) ||
  fail "functional tests stop before publishing their complete DSO-bound ledger"
grep -Fq 'stop_on_failure = FALSE' "$TEST_RUNNER" ||
  fail "functional batch still stops at its first ordinary failure"
grep -Fq 'requested_jobs = requested_jobs_value' "$TEST_RUNNER" ||
  fail "functional ledger does not retain requested parallelism"
grep -Fq 'effective_jobs = effective_jobs' "$TEST_RUNNER" ||
  fail "functional ledger does not retain effective parallelism"
grep -Fq 'scheduler_backend = scheduler_backend' "$TEST_RUNNER" ||
  fail "functional ledger does not retain its scheduler backend"
for selector in "$TEST_RUNNER" "$TEST_VERIFIER"; do
  grep -Fq '"upgrade-paradox-object|upgrade-registry)"' "$selector" ||
    fail "focused native-test selection omits a migration contract: $selector"
done

# The old-R and legacy consumer fallbacks are costly enough that they must
# expose the complete ordinary failure set before enforcing their strict clean
# result.  Keep this invariant even though the default repository path is now
# resumable: the fallback remains useful when diagnosing runner regressions.
for complete_runner in "$RUNTIME_MATRIX_TEST_RUNNER" \
    "$LEGACY_REPOSITORY_RUNNER"; do
  grep -Fq 'stop_on_failure = FALSE' "$complete_runner" ||
    fail "expensive fallback still stops at its first failure: $complete_runner"
  grep -Fq 'stop_on_warning = FALSE' "$complete_runner" ||
    fail "expensive fallback still stops at its first warning: $complete_runner"
done
runtime_test_start=$(first_line 'results <- testthat::test_dir(' \
  "$RUNTIME_MATRIX_TEST_RUNNER")
runtime_strict_summary=$(first_line \
  'if (failed != 0L || warnings != 0L || errors != 0L ||' \
  "$RUNTIME_MATRIX_TEST_RUNNER")
((runtime_test_start < runtime_strict_summary)) ||
  fail "runtime-matrix strict summary precedes its complete test batch"
repository_test_start=$(first_line 'test_results <- testthat::test_local(' \
  "$LEGACY_REPOSITORY_RUNNER")
repository_test_strict=$(first_line 'testthat:::test_files_check(' \
  "$LEGACY_REPOSITORY_RUNNER")
((repository_test_start < repository_test_strict)) ||
  fail "legacy repository strict result precedes its complete test batch"

# Operator job limits are lowering-only and parsed before shell arithmetic.
# Rejecting non-canonical or oversized digit strings prevents octal surprises
# and arithmetic wraparound in every expensive local build.
grep -Fq '[[ "$REQUESTED_JOBS" =~ ^[1-9][0-9]{0,8}$ ]]' "$R_BUILD" ||
  fail "instrumented-R build accepts an unsafe operator job count"
if grep -Fq 'AUTO_JOBS=$($RESOURCE_JOBS_HELPER compile)' "$R_BUILD"; then
  fail "instrumented-R make limit is detached from its retained report"
fi
grep -Fq 'JOBS=$(resource_report_jobs "$RESOURCE_REPORT_STAGING")' "$R_BUILD" ||
  fail "instrumented-R make limit is not parsed from retained evidence"
grep -Fq 'mv "$RESOURCE_REPORT_STAGING" "$BUILD/resource-jobs.tsv"' "$R_BUILD" ||
  fail "instrumented-R build does not retain the report that selected -j"

# The scheduler is a live CPU/RAM admission decision, not a raw CPU count.
# Keep the reviewed per-profile budgets and require callers/runners to retain
# the exact report from which their lowering-only ceiling was parsed.
compile_profile=$(awk '
  $0 == "  compile)" { inside = 1 }
  inside { print }
  inside && $0 == "    ;;" { exit }
' "$RESOURCE_JOBS")
api_profile=$(awk '
  $0 == "  api-compile)" { inside = 1 }
  inside { print }
  inside && $0 == "    ;;" { exit }
' "$RESOURCE_JOBS")
consumer_profile=$(awk '
  $0 == "  consumer)" { inside = 1 }
  inside { print }
  inside && $0 == "    ;;" { exit }
' "$RESOURCE_JOBS")
light_profile=$(awk '
  $0 == "  light-test)" { inside = 1 }
  inside { print }
  inside && $0 == "    ;;" { exit }
' "$RESOURCE_JOBS")
valgrind_profile=$(awk '
  $0 == "  valgrind)" { inside = 1 }
  inside { print }
  inside && $0 == "    ;;" { exit }
' "$RESOURCE_JOBS")
rchk_profile=$(awk '
  $0 == "  rchk)" { inside = 1 }
  inside { print }
  inside && $0 == "    ;;" { exit }
' "$RESOURCE_JOBS")
verify_resource_profile() {
  local profile_body=$1
  shift
  local budget
  for budget in "$@"; do
    printf '%s\n' "$profile_body" | grep -Fqx "    $budget" ||
      fail "resource profile lost reviewed budget $budget"
  done
}
verify_resource_profile "$compile_profile" CPU_PER_JOB=1 \
  MEMORY_MIB_PER_JOB=1024 MINIMUM_RESERVE_MIB=12288 PROFILE_MAX_JOBS=16 \
  AGGREGATE_MEMORY_MIB_PER_JOB=1024 AGGREGATE_MINIMUM_RESERVE_MIB=4096 \
  AGGREGATE_PROFILE_MAX_JOBS=16
verify_resource_profile "$api_profile" CPU_PER_JOB=1 \
  MEMORY_MIB_PER_JOB=768 MINIMUM_RESERVE_MIB=12288 PROFILE_MAX_JOBS=0 \
  AGGREGATE_MEMORY_MIB_PER_JOB=768 AGGREGATE_MINIMUM_RESERVE_MIB=4096 \
  AGGREGATE_PROFILE_MAX_JOBS=0
verify_resource_profile "$consumer_profile" CPU_PER_JOB=2 \
  MEMORY_MIB_PER_JOB=8192 MINIMUM_RESERVE_MIB=16384 PROFILE_MAX_JOBS=4 \
  AGGREGATE_MEMORY_MIB_PER_JOB=2048 AGGREGATE_MINIMUM_RESERVE_MIB=4096 \
  AGGREGATE_PROFILE_MAX_JOBS=8
verify_resource_profile "$light_profile" CPU_PER_JOB=1 \
  MEMORY_MIB_PER_JOB=2048 MINIMUM_RESERVE_MIB=12288 PROFILE_MAX_JOBS=16 \
  AGGREGATE_MEMORY_MIB_PER_JOB=1024 AGGREGATE_MINIMUM_RESERVE_MIB=4096 \
  AGGREGATE_PROFILE_MAX_JOBS=16
verify_resource_profile "$valgrind_profile" CPU_PER_JOB=1 \
  MEMORY_MIB_PER_JOB=16384 MINIMUM_RESERVE_MIB=16384 PROFILE_MAX_JOBS=1 \
  AGGREGATE_MEMORY_MIB_PER_JOB=16384 AGGREGATE_MINIMUM_RESERVE_MIB=16384 \
  AGGREGATE_PROFILE_MAX_JOBS=1
verify_resource_profile "$rchk_profile" CPU_PER_JOB=1 \
  MEMORY_MIB_PER_JOB=20480 MINIMUM_RESERVE_MIB=16384 PROFILE_MAX_JOBS=1 \
  AGGREGATE_MEMORY_MIB_PER_JOB=20480 AGGREGATE_MINIMUM_RESERVE_MIB=16384 \
  AGGREGATE_PROFILE_MAX_JOBS=1
grep -Fq 'DYNAMIC_RESERVE_MIB=$((MEMORY_AVAILABLE_MIB / 4))' \
  "$RESOURCE_JOBS" ||
  fail "resource scheduler no longer reserves one quarter of live memory"
grep -Fq 'RESERVE_MIB=$EFFECTIVE_MINIMUM_RESERVE_MIB' "$RESOURCE_JOBS" ||
  fail "resource scheduler no longer enforces its absolute memory reserve"
for contract in \
    'CONTAINMENT=direct' \
    '"${PARADOX_VERIFY_AGGREGATE_SYSTEMD:-}" == 1' \
    '"${PARADOX_VERIFY_HARD_WORKER:-}" == 1' \
    'CONTAINMENT=aggregate-systemd' \
    'CONTAINMENT=worker-hard' \
    'WORKER_MINIMUM_RESERVE_MIB=1024' \
    'EFFECTIVE_MEMORY_MIB_PER_JOB=$AGGREGATE_MEMORY_MIB_PER_JOB' \
    'EFFECTIVE_MINIMUM_RESERVE_MIB=$AGGREGATE_MINIMUM_RESERVE_MIB' \
    'EFFECTIVE_PROFILE_MAX_JOBS=$AGGREGATE_PROFILE_MAX_JOBS' \
