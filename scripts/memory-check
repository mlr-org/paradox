#!/usr/bin/env sh
# shellcheck disable=SC2016,SC1003 # literal R/driver code and emitted continuations

set -eu

usage() {
  cat <<'EOF'
Usage: scripts/memory-check --source-run ID --mode MODE [--mode MODE ...]
                            [--run-id ID]

Run release memory checks against a hash-verified copy of the immutable source
retained by an earlier check run.  There is deliberately no default mode.

Modes:
  gct       complete registered-routine and allocation-hazard probes under
            gctorture2(10), reusing the sealed strict-GCC candidate build
  valgrind  the same complete probes under Valgrind with the separately built,
            instrumented R 4.6.1 and dependency library
  rchk      source-pinned bounded bcheck plus image-pinned maacheck and
            fficheck, with an enforced 20 GiB analyzer address-space limit
  all       all three modes

Options:
  --source-run ID  required source snapshot below .local/checks/ID
  --run-id ID      output ID below .local/checks (default: UTC timestamp/PID)
  -h, --help       show this help and exit

The repository-local environment must already be active:

  . scripts/activate

The valgrind mode never builds R or installs prerequisite packages
automatically; it installs the frozen paradox candidate once for the dedicated
R.  Prepare the runtime with scripts/build-valgrind-r and
scripts/bootstrap-valgrind-r-packages.
The rchk mode never pulls an image or builds an analyzer. Prepare the exact
manifest digest with scripts/fetch-auxiliary-images and the authenticated local
analyzer cache with scripts/prepare-bounded-rchk-bcheck. Every mode retains
commands, source, provenance, tool versions, logs, and mode-specific artifacts
in its run.
EOF
}

fail() {
  printf '%s\n' "memory-check: $*" >&2
  exit 1
}

MODE_GCT=false
MODE_VALGRIND=false
MODE_RCHK=false
MODE_SELECTED=false
RUN_ID=
SOURCE_RUN_ID=

select_mode() {
  case "$1" in
    gct)
      MODE_GCT=true
      ;;
    valgrind)
      MODE_VALGRIND=true
      ;;
    rchk)
      MODE_RCHK=true
      ;;
    all)
      MODE_GCT=true
      MODE_VALGRIND=true
      MODE_RCHK=true
      ;;
    *)
      fail "unknown mode '$1' (see --help)"
      ;;
  esac
  MODE_SELECTED=true
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --mode)
      [ "$#" -ge 2 ] || fail "--mode requires a value"
      select_mode "$2"
      shift 2
      ;;
    --mode=*)
      select_mode "${1#--mode=}"
      shift
      ;;
    --run-id)
      [ "$#" -ge 2 ] || fail "--run-id requires a value"
      RUN_ID=$2
      shift 2
      ;;
    --run-id=*)
      RUN_ID=${1#--run-id=}
      shift
      ;;
    --source-run)
      [ "$#" -ge 2 ] || fail "--source-run requires a value"
      SOURCE_RUN_ID=$2
      shift 2
      ;;
    --source-run=*)
      SOURCE_RUN_ID=${1#--source-run=}
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      [ "$#" -eq 0 ] || fail "positional arguments are not supported"
      ;;
    *)
      fail "unknown argument '$1' (see --help)"
      ;;
  esac
done

[ "$MODE_SELECTED" = true ] || fail "at least one --mode is required"
[ -n "$SOURCE_RUN_ID" ] || fail "--source-run is required"

safe_id() {
  case "$1" in
    *[!A-Za-z0-9._-]*|''|.|..)
      return 1
      ;;
  esac
  return 0
}

safe_id "$SOURCE_RUN_ID" ||
  fail "--source-run must use only letters, digits, dot, underscore, hyphen"
if [ -n "$RUN_ID" ]; then
  safe_id "$RUN_ID" ||
    fail "--run-id must use only letters, digits, dot, underscore, hyphen"
else
  RUN_ID="memory-$(date -u +%Y%m%dT%H%M%SZ)-$$"
fi
[ "$SOURCE_RUN_ID" != "$RUN_ID" ] ||
  fail "--source-run and --run-id must identify different runs"

SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd -P)
[ "$(pwd -P)" = "$ROOT" ] || fail "run this command from the repository root"
[ "${PARADOX_ACTIVE_ROOT:-}" = "$ROOT" ] ||
  fail "activate the local environment first: . scripts/activate"

TOOLCHAIN="$ROOT/.local/toolchain"
TOOLCHAIN_LOCK="$ROOT/environment/toolchain-linux-64.lock"
ORDINARY_R="$TOOLCHAIN/bin/R"
ORDINARY_RSCRIPT="$TOOLCHAIN/bin/Rscript"
ORDINARY_LIBRARY="$ROOT/.local/R/library"
LOCAL_PATH="$TOOLCHAIN/bin:$ROOT/.local/bin:/usr/bin:/bin"
LOCAL_TARGET=x86_64-conda-linux-gnu
LOCAL_SYSROOT="$TOOLCHAIN/$LOCAL_TARGET/sysroot"
LOCAL_PKG_CONFIG_PATH="$TOOLCHAIN/lib/pkgconfig:$TOOLCHAIN/share/pkgconfig"
LOCAL_PKG_CONFIG_LIBDIR="$LOCAL_PKG_CONFIG_PATH:$LOCAL_SYSROOT/usr/lib/pkgconfig:$LOCAL_SYSROOT/usr/share/pkgconfig"
LOCAL_CMAKE_PREFIX_PATH="$TOOLCHAIN:$LOCAL_SYSROOT/usr"
LOCAL_LD_LIBRARY_PATH="$TOOLCHAIN/lib"
LOCAL_AR="$TOOLCHAIN/bin/$LOCAL_TARGET-ar"
LOCAL_RANLIB="$TOOLCHAIN/bin/$LOCAL_TARGET-ranlib"
LOCAL_AS="$TOOLCHAIN/bin/$LOCAL_TARGET-as"
LOCAL_LD="$TOOLCHAIN/bin/$LOCAL_TARGET-ld"
LOCAL_NM="$TOOLCHAIN/bin/$LOCAL_TARGET-nm"
LOCAL_STRIP="$TOOLCHAIN/bin/$LOCAL_TARGET-strip"
LOCAL_OBJCOPY="$TOOLCHAIN/bin/$LOCAL_TARGET-objcopy"
LOCAL_OBJDUMP="$TOOLCHAIN/bin/$LOCAL_TARGET-objdump"
LOCAL_READELF="$TOOLCHAIN/bin/$LOCAL_TARGET-readelf"
LOCAL_CPP="$TOOLCHAIN/bin/$LOCAL_TARGET-cpp"
LOCAL_CMAKE_ARGS="-DCMAKE_AR=$LOCAL_AR -DCMAKE_CXX_COMPILER_AR=$TOOLCHAIN/bin/$LOCAL_TARGET-gcc-ar -DCMAKE_C_COMPILER_AR=$TOOLCHAIN/bin/$LOCAL_TARGET-gcc-ar -DCMAKE_RANLIB=$LOCAL_RANLIB -DCMAKE_CXX_COMPILER_RANLIB=$TOOLCHAIN/bin/$LOCAL_TARGET-gcc-ranlib -DCMAKE_C_COMPILER_RANLIB=$TOOLCHAIN/bin/$LOCAL_TARGET-gcc-ranlib -DCMAKE_LINKER=$LOCAL_LD -DCMAKE_STRIP=$LOCAL_STRIP -DCMAKE_BUILD_TYPE=Release"
COPY_SNAPSHOT="$ROOT/scripts/environment/copy-check-snapshot.R"
HARNESS_SCRIPT="$ROOT/scripts/memory-check"
SOURCE_RUN_VALIDATOR="$ROOT/scripts/environment/validate-native-source-run"
OFFLINE_REPOSITORY_HELPER="$ROOT/scripts/environment/create-offline-check-repository.R"
VALGRIND_RECEIPT_HELPER="$ROOT/scripts/environment/valgrind-receipts"
TREE_RECEIPT_HELPER="$ROOT/scripts/environment/tree-receipt.R"
MEMORY_EVIDENCE_HELPER="$ROOT/scripts/environment/validate-memory-evidence"
NATIVE_PROBE_RUNNER="$ROOT/scripts/environment/run-native-probes.R"
NATIVE_PROBE_VERIFIER="$ROOT/scripts/environment/verify-native-probes.R"
NATIVE_TEST_RUNNER="$ROOT/scripts/environment/run-native-tests.R"
NATIVE_TEST_WORKER="$ROOT/scripts/environment/run-native-test-worker.R"
NATIVE_TEST_WORKER_GROUP="$ROOT/scripts/environment/run-native-test-worker-group"
NATIVE_TEST_VERIFIER="$ROOT/scripts/environment/verify-native-test-ledger.R"
RESOURCE_JOBS_HELPER="$ROOT/scripts/environment/resource-jobs"
BOUNDED_RCHK_PREPARER="$ROOT/scripts/prepare-bounded-rchk-bcheck"
BOUNDED_RCHK_BUILD_DRIVER="$ROOT/scripts/environment/build-bounded-rchk-bcheck"
BOUNDED_RCHK_CONFIG="$ROOT/environment/rchk-bounded-bcheck.tsv"
BOUNDED_RCHK_COMMAND="$ROOT/environment/rchk-bounded-bcheck-command.tsv"
BOUNDED_RCHK_ENVIRONMENT="$ROOT/environment/rchk-bounded-bcheck-environment.tsv"
BOUNDED_RCHK_TOOL_IDENTITY="$ROOT/environment/rchk-bounded-bcheck-tool-identity.tsv"
TRUSTED_RCHK_POLICY_DIRECTORY="$ROOT/environment/rchk-bcheck-policy"
DEBUG_SYMBOL_HELPER="$ROOT/scripts/bootstrap-valgrind-debug-symbols"
LOCAL_USER=$(/usr/bin/id -un)
VALGRIND_STATE_LOCK="$ROOT/.local/r-valgrind/locks/state.lock"
VALGRIND_LOCK_HELD=false
for required in "$ORDINARY_R" "$ORDINARY_RSCRIPT"; do
  [ -x "$required" ] || fail "local R is missing; run scripts/bootstrap"
done
for required in "$LOCAL_AR" "$LOCAL_RANLIB" "$LOCAL_AS" "$LOCAL_LD" \
    "$LOCAL_NM" "$LOCAL_STRIP" "$LOCAL_OBJCOPY" "$LOCAL_OBJDUMP" \
    "$LOCAL_READELF" "$LOCAL_CPP" \
    "$TOOLCHAIN/bin/$LOCAL_TARGET-gcc-ar" \
    "$TOOLCHAIN/bin/$LOCAL_TARGET-gcc-ranlib"; do
  [ -x "$required" ] || fail "required local tool is missing: $required"
done
[ -d "$ORDINARY_LIBRARY" ] || fail "repository-local R library is missing"
[ -f "$TOOLCHAIN_LOCK" ] && [ ! -L "$TOOLCHAIN_LOCK" ] ||
  fail "toolchain lock is missing or symbolic: $TOOLCHAIN_LOCK"
[ -f "$COPY_SNAPSHOT" ] || fail "snapshot verifier is missing: $COPY_SNAPSHOT"
[ -f "$HARNESS_SCRIPT" ] || fail "memory-check script is missing: $HARNESS_SCRIPT"
[ -x "$SOURCE_RUN_VALIDATOR" ] ||
  fail "source-run validator is missing: $SOURCE_RUN_VALIDATOR"
[ -f "$OFFLINE_REPOSITORY_HELPER" ] && [ ! -L "$OFFLINE_REPOSITORY_HELPER" ] ||
  fail "offline repository helper is missing or symbolic: $OFFLINE_REPOSITORY_HELPER"
[ -x "$VALGRIND_RECEIPT_HELPER" ] ||
  fail "Valgrind receipt helper is missing: $VALGRIND_RECEIPT_HELPER"
[ -f "$TREE_RECEIPT_HELPER" ] ||
  fail "tree-receipt helper is missing: $TREE_RECEIPT_HELPER"
[ -x "$MEMORY_EVIDENCE_HELPER" ] ||
  fail "memory-evidence validator is missing: $MEMORY_EVIDENCE_HELPER"
for required in "$NATIVE_PROBE_RUNNER" "$NATIVE_PROBE_VERIFIER" \
    "$NATIVE_TEST_RUNNER" "$NATIVE_TEST_WORKER" \
    "$NATIVE_TEST_WORKER_GROUP" "$NATIVE_TEST_VERIFIER" \
    "$RESOURCE_JOBS_HELPER" \
    "$BOUNDED_RCHK_PREPARER" "$BOUNDED_RCHK_BUILD_DRIVER" \
    "$BOUNDED_RCHK_CONFIG" "$BOUNDED_RCHK_COMMAND" \
    "$BOUNDED_RCHK_ENVIRONMENT" "$BOUNDED_RCHK_TOOL_IDENTITY"; do
  [ -f "$required" ] && [ ! -L "$required" ] ||
    fail "native coverage input is missing or symbolic: $required"
done
[ -x "$DEBUG_SYMBOL_HELPER" ] ||
  fail "Valgrind debug-symbol verifier is missing: $DEBUG_SYMBOL_HELPER"
[ "${CONDA_PREFIX:-}" = "$TOOLCHAIN" ] ||
  fail "CONDA_PREFIX does not identify the activated local toolchain"
[ "$(command -v R)" = "$ORDINARY_R" ] ||
  fail "R does not resolve to the activated local executable"
[ "$("$ORDINARY_R" RHOME)" = "$TOOLCHAIN/lib/R" ] ||
  fail "R_HOME is not project-local"
ORDINARY_R_VERSION=$("$ORDINARY_R" --vanilla --slave -e \
  'cat(as.character(getRversion()))')
[ "$ORDINARY_R_VERSION" = "4.6.1" ] ||
  fail "expected ordinary local R 4.6.1, found $ORDINARY_R_VERSION"

CHECKS_ROOT="$ROOT/.local/checks"
require_plain_check_directory() {
  checked_directory=$1
  [ -d "$checked_directory" ] && [ ! -L "$checked_directory" ] ||
    fail "managed check directory is missing, non-directory, or symbolic: $checked_directory"
  [ "$(CDPATH='' cd -- "$checked_directory" && pwd -P)" = "$checked_directory" ] ||
    fail "managed check directory resolves outside its expected path: $checked_directory"
}
ensure_plain_state_directory() {
  state_directory=$1
  state_parent=$(dirname -- "$state_directory")
  case "$state_directory" in
    "$ROOT/.local/r-valgrind"|"$ROOT/.local/r-valgrind/locks") ;;
    *) fail "unexpected managed state directory: $state_directory" ;;
  esac
  require_plain_check_directory "$state_parent"
  if [ -e "$state_directory" ] || [ -L "$state_directory" ]; then
    require_plain_check_directory "$state_directory"
  else
    mkdir -- "$state_directory" ||
      fail "could not create managed state directory: $state_directory"
    require_plain_check_directory "$state_directory"
  fi
}
require_plain_check_directory "$ROOT/.local"
require_plain_check_directory "$CHECKS_ROOT"
SOURCE_RUN_DIRECTORY="$CHECKS_ROOT/$SOURCE_RUN_ID"
[ -d "$SOURCE_RUN_DIRECTORY/source" ] ||
  fail "source run has no retained source: $SOURCE_RUN_DIRECTORY"
[ -f "$SOURCE_RUN_DIRECTORY/metadata/source-manifest.tsv" ] ||
  fail "source run has no retained manifest: $SOURCE_RUN_DIRECTORY"
[ ! -L "$SOURCE_RUN_DIRECTORY" ] && \
  [ ! -L "$SOURCE_RUN_DIRECTORY/source" ] && \
  [ ! -L "$SOURCE_RUN_DIRECTORY/metadata" ] && \
  [ ! -L "$SOURCE_RUN_DIRECTORY/metadata/source-manifest.tsv" ] ||
  fail "source run directories and manifest must not be symbolic links"
SOURCE_RUN_REAL=$(CDPATH='' cd -- "$SOURCE_RUN_DIRECTORY" && pwd -P)
[ "$SOURCE_RUN_REAL" = "$SOURCE_RUN_DIRECTORY" ] ||
  fail "source run must resolve directly below the repository-local checks tree"

RUN_DIRECTORY="$CHECKS_ROOT/$RUN_ID"
[ ! -e "$RUN_DIRECTORY" ] && [ ! -L "$RUN_DIRECTORY" ] ||
  fail "run directory already exists or is symbolic: $RUN_DIRECTORY"
(umask 077 && mkdir "$RUN_DIRECTORY" &&
  mkdir "$RUN_DIRECTORY/metadata" "$RUN_DIRECTORY/modes" \
    "$RUN_DIRECTORY/artifacts") ||
  fail "run directory already exists or cannot be created: $RUN_DIRECTORY"
require_plain_check_directory "$RUN_DIRECTORY"
cp "$HARNESS_SCRIPT" "$RUN_DIRECTORY/metadata/memory-check"
cp "$COPY_SNAPSHOT" "$RUN_DIRECTORY/metadata/copy-check-snapshot.R"
cp "$SOURCE_RUN_VALIDATOR" \
  "$RUN_DIRECTORY/metadata/validate-native-source-run"
cp "$OFFLINE_REPOSITORY_HELPER" \
  "$RUN_DIRECTORY/metadata/create-offline-check-repository.R"
cp "$VALGRIND_RECEIPT_HELPER" \
  "$RUN_DIRECTORY/metadata/valgrind-receipts"
cp "$TREE_RECEIPT_HELPER" "$RUN_DIRECTORY/metadata/tree-receipt.R"
cp "$MEMORY_EVIDENCE_HELPER" \
  "$RUN_DIRECTORY/metadata/validate-memory-evidence"
cp "$NATIVE_PROBE_RUNNER" \
  "$RUN_DIRECTORY/metadata/run-native-probes.R"
cp "$NATIVE_PROBE_VERIFIER" \
  "$RUN_DIRECTORY/metadata/verify-native-probes.R"
cp "$NATIVE_TEST_RUNNER" \
  "$RUN_DIRECTORY/metadata/run-native-tests.R"
cp "$NATIVE_TEST_WORKER" \
  "$RUN_DIRECTORY/metadata/run-native-test-worker.R"
cp "$NATIVE_TEST_WORKER_GROUP" \
  "$RUN_DIRECTORY/metadata/run-native-test-worker-group"
cp "$NATIVE_TEST_VERIFIER" \
  "$RUN_DIRECTORY/metadata/verify-native-test-ledger.R"
cp "$DEBUG_SYMBOL_HELPER" \
  "$RUN_DIRECTORY/metadata/bootstrap-valgrind-debug-symbols"
cp "$RESOURCE_JOBS_HELPER" \
  "$RUN_DIRECTORY/metadata/resource-jobs"
cp "$BOUNDED_RCHK_PREPARER" \
  "$RUN_DIRECTORY/metadata/prepare-bounded-rchk-bcheck"
cp "$BOUNDED_RCHK_BUILD_DRIVER" \
  "$RUN_DIRECTORY/metadata/build-bounded-rchk-bcheck"
cp "$BOUNDED_RCHK_CONFIG" \
  "$RUN_DIRECTORY/metadata/rchk-bounded-bcheck.tsv"
cp "$BOUNDED_RCHK_COMMAND" \
  "$RUN_DIRECTORY/metadata/rchk-bounded-bcheck-command.tsv"
cp "$BOUNDED_RCHK_ENVIRONMENT" \
  "$RUN_DIRECTORY/metadata/rchk-bounded-bcheck-environment.tsv"
cp "$BOUNDED_RCHK_TOOL_IDENTITY" \
  "$RUN_DIRECTORY/metadata/rchk-bounded-bcheck-tool-identity.tsv"
chmod 700 "$RUN_DIRECTORY/metadata/validate-native-source-run" \
  "$RUN_DIRECTORY/metadata/valgrind-receipts" \
  "$RUN_DIRECTORY/metadata/validate-memory-evidence" \
  "$RUN_DIRECTORY/metadata/bootstrap-valgrind-debug-symbols" \
  "$RUN_DIRECTORY/metadata/run-native-test-worker-group" \
  "$RUN_DIRECTORY/metadata/resource-jobs" \
  "$RUN_DIRECTORY/metadata/prepare-bounded-rchk-bcheck" \
  "$RUN_DIRECTORY/metadata/build-bounded-rchk-bcheck"
sha256sum "$RUN_DIRECTORY/metadata/memory-check" \
  "$RUN_DIRECTORY/metadata/copy-check-snapshot.R" \
  "$RUN_DIRECTORY/metadata/validate-native-source-run" \
  "$RUN_DIRECTORY/metadata/create-offline-check-repository.R" \
  "$RUN_DIRECTORY/metadata/valgrind-receipts" \
  "$RUN_DIRECTORY/metadata/tree-receipt.R" \
  "$RUN_DIRECTORY/metadata/validate-memory-evidence" \
  "$RUN_DIRECTORY/metadata/run-native-probes.R" \
  "$RUN_DIRECTORY/metadata/verify-native-probes.R" \
  "$RUN_DIRECTORY/metadata/run-native-tests.R" \
  "$RUN_DIRECTORY/metadata/run-native-test-worker.R" \
  "$RUN_DIRECTORY/metadata/run-native-test-worker-group" \
  "$RUN_DIRECTORY/metadata/verify-native-test-ledger.R" \
  "$RUN_DIRECTORY/metadata/bootstrap-valgrind-debug-symbols" \
  "$RUN_DIRECTORY/metadata/resource-jobs" \
  "$RUN_DIRECTORY/metadata/prepare-bounded-rchk-bcheck" \
  "$RUN_DIRECTORY/metadata/build-bounded-rchk-bcheck" \
  "$RUN_DIRECTORY/metadata/rchk-bounded-bcheck.tsv" \
  "$RUN_DIRECTORY/metadata/rchk-bounded-bcheck-command.tsv" \
  "$RUN_DIRECTORY/metadata/rchk-bounded-bcheck-environment.tsv" \
  "$RUN_DIRECTORY/metadata/rchk-bounded-bcheck-tool-identity.tsv" \
  > "$RUN_DIRECTORY/metadata/harness.sha256"
RETAINED_COPY_SNAPSHOT="$RUN_DIRECTORY/metadata/copy-check-snapshot.R"
RETAINED_SOURCE_RUN_VALIDATOR="$RUN_DIRECTORY/metadata/validate-native-source-run"
RETAINED_VALGRIND_RECEIPT_HELPER="$RUN_DIRECTORY/metadata/valgrind-receipts"
RETAINED_MEMORY_EVIDENCE_HELPER="$RUN_DIRECTORY/metadata/validate-memory-evidence"
RETAINED_NATIVE_PROBE_RUNNER="$RUN_DIRECTORY/metadata/run-native-probes.R"
RETAINED_NATIVE_PROBE_VERIFIER="$RUN_DIRECTORY/metadata/verify-native-probes.R"
RETAINED_NATIVE_TEST_RUNNER="$RUN_DIRECTORY/metadata/run-native-tests.R"
RETAINED_NATIVE_TEST_VERIFIER="$RUN_DIRECTORY/metadata/verify-native-test-ledger.R"
RETAINED_TREE_RECEIPT_HELPER="$RUN_DIRECTORY/metadata/tree-receipt.R"
RETAINED_DEBUG_SYMBOL_HELPER="$RUN_DIRECTORY/metadata/bootstrap-valgrind-debug-symbols"
RETAINED_RESOURCE_JOBS_HELPER="$RUN_DIRECTORY/metadata/resource-jobs"
RETAINED_BOUNDED_RCHK_PREPARER="$RUN_DIRECTORY/metadata/prepare-bounded-rchk-bcheck"
COMMAND_LOG="$RUN_DIRECTORY/commands.sh"
: > "$COMMAND_LOG"
chmod 600 "$COMMAND_LOG"
MEMORY_COMPLETION_READY=false

finish_run() {
  status=$?
  trap - 0
  if [ "$VALGRIND_LOCK_HELD" = true ]; then
    /usr/bin/flock -u 9 || true
    exec 9>&-
    VALGRIND_LOCK_HELD=false
  fi
  if [ "$status" -eq 0 ] && [ "$MEMORY_COMPLETION_READY" = true ] && \
      [ -f "$RUN_DIRECTORY/metadata/completion.txt" ] && \
      [ -f "$RUN_DIRECTORY/metadata/completion.sha256" ]; then
    state=passed
  else
    state=failed
    if [ "$status" -eq 0 ]; then
      status=1
    fi
  fi
  {
    printf 'status=%s\n' "$state"
    printf 'exit_code=%s\n' "$status"
    printf 'finished_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$RUN_DIRECTORY/metadata/result.txt"
  exit "$status"
}
trap finish_run 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

quote_argument() {
  case "$1" in
    '')
      printf "''"
      ;;
    *[!A-Za-z0-9_./:=,+@%-]*)
      printf "'"
      printf '%s' "$1" | sed "s/'/'\\\\''/g"
      printf "'"
      ;;
    *)
      printf '%s' "$1"
      ;;
  esac
}

log_command() {
  printf '$' >> "$COMMAND_LOG"
  for argument do
    printf ' ' >> "$COMMAND_LOG"
    quote_argument "$argument" >> "$COMMAND_LOG"
  done
  printf '\n' >> "$COMMAND_LOG"
}

log_command_in_directory() {
  directory=$1
  shift
  {
    printf '$ cd '
    quote_argument "$directory"
    printf ' &&'
    for argument do
      printf ' '
      quote_argument "$argument"
    done
    printf '\n'
  } >> "$COMMAND_LOG"
}

show_failure_log() {
  failed_log=$1
  printf '%s\n' "--- tail of $failed_log ---" >&2
  tail -n 240 "$failed_log" >&2 || true
}

run_logged() {
  output_log=$1
  shift
  mkdir -p "$(dirname -- "$output_log")"
  log_command "$@"
  if "$@" > "$output_log" 2>&1; then
    :
  else
    command_status=$?
    show_failure_log "$output_log"
    fail "command failed with status $command_status (log: $output_log)"
  fi
}

run_in_directory_logged() {
  output_log=$1
  working_directory=$2
  shift 2
  mkdir -p "$(dirname -- "$output_log")"
  log_command_in_directory "$working_directory" "$@"
  if (cd "$working_directory" && "$@") > "$output_log" 2>&1; then
    :
  else
    command_status=$?
    show_failure_log "$output_log"
    fail "command failed with status $command_status (log: $output_log)"
  fi
}

verify_rchk_policy_preflight() {
  policy_stage=$1
  policy_log="$RUN_DIRECTORY/metadata/rchk-policy-$policy_stage.log"
  run_logged "$policy_log" env -i \
    "HOME=$RUN_DIRECTORY/metadata/home" \
    "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
    "PATH=/usr/bin:/bin" "LC_ALL=C.UTF-8" "TZ=UTC" \
    "$RETAINED_MEMORY_EVIDENCE_HELPER" rchk-policy-directory \
    "$TRUSTED_RCHK_POLICY_DIRECTORY" \
    "$SOURCE_DIRECTORY/environment/rchk-bcheck-policy"
  [ "$(cat "$policy_log")" = \
      "rchk_policy_directory=matched
rchk_policy_files=3" ] ||
    fail "rchk policy preflight returned malformed evidence during $policy_stage"
}

resource_report_value() {
  awk -F '\t' -v target="$2" '
    $1 == target {
      if (NF != 2 || ++count != 1) exit 2
      value = $2
    }
    END {
      if (count != 1) exit 3
      print value
    }
  ' "$1"
}

validate_serial_resource_report() {
  resource_report=$1
  expected_profile=$2
  validation_log=$3
  run_logged "$validation_log" env -i \
    "HOME=$RUN_DIRECTORY/metadata/home" \
    "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
    "PATH=/usr/bin:/bin" "LC_ALL=C.UTF-8" "TZ=UTC" \
    "$RETAINED_RESOURCE_JOBS_HELPER" "$expected_profile" \
    --verify-report "$resource_report"
  [ "$(cat "$validation_log")" = \
      "resource_report_verified=$expected_profile" ] ||
    fail "$expected_profile resource admission validation output is malformed"
}

ORDINARY_INPUT_RECEIPTS="$RUN_DIRECTORY/metadata/ordinary-inputs"
mkdir -p "$ORDINARY_INPUT_RECEIPTS" "$RUN_DIRECTORY/metadata/home"
run_logged "$RUN_DIRECTORY/metadata/ordinary-toolchain-receipt-create.log" \
  env -i "HOME=$RUN_DIRECTORY/metadata/home" \
  "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
  "PATH=$LOCAL_PATH" "LD_LIBRARY_PATH=$LOCAL_LD_LIBRARY_PATH" \
  "R_ENVIRON_USER=/dev/null" "R_PROFILE_USER=/dev/null" \
  "R_HISTFILE=/dev/null" "TMPDIR=$ROOT/.local/tmp" \
  "LC_ALL=C.UTF-8" "TZ=UTC" \
  "$ORDINARY_RSCRIPT" --vanilla "$RETAINED_TREE_RECEIPT_HELPER" create \
  "$TOOLCHAIN" "$ORDINARY_INPUT_RECEIPTS/toolchain-tree.tsv"
run_logged "$RUN_DIRECTORY/metadata/ordinary-library-receipt-create.log" \
  env -i "HOME=$RUN_DIRECTORY/metadata/home" \
  "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
  "PATH=$LOCAL_PATH" "LD_LIBRARY_PATH=$LOCAL_LD_LIBRARY_PATH" \
  "R_ENVIRON_USER=/dev/null" "R_PROFILE_USER=/dev/null" \
  "R_HISTFILE=/dev/null" "TMPDIR=$ROOT/.local/tmp" \
  "LC_ALL=C.UTF-8" "TZ=UTC" \
  "$ORDINARY_RSCRIPT" --vanilla "$RETAINED_TREE_RECEIPT_HELPER" create \
  "$ORDINARY_LIBRARY" "$ORDINARY_INPUT_RECEIPTS/library-tree.tsv"
cp "$TOOLCHAIN_LOCK" "$ORDINARY_INPUT_RECEIPTS/toolchain-linux-64.lock"
(
  cd "$ORDINARY_INPUT_RECEIPTS"
  sha256sum toolchain-tree.tsv library-tree.tsv toolchain-linux-64.lock \
    > seal.sha256
)

# Content hashing the complete toolchain and dependency library at every mode
# boundary made memory validation spend substantial time rereading immutable
# inputs.  Retain one full content receipt above and verify it once at final
# postflight.  At intermediate boundaries use a non-following metadata digest:
# path, type, mode, size, mtime, ctime, device, inode, link count, and symlink
# target detect writes, replacement, and hard-link changes without rereading
# file contents.
write_tree_metadata_digest() {
  metadata_root=$1
  metadata_output=$2
  "$RETAINED_MEMORY_EVIDENCE_HELPER" metadata-fingerprint \
    "$metadata_root" "$metadata_output" >/dev/null
}

capture_ordinary_input_metadata() {
  metadata_stage=$1
  metadata_path="$ORDINARY_INPUT_RECEIPTS/metadata-$metadata_stage.tsv"
  toolchain_metadata="$ORDINARY_INPUT_RECEIPTS/toolchain-$metadata_stage.sha256"
  library_metadata="$ORDINARY_INPUT_RECEIPTS/library-$metadata_stage.sha256"
  write_tree_metadata_digest "$TOOLCHAIN" "$toolchain_metadata"
  write_tree_metadata_digest "$ORDINARY_LIBRARY" "$library_metadata"
  {
    printf 'input\troot\tmetadata_sha256\n'
    printf 'toolchain\t%s\t%s\n' "$TOOLCHAIN" "$(sed -n '1p' "$toolchain_metadata")"
    printf 'library\t%s\t%s\n' "$ORDINARY_LIBRARY" "$(sed -n '1p' "$library_metadata")"
  } > "$metadata_path"
  rm -f "$toolchain_metadata" "$library_metadata"
}

ORDINARY_METADATA_BASELINE="$ORDINARY_INPUT_RECEIPTS/metadata-start.tsv"
ORDINARY_METADATA_LEDGER="$ORDINARY_INPUT_RECEIPTS/metadata-ledger.tsv"
capture_ordinary_input_metadata start
printf 'stage\tsha256\n' > "$ORDINARY_METADATA_LEDGER"
printf 'start\t%s\n' \
  "$(sha256sum "$ORDINARY_METADATA_BASELINE" | cut -d ' ' -f 1)" \
  >> "$ORDINARY_METADATA_LEDGER"

verify_ordinary_input_metadata() {
  metadata_stage=$1
  capture_ordinary_input_metadata "$metadata_stage"
  metadata_path="$ORDINARY_INPUT_RECEIPTS/metadata-$metadata_stage.tsv"
  cmp -s "$ORDINARY_METADATA_BASELINE" "$metadata_path" ||
    fail "ordinary toolchain or dependency-library metadata changed during $metadata_stage"
  printf '%s\t%s\n' "$metadata_stage" \
    "$(sha256sum "$metadata_path" | cut -d ' ' -f 1)" \
    >> "$ORDINARY_METADATA_LEDGER"
}

verify_ordinary_metadata_ledger() {
  [ -f "$ORDINARY_METADATA_LEDGER" ] && [ ! -L "$ORDINARY_METADATA_LEDGER" ] ||
    fail "ordinary-input metadata ledger is absent or symbolic"
  /usr/bin/awk -F '\t' '
    NR == 1 {
      if ($0 != "stage\tsha256") exit 1
      next
    }
    NF != 2 || $1 !~ /^[A-Za-z0-9._-]+$/ ||
      length($2) != 64 || $2 ~ /[^0-9a-f]/ || seen[$1]++ { exit 1 }
    { rows++ }
    END { if (rows < 1) exit 1 }
  ' "$ORDINARY_METADATA_LEDGER" ||
    fail "ordinary-input metadata ledger is malformed or duplicated"
  expected_metadata_stages=$({
    printf '%s\n' start pre-source
    [ "$MODE_GCT" = false ] || printf '%s\n' pre-gct post-gct
    [ "$MODE_VALGRIND" = false ] || \
      printf '%s\n' pre-valgrind post-valgrind
    [ "$MODE_RCHK" = false ] || printf '%s\n' pre-rchk post-rchk
    printf '%s\n' final
  })
  observed_metadata_stages=$(/usr/bin/awk -F '\t' 'NR > 1 { print $1 }' \
    "$ORDINARY_METADATA_LEDGER")
  [ "$observed_metadata_stages" = "$expected_metadata_stages" ] ||
    fail "ordinary-input metadata stage inventory differs from selected modes"
  metadata_checks="$ORDINARY_INPUT_RECEIPTS/metadata-ledger.sha256.new"
  /usr/bin/awk -F '\t' 'NR > 1 {
    printf "%s  metadata-%s.tsv\n", $2, $1
  }' "$ORDINARY_METADATA_LEDGER" > "$metadata_checks"
  (cd "$ORDINARY_INPUT_RECEIPTS" &&
    sha256sum -c "$(basename -- "$metadata_checks")") >/dev/null || {
      rm -f "$metadata_checks"
      fail "ordinary-input metadata files differ from their ledger"
    }
  rm -f "$metadata_checks"
}

verify_ordinary_input_receipt_seal() {
  receipt_stage=$1
  (cd "$ORDINARY_INPUT_RECEIPTS" && sha256sum -c seal.sha256) >/dev/null ||
    fail "ordinary input receipt seal changed during $receipt_stage"
  cmp -s "$TOOLCHAIN_LOCK" \
    "$ORDINARY_INPUT_RECEIPTS/toolchain-linux-64.lock" ||
    fail "ordinary toolchain lock changed during $receipt_stage"
}

verify_ordinary_inputs() {
  verification_stage=$1
  run_logged "$RUN_DIRECTORY/metadata/ordinary-inputs-$verification_stage.log" \
    env -i "HOME=$RUN_DIRECTORY/metadata/home" \
    "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
    "PATH=$LOCAL_PATH" "LD_LIBRARY_PATH=$LOCAL_LD_LIBRARY_PATH" \
    "R_ENVIRON_USER=/dev/null" "R_PROFILE_USER=/dev/null" \
    "R_HISTFILE=/dev/null" "TMPDIR=$ROOT/.local/tmp" \
    "LC_ALL=C.UTF-8" "TZ=UTC" \
    "$ORDINARY_RSCRIPT" --vanilla "$RETAINED_TREE_RECEIPT_HELPER" verify \
    "$TOOLCHAIN" "$ORDINARY_INPUT_RECEIPTS/toolchain-tree.tsv"
  run_logged "$RUN_DIRECTORY/metadata/ordinary-library-$verification_stage.log" \
    env -i "HOME=$RUN_DIRECTORY/metadata/home" \
    "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
    "PATH=$LOCAL_PATH" "LD_LIBRARY_PATH=$LOCAL_LD_LIBRARY_PATH" \
    "R_ENVIRON_USER=/dev/null" "R_PROFILE_USER=/dev/null" \
    "R_HISTFILE=/dev/null" "TMPDIR=$ROOT/.local/tmp" \
    "LC_ALL=C.UTF-8" "TZ=UTC" \
    "$ORDINARY_RSCRIPT" --vanilla "$RETAINED_TREE_RECEIPT_HELPER" verify \
    "$ORDINARY_LIBRARY" "$ORDINARY_INPUT_RECEIPTS/library-tree.tsv"
  (cd "$ORDINARY_INPUT_RECEIPTS" && sha256sum -c seal.sha256) >/dev/null ||
    fail "ordinary input receipt seal changed during $verification_stage"
  cmp -s "$TOOLCHAIN_LOCK" \
    "$ORDINARY_INPUT_RECEIPTS/toolchain-linux-64.lock" ||
    fail "ordinary toolchain lock changed during $verification_stage"
}

