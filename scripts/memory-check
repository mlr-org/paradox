  CACHED_GCT_PACKAGE="$SOURCE_RUN_DIRECTORY/modes/strict-gcc/library/paradox"
  [ -d "$CACHED_GCT_PACKAGE" ] && [ ! -L "$CACHED_GCT_PACKAGE" ] ||
    fail "sealed source run has no regular strict-GCC candidate package"
  run_logged "$MODE_LOGS/cached-package-receipt-create.log" \
    env -i "HOME=$MODE_DIRECTORY/home" \
    "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
    "PATH=$LOCAL_PATH" "LD_LIBRARY_PATH=$LOCAL_LD_LIBRARY_PATH" \
    "R_ENVIRON_USER=/dev/null" "R_PROFILE_USER=/dev/null" \
    "R_HISTFILE=/dev/null" "TMPDIR=$MODE_WORK" \
    "LC_ALL=C.UTF-8" "TZ=UTC" \
    "$ORDINARY_RSCRIPT" --vanilla "$RETAINED_TREE_RECEIPT_HELPER" create \
    "$CACHED_GCT_PACKAGE" "$MODE_ARTIFACTS/cached-package-tree.tsv"
  # The source run lives outside this new run and can change after the initial
  # proof. Authenticate its origin-bound modes tree after taking the package
  # receipt, then immediately prove that the receipted source package did not
  # change across that authentication window.
  run_logged "$MODE_LOGS/source-run-proof-at-use.txt" \
    env -i "HOME=$MODE_DIRECTORY/home" \
    "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
    "PATH=$LOCAL_PATH" "LC_ALL=C.UTF-8" "TZ=UTC" \
    "$RETAINED_SOURCE_RUN_VALIDATOR" "$ROOT" "$SOURCE_RUN_ID" \
    "$SOURCE_RUN_DIRECTORY"
  cmp -s "$RUN_DIRECTORY/metadata/source-run-proof.post.txt" \
    "$MODE_LOGS/source-run-proof-at-use.txt" ||
    fail "source-run proof changed before the cached GCT package was used"
  run_logged "$MODE_LOGS/copy-cached-package.log" \
    cp -a -- "$CACHED_GCT_PACKAGE" "$MODE_LIBRARY/paradox"
  run_logged "$MODE_LOGS/cached-package-source-verify.log" \
    env -i "HOME=$MODE_DIRECTORY/home" \
    "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
    "PATH=$LOCAL_PATH" "LD_LIBRARY_PATH=$LOCAL_LD_LIBRARY_PATH" \
    "R_ENVIRON_USER=/dev/null" "R_PROFILE_USER=/dev/null" \
    "R_HISTFILE=/dev/null" "TMPDIR=$MODE_WORK" \
    "LC_ALL=C.UTF-8" "TZ=UTC" \
    "$ORDINARY_RSCRIPT" --vanilla "$RETAINED_TREE_RECEIPT_HELPER" verify \
    "$CACHED_GCT_PACKAGE" "$MODE_ARTIFACTS/cached-package-tree.tsv"
  run_logged "$MODE_LOGS/cached-package-copy-verify.log" \
    env -i "HOME=$MODE_DIRECTORY/home" \
    "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
    "PATH=$LOCAL_PATH" "LD_LIBRARY_PATH=$LOCAL_LD_LIBRARY_PATH" \
    "R_ENVIRON_USER=/dev/null" "R_PROFILE_USER=/dev/null" \
    "R_HISTFILE=/dev/null" "TMPDIR=$MODE_WORK" \
    "LC_ALL=C.UTF-8" "TZ=UTC" \
    "$ORDINARY_RSCRIPT" --vanilla "$RETAINED_TREE_RECEIPT_HELPER" verify \
    "$MODE_LIBRARY/paradox" "$MODE_ARTIFACTS/cached-package-tree.tsv"
  write_probe_dso_hash "$MODE_LIBRARY" "$MODE_ARTIFACTS"
  GCT_PROBE_RESULT="$MODE_ARTIFACTS/native-probes.tsv"
  {
    printf '%s\n' \
      'mode=gct' \
      'r_executable=ordinary repository-local R 4.6.1' \
      'candidate=sealed strict-GCC install copied from the native source run' \
      'gctorture2_step=10' \
      'coverage=every registered routine plus four reviewed allocation/callback hazards' \
      'rounds=1' \
      'functional_tests=false (owned by the frozen native run)' \
      'examples_vignettes_manual=false (documentation and policy are separate gates)'
  } > "$MODE_ARTIFACTS/scope.txt"
  ordinary_environment_in_directory \
    "$MODE_LOGS/probes-run.log" "$MODE_WORK" \
    "$MODE_DIRECTORY/home" "$MODE_LIBRARY" \
    "$ORDINARY_RSCRIPT" --vanilla "$RETAINED_NATIVE_PROBE_RUNNER" \
    --mode=gct "--manifest=$NATIVE_PROBE_MANIFEST" \
    "--candidate-library=$MODE_LIBRARY" \
    "--dependency-library=$ORDINARY_LIBRARY" \
    "--output=$GCT_PROBE_RESULT" \
    "--expected-dso-sha256=$(sha256sum "$MODE_LIBRARY/paradox/libs/paradox.so" | cut -d ' ' -f 1)" \
    --expected-version=2.0.0 --gct-step=10 --rounds=1
  verify_native_probe_result gct "$MODE_LIBRARY" "$GCT_PROBE_RESULT" \
    "$MODE_ARTIFACTS" "$MODE_LOGS/probes-verification.log"
  verify_ordinary_input_receipt_seal post-gct
  verify_ordinary_input_metadata post-gct
fi

validate_instrumented_library() {
  validation_log=$1
  build_configuration=$2
  valgrind_r=$3
  valgrind_library=$4
  package_manifest=$5

  [ -f "$build_configuration" ] ||
    fail "instrumented R has no retained build configuration"
  grep -q -- '--with-valgrind-instrumentation=2' "$build_configuration" ||
    fail "instrumented R was not configured at Valgrind level 2"
  if grep -q -- '--with-blas' "$build_configuration"; then
    fail "instrumented R configuration selected an external BLAS"
  fi

  mkdir -p "$(dirname -- "$validation_log")/home"

  run_logged "$validation_log" env -i \
    "HOME=$(dirname -- "$validation_log")/home" \
    "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
    "PATH=$LOCAL_PATH" \
    "PKG_CONFIG_PATH=$LOCAL_PKG_CONFIG_PATH" \
    "PKG_CONFIG_LIBDIR=$LOCAL_PKG_CONFIG_LIBDIR" \
    "CMAKE_PREFIX_PATH=$LOCAL_CMAKE_PREFIX_PATH" \
    "LD_LIBRARY_PATH=$LOCAL_LD_LIBRARY_PATH" \
    "LIBRARY_PATH=" \
    "CPATH=" \
    "C_INCLUDE_PATH=" \
    "CPLUS_INCLUDE_PATH=" \
    "DEBUGINFOD_URLS=" \
    "R_LIBS_USER=$valgrind_library" \
    "R_LIBS=$valgrind_library" \
    "R_LIBS_SITE=" \
    "R_ENVIRON_USER=/dev/null" \
    "R_PROFILE_USER=/dev/null" \
    "R_MAKEVARS_USER=/dev/null" \
    "R_HISTFILE=/dev/null" \
    "LC_ALL=C.UTF-8" \
    "TZ=UTC" \
    "$valgrind_r" --vanilla --slave \
    -e 'args <- commandArgs(TRUE); manifest <- read.delim(args[[1L]], sep = "\t", quote = "", colClasses = "character", check.names = FALSE); lib <- normalizePath(args[[2L]], mustWork = TRUE); prefix <- normalizePath(args[[3L]], mustWork = TRUE); stopifnot(identical(as.character(getRversion()), "4.6.1"), startsWith(normalizePath(R.home()), prefix), isTRUE(capabilities("profmem")), identical(names(manifest), c("package", "version", "sha256")), !anyDuplicated(manifest$package), !anyNA(manifest), all(nzchar(manifest$package)), all(nzchar(manifest$version)), all(grepl("^[0-9a-f]{64}$", manifest$sha256))); present <- basename(list.dirs(lib, recursive = FALSE, full.names = TRUE)); stopifnot(setequal(present, manifest$package)); for (i in seq_len(nrow(manifest))) { pkg <- manifest$package[[i]]; path <- normalizePath(find.package(pkg, lib.loc = lib), mustWork = TRUE); version <- as.character(packageVersion(pkg, lib.loc = lib)); built <- packageDescription(pkg, lib.loc = lib, fields = "Built"); stopifnot(startsWith(path, paste0(lib, .Platform$file.sep)), identical(version, manifest$version[[i]]), grepl("^R 4\\.6\\.1;", built)); cat(pkg, version, built, sep = "\t"); cat("\n") }; blas <- normalizePath(unname(extSoftVersion()[["BLAS"]]), mustWork = TRUE); stopifnot(startsWith(blas, prefix), grepl("^libRblas", basename(blas))); cat("R_HOME=", R.home(), "\nBLAS=", blas, "\n", sep = "")' \
    --args "$package_manifest" "$valgrind_library" "$(dirname -- "$valgrind_r")/.."
}

acquire_valgrind_state_lock() {
  ensure_plain_state_directory "$ROOT/.local/r-valgrind"
  ensure_plain_state_directory "$(dirname -- "$VALGRIND_STATE_LOCK")"
  [ ! -L "$VALGRIND_STATE_LOCK" ] ||
    fail "instrumented-R state lock must not be symbolic"
  exec 9>>"$VALGRIND_STATE_LOCK"
  [ -f "$VALGRIND_STATE_LOCK" ] && [ ! -L "$VALGRIND_STATE_LOCK" ] || {
    exec 9>&-
    fail "instrumented-R state lock changed while it was opened"
  }
  [ "$(/usr/bin/stat -Lc '%d:%i' /proc/$$/fd/9)" = \
      "$(/usr/bin/stat -Lc '%d:%i' "$VALGRIND_STATE_LOCK")" ] || {
    exec 9>&-
    fail "instrumented-R state lock path was substituted while opening"
  }
  if ! /usr/bin/flock -n -x 9; then
    exec 9>&-
    fail "instrumented-R state is locked by another build, bootstrap, or memory check"
  fi
  VALGRIND_LOCK_HELD=true
}

release_valgrind_state_lock() {
  if [ "$VALGRIND_LOCK_HELD" = true ]; then
    /usr/bin/flock -u 9
    exec 9>&-
    VALGRIND_LOCK_HELD=false
  fi
}

