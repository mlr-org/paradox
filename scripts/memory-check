ensure_source_tarball() {
  if [ -n "$TARBALL" ]; then
    return
  fi
  set -- "$SOURCE_RUN_DIRECTORY"/source-package/build/paradox_*.tar.gz
  [ "$#" -eq 1 ] && [ -f "$1" ] ||
    fail "sealed source run has no unique paradox source archive"
  source_tarball=$1
  [ ! -L "$source_tarball" ] ||
    fail "sealed source-run archive must not be symbolic"
  expected_tarball_sha=$(sed -n 's/^source_archive_sha256=//p' \
    "$RUN_DIRECTORY/metadata/origin-completion.txt")
  case "$expected_tarball_sha" in
    *[!0-9a-f]*|'') fail "sealed source-run archive SHA-256 is malformed" ;;
  esac
  [ "${#expected_tarball_sha}" -eq 64 ] ||
    fail "sealed source-run archive SHA-256 has an invalid length"
  [ "$(sha256sum "$source_tarball" | cut -d ' ' -f 1)" = \
      "$expected_tarball_sha" ] ||
    fail "sealed source-run archive differs from native completion evidence"
  mkdir -p "$SOURCE_PACKAGE_DIRECTORY/build"
  TARBALL="$SOURCE_PACKAGE_DIRECTORY/build/$(basename -- "$source_tarball")"
  run_logged "$SOURCE_PACKAGE_DIRECTORY/archive-copy.log" \
    cp -- "$source_tarball" "$TARBALL"
  [ "$(sha256sum "$TARBALL" | cut -d ' ' -f 1)" = \
      "$expected_tarball_sha" ] ||
    fail "copied source archive differs from sealed native-run input"
  printf '%s  %s\n' "$expected_tarball_sha" "$(basename -- "$TARBALL")" \
    > "$SOURCE_PACKAGE_DIRECTORY/source-archive.sha256"
}

write_probe_dso_hash() {
  probe_library=$1
  probe_artifacts=$2
  probe_dso="$probe_library/paradox/libs/paradox.so"
  [ -f "$probe_dso" ] && [ ! -L "$probe_dso" ] ||
    fail "native-probe DSO is absent or symbolic: $probe_dso"
  probe_dso_sha=$(sha256sum "$probe_dso" | cut -d ' ' -f 1)
  printf '%s  paradox.so\n' "$probe_dso_sha" \
    > "$probe_artifacts/paradox.so.sha256"
}

verify_native_probe_result() {
  probe_mode=$1
  probe_library=$2
  probe_result=$3
  probe_artifacts=$4
  probe_log=$5
  probe_dso="$probe_library/paradox/libs/paradox.so"
  probe_hash="$probe_artifacts/paradox.so.sha256"
  [ -f "$probe_dso" ] && [ ! -L "$probe_dso" ] ||
    fail "$probe_mode native-probe DSO is absent or symbolic"
  [ -f "$probe_result" ] && [ ! -L "$probe_result" ] ||
    fail "$probe_mode native-probe result is absent or symbolic"
  [ -f "$probe_hash" ] && [ ! -L "$probe_hash" ] ||
    fail "$probe_mode native-probe DSO receipt is absent or symbolic"
  probe_dso_sha=$(sha256sum "$probe_dso" | cut -d ' ' -f 1)
  [ "$(wc -l < "$probe_hash")" -eq 1 ] &&
    [ "$(cat "$probe_hash")" = "$probe_dso_sha  paradox.so" ] ||
    fail "$probe_mode native-probe DSO receipt differs from the current DSO"
  run_logged "$probe_log" env -i \
    "HOME=$RUN_DIRECTORY/metadata/home" \
    "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
    "PATH=$LOCAL_PATH" "LD_LIBRARY_PATH=$LOCAL_LD_LIBRARY_PATH" \
    "R_LIBS_USER=" "R_LIBS=" "R_LIBS_SITE=" \
    "R_ENVIRON_USER=/dev/null" "R_PROFILE_USER=/dev/null" \
    "R_MAKEVARS_USER=/dev/null" "R_HISTFILE=/dev/null" \
    "TMPDIR=$ROOT/.local/tmp" "LC_ALL=C.UTF-8" "TZ=UTC" \
    "$RETAINED_MEMORY_EVIDENCE_HELPER" native-probes \
    "$ORDINARY_RSCRIPT" "$RETAINED_NATIVE_PROBE_VERIFIER" \
    "$NATIVE_PROBE_MANIFEST" "$probe_result" "$probe_mode" "$probe_dso"
}

verify_native_analyzer_result() {
  analyzer_mode=$1
  analyzer_ledger=$2
  analyzer_log=$3
  analyzer_dso="$RUN_DIRECTORY/modes/$analyzer_mode/library/paradox/libs/paradox.so"
  [ -f "$analyzer_ledger" ] && [ ! -L "$analyzer_ledger" ] && \
    [ -s "$analyzer_ledger" ] ||
    fail "$analyzer_mode native analyzer ledger is absent, empty, or symbolic"
  run_logged "$analyzer_log" env -i \
    "HOME=$RUN_DIRECTORY/metadata/home" \
    "USER=$LOCAL_USER" "LOGNAME=$LOCAL_USER" \
    "PATH=$LOCAL_PATH" "LD_LIBRARY_PATH=$LOCAL_LD_LIBRARY_PATH" \
    "R_LIBS_USER=$ORDINARY_LIBRARY" "R_LIBS=$ORDINARY_LIBRARY" \
    "R_LIBS_SITE=" "R_ENVIRON_USER=/dev/null" \
    "R_PROFILE_USER=/dev/null" "R_MAKEVARS_USER=/dev/null" \
    "R_HISTFILE=/dev/null" "TMPDIR=$ROOT/.local/tmp" \
    "LC_ALL=C.UTF-8" "TZ=UTC" \
    "$ORDINARY_RSCRIPT" --vanilla "$RETAINED_NATIVE_TEST_VERIFIER" \
    "--source=$SOURCE_DIRECTORY" "--ledger=$analyzer_ledger" \
    --selection=analyzer \
    "--expected-dso-sha256=$(sha256sum "$analyzer_dso" | cut -d ' ' -f 1)"
}

