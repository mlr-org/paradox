#!/usr/bin/env sh

set -eu

usage() {
  cat <<'EOF'
Usage: scripts/native-check --mode MODE [--mode MODE ...] [OPTIONS]

Build and inspect an immutable snapshot of the current Git-visible worktree or
replay a verified snapshot retained by an earlier run.  There is deliberately
no default mode, so merely invoking this script cannot start a long compiler or
sanitizer run.

Modes:
  strict-gcc     GCC 14 C99 source install, warnings as errors
  strict-clang   Clang 22 C99 source install, warnings as errors
  analyzer       GCC 14 -fanalyzer source install
  analyzer-clang Clang 22 Static Analyzer, retained plist per C source
  cppcheck       exhaustive cppcheck pass over shipped C sources
  symbols        strict-GCC build plus registration/ELF export audit
  asan           Clang AddressSanitizer package-DSO-only build and tests
  ubsan          Clang UndefinedBehaviorSanitizer package-DSO-only build/tests
  static         both strict builds and analyzers, cppcheck, and symbols
  all            every mode above, including the two separate sanitizers

Options:
  --tests LEVEL  none, probes, focused, or full (default: focused).  Probes
                 dynamically exercise every registered routine and reviewed
                 allocation/callback hazard plus the reviewed bounded analyzer
                 corpus.  Focused/full functional tests run once, preferring
                 strict GCC; other compiler and sanitizer builds run probes.
                 A full strict-GCC run additionally performs one clean --as-cran
                 check and a test-free depends-only check.
  --run-id ID    use ID below .local/checks instead of a UTC timestamp/PID
  --source-run ID
                 verify and replay the immutable source retained by run ID
  -h, --help     show this help and exit

The repository-local environment must already be active:

  . scripts/activate

Every command, log, compiler version, installed library, source archive, Git
state, and content-hashed snapshot is retained below .local/checks/ID.  ASan
and UBSan are never combined.  These sanitizer modes instrument only the
package DSO and do not claim coverage of a sanitizer-built R runtime.
PARADOX_NATIVE_COMPILE_JOBS and PARADOX_NATIVE_TEST_JOBS may lower, but never
raise, the retained resource-aware install and focused/full test ceilings.
EOF
}

fail() {
  printf '%s\n' "native-check: $*" >&2
  exit 1
}

MODE_STRICT_GCC=false
MODE_STRICT_CLANG=false
MODE_ANALYZER=false
MODE_ANALYZER_CLANG=false
MODE_CPPCHECK=false
MODE_SYMBOLS=false
MODE_ASAN=false
MODE_UBSAN=false
MODE_SELECTED=false
TEST_SELECTION=focused
RUN_ID=
SOURCE_RUN_ID=

select_mode() {
  case "$1" in
    strict-gcc)
      MODE_STRICT_GCC=true
      ;;
    strict-clang)
      MODE_STRICT_CLANG=true
      ;;
    analyzer)
      MODE_ANALYZER=true
      ;;
    analyzer-clang)
      MODE_ANALYZER_CLANG=true
      ;;
    cppcheck)
      MODE_CPPCHECK=true
      ;;
    symbols)
      MODE_SYMBOLS=true
      ;;
    asan)
      MODE_ASAN=true
      ;;
    ubsan)
      MODE_UBSAN=true
      ;;
    static)
      MODE_STRICT_GCC=true
      MODE_STRICT_CLANG=true
      MODE_ANALYZER=true
      MODE_ANALYZER_CLANG=true
      MODE_CPPCHECK=true
      MODE_SYMBOLS=true
      ;;
    all)
      MODE_STRICT_GCC=true
      MODE_STRICT_CLANG=true
      MODE_ANALYZER=true
      MODE_ANALYZER_CLANG=true
      MODE_CPPCHECK=true
      MODE_SYMBOLS=true
      MODE_ASAN=true
      MODE_UBSAN=true
      ;;
    *)
      fail "unknown mode '$1' (see --help)"
      ;;
  esac
  MODE_SELECTED=true
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --mode)
      [ "$#" -ge 2 ] || fail "--mode requires a value"
      select_mode "$2"
      shift 2
      ;;
    --mode=*)
      select_mode "${1#--mode=}"
      shift
      ;;
    --tests)
      [ "$#" -ge 2 ] || fail "--tests requires a value"
      TEST_SELECTION=$2
      shift 2
      ;;
    --tests=*)
      TEST_SELECTION=${1#--tests=}
      shift
      ;;
    --run-id)
      [ "$#" -ge 2 ] || fail "--run-id requires a value"
      RUN_ID=$2
      shift 2
      ;;
    --run-id=*)
      RUN_ID=${1#--run-id=}
      shift
      ;;
    --source-run)
      [ "$#" -ge 2 ] || fail "--source-run requires a value"
      SOURCE_RUN_ID=$2
      shift 2
      ;;
    --source-run=*)
      SOURCE_RUN_ID=${1#--source-run=}
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      [ "$#" -eq 0 ] || fail "positional arguments are not supported"
      ;;
    *)
      fail "unknown argument '$1' (see --help)"
      ;;
  esac
done

[ "$MODE_SELECTED" = true ] || fail "at least one --mode is required"
case "$TEST_SELECTION" in
  none|probes|focused|full) ;;
  *) fail "--tests must be none, probes, focused, or full" ;;
esac

NATIVE_TEST_JOB_OVERRIDE=${PARADOX_NATIVE_TEST_JOBS:-}
NATIVE_COMPILE_JOB_OVERRIDE=${PARADOX_NATIVE_COMPILE_JOBS:-}
for job_override in "$NATIVE_TEST_JOB_OVERRIDE" "$NATIVE_COMPILE_JOB_OVERRIDE"; do
  case "$job_override" in
    '') ;;
    *[!0-9]*|0*)
      fail "native job overrides must be canonical positive integers"
      ;;
  esac
done

# Functional R tests describe package behavior, not compiler identity. Run
# them once under the first selected executable mode and use the complete
# native probe inventory for every other DSO. This preserves compiler and
# sanitizer coverage without repeating a half-hour R corpus per build.
STRICT_GCC_TEST_SCOPE=none
STRICT_CLANG_TEST_SCOPE=none
ASAN_TEST_SCOPE=none
UBSAN_TEST_SCOPE=none
if [ "$TEST_SELECTION" = probes ]; then
  [ "$MODE_STRICT_GCC" = false ] || STRICT_GCC_TEST_SCOPE=probes
  [ "$MODE_STRICT_CLANG" = false ] || STRICT_CLANG_TEST_SCOPE=probes
  [ "$MODE_ASAN" = false ] || ASAN_TEST_SCOPE=probes
  [ "$MODE_UBSAN" = false ] || UBSAN_TEST_SCOPE=probes
elif [ "$TEST_SELECTION" != none ]; then
  [ "$MODE_STRICT_GCC" = false ] || STRICT_GCC_TEST_SCOPE=probes
  [ "$MODE_STRICT_CLANG" = false ] || STRICT_CLANG_TEST_SCOPE=probes
  [ "$MODE_ASAN" = false ] || ASAN_TEST_SCOPE=probes
  [ "$MODE_UBSAN" = false ] || UBSAN_TEST_SCOPE=probes
  if [ "$MODE_STRICT_GCC" = true ]; then
    STRICT_GCC_TEST_SCOPE=$TEST_SELECTION
  elif [ "$MODE_STRICT_CLANG" = true ]; then
    STRICT_CLANG_TEST_SCOPE=$TEST_SELECTION
  elif [ "$MODE_ASAN" = true ]; then
    ASAN_TEST_SCOPE=$TEST_SELECTION
  elif [ "$MODE_UBSAN" = true ]; then
    UBSAN_TEST_SCOPE=$TEST_SELECTION
  fi
fi
if [ "$TEST_SELECTION" != none ] &&
    [ "$MODE_STRICT_GCC" = false ] &&
    [ "$MODE_STRICT_CLANG" = false ] &&
    [ "$MODE_ASAN" = false ] &&
    [ "$MODE_UBSAN" = false ]; then
  fail "--tests $TEST_SELECTION requires at least one executable compiler mode"
fi
NEED_TINY_TEX=false
[ "$TEST_SELECTION" != full ] || NEED_TINY_TEX=true
NEED_CONFIGSPACE=false
[ "$TEST_SELECTION" != full ] || NEED_CONFIGSPACE=true
CONFIGSPACE_FIXTURE_MODE=
[ "$NEED_CONFIGSPACE" != true ] ||
  CONFIGSPACE_FIXTURE_MODE=sealed-v1

SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd -P)
[ "$(pwd -P)" = "$ROOT" ] || fail "run this command from the repository root"
[ "${PARADOX_ACTIVE_ROOT:-}" = "$ROOT" ] ||
  fail "activate the local environment first: . scripts/activate"

TOOLCHAIN="$ROOT/.local/toolchain"
DEPENDENCY_LIBRARY="$ROOT/.local/R/library"
TOOLCHAIN_LOCK="$ROOT/environment/toolchain-linux-64.lock"
MICROMAMBA_VERSION=2.5.0
MICROMAMBA_ARCHIVE_SHA256=cec496f2299f9ceb5f5e23fc2ccf081fffda0c4bc87a6fdab575bf1e04f103b6
MICROMAMBA="$ROOT/.local/bin/micromamba"
MICROMAMBA_ARCHIVE="$ROOT/.cache/downloads/micromamba-${MICROMAMBA_VERSION}-linux-64.tar.bz2"
CONFIGSPACE_BOOTSTRAP="$ROOT/scripts/bootstrap-configspace"
CONFIGSPACE_CURRENT_LOCK="$ROOT/environment/configspace-current-linux-64.lock"
CONFIGSPACE_OLD_LOCK="$ROOT/environment/configspace-old-linux-64.lock"
CONFIGSPACE_CURRENT_PYTHON="$ROOT/.local/configspace/prefixes/current/bin/python"
CONFIGSPACE_OLD_PYTHON="$ROOT/.local/configspace/prefixes/old/bin/python"
CONFIGSPACE_CURRENT_RECEIPT="$ROOT/.local/configspace/receipts/current/receipt.tsv"
CONFIGSPACE_CURRENT_SEAL="$ROOT/.local/configspace/receipts/current/receipt.sha256"
CONFIGSPACE_OLD_RECEIPT="$ROOT/.local/configspace/receipts/old/receipt.tsv"
CONFIGSPACE_OLD_SEAL="$ROOT/.local/configspace/receipts/old/receipt.sha256"
TINY_TEX_MANIFEST="$ROOT/environment/tinytex-linux-x86_64.tsv"
TINY_TEX_ROOT="$ROOT/.local/tinytex"
TINY_TEX_BIN="$TINY_TEX_ROOT/bin/x86_64-linux"
LOCAL_PATH="$TOOLCHAIN/bin:$ROOT/.local/bin:/usr/bin:/bin"
[ "$NEED_TINY_TEX" = false ] || LOCAL_PATH="$TINY_TEX_BIN:$LOCAL_PATH"
LOCAL_TARGET=x86_64-conda-linux-gnu
LOCAL_SYSROOT="$TOOLCHAIN/$LOCAL_TARGET/sysroot"
LOCAL_PKG_CONFIG_PATH="$TOOLCHAIN/lib/pkgconfig:$TOOLCHAIN/share/pkgconfig"
LOCAL_PKG_CONFIG_LIBDIR="$LOCAL_PKG_CONFIG_PATH:$LOCAL_SYSROOT/usr/lib/pkgconfig:$LOCAL_SYSROOT/usr/share/pkgconfig"
LOCAL_CMAKE_PREFIX_PATH="$TOOLCHAIN:$LOCAL_SYSROOT/usr"
LOCAL_LD_LIBRARY_PATH="$TOOLCHAIN/lib"
LOCAL_AR="$TOOLCHAIN/bin/$LOCAL_TARGET-ar"
LOCAL_RANLIB="$TOOLCHAIN/bin/$LOCAL_TARGET-ranlib"
LOCAL_AS="$TOOLCHAIN/bin/$LOCAL_TARGET-as"
LOCAL_LD="$TOOLCHAIN/bin/$LOCAL_TARGET-ld"
LOCAL_NM="$TOOLCHAIN/bin/$LOCAL_TARGET-nm"
LOCAL_STRIP="$TOOLCHAIN/bin/$LOCAL_TARGET-strip"
LOCAL_OBJCOPY="$TOOLCHAIN/bin/$LOCAL_TARGET-objcopy"
LOCAL_OBJDUMP="$TOOLCHAIN/bin/$LOCAL_TARGET-objdump"
LOCAL_READELF="$TOOLCHAIN/bin/$LOCAL_TARGET-readelf"
LOCAL_CPP="$TOOLCHAIN/bin/$LOCAL_TARGET-cpp"
LOCAL_CMAKE_ARGS="-DCMAKE_AR=$LOCAL_AR -DCMAKE_CXX_COMPILER_AR=$TOOLCHAIN/bin/$LOCAL_TARGET-gcc-ar -DCMAKE_C_COMPILER_AR=$TOOLCHAIN/bin/$LOCAL_TARGET-gcc-ar -DCMAKE_RANLIB=$LOCAL_RANLIB -DCMAKE_CXX_COMPILER_RANLIB=$TOOLCHAIN/bin/$LOCAL_TARGET-gcc-ranlib -DCMAKE_C_COMPILER_RANLIB=$TOOLCHAIN/bin/$LOCAL_TARGET-gcc-ranlib -DCMAKE_LINKER=$LOCAL_LD -DCMAKE_STRIP=$LOCAL_STRIP -DCMAKE_BUILD_TYPE=Release"
LOCAL_USER=$(/usr/bin/id -un 2>/dev/null || /usr/bin/id -u) ||
  fail "could not identify the verification worker user"
case "$LOCAL_USER" in
  ''|*[!A-Za-z0-9._-]*)
    fail "verification worker user has an unsafe environment representation"
    ;;
esac
[ -x "$TOOLCHAIN/bin/R" ] || fail "local R is missing; run scripts/bootstrap"
[ -d "$DEPENDENCY_LIBRARY" ] || fail "repository-local R library is missing"
[ -f "$TOOLCHAIN_LOCK" ] && [ ! -L "$TOOLCHAIN_LOCK" ] ||
  fail "toolchain lock is missing or symbolic: $TOOLCHAIN_LOCK"
[ -x "$MICROMAMBA" ] && [ -f "$MICROMAMBA" ] && [ ! -L "$MICROMAMBA" ] ||
  fail "authenticated local micromamba is missing or symbolic: $MICROMAMBA"
[ -f "$MICROMAMBA_ARCHIVE" ] && [ ! -L "$MICROMAMBA_ARCHIVE" ] ||
  fail "pinned micromamba archive is missing or symbolic: $MICROMAMBA_ARCHIVE"
[ "$(sha256sum "$MICROMAMBA_ARCHIVE" | cut -d ' ' -f 1)" = \
  "$MICROMAMBA_ARCHIVE_SHA256" ] || fail "micromamba archive SHA-256 differs from its pin"
micromamba_member_count=$(tar -tjf "$MICROMAMBA_ARCHIVE" |
  awk '$0 == "bin/micromamba" { count += 1 } END { print count + 0 }')
[ "$micromamba_member_count" -eq 1 ] ||
  fail "pinned micromamba archive has no unique bin/micromamba member"
micromamba_member_sha256=$(tar -xOjf "$MICROMAMBA_ARCHIVE" bin/micromamba |
  sha256sum | cut -d ' ' -f 1)
[ "$(sha256sum "$MICROMAMBA" | cut -d ' ' -f 1)" = \
  "$micromamba_member_sha256" ] ||
  fail "installed micromamba differs from the pinned archive member"
[ "$("$MICROMAMBA" --version)" = "$MICROMAMBA_VERSION" ] ||
  fail "authenticated micromamba reports an unexpected version"
if [ "$NEED_CONFIGSPACE" = true ]; then
  for configspace_input in \
      "$CONFIGSPACE_BOOTSTRAP" "$CONFIGSPACE_CURRENT_LOCK" \
      "$CONFIGSPACE_OLD_LOCK" "$CONFIGSPACE_CURRENT_RECEIPT" \
      "$CONFIGSPACE_CURRENT_SEAL" "$CONFIGSPACE_OLD_RECEIPT" \
      "$CONFIGSPACE_OLD_SEAL"; do
    [ -f "$configspace_input" ] && [ ! -L "$configspace_input" ] ||
      fail "sealed ConfigSpace input is absent or symbolic: $configspace_input"
  done
  [ -x "$CONFIGSPACE_BOOTSTRAP" ] ||
    fail "sealed ConfigSpace helper is not executable"
  for configspace_python in \
      "$CONFIGSPACE_CURRENT_PYTHON" "$CONFIGSPACE_OLD_PYTHON"; do
    [ -x "$configspace_python" ] ||
      fail "sealed ConfigSpace Python is not executable: $configspace_python"
    configspace_python_resolved=$(realpath -- "$configspace_python")
    case "$configspace_python:$configspace_python_resolved" in
      "$ROOT/.local/configspace/prefixes/current/"*:"$ROOT/.local/configspace/prefixes/current/"*|\
      "$ROOT/.local/configspace/prefixes/old/"*:"$ROOT/.local/configspace/prefixes/old/"*) ;;
      *) fail "sealed ConfigSpace Python escapes its selected prefix" ;;
    esac
  done
fi
[ "$(sed -n '1p' "$TOOLCHAIN_LOCK")" = '# platform: linux-64' ] &&
  [ "$(sed -n '2p' "$TOOLCHAIN_LOCK")" = '@EXPLICIT' ] ||
  fail "toolchain lock has an unexpected explicit header"
toolchain_lock_rows=$(sed -n '3,$p' "$TOOLCHAIN_LOCK" | awk '
  BEGIN { invalid = 0; count = 0 }
  { count += 1; if ($0 !~ /^https:\/\/[^[:space:]#]+#[0-9a-f]{64}$/) invalid = 1 }
  END { printf "%d:%d\n", count, invalid }
')
case "$toolchain_lock_rows" in
  0:*|*:1) fail "toolchain lock contains no packages or a malformed artifact row" ;;
esac
if grep -Fq "$ROOT" "$TOOLCHAIN_LOCK"; then
  fail "toolchain lock contains a checkout-specific path"
fi
[ -f "$TINY_TEX_MANIFEST" ] && [ ! -L "$TINY_TEX_MANIFEST" ] ||
  fail "TinyTeX manifest is missing or symbolic: $TINY_TEX_MANIFEST"
TINY_TEX_HEADER='version	platform	archive	archive_size	archive_sha256	tree_manifest_sha256	url'
[ "$(wc -l < "$TINY_TEX_MANIFEST")" -eq 2 ] &&
  [ "$(sed -n '1p' "$TINY_TEX_MANIFEST")" = "$(printf '%b' "$TINY_TEX_HEADER")" ] ||
  fail "TinyTeX manifest must contain one exact row"
old_ifs=$IFS
IFS=$(printf '\t')
read -r TINY_TEX_VERSION TINY_TEX_PLATFORM TINY_TEX_ARCHIVE_NAME \
  TINY_TEX_ARCHIVE_SIZE TINY_TEX_ARCHIVE_SHA256 TINY_TEX_TREE_SHA256 \
  TINY_TEX_URL <<EOF
$(sed -n '2p' "$TINY_TEX_MANIFEST")
EOF
IFS=$old_ifs
case "$TINY_TEX_ARCHIVE_SIZE" in ''|*[!0-9]*) fail "TinyTeX archive size is malformed" ;; esac
for tinytex_digest in "$TINY_TEX_ARCHIVE_SHA256" "$TINY_TEX_TREE_SHA256"; do
  case "$tinytex_digest" in ''|*[!0-9a-f]*) fail "TinyTeX digest is malformed" ;; esac
  [ "${#tinytex_digest}" -eq 64 ] || fail "TinyTeX digest has the wrong length"
done
[ "$TINY_TEX_VERSION" = 2026.07 ] &&
  [ "$TINY_TEX_PLATFORM" = linux-x86_64 ] &&
  [ "$TINY_TEX_ARCHIVE_NAME" = "TinyTeX-linux-x86_64-v$TINY_TEX_VERSION.tar.xz" ] &&
  [ "$TINY_TEX_URL" = "https://github.com/rstudio/tinytex-releases/releases/download/v$TINY_TEX_VERSION/$TINY_TEX_ARCHIVE_NAME" ] ||
  fail "TinyTeX manifest identity is unexpected"
[ "${CONDA_PREFIX:-}" = "$TOOLCHAIN" ] ||
  fail "CONDA_PREFIX does not identify the activated local toolchain"
[ "$(command -v R)" = "$TOOLCHAIN/bin/R" ] ||
  fail "R does not resolve to the activated local executable"
[ "$(R RHOME)" = "$TOOLCHAIN/lib/R" ] || fail "R_HOME is not project-local"
if [ "$NEED_TINY_TEX" = true ]; then
  TINY_TEX_ARCHIVE="$ROOT/.cache/downloads/$TINY_TEX_ARCHIVE_NAME"
  [ -f "$TINY_TEX_ARCHIVE" ] && [ ! -L "$TINY_TEX_ARCHIVE" ] ||
    fail "pinned TinyTeX archive is missing or symbolic"
  [ "$(stat -c '%s' "$TINY_TEX_ARCHIVE")" = "$TINY_TEX_ARCHIVE_SIZE" ] ||
    fail "TinyTeX archive size differs from the manifest"
  [ "$(sha256sum "$TINY_TEX_ARCHIVE" | cut -d ' ' -f 1)" = \
    "$TINY_TEX_ARCHIVE_SHA256" ] ||
    fail "TinyTeX archive SHA-256 differs from the manifest"
  for tinytex_tool in pdflatex kpsewhich makeindex; do
    [ -x "$TINY_TEX_BIN/$tinytex_tool" ] ||
      fail "pinned TinyTeX tool is missing: $TINY_TEX_BIN/$tinytex_tool"
    [ "$(PATH=$LOCAL_PATH command -v "$tinytex_tool")" = \
      "$TINY_TEX_BIN/$tinytex_tool" ] ||
      fail "$tinytex_tool does not resolve to the pinned TinyTeX overlay"
  done
  PATH=$LOCAL_PATH "$TINY_TEX_BIN/kpsewhich" -engine=pdftex \
    pdflatex.fmt >/dev/null ||
    fail "pinned TinyTeX cannot locate the pdflatex format"
fi

GCC="$TOOLCHAIN/bin/x86_64-conda-linux-gnu-gcc"
CLANG="$TOOLCHAIN/bin/x86_64-conda-linux-gnu-clang"
CPPCHECK="$TOOLCHAIN/bin/cppcheck"
NM="$TOOLCHAIN/bin/x86_64-conda-linux-gnu-nm"
READELF="$TOOLCHAIN/bin/x86_64-conda-linux-gnu-readelf"
LLVM_SYMBOLIZER="$TOOLCHAIN/bin/llvm-symbolizer"
for required_tool in "$GCC" "$CLANG" "$CPPCHECK" "$NM" "$READELF" \
    "$LLVM_SYMBOLIZER" "$LOCAL_AR" "$LOCAL_RANLIB" "$LOCAL_AS" \
    "$LOCAL_LD" "$LOCAL_NM" "$LOCAL_STRIP" "$LOCAL_OBJCOPY" \
    "$LOCAL_OBJDUMP" "$LOCAL_READELF" "$LOCAL_CPP" \
    "$TOOLCHAIN/bin/$LOCAL_TARGET-gcc-ar" \
    "$TOOLCHAIN/bin/$LOCAL_TARGET-gcc-ranlib"; do
  [ -x "$required_tool" ] || fail "required local tool is missing: $required_tool"
done

R_VERSION=$(R --vanilla --slave -e 'cat(as.character(getRversion()))')
[ "$R_VERSION" = "4.6.1" ] || fail "expected local R 4.6.1, found $R_VERSION"
GCC_VERSION=$($GCC -dumpfullversion -dumpversion)
case "$GCC_VERSION" in 14.*) ;; *) fail "expected GCC 14, found $GCC_VERSION" ;; esac
CLANG_MAJOR=$($CLANG -dM -E -x c /dev/null |
  awk '$2 == "__clang_major__" { print $3 }')
[ "$CLANG_MAJOR" = "22" ] || fail "expected Clang 22, found major $CLANG_MAJOR"

if [ -n "$RUN_ID" ]; then
  case "$RUN_ID" in
    *[!A-Za-z0-9._-]*|''|.|..)
      fail "--run-id must be a safe name using letters, digits, dot, underscore, hyphen"
      ;;
  esac
else
  RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
fi

if [ -n "$SOURCE_RUN_ID" ]; then
  case "$SOURCE_RUN_ID" in
    *[!A-Za-z0-9._-]*|''|.|..)
      fail "--source-run must be a safe name using letters, digits, dot, underscore, hyphen"
      ;;
  esac
  [ "$SOURCE_RUN_ID" != "$RUN_ID" ] ||
    fail "--source-run and --run-id must identify different runs"
fi

CHECKS_ROOT="$ROOT/.local/checks"
require_plain_check_directory() {
  checked_directory=$1
  [ -d "$checked_directory" ] && [ ! -L "$checked_directory" ] ||
    fail "managed check directory is missing, non-directory, or symbolic: $checked_directory"
  [ "$(CDPATH='' cd -- "$checked_directory" && pwd -P)" = "$checked_directory" ] ||
    fail "managed check directory resolves outside its expected path: $checked_directory"
}
require_plain_check_directory "$ROOT/.local"
if [ -L "$CHECKS_ROOT" ] || { [ -e "$CHECKS_ROOT" ] && [ ! -d "$CHECKS_ROOT" ]; }; then
  fail "checks root is symbolic or not a directory: $CHECKS_ROOT"
fi
if [ ! -d "$CHECKS_ROOT" ]; then
  mkdir "$CHECKS_ROOT"
fi
require_plain_check_directory "$CHECKS_ROOT"
if [ -n "$SOURCE_RUN_ID" ]; then
  SOURCE_RUN_DIRECTORY="$CHECKS_ROOT/$SOURCE_RUN_ID"
  require_plain_check_directory "$SOURCE_RUN_DIRECTORY"
  require_plain_check_directory "$SOURCE_RUN_DIRECTORY/source"
  require_plain_check_directory "$SOURCE_RUN_DIRECTORY/metadata"
  [ -f "$SOURCE_RUN_DIRECTORY/metadata/source-manifest.tsv" ] &&
    [ ! -L "$SOURCE_RUN_DIRECTORY/metadata/source-manifest.tsv" ] ||
    fail "source run has no regular retained source manifest: $SOURCE_RUN_DIRECTORY"
  [ -d "$SOURCE_RUN_DIRECTORY/source" ] ||
    fail "source run has no retained source tree: $SOURCE_RUN_DIRECTORY"
fi
RUN_DIRECTORY="$CHECKS_ROOT/$RUN_ID"
[ ! -e "$RUN_DIRECTORY" ] && [ ! -L "$RUN_DIRECTORY" ] ||
  fail "run directory already exists or is symbolic: $RUN_DIRECTORY"
(umask 077 && mkdir "$RUN_DIRECTORY" &&
  mkdir "$RUN_DIRECTORY/metadata" "$RUN_DIRECTORY/modes" \
    "$RUN_DIRECTORY/metadata/home") ||
  fail "run directory already exists or cannot be created: $RUN_DIRECTORY"
require_plain_check_directory "$RUN_DIRECTORY"
HARNESS_SCRIPT="$ROOT/scripts/native-check"
TREE_RECEIPT_HELPER="$ROOT/scripts/environment/tree-receipt.R"
RESOURCE_JOBS_HELPER="$ROOT/scripts/environment/resource-jobs"
MBO_CONFIG_FIXTURE_HELPER="$ROOT/scripts/environment/mbo-config-fixtures"
[ -f "$HARNESS_SCRIPT" ] && [ ! -L "$HARNESS_SCRIPT" ] ||
  fail "native-check harness is missing or symbolic: $HARNESS_SCRIPT"
[ -f "$TREE_RECEIPT_HELPER" ] && [ ! -L "$TREE_RECEIPT_HELPER" ] ||
  fail "tree-receipt helper is missing or symbolic: $TREE_RECEIPT_HELPER"
[ -f "$RESOURCE_JOBS_HELPER" ] && [ ! -L "$RESOURCE_JOBS_HELPER" ] &&
  [ -x "$RESOURCE_JOBS_HELPER" ] ||
  fail "resource scheduler is missing, symbolic, or non-executable: $RESOURCE_JOBS_HELPER"
[ -f "$MBO_CONFIG_FIXTURE_HELPER" ] &&
  [ ! -L "$MBO_CONFIG_FIXTURE_HELPER" ] &&
  [ -x "$MBO_CONFIG_FIXTURE_HELPER" ] ||
  fail "mbo_config fixture helper is missing, symbolic, or non-executable"
cp "$HARNESS_SCRIPT" "$RUN_DIRECTORY/metadata/native-check"
cp "$TREE_RECEIPT_HELPER" "$RUN_DIRECTORY/metadata/tree-receipt.R"
cp "$RESOURCE_JOBS_HELPER" "$RUN_DIRECTORY/metadata/resource-jobs"
NATIVE_CHECK_SHA256=$(sha256sum "$RUN_DIRECTORY/metadata/native-check" |
  cut -d ' ' -f 1)
TREE_RECEIPT_HELPER_SHA256=$(sha256sum \
  "$RUN_DIRECTORY/metadata/tree-receipt.R" | cut -d ' ' -f 1)
RESOURCE_JOBS_HELPER_SHA256=$(sha256sum \
  "$RUN_DIRECTORY/metadata/resource-jobs" | cut -d ' ' -f 1)
(
  cd "$RUN_DIRECTORY/metadata"
  sha256sum native-check tree-receipt.R resource-jobs
) > "$RUN_DIRECTORY/metadata/harness.sha256"
printf 'scope\tmode\tprofile\tjobs\treport_sha256\treport\n' \
  > "$RUN_DIRECTORY/metadata/resource-jobs.tsv"
COMMAND_LOG="$RUN_DIRECTORY/commands.sh"
: > "$COMMAND_LOG"
chmod 600 "$COMMAND_LOG"
COMPLETION_READY=false

finish_run() {
  status=$?
  trap - 0
  if [ "$status" -eq 0 ] && [ "$COMPLETION_READY" = true ] &&
      [ -f "$RUN_DIRECTORY/metadata/completion.txt" ] &&
      [ -f "$RUN_DIRECTORY/metadata/completion.sha256" ]; then
    state=passed
  else
    state=failed
    if [ "$status" -eq 0 ]; then
      status=1
    fi
  fi
  {
    printf 'status=%s\n' "$state"
    printf 'exit_code=%s\n' "$status"
    printf 'finished_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$RUN_DIRECTORY/metadata/result.txt"
  exit "$status"
}
trap finish_run 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

quote_argument() {
  case "$1" in
    '')
      printf "''"
      ;;
    *[!A-Za-z0-9_./:=,+@%-]*)
      printf "'"
      printf '%s' "$1" | sed "s/'/'\\\\''/g"
      printf "'"
      ;;
    *)
      printf '%s' "$1"
      ;;
  esac
}

log_command() {
  printf '$' >> "$COMMAND_LOG"
  for argument do
    printf ' ' >> "$COMMAND_LOG"
    quote_argument "$argument" >> "$COMMAND_LOG"
  done
  printf '\n' >> "$COMMAND_LOG"
}

log_command_in_directory() {
  directory=$1
  shift
  {
    printf '$ cd '
    quote_argument "$directory"
    printf ' &&'
    for argument do
      printf ' '
      quote_argument "$argument"
    done
    printf '\n'
  } >> "$COMMAND_LOG"
}

reject_warnings() {
  checked_log=$1
  warning_report="$checked_log.warnings"
  if grep -E -n -i '(^|[^[:alpha:]])warning([[:space:]]|:)' \
      "$checked_log" > "$warning_report"; then
    cat "$warning_report" >&2
    fail "warning text found in successful command log: $checked_log"
  fi
  rm -f "$warning_report"
}

run_logged() {
  output_log=$1
  shift
  mkdir -p "$(dirname -- "$output_log")"
  log_command "$@"
  if "$@" > "$output_log" 2>&1; then
    :
  else
    command_status=$?
    cat "$output_log" >&2
    fail "command failed with status $command_status (log: $output_log)"
  fi
  reject_warnings "$output_log"
}

run_in_directory_logged() {
  output_log=$1
  working_directory=$2
  shift 2
  mkdir -p "$(dirname -- "$output_log")"
  log_command_in_directory "$working_directory" "$@"
  if (cd "$working_directory" && "$@") > "$output_log" 2>&1; then
    :
  else
    command_status=$?
    cat "$output_log" >&2
    fail "command failed with status $command_status (log: $output_log)"
  fi
  reject_warnings "$output_log"
}

resource_report_value() {
  awk -F '\t' -v target="$2" '
    $1 == target {
      if (NF != 2 || ++count != 1) exit 2
      value = $2
    }
    END {
      if (count != 1) exit 3
      print value
    }
  ' "$1"
}

validate_resource_report() {
  validated_report=$1
  validated_profile=$2
  validated_jobs=$3
  validated_force_one=$4
  awk -F '\t' -v expected_profile="$validated_profile" \
      -v expected_jobs="$validated_jobs" \
      -v force_one="$validated_force_one" '
    function positive(value) {
      return value ~ /^[1-9][0-9]*$/
    }
    function nonnegative(value) {
      return value ~ /^(0|[1-9][0-9]*)$/
    }
    function minimum(left, right) {
      return left < right ? left : right
    }
    BEGIN {
      count = split("field schema profile containment platform online_cpus affinity_cpus cgroup_cpu_limit cpu_limit cpu_reserve cpu_per_job cpu_jobs memory_source memory_available_mib cgroup_memory_available_mib memory_reserve_mib memory_mib_per_job memory_jobs profile_max_jobs operator_max_jobs jobs", keys, " ")
    }
    {
      if (NF != 2 || NR > count || $1 != keys[NR]) bad = 1
      values[$1] = $2
    }
    END {
      if (bad || NR != count || values["field"] != "value" ||
          values["schema"] != "2" ||
          values["profile"] != expected_profile ||
          values["platform"] == "" || values["memory_source"] == "") exit 1

      if (expected_profile == "compile") {
        expected_cpu_per_job = 1
        expected_memory_per_job = 1024
        expected_profile_max = 16
      } else if (expected_profile == "light-test") {
        expected_cpu_per_job = 1
        expected_memory_per_job = 2048
        expected_profile_max = 16
      } else {
        exit 1
      }
      # Containment selects the cooperative memory policy: inside the
      # authenticated aggregate envelope the launcher already withheld the
      # host reserve, so light-test uses the measured 1024-MiB weight and a
      # 4096-MiB intra-envelope floor instead of the conservative direct
      # values.
      if (values["containment"] == "aggregate-systemd") {
        reserve_floor = 4096
        if (expected_profile == "light-test") expected_memory_per_job = 1024
      } else if (values["containment"] == "direct") {
        reserve_floor = 12288
      } else {
        exit 1
      }

      if (!positive(values["online_cpus"]) ||
          !positive(values["affinity_cpus"]) ||
          !positive(values["cpu_limit"]) ||
          !nonnegative(values["cpu_reserve"]) ||
          !positive(values["cpu_per_job"]) ||
          !positive(values["cpu_jobs"]) ||
          !positive(values["memory_available_mib"]) ||
          !positive(values["memory_reserve_mib"]) ||
          !positive(values["memory_mib_per_job"]) ||
          !positive(values["memory_jobs"]) ||
          !positive(values["profile_max_jobs"]) ||
          !positive(values["jobs"]) ||
          !positive(expected_jobs)) exit 1
      if (values["cgroup_cpu_limit"] != "unlimited" &&
          !positive(values["cgroup_cpu_limit"])) exit 1
      if (values["cgroup_memory_available_mib"] != "unlimited" &&
          !positive(values["cgroup_memory_available_mib"])) exit 1
      if (values["cgroup_memory_available_mib"] != "unlimited" &&
          (values["memory_available_mib"] + 0) > (values["cgroup_memory_available_mib"] + 0)) exit 1
      if (values["operator_max_jobs"] != "none" &&
          !positive(values["operator_max_jobs"])) exit 1

      cpu_limit = minimum(values["online_cpus"] + 0,
        values["affinity_cpus"] + 0)
      if (values["cgroup_cpu_limit"] != "unlimited")
        cpu_limit = minimum(cpu_limit, values["cgroup_cpu_limit"] + 0)
      if (values["cpu_limit"] + 0 != cpu_limit) exit 1
      cpu_reserve = cpu_limit >= 16 ? 2 : (cpu_limit >= 4 ? 1 : 0)
      cpu_budget = cpu_limit - cpu_reserve
      if (cpu_budget < 1) cpu_budget = 1
      cpu_jobs = int(cpu_budget / expected_cpu_per_job)
      if (cpu_jobs < 1) cpu_jobs = 1
      if (values["cpu_reserve"] + 0 != cpu_reserve ||
          values["cpu_per_job"] + 0 != expected_cpu_per_job ||
          values["cpu_jobs"] + 0 != cpu_jobs) exit 1

      memory_available = values["memory_available_mib"] + 0
      memory_reserve = int(memory_available / 4)
      if (memory_reserve < reserve_floor) memory_reserve = reserve_floor
      memory_budget = memory_available > memory_reserve ?
        memory_available - memory_reserve : 0
      memory_jobs = int(memory_budget / expected_memory_per_job)
      if (values["memory_reserve_mib"] + 0 != memory_reserve ||
          values["memory_mib_per_job"] + 0 != expected_memory_per_job ||
          memory_jobs < 1 || values["memory_jobs"] + 0 != memory_jobs ||
          values["profile_max_jobs"] + 0 != expected_profile_max) exit 1

      jobs = minimum(cpu_jobs, memory_jobs)
      jobs = minimum(jobs, expected_profile_max)
      if (values["operator_max_jobs"] != "none") {
        operator_max = values["operator_max_jobs"] + 0
        if (operator_max > jobs) exit 1
        jobs = minimum(jobs, operator_max)
      }
      if (values["jobs"] + 0 != jobs || expected_jobs + 0 != jobs) exit 1
      if (force_one == "true" &&
          (values["operator_max_jobs"] != "1" || jobs != 1)) exit 1
    }
  ' "$validated_report" ||
    fail "native resource report is malformed or semantically inconsistent: $validated_report"
}

resource_jobs_decision() {
  resource_report=$1
  resource_scope=$2
  resource_mode=$3
  resource_profile=$4
  resource_override=$5
  set -- env -i "HOME=$RUN_DIRECTORY/metadata/home" \
    "PATH=$LOCAL_PATH" "LC_ALL=C.UTF-8" "TZ=UTC"
  # The sanitized environment must retain the aggregate-containment marker
  # and the coordinator's assigned envelope: they select the cooperative
  # admission policy and cap nested work by the actual allocation.
  if [ "${PARADOX_VERIFY_AGGREGATE_SYSTEMD:-}" = 1 ]; then
    set -- "$@" "PARADOX_VERIFY_AGGREGATE_SYSTEMD=1"
  fi
  if [ -n "${PARADOX_VERIFY_ASSIGNED_CPUS:-}" ] &&
      [ -n "${PARADOX_VERIFY_ASSIGNED_MEMORY_MIB:-}" ]; then
    set -- "$@" \
      "PARADOX_VERIFY_ASSIGNED_CPUS=$PARADOX_VERIFY_ASSIGNED_CPUS" \
      "PARADOX_VERIFY_ASSIGNED_MEMORY_MIB=$PARADOX_VERIFY_ASSIGNED_MEMORY_MIB"
  fi
  set -- "$@" "$RUN_DIRECTORY/metadata/resource-jobs" "$resource_profile"
  if [ -n "$resource_override" ]; then
    set -- "$@" --max-jobs "$resource_override"
  fi
  set -- "$@" --report
  run_logged "$resource_report" "$@"

  resource_cpu_jobs=$(resource_report_value "$resource_report" cpu_jobs) ||
    fail "resource report has no unique cpu_jobs field: $resource_report"
  resource_memory_jobs=$(resource_report_value "$resource_report" memory_jobs) ||
    fail "resource report has no unique memory_jobs field: $resource_report"
  resource_profile_max=$(resource_report_value \
    "$resource_report" profile_max_jobs) ||
    fail "resource report has no unique profile_max_jobs field: $resource_report"
  RESOURCE_JOBS=$(resource_report_value "$resource_report" jobs) ||
    fail "resource report has no unique jobs field: $resource_report"
  case "$resource_cpu_jobs:$resource_memory_jobs:$RESOURCE_JOBS" in
    *[!0-9:]*|0:*|*:0:*|*:0) fail "resource report contains a malformed job count" ;;
  esac
  resource_safe_ceiling=$resource_cpu_jobs
  if [ "$resource_memory_jobs" -lt "$resource_safe_ceiling" ]; then
    resource_safe_ceiling=$resource_memory_jobs
  fi
  case "$resource_profile_max" in
    unlimited) ;;
    *[!0-9]*|0) fail "resource report contains a malformed profile ceiling" ;;
    *)
      if [ "$resource_profile_max" -lt "$resource_safe_ceiling" ]; then
        resource_safe_ceiling=$resource_profile_max
      fi
      ;;
  esac
  if [ -n "$resource_override" ] &&
      [ "$resource_override" -gt "$resource_safe_ceiling" ]; then
    fail "native job override may lower but not exceed safe ceiling $resource_safe_ceiling"
  fi
  resource_expected_jobs=$resource_safe_ceiling
  if [ -n "$resource_override" ] &&
      [ "$resource_override" -lt "$resource_expected_jobs" ]; then
    resource_expected_jobs=$resource_override
  fi
  [ "$RESOURCE_JOBS" -eq "$resource_expected_jobs" ] ||
    fail "resource report selected an unexpected job count"
  resource_relative=${resource_report#"$RUN_DIRECTORY/"}
  [ "$resource_relative" != "$resource_report" ] ||
    fail "resource report escaped the retained native run"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$resource_scope" "$resource_mode" "$resource_profile" \
    "$RESOURCE_JOBS" \
    "$(sha256sum "$resource_report" | cut -d ' ' -f 1)" \
    "$resource_relative" >> "$RUN_DIRECTORY/metadata/resource-jobs.tsv"
}

