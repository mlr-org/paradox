    "$(sha256sum "$TOOLCHAIN_LOCK" | cut -d ' ' -f 1)"
  printf 'toolchain_explicit_sha256=%s\n' "$TOOLCHAIN_EXPLICIT_SHA256"
  printf 'started_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'root=%s\n' "$ROOT"
  printf 'run_id=%s\n' "$RUN_ID"
  printf 'source_run=%s\n' "${SOURCE_RUN_ID:-current-worktree}"
  printf 'tests=%s\n' "$TEST_SELECTION"
  printf 'strict_gcc=%s\n' "$MODE_STRICT_GCC"
  printf 'strict_clang=%s\n' "$MODE_STRICT_CLANG"
  printf 'analyzer=%s\n' "$MODE_ANALYZER"
  printf 'analyzer_clang=%s\n' "$MODE_ANALYZER_CLANG"
  printf 'cppcheck=%s\n' "$MODE_CPPCHECK"
  printf 'symbols=%s\n' "$MODE_SYMBOLS"
  printf 'asan=%s\n' "$MODE_ASAN"
  printf 'ubsan=%s\n' "$MODE_UBSAN"
} > "$RUN_DIRECTORY/metadata/run.txt"

{
  uname -a
  R --version
  "$GCC" --version
  "$CLANG" --version
  "$CPPCHECK" --version
  "$NM" --version
  "$READELF" --version
  if [ "$NEED_TINY_TEX" = true ]; then
    "$TINY_TEX_BIN/pdflatex" --version
    "$TINY_TEX_BIN/kpsewhich" --version
  else
    printf 'tinytex_scope=not-used\n'
  fi
  printf 'micromamba_version=%s\n' "$("$MICROMAMBA" --version)"
  printf 'micromamba_sha256=%s\n' \
    "$(sha256sum "$MICROMAMBA" | cut -d ' ' -f 1)"
  printf 'micromamba_archive_sha256=%s\n' \
    "$(sha256sum "$MICROMAMBA_ARCHIVE" | cut -d ' ' -f 1)"
  printf 'toolchain_explicit_sha256=%s\n' "$TOOLCHAIN_EXPLICIT_SHA256"
  printf 'tinytex_manifest_sha256=%s\n' \
    "$(sha256sum "$TINY_TEX_MANIFEST" | cut -d ' ' -f 1)"
  if [ "$NEED_TINY_TEX" = true ]; then
    printf 'makeindex_sha256=%s\n' \
      "$(sha256sum "$TINY_TEX_BIN/makeindex" | cut -d ' ' -f 1)"
    printf 'tinytex_tree_receipt_sha256=%s\n' \
      "$(sha256sum "$RUN_DIRECTORY/metadata/tinytex-tree.tsv" | cut -d ' ' -f 1)"
  else
    printf 'makeindex_sha256=not-used\n'
    printf 'tinytex_tree_receipt_sha256=not-used\n'
  fi
  printf 'configspace_scope=%s\n' \
    "$(if [ "$NEED_CONFIGSPACE" = true ]; then printf full; else printf not-used; fi)"
  printf 'configspace_bootstrap_sha256=%s\n' \
    "$(if [ "$NEED_CONFIGSPACE" = true ]; then
      sha256sum "$CONFIGSPACE_BOOTSTRAP" | cut -d ' ' -f 1
    else
      printf not-used
    fi)"
  printf 'configspace_current_lock_sha256=%s\n' \
    "$(if [ "$NEED_CONFIGSPACE" = true ]; then
      sha256sum "$CONFIGSPACE_CURRENT_LOCK" | cut -d ' ' -f 1
    else
      printf not-used
    fi)"
  printf 'configspace_current_receipt_sha256=%s\n' \
    "$CONFIGSPACE_CURRENT_RECEIPT_SHA256"
  printf 'configspace_current_seal_sha256=%s\n' \
    "$CONFIGSPACE_CURRENT_SEAL_SHA256"
  printf 'configspace_old_lock_sha256=%s\n' \
    "$(if [ "$NEED_CONFIGSPACE" = true ]; then
      sha256sum "$CONFIGSPACE_OLD_LOCK" | cut -d ' ' -f 1
    else
      printf not-used
    fi)"
  printf 'configspace_old_receipt_sha256=%s\n' \
    "$CONFIGSPACE_OLD_RECEIPT_SHA256"
  printf 'configspace_old_seal_sha256=%s\n' \
    "$CONFIGSPACE_OLD_SEAL_SHA256"
  printf 'R_HOME=%s\n' "$(R RHOME)"
  for configuration in CC CFLAGS CC17 C17FLAGS CPPFLAGS LDFLAGS SHLIB_LD; do
    printf 'R_CMD_config_%s=' "$configuration"
    R CMD config "$configuration"
  done
} > "$RUN_DIRECTORY/metadata/tool-versions.txt" 2>&1

